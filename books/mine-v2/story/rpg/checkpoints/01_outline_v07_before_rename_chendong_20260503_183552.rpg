        description = "向核心成员公开天道契约和缉厄司大司首的秘密"
        event {
          type = "premise"
          state_delta {
            target = "天道契约真相"
            kind = "knowledge"
            field = "reveal"
            to = "reveal"
            note = "向核心成员公开天道契约和缉厄司大司首的秘密"
          }
        }
      }
      step 13 {
        description = "服下延寿丹，寿命延长五十年"
        event {
          type = "status"
          state_delta {
            target = "延寿丹"
            kind = "item"
            field = "use"
            to = "use"
            note = "服下延寿丹，寿命延长五十年"
          }
        }
      }
      step 14 {
        description = "最后一封书信通过遗迹回廊的机关送至据点"
        event {
          type = "acquire"
          state_delta {
            target = "遗迹传信机关"
            kind = "item"
            field = "use"
            to = "send"
            note = "最后一封书信通过遗迹回廊的机关送至据点"
          }
        }
      }
      step 15 {
        description = "林北辰决定加速整合书友会内部力量，准备对缉厄司发起总攻"
        event {
          type = "status"
          state_delta {
            target = "总攻计划"
            kind = "status"
            field = "decide"
            to = "decide"
            note = "林北辰决定加速整合书友会内部力量，准备对缉厄司发起总攻"
          }
        }
      }
      step 16 {
        description = "寿命 resource change: 4 +50 = 54. 服用延寿丹"
        event {
          type = "resource"
          state_delta {
            target = "寿命"
            kind = "resource"
            field = "quantity"
            from = "4"
            to = "54"
            delta = 50
            note = "服用延寿丹"
          }
        }
      }
      step 17 {
        description = "灵石 resource change: 1 +0 = 1. 无变化"
        event {
          type = "resource"
          state_delta {
            target = "灵石"
            kind = "resource"
            field = "quantity"
            from = "1"
            to = "1"
            note = "无变化"
          }
        }
      }
      step 18 {
        description = "林砚在遗迹中与楚怀远告别后返回据点"
        event {
          type = "transition"
          state_delta {
            kind = "transition"
            field = "time_jump"
            to = "true"
            note = "过了1天 林砚在遗迹中与楚怀远告别后返回据点"
          }
        }
      }
    }
  }
}

systems {
  attribute_system "Core Attributes" {
    id = "attr_core"
    description = "Numeric baseline attributes for simulation and continuity checks."
    attribute "Strength" {
      id = "str"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Agility" {
      id = "agi"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Intelligence" {
      id = "int"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Vitality" {
      id = "vit"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "HP" {
      id = "hp"
      type = "resource"
      base_value = 100
      max_value = 999999
      is_resource = true
    }
    attribute "MP" {
      id = "mp"
      type = "resource"
      base_value = 50
      max_value = 999999
      is_resource = true
    }
    attribute "Qi" {
      id = "qi"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "灵石" {
      id = "resource_01"
      description = "修仙界基础硬通货，内含可吸收灵气，用于修炼、布阵、驱动法器。低阶灵石易得，高阶灵石稀有。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "天道碎片" {
      id = "resource_02"
      description = "天道破碎后散落于世间的法则碎片，穿越者体内天然携带，缉厄司猎杀穿越者的根本目标。每块碎片蕴含不同规则（如时间、空间、情感），可被吸收或用于修补天道。也是穿越者金手指力量的潜在来源。此类碎片总数有限，其中一枚被内鬼藏匿，原为其父（缉厄司温和派高层）秘密研究的核心样品，与“轨迹推演”金手指产生共鸣，亦被缉厄司视为追踪标记。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "静心佩" {
      id = "resource_03"
      description = "上古流传的宁神法器，可压制精神类金手指的无意识波动，尤其对「剧情强制」等情感操控型能力有显著抑制效果。甜宠文作者佩戴后可将范围压缩至一丈以下。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "副本核心（玉简）" {
      id = "resource_04"
      description = "无限流作者生成副本所需的媒介，由特殊玉简雕刻而成，可重复充能使用。其材质与天道碎片存在某种共鸣，暗示两者同源。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "禁术封印之物" {
      id = "resource_05"
      description = "矿场地下遗迹中封印的「死后夺取」金手指本体，以七重上古禁制镇压。林砚在逃离矿场时偶然触发其气息，成为后续探索副本核心。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "寿命" {
      id = "resource_06"
      description = "修仙者每进阶一次，寿命大幅延长。练气期约120年，筑基期约300年，金丹期约500年，元婴期约1000年，化神期约2000年。寿命耗尽则无法续命（除特殊天材地宝）。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "干粮及水袋" {
      id = "resource_07"
      description = "修仙界普通干粮与水袋，用于长途跋涉与矿场劳作，无特殊功效，但长期在野外生存必备。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "下品灵石" {
      id = "resource_08"
      description = "修仙界最低阶灵石，广泛流通，用于日常交易与低阶修炼。内含灵气稀薄，练气期常用。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "百年聚气草" {
      id = "resource_09"
      description = "百年药性的聚气草，可用于炼制聚气丹，或直接吸收加速练气期修炼，价值不高但易获取。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "聚气丹" {
      id = "resource_10"
      description = "练气期常用修炼丹药，可加速灵气吸收，提高修炼效率，由聚气草炼制而成。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "练气七层突破丹" {
      id = "resource_11"
