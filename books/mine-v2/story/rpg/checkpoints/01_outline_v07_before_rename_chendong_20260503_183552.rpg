  rule "progression_requirement_金手指体系：附矿场复活_L1" {
    trigger = "progression.requirement"
    effect = "system=金手指体系：附矿场复活; level=1; requires=死亡触发，且复活点为离死亡最近的矿场"
  }
  rule "progression_max_金手指体系：附矿场复活" {
    trigger = "progression.max_level"
    effect = "system=金手指体系：附矿场复活; max_level=1"
  }
  rule "progression_requirement_金手指体系：复活爱人_L1" {
    trigger = "progression.requirement"
    effect = "system=金手指体系：复活爱人; level=1; requires=需触发两个核心条件——所爱之人死亡，且三哥自身对其怀有灵魂层面的强烈执念与爱意。"
  }
  rule "progression_max_金手指体系：复活爱人" {
    trigger = "progression.max_level"
    effect = "system=金手指体系：复活爱人; max_level=1"
  }
  rule "progression_requirement_金手指体系：情感强制_L1" {
    trigger = "progression.requirement"
    effect = "system=金手指体系：情感强制; level=1; requires=主动触发，需与目标面对面接触，且自身灵气充足，目标无强烈的精神防御。"
  }
  rule "progression_max_金手指体系：情感强制" {
    trigger = "progression.max_level"
    effect = "system=金手指体系：情感强制; max_level=1"
  }
  rule "progression_requirement_金手指体系：龙傲天_L1" {
    trigger = "progression.requirement"
    effect = "system=金手指体系：龙傲天; level=1; requires=无主动触发条件，随机被动激活，触发概率与自身气运相关。"
  }
  rule "progression_max_金手指体系：龙傲天" {
    trigger = "progression.max_level"
    effect = "system=金手指体系：龙傲天; max_level=1"
  }
  rule "progression_requirement_金手指体系：异能吞噬_L1" {
    trigger = "progression.requirement"
    effect = "system=金手指体系：异能吞噬; level=1; requires=死后触发，且杀人者必须是拥有金手指的穿越者或伪穿越者（普通本土修士杀死不触发）。"
  }
  rule "progression_max_金手指体系：异能吞噬" {
    trigger = "progression.max_level"
    effect = "system=金手指体系：异能吞噬; max_level=1"
  }
  rule "progression_requirement_金手指体系：轨迹推演_L1" {
    trigger = "progression.requirement"
    effect = "system=金手指体系：轨迹推演; level=1; requires=主动触发，需清晰看到目标的面部或感知到其核心气息，且目标修为不超过自身。"
  }
  rule "progression_max_金手指体系：轨迹推演" {
    trigger = "progression.max_level"
    effect = "system=金手指体系：轨迹推演; max_level=1"
  }
  rule "progression_requirement_金手指体系：话术操控_L1" {
    trigger = "progression.requirement"
    effect = "system=金手指体系：话术操控; level=1; requires=主动触发，需与目标面对面交流，目标无强烈戒备心，且自身消耗少量灵气维持话术效果。"
  }
  rule "progression_max_金手指体系：话术操控" {
    trigger = "progression.max_level"
    effect = "system=金手指体系：话术操控; max_level=1"
  }
  rule "progression_requirement_修仙境界体系：修仙_L1" {
    trigger = "progression.requirement"
    effect = "system=修仙境界体系：修仙; level=1; requires=灵气入体，成功引天地灵气进入体内，完成第一次灵气循环。"
  }
