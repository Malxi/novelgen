world {
  item "灵石" {
    id = "resource_01"
    type = "货币/能源"
    rarity = "common"
    description = "修仙界基础硬通货，内含可吸收灵气，用于修炼、布阵、驱动法器。低阶灵石易得，高阶灵石稀有。"
  }
  item "天道碎片" {
    id = "resource_02"
    type = "核心资源"
    rarity = "legendary"
    description = "天道破碎后散落于世间的法则碎片，穿越者体内天然携带，缉厄司猎杀穿越者的根本目标。每块碎片蕴含不同规则（如时间、空间、情感），可被吸收或用于修补天道。也是穿越者金手指力量的潜在来源。此类碎片总数有限，其中一枚被内鬼藏匿，原为其父（缉厄司温和派高层）秘密研究的核心样品，与“轨迹推演”金手指产生共鸣，亦被缉厄司视为追踪标记。"
  }
  item "静心佩" {
    id = "resource_03"
    type = "法器"
    rarity = "rare"
    description = "上古流传的宁神法器，可压制精神类金手指的无意识波动，尤其对「剧情强制」等情感操控型能力有显著抑制效果。甜宠文作者佩戴后可将范围压缩至一丈以下。"
  }
  item "副本核心（玉简）" {
    id = "resource_04"
    type = "消耗品"
    rarity = "rare"
    description = "无限流作者生成副本所需的媒介，由特殊玉简雕刻而成，可重复充能使用。其材质与天道碎片存在某种共鸣，暗示两者同源。"
  }
  item "禁术封印之物" {
    id = "resource_05"
    type = "禁忌遗产"
    rarity = "legendary"
    description = "矿场地下遗迹中封印的「死后夺取」金手指本体，以七重上古禁制镇压。林砚在逃离矿场时偶然触发其气息，成为后续探索副本核心。"
  }
  item "寿命" {
    id = "resource_06"
    type = "通用"
    rarity = "rare"
    description = "修仙者每进阶一次，寿命大幅延长。练气期约120年，筑基期约300年，金丹期约500年，元婴期约1000年，化神期约2000年。寿命耗尽则无法续命（除特殊天材地宝）。"
  }
  item "干粮及水袋" {
    id = "resource_07"
    type = "通用"
    rarity = "common"
    description = "修仙界普通干粮与水袋，用于长途跋涉与矿场劳作，无特殊功效，但长期在野外生存必备。"
  }
  item "下品灵石" {
    id = "resource_08"
    type = "通用"
    rarity = "common"
    description = "修仙界最低阶灵石，广泛流通，用于日常交易与低阶修炼。内含灵气稀薄，练气期常用。"
  }
  item "百年聚气草" {
    id = "resource_09"
    type = "通用"
    rarity = "common"
    description = "百年药性的聚气草，可用于炼制聚气丹，或直接吸收加速练气期修炼，价值不高但易获取。"
  }
  item "聚气丹" {
    id = "resource_10"
    type = "通用"
    rarity = "common"
    description = "练气期常用修炼丹药，可加速灵气吸收，提高修炼效率，由聚气草炼制而成。"
  }
  item "练气七层突破丹" {
    id = "resource_11"
    type = "通用"
    rarity = "rare"
    description = "专用于辅助练气六层修士突破至练气七层的丹药，含有精纯灵气与少许破境感悟，较为珍贵。"
  }
  item "中品灵石" {
    id = "resource_12"
    type = "通用"
    rarity = "rare"
    description = "品质高于下品灵石的灵石，内含灵气更精纯，常用于交易高阶物品与金丹期修炼，价值较高。"
  }
  item "驱邪符" {
    id = "resource_13"
    type = "通用"
    rarity = "rare"
    description = "(自动添加 — 请手动补充描述)"
  }
  item "蓝色灵石" {
    id = "resource_14"
    type = "通用"
