  rule "storyline_contract_悲情作者的厄运诅咒" {
    trigger = "storyline.contract"
    effect = "id=悲情作者的厄运诅咒; name=悲情作者的厄运诅咒; type=subplot; importance=6; scope=volume; payoff_style=staged_reveal; setup_role=生存压力与黑色幽默; desire=找到打破厄运循环的方法，保护亲近者免受牵连; opposition=不可更改的命运预知，自身霉运指数级叠加; stakes=亲近者接连死亡或自身精神崩溃，甚至可能拖累林砚团队; open_question=预知与复活能否真正互补？能否利用厄运预知反向设计陷阱？; pressure_points=首次预知林砚的死亡但无法阻止 | 因霉运意外暴露团队位置 | 选择隐瞒预知内容导致危机加深 | 在绝境中主动利用厄运制造机会"
  }
  rule "storyline_contract_无限流作者的致命副本" {
    trigger = "storyline.contract"
    effect = "id=无限流作者的致命副本; name=无限流作者的致命副本; type=subplot; importance=8; scope=volume; payoff_style=immediate; setup_role=规则碰撞与资源争夺; desire=利用副本规则破解天道碎片谜题; opposition=副本内的死亡规则、缉厄司对副本的觊觎; stakes=副本若被缉厄司夺取，将成为批量猎杀穿越者的武器; open_question=副本生成器能否用于反向修复天道？; pressure_points=第一次被动卷入副本 | 发现副本核心与天道碎片关联 | 书友会内部对副本使用权的争议 | 与缉厄司在副本内决战"
  }
  rule "storyline_contract_甜宠文作者的剧情强制" {
    trigger = "storyline.contract"
    effect = "id=甜宠文作者的剧情强制; name=甜宠文作者的剧情强制; type=subplot; importance=7; scope=volume; payoff_style=staged_reveal; setup_role=内部猜忌催化剂与黑色幽默来源; desire=控制好自己的能力，不被缉厄司利用或成为团队负担; opposition=无法完全自控的剧情强制效果，书友会成员的不信任; stakes=若能力失控，可能暴露整个组织或造成内部决裂; open_question=能否通过修炼或法器彻底掌控剧情强制，将其变为可控破局手段？; pressure_points=在秘密接头时意外触发强制导致计划暴露 | 被内鬼发现并利用其能力挑拨关系 | 林砚指导她尝试佩戴静心佩观察效果 | 关键时刻主动开启强制制造混乱掩护撤退"
  }
  rule "storyline_contract_考据党的自我历史化" {
    trigger = "storyline.contract"
    effect = "id=考据党的自我历史化; name=考据党的自我历史化; type=character_arc; importance=8; scope=series; payoff_style=final_turn; setup_role=存在主义拷问与极端解法; desire=在历史还原与自我存续间找到平衡; opposition=不可逆的历史化侵蚀、时间紧迫的压力; stakes=若完全历史化，将丧失现代自我意识，成为另一个时代的人; open_question=历史化是否意味着另一种形式的永生？能否反过来通过「历史化」修复被天道碎片侵蚀的灵魂？; pressure_points=首次使用真实还原破解封印 | 发现外貌开始出现历史特征 | 被迫使用第三次以挽救团队 | 最终选择迎接彻底历史化提供线索"
  }
  rule "storyline_contract_不可名状的低语" {
    trigger = "storyline.contract"
    effect = "id=不可名状的低语; name=不可名状的低语; type=character_arc; importance=9; scope=series; payoff_style=slow_burn; setup_role=风险与收益的压倒性杠杆; desire=抵抗疯狂，同时利用污染能力击败缉厄司; opposition=低语侵蚀、天道对异常规则的排斥; stakes=若完全疯魔，将成为不分敌我的污染源; open_question=污染能力能否反过来感染天道本身？; pressure_points=首次使用污染造成小规模异象 | 作者开始出现幻觉与偏执 | 林砚在利用与保护之间的艰难抉择 | 最终爆发导致天道异常注视"
  }
  rule "storyline_contract_无厘头的逻辑崩坏" {
    trigger = "storyline.contract"
    effect = "id=无厘头的逻辑崩坏; name=无厘头的逻辑崩坏; type=subplot; importance=6; scope=volume; payoff_style=staged_reveal; setup_role=混乱战术与天道注视风险; desire=让荒诞能力成为团队的独特战术，而非纯粹笑料; opposition=事件完全随机，无法精确控制，可能适得其反；且频繁使用会引发天道注视; stakes=关键时刻的荒诞事件可能毁灭重要计划或暴露团队，严重时招来天道亲自干预; open_question=这种不可预测的混乱能否被引导成对抗天道的独特武器？; pressure_points=第一次荒诞事件意外拯救团队 | 随之而来更大混乱导致计划延宕 | 团队内部对是否保留他的激烈争议 | 林砚尝试引导荒诞事件出现的规律 | 一次荒诞事件引发天道异常天象"
  }
  rule "storyline_contract_真实刺痛的代价" {
    trigger = "storyline.contract"
    effect = "id=真实刺痛的代价; name=真实刺痛的代价; type=subplot; importance=8; scope=volume; payoff_style=staged_reveal; setup_role=认知代价的警示; desire=平衡真相的获取与心灵的承受; opposition=情绪反噬积累、对人性越来越绝望; stakes=若过度使用，林砚可能沦为冷漠的观察者，丧失行动意志; open_question=真实洞察能否看到连金手指宿主都不自知的深层真实？; pressure_points=首次使用识破内鬼谎言 | 反噬让林砚情绪低落数日 | 在一次关键审讯中使用后产生心魔 | 与悲情作者的厄运预知产生共鸣，形成极端两难"
  }
  rule "storyline_contract_上古科技的理性破解" {
    trigger = "storyline.contract"
    effect = "id=上古科技的理性破解; name=上古科技的理性破解; type=subplot; importance=7; scope=volume; payoff_style=staged_reveal; setup_role=科学与玄学的融合; desire=破解上古遗迹的秘密，获取对抗缉厄司的科技力量; opposition=科学思维与玄学环境的冲突，遗迹中的超自然陷阱; stakes=若失败，可能错失关键线索或触发遗迹自毁; open_question=上古科技是否与天道碎片同源？能否用科技手段修复天道？; pressure_points=首次尝试推演发现误差导致危险 | 与修仙者合作时陷入理念冲突 | 发现遗迹核心与天道碎片产生共鸣"
  }
}

storyline {
  chapter "遗迹的召唤" {
    id = "v7ch01"
    arc = "volume_7"
    objective "遗迹的召唤" {
      id = "obj_v7ch01"
      type = "sequence"
      step 1 {
        description = "考据党的自我历史化 | hook | 林砚发现一处与历史还原相关的遗迹，为后续引入考据党作者埋下伏笔 | 遗迹深处的存在可能会改变林砚对'历史'的认知 | 遗迹共鸣可能引来缉厄司的注意"
        event {
          type = "storyline"
          state_delta {
            target = "考据党的自我历史化"
            kind = "storyline"
            field = "stage"
            to = "hook"
            unit = "遗迹共鸣可能引来缉厄司的注意"
            cost = "遗迹深处的存在可能会改变林砚对'历史'的认知"
            note = "change=林砚发现一处与历史还原相关的遗迹，为后续引入考据党作者埋下伏笔; consequence=遗迹深处的存在可能会改变林砚对'历史'的认知; pressure=遗迹共鸣可能引来缉厄司的注意"
          }
          state_delta {
            target = "考据党的自我历史化"
            kind = "plot_thread"
            field = "storyline"
            to = "raised"
            note = "active pressure in v7ch01"
          }
        }
      }
      step 2 {
        description = "mystery myst_history_jade planted: 玉简上刻有'历史'二字，内部封存着一段被凝固的时间片段"
        event {
          type = "mystery"
          state_delta {
            target = "myst_history_jade"
            kind = "plot_thread"
            field = "mystery"
            to = "raised"
            unit = "this_volume"
            cost = "open"
            note = "玉简上刻有'历史'二字，内部封存着一段被凝固的时间片段"
          }
        }
      }
      step 3 {
        description = "mystery myst_deep_call planted: 禁术种子对遗迹深处的共鸣比之前任何一次都强烈，仿佛那里有它的源头"
        event {
          type = "mystery"
          state_delta {
            target = "myst_deep_call"
            kind = "plot_thread"
            field = "mystery"
            to = "raised"
            unit = "this_volume"
            cost = "open"
            note = "禁术种子对遗迹深处的共鸣比之前任何一次都强烈，仿佛那里有它的源头"
          }
        }
      }
      step 4 {
        description = "chapter start cultivation: 练气三层"
        event {
          type = "status"
          state_delta {
            target = "protagonist"
            kind = "cultivation"
            field = "realm"
            to = "练气三层"
            note = "chapter start cultivation: 练气三层"
          }
        }
      }
      step 5 {
        description = "chapter start spirit stones"
        event {
          type = "status"
          state_delta {
            target = "spirit_stones"
            kind = "resource"
            field = "quantity"
            to = "1"
            note = "chapter start spirit stones"
          }
        }
      }
      step 6 {
        description = "chapter start allies: 赵虎, 苏婉, 慕容寒"
        event {
          type = "status"
          state_delta {
            target = "protagonist"
            kind = "ally"
            field = "active"
            to = "赵虎, 苏婉, 慕容寒"
            note = "chapter start allies: 赵虎, 苏婉, 慕容寒"
          }
        }
      }
      step 7 {
        description = "chapter start key items: 灵气追踪, 终极天道碎片, 规则洞察, 天道碎片残骸, 「历史」玉简"
        event {
          type = "status"
          state_delta {
            target = "protagonist"
            kind = "item"
            field = "key_items"
            to = "灵气追踪, 终极天道碎片, 规则洞察, 天道碎片残骸, 「历史」玉简"
            note = "chapter start key items: 灵气追踪, 终极天道碎片, 规则洞察, 天道碎片残骸, 「历史」玉简"
          }
        }
      }
      step 8 {
        description = "遗迹入口处的封印与矿场地底的禁术封印同源"
        event {
          type = "premise"
          state_delta {
            target = "规则洞察"
            kind = "skill"
            field = "use"
            to = "discover"
            note = "遗迹入口处的封印与矿场地底的禁术封印同源"
          }
        }
      }
      step 9 {
        description = "独自进入遗迹入口，石门在身后关闭"
        event {
          type = "status"
          state_delta {
            target = "遗迹通道"
            kind = "location"
            field = "move"
            to = "move"
            note = "独自进入遗迹入口，石门在身后关闭"
          }
        }
      }
      step 10 {
        description = "在通道石壁上发现一枚嵌着的古老玉简，刻有'历史'二字"
        event {
          type = "acquire"
          state_delta {
            target = "古老玉简"
            kind = "item"
            field = "acquire"
            to = "add"
            note = "在通道石壁上发现一枚嵌着的古老玉简，刻有'历史'二字"
          }
        }
      }
      step 11 {
        description = "禁术种子与玉简产生共鸣，林砚感知到遗迹深处有更强的存在"
        event {
          type = "premise"
          state_delta {
            target = "深层共鸣"
            kind = "knowledge"
            field = "discover"
            to = "react"
            note = "禁术种子与玉简产生共鸣，林砚感知到遗迹深处有更强的存在"
          }
        }
      }
      step 12 {
        description = "灵石 resource change: 1 +0 = 1. 无变化"
        event {
          type = "resource"
          state_delta {
            target = "灵石"
            kind = "resource"
            field = "quantity"
            from = "1"
            to = "1"
            note = "无变化"
          }
        }
      }
      step 13 {
        description = "林砚将遗迹入口情报上报林北辰后，决定当夜独自探索"
        event {
          type = "transition"
          state_delta {
            kind = "transition"
            field = "time_jump"
            to = "true"
            note = "次日 林砚将遗迹入口情报上报林北辰后，决定当夜独自探索"
          }
        }
      }
    }
  }
  chapter "时间的回廊" {
    id = "v7ch02"
    arc = "volume_7"
    objective "时间的回廊" {
      id = "obj_v7ch02"
