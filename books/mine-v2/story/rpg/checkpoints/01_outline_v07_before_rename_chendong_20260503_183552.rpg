
metadata {
  title = "穿越者的天道弈局"
  genre = ["仙侠", "穿越", "悬疑", "黑暗奇幻"]
  power_system = "金手指体系：附矿场复活 + 金手指体系：复活爱人 + 金手指体系：情感强制 + 金手指体系：龙傲天 + 金手指体系：异能吞噬 + 金手指体系：轨迹推演 + 金手指体系：话术操控 + 修仙境界体系：修仙 + 金手指体系：命运悲鸣 + 金手指体系：副本生成器 + 金手指体系：剧情强制 + 金手指体系：真实还原 + 金手指体系：知识污染 + 金手指体系：荒诞吸引 + 金手指体系：真实洞察 + 金手指体系：技术预演 + 阵营体系：缉厄司 + 阵营体系：书友会 + 阵营体系：无阵营威胁 + ?????????"
  tone = "冷峻烧脑，黑暗残酷，悬念迭起，略带黑色幽默"
  dsl_version = "0.2.0"
  phase = "outline"
}

characters {
  player "幽默的主" {
    id = "幽默的主"
    class = "adventurer"
    description = "专写矿场开局修仙文的网络作者林砚穿越为灵石矿奴，他因常年深耕同类型创作觉醒与写作风格绑定的诡异金手指。修仙界遍布各类题材的穿越作者，以维护天道为名的官方组织「缉厄司」实则猎杀穿越者抽取其体内的天道碎片修补破损天道。"
    background = "专写矿场开局修仙文的网络作者林砚穿越为灵石矿奴，他因常年深耕同类型创作觉醒与写作风格绑定的诡异金手指。修仙界遍布各类题材的穿越作者，以维护天道为名的官方组织「缉厄司」实则猎杀穿越者抽取其体内的天道碎片修补破损天道。"
    personality = ["沉稳务实", "重情重义", "求生意志强"]
    motivation = "逃离矿场死循环"
    abilities = ["金手指体系：附矿场复活"]
    role_in_story = "protagonist"
    str = 12
    agi = 11
    int = 14
    vit = 12
    hp = 120
    mp = 60
    skills = ["快速学习"]
  }
