  power_formula "Core Power Formula" {
    id = "power_core"
    description = "Deterministic combat power formula for benchmark simulation."
    base_power = 10
    formula = "base + sum(attr_i * weight_i)"
    factor "Strength" {
      attribute = "str"
      weight = 2
    }
    factor "Agility" {
      attribute = "agi"
      weight = 1.2
    }
    factor "Intelligence" {
      attribute = "int"
      weight = 1.8
    }
    factor "Vitality" {
      attribute = "vit"
      weight = 1.5
    }
    factor "HP" {
      attribute = "hp"
      weight = 0.1
    }
    factor "MP" {
      attribute = "mp"
      weight = 0.2
    }
    factor "Qi" {
      attribute = "qi"
      weight = 1
    }
