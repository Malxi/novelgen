  rule "setup_rule_01" {
    trigger = "always"
    effect = "复活能力一旦暴露，必遭缉厄司锁定追杀或被其他穿越者胁迫利用。"
  }
  rule "setup_rule_02" {
    trigger = "always"
    effect = "金手指力量与作者生前创作题材的专注度和风格鲜明度正相关，断更或转型将导致能力衰退。"
  }
  rule "setup_rule_03" {
    trigger = "always"
    effect = "存在被封印的禁术级金手指「死后夺取」，曾为悬疑类惊悚作者持有，引发穿越者大屠杀后被缉厄司封印于矿场地下遗迹中，是前期大型探索副本的核心线索。"
  }
  rule "setup_rule_04" {
    trigger = "always"
    effect = "缉厄司猎杀穿越者的根本目的是剥离其神魂与天道碎片，用以修补早已千疮百孔的天道。"
  }
  rule "setup_rule_05" {
    trigger = "always"
    effect = "附矿场复活每次复活都会损耗自身修为，损耗下限为练气一层，若处于练气一层时复活将折损10年寿命，寿命归零则彻底死亡；若死亡地点千里范围内无矿场，复活将延迟72小时，且复活后直接处于濒死状态，尸体消失不留痕迹。"
  }
  rule "setup_rule_06" {
    trigger = "always"
    effect = "「复活爱人」能力的「真心所爱」判定以灵魂本源的情感为唯一依据，外力精神操控、诱导产生的虚假爱意无法触发该能力；且情感强制产生的虚假爱意会完全覆盖目标原本对施术者的任何真实好感，不留痕迹，但若施术者解除强制后，目标可能出现「情感印记残留」——对施术者记忆中模糊矛盾的依赖感，可作为后期反水或识破的线索。"
  }
  rule "setup_rule_07" {
    trigger = "always"
    effect = "穿越者互助组织「书友会」内部潜伏着缉厄司内鬼，擅长利用信息差制造猜忌与自相残杀。"
  }
  rule "setup_rule_08" {
    trigger = "always"
    effect = "穿越者的金手指威力与自身本土修仙修为正相关，修为越高金手指的上限越高、副作用越低。"
  }
  rule "setup_rule_09" {
    trigger = "always"
    effect = "同一目标受多个穿越者金手指作用时，其效果取最高值，不可简单叠加；且修为高出施术者一个大境界及以上者，可降低金手指效果的20%作为天然抗性。"
  }
  rule "setup_rule_10" {
    trigger = "always"
    effect = "甜宠文作者的金手指「剧情强制」的生效范围（基础半径十丈）与效果强度受作者自身修为影响，且可被高其一个大境界及以上的修士以精神防御法术短暂抵抗（不超过3息）；作者亦可佩戴特制「静心佩」类法器主动将生效范围从十丈压制至一丈以内。"
  }
  rule "setup_rule_11" {
    trigger = "always"
    effect = "缉厄司内部等级分明：基层缉厄使负责一线猎杀与追踪；司丞统领分队指挥行动；司主掌管区域事务并直接向大司首汇报；大司首为组织最高领袖，仅对天道意志负责。"
  }
  rule "setup_rule_12" {
    trigger = "always"
    effect = "书友会结构松散却暗藏阶层：普通成员仅知有限信息；骨干成员参与核心决策并掌握若干据点；长老负责统筹资源与情报；会长为穿越者中实力与威望最高者，拥有否决权。"
  }
