
metadata {
  title = "外挂公敌"
  genre = ["修仙", "系统流", "反套路", "智斗爽文"]
  power_system = "系统任务日志 + 宿主名单之外 + 任务热度 + 五条宿主线 + 修仙境界与真实战力 + 势力分层"
  tone = "节奏快，吐槽锋利，前期轻松缺德，中期爽感和压力并重，后期保持智斗爽文底色，但让“别人刷任务会伤到真人”的代价越来越清楚。"
  dsl_version = "0.2.0"
  phase = "outline"
}

characters {
  player "青年白烬" {
    id = "青年白烬"
    class = "adventurer"
    description = "现代青年白烬穿越到修仙界青岚宗，成了最底层的杂役。别人开局绑定系统，拿功法、丹药、回档、签到和气运；他什么都没有。"
    background = "现代青年白烬穿越到修仙界青岚宗，成了最底层的杂役。别人开局绑定系统，拿功法、丹药、回档、签到和气运；他什么都没有。"
    personality = ["沉稳务实", "重情重义", "求生意志强"]
    motivation = "白烬想从任务耗材身份里活下来，并弄清如何不再被随意调用。"
    role_in_story = "protagonist"
    str = 12
    agi = 11
    int = 14
    vit = 12
    hp = 120
    mp = 60
    skills = ["快速学习"]
  }
