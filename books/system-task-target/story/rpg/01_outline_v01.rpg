        }
      }
      step 13 {
        description = "在一次回档间隙中，白烬从树洞里发现一张炼气入门残页"
        event {
          type = "acquire"
          acquire {
            actor = "白烬"
            item = "炼气入门残页"
            quantity = 1
            source = "后山树洞"
          }
          state_delta {
            target = "炼气入门残页"
            kind = "item"
            field = "acquire"
            to = "get"
            note = "在一次回档间隙中，白烬从树洞里发现一张炼气入门残页"
          }
        }
      }
      step 14 {
        description = "回档过程中时间线跳跃，但白烬每次都能借助残响保存记忆"
        event {
          type = "transition"
          state_delta {
            kind = "transition"
            field = "time_jump"
            to = "true"
            note = "从第八天经历多次回档 回档过程中时间线跳跃，但白烬每次都能借助残响保存记忆"
          }
        }
      }
    }
  }
}

