  }
  rule "progression_max_宿主名单之外" {
    trigger = "progression.max_level"
    effect = "system=宿主名单之外; max_level=5"
  }
  rule "progression_max_任务热度" {
    trigger = "progression.max_level"
    effect = "system=任务热度; max_level=5"
  }
