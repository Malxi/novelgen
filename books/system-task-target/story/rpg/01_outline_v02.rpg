    effect = "system=势力分层; level=4; requires=第十一至十三卷"
  }
  rule "progression_requirement_势力分层_L5" {
    trigger = "progression.requirement"
    effect = "system=势力分层; level=5; requires=第十四至十六卷"
  }
  rule "progression_requirement_势力分层_L6" {
    trigger = "progression.requirement"
    effect = "system=势力分层; level=6; requires=第十七至十九卷"
  }
  rule "progression_max_势力分层" {
    trigger = "progression.max_level"
    effect = "system=势力分层; max_level=6"
  }
  rule "storyline_contract_没有金手指的耗材" {
    trigger = "storyline.contract"
    effect = "id=没有金手指的耗材; name=没有金手指的耗材; type=main; importance=10; scope=series; payoff_style=staged_reveal; setup_role=解释主角为什么不断卷入宿主冲突：不是因为天生命格特殊，而是因为没被任何系统罩着、身份低、又最好欺负。; desire=白烬想从任务耗材身份里活下来，并弄清如何不再被随意调用。; opposition=各类系统需要他扮演爽点耗材，宿主也需要踩他拿奖励。; stakes=失败意味着白烬会被当成一次性任务怪杀死，或者被迫成为所有系统定义的反派。; open_question=一个没有金手指的人，能不能靠读懂别人的任务栏，活成所有外挂都不敢乱刷的对象？; pressure_points=第一次发现自己在别人的新手任务里 | 大比阶段被多个宿主同时指定为垫脚石 | 黑市阶段悬赏榜上出现白烬 | 终局阶段被公开悬赏为众矢之的"
  }
  rule "storyline_contract_从新手任务怪到众矢之的" {
    trigger = "storyline.contract"
    effect = "id=从新手任务怪到众矢之的; name=从新手任务怪到众矢之的; type=main; importance=10; scope=series; payoff_style=slow_burn; setup_role=提供全书名场面和爽点升级。; desire=白烬想保住普通人的行动自由。; opposition=系统和宿主都需要给他贴标签，好把他写进任务。; stakes=标签一旦坐实，所有宿主都会把击败他当升级捷径。; open_question=被系统刷出来的反派，能不能反过来改写规则？; pressure_points=顾衡回档后把白烬列入高危名单 | 大比宿主把白烬当名场面垫脚石 | 圣地系统把白烬包装成道心反派 | 终局白烬承认众矢之的身份"
  }
  rule "storyline_contract_青岚宗四宿主局" {
    trigger = "storyline.contract"
    effect = "id=青岚宗四宿主局; name=青岚宗四宿主局; type=opening_arc; importance=9; scope=opening; payoff_style=immediate; setup_role=用具体好玩的局面让读者理解设定，而不是先讲宏大规则。; desire=白烬想在大师兄、二师姐、小师弟的任务缝隙中活过新手期。; opposition=回档、气运掠夺、签到三个系统都把青岚宗当起步资源池。; stakes=白烬随时可能被杀、背锅或被拿去刷任务。; payoff=白烬反杀/反制第一个系统宿主，确认日志能力能让他活下去。; pressure_points=饭堂羞辱任务 | 丹房灭口回档 | 陆青禾机缘被截胡 | 宗门大比前夜三系统互撞"
  }
  rule "storyline_contract_普通人不是耗材" {
    trigger = "storyline.contract"
    effect = "id=普通人不是耗材; name=普通人不是耗材; type=moral_arc; importance=9; scope=book; payoff_style=staged_reveal; setup_role=让主角行动不只停留在缺德自保，而有后期立场。; desire=白烬想让自己和身边人不再被当成奖励触发器。; opposition=系统的任务逻辑天然需要耗材，宿主为了变强会合理化消耗。; stakes=如果没人阻止，系统宿主越强，世界越像一张刷分地图。; open_question=白烬能不能在不成为救世圣人的情况下，建立最低限度的边界？; pressure_points=陆青禾机缘被签到和气运任务反复挤压 | 秘境本土弟子被攻略线当成牺牲节点 | 边境城被军功宿主当成刷分诱饵 | 终局普通人被系统重新归类为可调用耗材"
  }
  rule "storyline_contract_系统宿主也是人" {
    trigger = "storyline.contract"
    effect = "id=系统宿主也是人; name=系统宿主也是人; type=character_arc; importance=8; scope=book; payoff_style=staged_reveal; setup_role=避免系统宿主脸谱化，并给后续临时同盟和背刺空间。; desire=白烬想利用宿主，但也不想变成把别人当工具的人。; opposition=系统惩罚、奖励诱惑和宿主自己的欲望。; stakes=错误判断会让白烬被背刺，或亲手毁掉本可救的人。; open_question=一个靠拆别人任务活下来的人，能否不把别人也当任务耗材？; pressure_points=纪迟被签到系统逼着截胡不属于自己的机缘 | 苏瑶在收益和短暂合作之间反复摇摆 | 战场宿主为了活命不得不刷军功 | 终局部分宿主选择帮白烬拆自己的任务"
  }
  rule "storyline_contract_众矢之的终局" {
    trigger = "storyline.contract"
    effect = "id=众矢之的终局; name=众矢之的终局; type=final_arc; importance=9; scope=series; payoff_style=final_turn; setup_role=给长线反派压力和终局方向，不急着露出宏大幕后。; desire=白烬想让系统不敢再随意调用自己和普通人。; opposition=高阶系统宿主和把白烬当升级钥匙的群体任务。; stakes=白烬一旦输，所有被他保护过的人都会被系统重新归类为耗材。; payoff=白烬利用众矢之的身份完成反围剿，建立宿主越界必被反噬的新规则。; open_question=当所有系统都要他当反派，他能不能用这个位置赢出一条普通人能活的路？; pressure_points=高阶宿主远程观察白烬的任务热度 | 圣地阶段白烬被定义成反派模板 | 万妖城后多个系统联合生成围猎任务 | 终局围剿中所有任务奖励都指向击败白烬"
  }
}

storyline {
  chapter "回档后的第一天" {
    id = "P1-V2-C1"
    arc = "P1-V2"
    position = 1
    objective "回档后的第一天" {
      id = "obj_P1-V2-C1"
      type = "sequence"
      step 1 {
        description = "没有金手指的耗材 | pressure | 顾衡从试探式回档转为系统性验证，白烬面对更持续的压力 | 白烬必须更快完成修炼入门，以应对后续回档中的硬实力差距 | 顾衡会连续回档到不同时间节点，测试白烬是否每次都预知"
        event {
          type = "storyline"
          state_delta {
            target = "没有金手指的耗材"
            kind = "storyline"
            field = "stage"
            to = "pressure"
            unit = "顾衡会连续回档到不同时间节点，测试白烬是否每次都预知"
            cost = "白烬必须更快完成修炼入门，以应对后续回档中的硬实力差距"
            note = "change=顾衡从试探式回档转为系统性验证，白烬面对更持续的压力; consequence=白烬必须更快完成修炼入门，以应对后续回档中的硬实力差距; pressure=顾衡会连续回档到不同时间节点，测试白烬是否每次都预知"
          }
