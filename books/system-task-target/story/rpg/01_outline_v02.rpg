  progression "五条宿主线" {
    id = "五条宿主线"
    level 1 {
      name = "顾衡 / 回档系统"
      requirements = "reach level 1"
      bonuses = ["随手重开 -> 路线排除 -> 残响泄露 -> 重来成瘾 -> 重来不等于清零。白烬的解法是收集每次回档留下的失败痕迹。"]
    }
    level 2 {
      name = "苏瑶 / 气运掠夺系统"
      requirements = "reach level 2"
      bonuses = ["借运 -> 夺运 -> 嫁祸 -> 收割关系 -> 气运反噬。白烬的解法是拆她的关系链，让收益条件互相打架。"]
    }
    level 3 {
      name = "纪迟 / 签到系统"
      requirements = "reach level 3"
      bonuses = ["蹲点签到 -> 错位捡漏 -> 地点污染 -> 被迫截胡 -> 反向签到。白烬的解法是把签到点变成诱饵。"]
    }
    level 4 {
      name = "摇光圣女 / 攻略系统线"
      requirements = "reach level 4"
      bonuses = ["被当目标 -> 情敌模板 -> 道心试炼 -> 共同拆局 -> 拒绝被攻略。摇光不是宿主，她是攻略线的核心目标和反制者。"]
    }
    level 5 {
      name = "谢无咎 / 定义系统"
      requirements = "reach level 5"
      bonuses = ["远程标记 -> 反派命名 -> 公开悬赏 -> 同日围猎 -> 外挂公敌。白烬的解法是不否认标签，而是让标签背后的任务条件互相冲突。"]
    }
  }
