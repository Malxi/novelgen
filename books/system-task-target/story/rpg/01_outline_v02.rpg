            field = "storyline"
            to = "raised"
            note = "active pressure in P1-V2-C1"
          }
        }
      }
      step 3 {
        description = "mystery myst_guhun_retrace_range planted: 顾衡的回档起点是上一次时间线的结尾，但每次回档前的时间点都在前移——他似乎能控制回档的精确度，但范围有限。"
        event {
          type = "mystery"
          state_delta {
            target = "myst_guhun_retrace_range"
            kind = "plot_thread"
            field = "mystery"
            to = "raised"
            unit = "this_volume"
