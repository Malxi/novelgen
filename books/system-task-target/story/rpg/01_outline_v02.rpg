  rule "setup_rule_01" {
    trigger = "always"
    effect = "系统宿主拥有不同外挂，但外挂必须靠任务触发、结算或升级；为了制造爽点，任务会主动寻找羞辱对象、见证人、炮灰、背锅人、截胡目标等消耗位。"
  }
  rule "setup_rule_02" {
    trigger = "always"
    effect = "白烬不是系统宿主，不在任何宿主名单里，也没有系统奖励；他不能读档，死亡即真死。"
  }
  rule "setup_rule_03" {
    trigger = "always"
    effect = "白烬不能主动读心，也看不到完整系统面板；他只能看见与自己、当前局势或强烈系统干预有关的任务日志、失败记录和结算残留。"
  }
  rule "setup_rule_04" {
    trigger = "always"
    effect = "白烬不是天选漏洞，也不是隐藏命格。他只是没被任何系统护着，又太像软柿子：身份低、没后台、没外挂反制。系统越喜欢拿他刷奖励，他越容易提前看见任务破绽。"
  }
  rule "setup_rule_05" {
    trigger = "always"
    effect = "任务热度不是奖励，而是危险：它会带来更多任务、更多误会和更高阶宿主。白烬能做的，是把危险改造成诱饵。"
  }
  rule "setup_rule_06" {
    trigger = "always"
    effect = "系统宿主不全是坏人，但他们的任务常常把本土修士、凡人和弱者当成耗材。白烬后期真正要划的线，是“开挂可以，别拿别人垫账”。"
  }
  rule "setup_rule_07" {
    trigger = "always"
    effect = "主角的胜利优先来自信息差、任务条件互卡、对手误判和低成本反制，而不是突然获得压倒性战力。"
  }
  rule "setup_rule_08" {
    trigger = "always"
    effect = "每卷必须有一个具体舞台和清晰玩法：宗门、外门大比、秘境、拍卖黑市、圣地、战场、万妖城、众矢之的终局。"
  }
  rule "resource_scarcity_resource_01" {
    trigger = "resource.scarcity"
    effect = "resource=resource_01; scarcity=不可直接交易，但会随任务干预累积; category=隐性规则资源"
  }
  rule "resource_scarcity_resource_02" {
    trigger = "resource.scarcity"
    effect = "resource=resource_02; scarcity=只有白烬能稳定看见，且多为残缺片段; category=情报资源"
  }
  rule "resource_scarcity_resource_03" {
    trigger = "resource.scarcity"
    effect = "resource=resource_03; scarcity=宿主专属，依赖任务结算; category=系统资源"
  }
  rule "resource_scarcity_resource_04" {
    trigger = "resource.scarcity"
    effect = "resource=resource_04; scarcity=难得易失; category=社会资源"
  }
  rule "resource_scarcity_resource_05" {
    trigger = "resource.scarcity"
    effect = "resource=resource_05; scarcity=不稳定; category=社会资源"
  }
  rule "resource_scarcity_resource_06" {
    trigger = "resource.scarcity"
    effect = "resource=resource_06; scarcity=rare; category=general"
  }
