        event {
          type = "storyline"
          state_delta {
            target = "从新手任务怪到众矢之的"
            kind = "storyline"
            field = "stage"
            to = "hook"
            unit = "一旦被定义为'过不去的任务障碍'，任务热度将升高"
            cost = "白烬在小范围内的异常表现开始引起注意"
            note = "change=顾衡对白烬的怀疑升级为主动验证，白烬开始以'难刷的人'身份被认知; consequence=白烬在小范围内的异常表现开始引起注意; pressure=一旦被定义为'过不去的任务障碍'，任务热度将升高"
          }
