  chapter "顾衡的假山埋伏" {
    id = "P1-V3-C3"
    arc = "P1-V3"
    position = 3
    objective "顾衡的假山埋伏" {
      id = "obj_P1-V3-C3"
      type = "sequence"
      step 1 {
        description = "没有金手指的耗材 | progress | 白烬从被动避开顾衡转为主动转移顾衡的敌意 | 顾衡与纪迟的矛盾加深，白烬的生存空间扩大 | 但顾衡会越来越确认有人在暗中操控局面，最终仍会回到白烬身上"
        event {
          type = "storyline"
