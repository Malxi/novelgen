          }
        }
      }
      step 5 {
        description = "mystery myst_high_level_taskpool planted: 任务热度升级到高级任务池，意味着白烬的名字已经被跨宗门的系统记录，下卷的敌人可能不是青岚宗的宿主"
        event {
          type = "mystery"
          state_delta {
            target = "myst_high_level_taskpool"
            kind = "plot_thread"
            field = "mystery"
            to = "raised"
            unit = "next_volume"
            cost = "open"
            note = "任务热度升级到高级任务池，意味着白烬的名字已经被跨宗门的系统记录，下卷的敌人可能不是青岚宗的宿主"
