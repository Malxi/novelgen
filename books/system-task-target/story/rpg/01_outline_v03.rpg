          state_delta {
            target = "观礼令牌"
            kind = "item"
            field = "acquire"
            to = "get"
            note = "白烬作为杂役获得观礼资格，但无参赛资格"
          }
        }
      }
      step 8 {
        description = "小比奖励榜公告：最终胜者获一枚剑骨，传说可淬炼剑意。白烬看到纪迟面前闪过签到任务日志：『签到任务·高级：于小比决赛擂台中央静坐三十息，奖励：剑骨碎片×1』"
        event {
          type = "storyline"
          state_delta {
            target = "纪迟的签到目标"
            kind = "knowledge"
            field = "discover"
            to = "revealed"
            note = "小比奖励榜公告：最终胜者获一枚剑骨，传说可淬炼剑意。白烬看到纪迟面前闪过签到任务日志：『签到任务·高级：于小比决赛擂台中央静坐三十息，奖励：剑骨碎片×1』"
          }
          state_delta {
            target = "纪迟的签到目标"
            kind = "storyline"
            field = "event"
            to = "revealed"
            note = "小比奖励榜公告：最终胜者获一枚剑骨，传说可淬炼剑意。白烬看到纪迟面前闪过签到任务日志：『签到任务·高级：于小比决赛擂台中央静坐三十息，奖励：剑骨碎片×1』"
          }
        }
      }
      step 9 {
        description = "白烬瞥见苏瑶的任务日志更新：『命格掠夺·陆青禾：使陆青禾在小比全程中被师门公开批评三次以上，即可抽离其命格』"
        event {
          type = "storyline"
          state_delta {
            target = "苏瑶的命格掠夺任务"
            kind = "knowledge"
            field = "discover"
            to = "started"
            note = "白烬瞥见苏瑶的任务日志更新：『命格掠夺·陆青禾：使陆青禾在小比全程中被师门公开批评三次以上，即可抽离其命格』"
          }
          state_delta {
            target = "苏瑶的命格掠夺任务"
            kind = "storyline"
            field = "event"
            to = "started"
            note = "白烬瞥见苏瑶的任务日志更新：『命格掠夺·陆青禾：使陆青禾在小比全程中被师门公开批评三次以上，即可抽离其命格』"
          }
        }
      }
      step 10 {
        description = "顾衡全程未看向白烬，但白烬注意到他袖口有藏经阁高阶功法的灵力残留——他已偷到《玄元诀》并开始修炼"
        event {
          type = "status"
          state_delta {
            target = "顾衡的新功法"
            kind = "knowledge"
            field = "observe"
            to = "observed"
