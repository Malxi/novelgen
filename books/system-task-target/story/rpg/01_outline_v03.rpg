          }
        }
      }
      step 11 {
        description = "chapter start key items: 破旧衣衫, 杂役令牌, 妖狼牙, 草药志（记忆）, 观礼令牌（已过期）, 小香炉（已空）, 莫问君给的药材手册（内含纸条）"
        event {
          type = "status"
          state_delta {
            target = "protagonist"
            kind = "item"
            field = "key_items"
            to = "破旧衣衫, 杂役令牌, 妖狼牙, 草药志（记忆）, 观礼令牌（已过期）, 小香炉（已空）, 莫问君给的药材手册（内含纸条）"
            note = "chapter start key items: 破旧衣衫, 杂役令牌, 妖狼牙, 草药志（记忆）, 观礼令牌（已过期）, 小香炉（已空）, 莫问君给的药材手册（内含纸条）"
          }
        }
      }
      step 12 {
        description = "莫问君在侧厅单独询问白烬，用看似随意的几句话试探：'你最近和陆青禾走得很近？' '你看到剑骨被干扰时在想什么？' '杂役房里有什么有趣的东西吗？'"
        event {
          type = "relationship"
          state_delta {
            target = "白烬"
            kind = "status"
            field = "meet"
            to = "started"
            note = "莫问君在侧厅单独询问白烬，用看似随意的几句话试探：'你最近和陆青禾走得很近？' '你看到剑骨被干扰时在想什么？' '杂役房里有什么有趣的东西吗？'"
          }
        }
      }
      step 13 {
        description = "白烬对所有问题都回答得滴水不漏：'陆师姐是照顾杂役的好人' '我当时吓坏了，只想着躲' '杂役房只有老鼠和破被子'。莫问君笑着让他离开了。"
        event {
          type = "status"
          state_delta {
            target = "模糊回答"
            kind = "knowledge"
            field = "use"
            to = "successful"
            note = "白烬对所有问题都回答得滴水不漏：'陆师姐是照顾杂役的好人' '我当时吓坏了，只想着躲' '杂役房只有老鼠和破被子'。莫问君笑着让他离开了。"
          }
        }
      }
      step 14 {
        description = "白烬从陆青禾处得知：顾衡被禁足三天；苏瑶接到宗门任务临时离开青岚宗前往临城；纪迟的签到系统因剑骨被莫问君收入宗门宝库，系统判定『高级物品位置失效，所有相关路线标记为不可达』，任务自动关闭。但白烬在三人离开前都看到了他们任务日志上的相同提示：『任务热度升级：目标“杂役白烬”已被录入高级任务池』"
        event {
          type = "storyline"
          state_delta {
            target = "任务热度升级"
            kind = "knowledge"
            field = "discover"
            to = "resolved"
            note = "白烬从陆青禾处得知：顾衡被禁足三天；苏瑶接到宗门任务临时离开青岚宗前往临城；纪迟的签到系统因剑骨被莫问君收入宗门宝库，系统判定『高级物品位置失效，所有相关路线标记为不可达』，任务自动关闭。但白烬在三人离开前都看到了他们任务日志上的相同提示：『任务热度升级：目标“杂役白烬”已被录入高级任务池』"
          }
          state_delta {
            target = "任务热度升级"
            kind = "storyline"
            field = "event"
            to = "resolved"
            note = "白烬从陆青禾处得知：顾衡被禁足三天；苏瑶接到宗门任务临时离开青岚宗前往临城；纪迟的签到系统因剑骨被莫问君收入宗门宝库，系统判定『高级物品位置失效，所有相关路线标记为不可达』，任务自动关闭。但白烬在三人离开前都看到了他们任务日志上的相同提示：『任务热度升级：目标“杂役白烬”已被录入高级任务池』"
          }
        }
      }
      step 15 {
        description = "问话结束后，莫问君让弟子转给白烬一本《青岚山低级药材炮制手册》，说是'照顾杂役的奖赏'，但白烬发现书里夹了一页手写的纸条：'三十六宗外门大比将在半年后举行，青岚宗需选十名弟子参加。名额有限。'"
        event {
          type = "acquire"
          acquire {
            actor = "白烬"
            item = "莫问君的信"
            quantity = 1
            source = "回到杂役房后阅读"
          }
          state_delta {
            target = "莫问君的信"
            kind = "item"
            field = "acquire"
            to = "acquired"
            note = "问话结束后，莫问君让弟子转给白烬一本《青岚山低级药材炮制手册》，说是'照顾杂役的奖赏'，但白烬发现书里夹了一页手写的纸条：'三十六宗外门大比将在半年后举行，青岚宗需选十名弟子参加。名额有限。'"
          }
        }
      }
      step 16 {
        description = "灵石 resource change: 3 +1 = 4. 莫问君的弟子在小比后额外给了杂役补贴，白烬分到1块"
        event {
          type = "resource"
          state_delta {
            target = "灵石"
            kind = "resource"
            field = "quantity"
            from = "3"
            to = "4"
            delta = 1
            note = "莫问君的弟子在小比后额外给了杂役补贴，白烬分到1块"
          }
        }
      }
      step 17 {
        description = "决赛后的第二天"
        event {
          type = "transition"
          state_delta {
            kind = "transition"
            field = "time_jump"
            to = "true"
            note = "次日 决赛后的第二天"
          }
        }
      }
    }
  }
}

