          }
        }
      }
      step 11 {
        description = "灵石 resource change: 1 +1 = 2. 小比开幕式上执事发放的杂役补贴"
        event {
          type = "resource"
          state_delta {
            target = "灵石"
            kind = "resource"
            field = "quantity"
            from = "1"
            to = "2"
            delta = 1
            note = "小比开幕式上执事发放的杂役补贴"
          }
        }
      }
      step 12 {
        description = "预选赛结束后，白烬回杂役房睡了一夜，体力恢复"
        event {
          type = "transition"
          state_delta {
            kind = "transition"
            field = "time_jump"
            to = "true"
            note = "次日 预选赛结束后，白烬回杂役房睡了一夜，体力恢复"
          }
        }
      }
    }
  }
