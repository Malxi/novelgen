            note = "莫问君长老在混乱后给杂役们的安抚补贴，白烬作为在场杂役领到1块"
          }
        }
      }
      step 16 {
        description = "布置完成后的第二天"
        event {
          type = "transition"
          state_delta {
            kind = "transition"
            field = "time_jump"
            to = "true"
            note = "次日 布置完成后的第二天"
          }
        }
      }
    }
  }
  chapter "小比之后，暗流涌动" {
    id = "P1-V3-C10"
    arc = "P1-V3"
    position = 10
    objective "小比之后，暗流涌动" {
      id = "obj_P1-V3-C10"
      type = "sequence"
      step 1 {
        description = "没有金手指的耗材 | escalation | 白烬从‘难刷的人’升级为高级任务池目标，意味着更强大的宿主即将登场 | 下卷的三十六宗大比将是全新舞台，敌人不再局限于一个小宗门的三名宿主 | 半年时间窗口内，白烬必须大幅提升自己的修为和情报网络"
        event {
          type = "storyline"
          state_delta {
            target = "没有金手指的耗材"
