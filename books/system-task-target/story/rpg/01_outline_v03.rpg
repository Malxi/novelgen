      description = "功法、丹药、道具、气运、声望、军功等，常常伴随不合理代价。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "本土信任" {
      id = "resource_04"
      description = "白烬在没有硬实力时最重要的生存资源，来自陆青禾、莫问君、摇光圣女等本土角色。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "势力庇护" {
      id = "resource_05"
      description = "来自宗门长老、圣地、边军、万妖城等势力的临时保护。它不是后台，随时可能因为利益变化反噬白烬。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "灵石" {
      id = "resource_06"
      description = "Auto-added by compose pipeline cross check; refine manually."
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
  }
  power_formula "Core Power Formula" {
    id = "power_core"
    description = "Deterministic combat power formula for benchmark simulation."
    base_power = 10
    formula = "base + sum(attr_i * weight_i)"
    factor "Strength" {
      attribute = "str"
      weight = 2
    }
    factor "Agility" {
      attribute = "agi"
      weight = 1.2
    }
    factor "Intelligence" {
      attribute = "int"
      weight = 1.8
    }
    factor "Vitality" {
      attribute = "vit"
      weight = 1.5
    }
    factor "HP" {
      attribute = "hp"
      weight = 0.1
    }
    factor "MP" {
      attribute = "mp"
      weight = 0.2
    }
    factor "Qi" {
      attribute = "qi"
      weight = 1
