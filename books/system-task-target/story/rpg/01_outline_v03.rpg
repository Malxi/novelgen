  progression "系统任务日志" {
    id = "系统任务日志"
    level 1 {
      name = "残留提示"
      requirements = "青岚宗开局，第一次被任务调用。"
      bonuses = ["只能看见与自己直接相关的任务片段。"]
    }
  }
  progression "宿主名单之外" {
    id = "宿主名单之外"
    level 1 {
      name = "软柿子"
      requirements = "reach level 1"
      bonuses = ["系统把他当成随手可用的羞辱对象、背锅人、新手怪。"]
    }
    level 2 {
      name = "常用耗材"
      requirements = "reach level 2"
      bonuses = ["白烬反复出现在任务里，成了宿主们熟悉的刷奖励对象。"]
    }
    level 3 {
      name = "难刷的人"
      requirements = "reach level 3"
      bonuses = ["他开始卡任务条件，系统和宿主都发现这个人不好刷。"]
    }
    level 4 {
      name = "反派靶子"
      requirements = "reach level 4"
      bonuses = ["高阶宿主把他包装成道心试炼、攻略阻碍、宗门隐患。"]
    }
    level 5 {
      name = "外挂公敌"
      requirements = "reach level 5"
      bonuses = ["击败白烬本身变成高收益任务，但谁来刷他，谁就可能被他反刷。"]
    }
  }
  progression "任务热度" {
    id = "任务热度"
    level 1 {
      name = "被随手调用"
      requirements = "reach level 1"
      bonuses = ["系统把白烬当普通路人。"]
    }
    level 2 {
      name = "被重复调用"
      requirements = "reach level 2"
      bonuses = ["系统发现他适合制造冲突。"]
    }
    level 3 {
      name = "被主动标记"
      requirements = "reach level 3"
      bonuses = ["任务开始出现白烬的名字。"]
    }
    level 4 {
      name = "被悬赏调用"
      requirements = "reach level 4"
      bonuses = ["多个宿主围绕白烬获得任务奖励。"]
    }
    level 5 {
      name = "被规则承认"
      requirements = "reach level 5"
      bonuses = ["白烬能用自身任务热度反向吸引和转移任务。"]
    }
  }
  progression "五条宿主线" {
    id = "五条宿主线"
    level 1 {
      name = "顾衡 / 回档系统"
      requirements = "reach level 1"
      bonuses = ["随手重开 -> 路线排除 -> 残响泄露 -> 重来成瘾 -> 重来不等于清零。白烬的解法是收集每次回档留下的失败痕迹。"]
    }
    level 2 {
      name = "苏瑶 / 气运掠夺系统"
      requirements = "reach level 2"
      bonuses = ["借运 -> 夺运 -> 嫁祸 -> 收割关系 -> 气运反噬。白烬的解法是拆她的关系链，让收益条件互相打架。"]
    }
    level 3 {
      name = "纪迟 / 签到系统"
      requirements = "reach level 3"
      bonuses = ["蹲点签到 -> 错位捡漏 -> 地点污染 -> 被迫截胡 -> 反向签到。白烬的解法是把签到点变成诱饵。"]
    }
    level 4 {
      name = "摇光圣女 / 攻略系统线"
      requirements = "reach level 4"
      bonuses = ["被当目标 -> 情敌模板 -> 道心试炼 -> 共同拆局 -> 拒绝被攻略。摇光不是宿主，她是攻略线的核心目标和反制者。"]
    }
    level 5 {
      name = "谢无咎 / 定义系统"
      requirements = "reach level 5"
      bonuses = ["远程标记 -> 反派命名 -> 公开悬赏 -> 同日围猎 -> 外挂公敌。白烬的解法是不否认标签，而是让标签背后的任务条件互相冲突。"]
    }
  }
  progression "修仙境界与真实战力" {
    id = "修仙境界与真实战力"
    level 1 {
      name = "炼气"
      requirements = "reach level 1"
      bonuses = ["外门、杂役和低阶宿主主要阶段。"]
    }
    level 2 {
      name = "筑基"
      requirements = "reach level 2"
      bonuses = ["内门弟子、基层执事和大比强者。"]
    }
    level 3 {
      name = "金丹"
      requirements = "reach level 3"
      bonuses = ["长老、秘境核心对手和战场骨干。"]
    }
    level 4 {
      name = "元婴"
      requirements = "reach level 4"
      bonuses = ["宗门高层、圣地强者和万妖城王族。"]
    }
    level 5 {
      name = "化神"
      requirements = "reach level 5"
      bonuses = ["终局级强者和高阶系统宿主后台。"]
    }
  }
  progression "势力分层" {
    id = "势力分层"
    level 1 {
      name = "青岚宗"
      requirements = "第一至三卷"
      bonuses = ["杂役 -> 外门 -> 内门 -> 核心 -> 长老 -> 宗主。开局舞台，白烬从最底层杂役往上接触宗门规则；宿主把这里当新手村，本土弟子最容易被当耗材。"]
    }
    level 2 {
      name = "三十六宗与上宗"
      requirements = "第四至六卷"
      bonuses = ["小宗弟子 -> 大比选手 -> 宗门种子 -> 上宗观察名单 -> 临时弟子 -> 上宗真传。公开大比舞台，名声、排名、观众和门派脸面会成为系统任务条件。"]
    }
    level 3 {
      name = "仙城黑市"
      requirements = "第九至十卷"
      bonuses = ["散客 -> 掮客 -> 摊主 -> 拍卖行 -> 商会供奉 -> 幕后庄家。交易任务情报、宿主遗物和系统奖励；白烬要用买卖规矩反过来钓买家。"]
    }
    level 4 {
      name = "圣地"
      requirements = "第十一至十三卷"
      bonuses = ["外围弟子 -> 试炼者 -> 真传候选 -> 圣女一系 -> 长老会 -> 圣地主脉。圣地看重道心、名望和身份标签，攻略、收徒、打脸类系统在这里最容易泛滥。"]
    }
    level 5 {
      name = "边军"
      requirements = "第十四至十六卷"
      bonuses = ["新卒 -> 斥候 -> 小队首 -> 百夫长 -> 校尉 -> 镇边将。战场不认爽文名场面，只认军令、粮草和城池伤亡；军功系统在这里必须付出现实代价。"]
    }
    level 6 {
      name = "万妖城"
      requirements = "第十七至十九卷"
      bonuses = ["外城客 -> 契约客卿 -> 妖卫 -> 妖将 -> 王族议席 -> 城主盟约。妖族礼法和契约不按人族系统模板运行，是白烬验证“系统不是万能”的关键舞台。"]
    }
  }
}
