            cost = "下卷的三十六宗大比将是全新舞台，敌人不再局限于一个小宗门的三名宿主"
            note = "change=白烬从‘难刷的人’升级为高级任务池目标，意味着更强大的宿主即将登场; consequence=下卷的三十六宗大比将是全新舞台，敌人不再局限于一个小宗门的三名宿主; pressure=半年时间窗口内，白烬必须大幅提升自己的修为和情报网络"
          }
        }
      }
      step 2 {
        description = "从新手任务怪到众矢之的 | setup | 外门大比邀请到达，白烬的舞台将正式扩展到宗门之外 | 白烬需要在更大范围内保持低调，并应对更多系统的调用 | 莫问君的态度既是机遇也是监视，白烬不能完全信任他"
        event {
          type = "storyline"
          state_delta {
            target = "从新手任务怪到众矢之的"
            kind = "storyline"
            field = "stage"
            to = "setup"
            unit = "莫问君的态度既是机遇也是监视，白烬不能完全信任他"
            cost = "白烬需要在更大范围内保持低调，并应对更多系统的调用"
            note = "change=外门大比邀请到达，白烬的舞台将正式扩展到宗门之外; consequence=白烬需要在更大范围内保持低调，并应对更多系统的调用; pressure=莫问君的态度既是机遇也是监视，白烬不能完全信任他"
          }
        }
      }
      step 3 {
        description = "青岚宗四宿主局 | closure | 青岚宗的小比舞台以三系统互撞告终，三名宿主暂时退场 | 青岚宗线的短期冲突告一段落，但任务热度升高意味着新的敌人 | 莫问君成为新的关键人物，下一卷他将以长老身份出现在大比中"
        event {
          type = "storyline"
          state_delta {
            target = "青岚宗四宿主局"
            kind = "storyline"
            field = "stage"
            to = "closure"
            unit = "莫问君成为新的关键人物，下一卷他将以长老身份出现在大比中"
            cost = "青岚宗线的短期冲突告一段落，但任务热度升高意味着新的敌人"
            note = "change=青岚宗的小比舞台以三系统互撞告终，三名宿主暂时退场; consequence=青岚宗线的短期冲突告一段落，但任务热度升高意味着新的敌人; pressure=莫问君成为新的关键人物，下一卷他将以长老身份出现在大比中"
          }
        }
      }
      step 4 {
        description = "mystery myst_mo_knowledge planted: 莫问君知道白烬不是普通杂役，但他到底知道多少？他是否在利用白烬？"
