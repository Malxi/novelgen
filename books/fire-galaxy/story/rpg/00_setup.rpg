      is_resource = true
    }
    attribute "能量晶核" {
      id = "resource_04"
      description = "(自动添加 — 请手动补充描述)"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
  }
  power_formula "Core Power Formula" {
    id = "power_core"
    description = "Deterministic combat power formula for benchmark simulation."
    base_power = 10
    formula = "base + sum(attr_i * weight_i)"
    factor "Strength" {
      attribute = "str"
      weight = 2
    }
    factor "Agility" {
      attribute = "agi"
      weight = 1.2
    }
    factor "Intelligence" {
      attribute = "int"
      weight = 1.8
    }
    factor "Vitality" {
      attribute = "vit"
      weight = 1.5
    }
    factor "HP" {
      attribute = "hp"
      weight = 0.1
    }
    factor "MP" {
      attribute = "mp"
      weight = 0.2
    }
    factor "Gene Potential" {
      attribute = "gene"
      weight = 1
    }
  }
  counter "chapter_progress" {
    track = "story.chapter"
    description = "Story progression counter"
    milestone 5 {
      title = "Arc Warmup"
    }
    milestone 10 {
      title = "Arc Core"
    }
  }
  counter "基因进化与火种机甲体系_progress" {
    track = "player.progression"
    description = "Primary progression pace tracker"
    milestone 1 {
      title = "System Activated"
    }
    milestone 3 {
      title = "First Breakthrough"
    }
    milestone 5 {
      title = "Mid-Arc Growth"
    }
  }
  progression "基因进化与火种机甲体系" {
    id = "基因进化与火种机甲体系"
    level 1 {
      name = "基因适配者"
      requirements = "首次接触虫族低级晶核，完成基础基因适配，解锁第一次组装火种机甲核心的记忆碎片"
      bonuses = ["刚激活系统的初级状态，可操控基础形态的火种机甲，身体素质是普通人类的3倍，可对抗最低级的工虫"]
    }
    level 2 {
      name = "基因强化者"
      requirements = "吸收10枚低级虫族晶核，基因稳定性达到70%以上，解锁基因锁模块研发的记忆碎片"
      bonuses = ["可解锁机甲的近战、远程武器模块，身体素质提升至普通人类的10倍，能独立对抗虫族的作战兵虫"]
    }
    level 3 {
      name = "基因觉醒者"
      requirements = "吸收1枚中级虫族晶核，扛过基因崩溃的风险，解锁机甲武器模块测试的记忆碎片"
      bonuses = ["可解锁机甲的飞行、能量护盾模块，拥有专属的基因异能，能独立对抗中级虫族与初级虫将，也是次一级基因适配者可达到的最高等级"]
    }
    level 4 {
      name = "基因掌控者"
      requirements = "吸收3枚高级虫族晶核，完全融合火种系统的核心代码，解锁当年爆炸事故前的最后一段工作记忆碎片"
      bonuses = ["仅林野可达到的等级，可解锁机甲的星际航行模块，可通过火种机甲的基因链共振向所有适配基因进化系统的用户发送全域加密信息、共享虫群动向数据，该传输不属于电磁波频段，不受虫族电磁干扰影响，仅适配了基因进化系统的用户可接收，获得进化者的天然信服，可对抗虫族的高级统领"]
    }
    level 5 {
      name = "文明火种者"
      requirements = "吸收虫族母巢的唯一核心晶核，解锁全部文明数据库，解锁当年被暗害的完整真相记忆碎片"
      bonuses = ["仅林野可达到的等级，可激活机甲的终极星舰形态，释放覆盖全球的基因修复波，一次性修复所有人类因虫族长期辐射导致的基因缺陷与生育率下降问题，无法修改或强化正常人类基因；使用该能力后机甲会损失90%核心能量，一年内无法启动星际航行模块，仅可使用一次，拥有该等级权限者是整个人类文明的法定领袖"]
    }
  }
}
