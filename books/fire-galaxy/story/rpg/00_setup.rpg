      is_resource = true
    }
    attribute "Gene Potential" {
      id = "gene"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "虫族晶核" {
      id = "resource_01"
      description = "虫族体内生成的能量结晶，是基因进化的核心原料，也可作为能源驱动火种机甲、据点防御设施等设备"
      type = "resource"
      base_value = 0
      max_value = 999999
