          }
        }
      }
      step 7 {
        description = "林野宣布离开地球前往星际、重建人类文明的计划，同时提到还有其他休眠者存活，下一步先前往青藤据点整合势力，47名幸存者全部愿意跟随他，成为他的第一批追随者；虎子主动申请担任开路先锋，虎妞负责侦察虫族动向，阿禾与周叔负责机甲维修，陈婆负责医疗，苏晴负责队伍管理，分工明确；林野重述了父母当年牺牲的过往，自己最初只是想查清真相，现在决定承担起带领人类重建文明的责任，冲突解决：完成第一阶段的势力集结，明确下一阶段目标"
        event {
          type = "premise"
          state_delta {
            target = "前往星际重建人类文明计划"
            kind = "plan"
            field = "propose"
            to = "established"
            note = "林野宣布离开地球前往星际、重建人类文明的计划，同时提到还有其他休眠者存活，下一步先前往青藤据点整合势力，47名幸存者全部愿意跟随他，成为他的第一批追随者；虎子主动申请担任开路先锋，虎妞负责侦察虫族动向，阿禾与周叔负责机甲维修，陈婆负责医疗，苏晴负责队伍管理，分工明确；林野重述了父母当年牺牲的过往，自己最初只是想查清真相，现在决定承担起带领人类重建文明的责任，冲突解决：完成第一阶段的势力集结，明确下一阶段目标"
          }
        }
      }
      step 8 {
        description = "林野驾驶修复好左臂的重曙机甲开路，带着所有追随者先往西边青藤据点方向出发，正式迈出跨星际远征、整合人类反抗势力的第一步，为第二卷青藤据点的剧情留下钩子：青藤据点内奸身份揭晓、其余休眠者营救、沈氏势力大规模进攻、下一枚密钥争夺"
        event {
          type = "goal"
          state_delta {
            target = "大部队前往青藤据点"
            kind = "action"
            field = "lead"
            to = "started"
            note = "林野驾驶修复好左臂的重曙机甲开路，带着所有追随者先往西边青藤据点方向出发，正式迈出跨星际远征、整合人类反抗势力的第一步，为第二卷青藤据点的剧情留下钩子：青藤据点内奸身份揭晓、其余休眠者营救、沈氏势力大规模进攻、下一枚密钥争夺"
          }
        }
      }
      step 9 {
        description = "初级能量晶核 resource change: 38 -10 = 28. 修复机甲左臂消耗10枚晶核"
        event {
          type = "resource"
          state_delta {
            target = "初级能量晶核"
            kind = "resource"
            field = "quantity"
            from = "38"
            to = "28"
            delta = -10
            note = "修复机甲左臂消耗10枚晶核"
          }
        }
      }
      step 10 {
        description = "chapter start cultivation: 基因强化者（二阶中级）"
        event {
          type = "status"
          state_delta {
            target = "protagonist"
            kind = "cultivation"
            field = "realm"
            to = "基因强化者（二阶中级）"
            note = "chapter start cultivation: 基因强化者（二阶中级）"
          }
        }
      }
      step 11 {
        description = "chapter start spirit stones"
        event {
          type = "status"
          state_delta {
            target = "spirit_stones"
            kind = "resource"
            field = "quantity"
            to = "28"
            note = "chapter start spirit stones"
          }
        }
      }
      step 12 {
        description = "chapter start injuries: 轻度精神力消耗"
        event {
          type = "status"
          state_delta {
            target = "protagonist"
            kind = "injury"
            field = "active"
            to = "injured"
            note = "chapter start injuries: 轻度精神力消耗"
          }
        }
      }
      step 13 {
        description = "小队用6小时清理战场、修复机甲、清点前哨站的物资储备，阿禾与周叔用前哨站的金属零件修复了机甲的左臂"
        event {
          type = "transition"
          state_delta {
            kind = "transition"
            field = "time_jump"
            to = "true"
            note = "6小时 小队用6小时清理战场、修复机甲、清点前哨站的物资储备，阿禾与周叔用前哨站的金属零件修复了机甲的左臂"
          }
        }
      }
    }
  }
}

systems {
  attribute_system "Core Attributes" {
    id = "attr_core"
    description = "Numeric baseline attributes for simulation and continuity checks."
    attribute "Strength" {
      id = "str"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Agility" {
      id = "agi"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Intelligence" {
      id = "int"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Vitality" {
      id = "vit"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "HP" {
      id = "hp"
      type = "resource"
      base_value = 100
      max_value = 999999
      is_resource = true
    }
    attribute "MP" {
      id = "mp"
      type = "resource"
      base_value = 50
      max_value = 999999
      is_resource = true
    }
    attribute "Gene Potential" {
      id = "gene"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "虫族晶核" {
      id = "resource_01"
      description = "虫族体内生成的能量结晶，是基因进化的核心原料，也可作为能源驱动火种机甲、据点防御设施等设备"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "蓝星草" {
      id = "resource_02"
      description = "仅生长在虫族活动极少的地下溶洞深处，磐石堡周边溶洞产量最高，是制作基因抑制剂的核心原材料，目前被沈氏垄断开采"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "基因抑制剂" {
      id = "resource_03"
      description = "由虫族体液搭配蓝星草提取制成，可将基因进化时的崩溃风险降低40%，是各幸存者据点的核心战略物资"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "旧文明数据芯片" {
      id = "resource_04"
      description = "散落在地表旧人类遗址中的存储芯片，录入了旧时代的科技、文化资料，解锁与林野的基因等级绑定，低级芯片可解锁基础生产技术，高级芯片可解锁武器、机甲相关的额外功能，能大幅提升据点的生产、防御能力"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "旧人类核聚变晶块" {
      id = "resource_05"
      description = "大陨落前旧人类批量生产的核聚变能量结晶，仅可驱动旧式纯机械武器、据点供电与防御设施，无法用于基因进化与火种机甲供能，是各据点日常运行的通用能源"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
  }
  power_formula "Core Power Formula" {
    id = "power_core"
    description = "Deterministic combat power formula for benchmark simulation."
    base_power = 10
    formula = "base + sum(attr_i * weight_i)"
    factor "Strength" {
      attribute = "str"
      weight = 2
    }
    factor "Agility" {
      attribute = "agi"
      weight = 1.2
    }
    factor "Intelligence" {
      attribute = "int"
      weight = 1.8
    }
    factor "Vitality" {
      attribute = "vit"
      weight = 1.5
    }
    factor "HP" {
      attribute = "hp"
      weight = 0.1
    }
    factor "MP" {
      attribute = "mp"
      weight = 0.2
    }
    factor "Gene Potential" {
      attribute = "gene"
      weight = 1
    }
  }
  counter "chapter_progress" {
    track = "story.chapter"
    description = "Story progression counter"
    milestone 5 {
      title = "Arc Warmup"
    }
    milestone 10 {
      title = "Arc Core"
    }
  }
  counter "基因进化与火种机甲体系_progress" {
    track = "player.progression"
    description = "Primary progression pace tracker"
    milestone 1 {
      title = "System Activated"
    }
    milestone 3 {
      title = "First Breakthrough"
    }
    milestone 5 {
      title = "Mid-Arc Growth"
    }
  }
  progression "基因进化与火种机甲体系" {
    id = "基因进化与火种机甲体系"
    level 1 {
      name = "基因适配者"
      requirements = "首次接触虫族低级晶核，完成基础基因适配，解锁第一次组装火种机甲核心的记忆碎片"
      bonuses = ["刚激活系统的初级状态，可操控基础形态的火种机甲，身体素质是普通人类的3倍，可对抗最低级的工虫"]
    }
    level 2 {
      name = "基因强化者"
      requirements = "吸收10枚低级虫族晶核，基因稳定性达到70%以上，解锁基因锁模块研发的记忆碎片"
      bonuses = ["可解锁机甲的近战、远程武器模块，身体素质提升至普通人类的10倍，能独立对抗虫族的作战兵虫"]
    }
    level 3 {
      name = "基因觉醒者"
      requirements = "吸收1枚中级虫族晶核，扛过基因崩溃的风险，解锁机甲武器模块测试的记忆碎片"
      bonuses = ["可解锁机甲的飞行、能量护盾模块，拥有专属的基因异能，能独立对抗中级虫族与初级虫将，也是次一级基因适配者可达到的最高等级"]
    }
    level 4 {
      name = "基因掌控者"
      requirements = "吸收3枚高级虫族晶核，完全融合火种系统的核心代码，解锁当年爆炸事故前的最后一段工作记忆碎片"
      bonuses = ["仅林野可达到的等级，可解锁机甲的星际航行模块，可通过火种机甲的基因链共振向所有适配基因进化系统的用户发送全域加密信息、共享虫群动向数据，该传输不属于电磁波频段，不受虫族电磁干扰影响，仅适配了基因进化系统的用户可接收，获得进化者的天然信服，可对抗虫族的高级统领"]
    }
    level 5 {
      name = "文明火种者"
      requirements = "吸收虫族母巢的唯一核心晶核，解锁全部文明数据库，解锁当年被暗害的完整真相记忆碎片"
      bonuses = ["仅林野可达到的等级，可激活机甲的终极星舰形态，释放覆盖全球的基因修复波，一次性修复所有人类因虫族长期辐射导致的基因缺陷与生育率下降问题，无法修改或强化正常人类基因；使用该能力后机甲会损失90%核心能量，一年内无法启动星际航行模块，仅可使用一次，拥有该等级权限者是整个人类文明的法定领袖"]
    }
  }
}
