          type = "relationship"
          state_delta {
            target = "虫族巡逻队"
            kind = "enemy"
            field = "fight"
            to = "improved"
            note = "虎子手持之前缴获的沈氏特制重型反器材穿甲枪远程打虫族的眼部弱点，林野近身偷袭砸烂虫核，两人配合默契，全歼4只3级虫族巡逻队，未触发警报；战斗间隙虎子掏出半块磨得发亮的粉色儿童发饰发呆，跟阿禾说「我妹八岁生日我给她买的，当年虫族冲进来的时候她还攥着，现在不知道还活着不」，对林野的信任进一步提升，获得4枚初级能量晶核"
