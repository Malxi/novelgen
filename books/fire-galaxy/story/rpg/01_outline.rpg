            note = "林野返回据点后注射自产抑制剂，老周用基因检测仪完成二级适配突破后的稳固校准。"
          }
        }
      }
      step 14 {
        description = "苏晴截获到黄土沟据点的求救短讯：上周虫潮冲垮了外围防御工事，他们库存的基因抑制剂已消耗殆尽，冒险者因基因反噬伤亡超过30人，请求青藤据点支援"
        event {
          type = "status"
          state_delta {
            target = "黄土沟据点求援信息"
            kind = "status"
            field = "receive"
            to = "progressed"
            note = "苏晴截获到黄土沟据点的求救短讯：上周虫潮冲垮了外围防御工事，他们库存的基因抑制剂已消耗殆尽，冒险者因基因反噬伤亡超过30人，请求青藤据点支援"
          }
        }
      }
      step 15 {
        description = "林野提议用据点新产的8支抑制剂（含他的那支）支援黄土沟，换取黄土沟的军事同盟与情报共享；吴伯反对，认为抑制剂是据点百年生存的保障，不能外送"
        event {
          type = "relationship"
          state_delta {
            target = "据点资源分配争议"
            kind = "relationship"
            field = "debate"
            to = "progressed"
            note = "林野提议用据点新产的8支抑制剂（含他的那支）支援黄土沟，换取黄土沟的军事同盟与情报共享；吴伯反对，认为抑制剂是据点百年生存的保障，不能外送"
          }
        }
      }
      step 16 {
        description = "林野提出自己携带5支抑制剂前往黄土沟据点‘交易’，同时探查黄土沟附近那枚密钥坐标的旧军事禁区——这样既不算动用据点战略库存（抑制剂是他自产的），又能达成目标"
        event {
          type = "goal"
          state_delta {
            target = "林野的折中方案"
            kind = "goal"
            field = "decide"
            to = "completed"
            note = "林野提出自己携带5支抑制剂前往黄土沟据点‘交易’，同时探查黄土沟附近那枚密钥坐标的旧军事禁区——这样既不算动用据点战略库存（抑制剂是他自产的），又能达成目标"
          }
        }
      }
      step 17 {
        description = "吴伯沉默后松口：‘你去吧，自己谈，别把据点搭进去。’"
        event {
          type = "story"
          state_delta {
            target = "战略说服"
            kind = "relationship"
            field = "persuade"
            to = "吴伯沉默后松口：‘你去吧，自己谈，别把据点搭进去。’"
            note = "吴伯沉默后松口：‘你去吧，自己谈，别把据点搭进去。’"
          }
        }
      }
      step 18 {
        description = "基因抑制剂 resource change: 1 -1 = 0. 林野注射最后1支随身抑制剂稳定基因"
        event {
          type = "resource"
          state_delta {
            target = "基因抑制剂"
            kind = "resource"
            field = "quantity"
            from = "1"
            to = "0"
            delta = -1
            note = "林野注射最后1支随身抑制剂稳定基因"
          }
        }
      }
      step 19 {
        description = "林野在地窖升级后连夜赶路，中途避开两拨虫族巡逻队，于第23天上午回到青藤据点"
        event {
          type = "transition"
          state_delta {
            kind = "transition"
            field = "time_jump"
            to = "true"
            note = "过了2天 林野在地窖升级后连夜赶路，中途避开两拨虫族巡逻队，于第23天上午回到青藤据点"
          }
        }
      }
    }
  }
