  chapter "初代机甲重曙" {
    id = "P1-V1-C6"
    arc = "P1-V1"
    objective "初代机甲重曙" {
      id = "obj_P1-V1-C6"
      type = "sequence"
      step 1 {
        description = "火种远征主线 | pressure | 林野成功修复专属重曙机甲，人类获得了对抗虫族的核心战力，打破边境封锁成为可能 | 接下来可以依靠机甲的战力攻破虫族前哨站，打通前往青藤据点的通道，整合更多反抗力量 | 机甲的能量波动已经传出去，虫族和机械部队很快就会大规模赶来，必须尽快离开研究所"
        event {
          type = "storyline"
          state_delta {
            target = "火种远征主线"
            kind = "storyline"
            field = "stage"
            to = "pressure"
            unit = "机甲的能量波动已经传出去，虫族和机械部队很快就会大规模赶来，必须尽快离开研究所"
            cost = "接下来可以依靠机甲的战力攻破虫族前哨站，打通前往青藤据点的通道，整合更多反抗力量"
            note = "change=林野成功修复专属重曙机甲，人类获得了对抗虫族的核心战力，打破边境封锁成为可能; consequence=接下来可以依靠机甲的战力攻破虫族前哨站，打通前往青藤据点的通道，整合更多反抗力量; pressure=机甲的能量波动已经传出去，虫族和机械部队很快就会大规模赶来，必须尽快离开研究所"
          }
          state_delta {
            target = "火种远征主线"
            kind = "plot_thread"
            field = "storyline"
            to = "raised"
            note = "active pressure in P1-V1-C6"
          }
        }
      }
      step 2 {
        description = "林野找到自己当年主导研发的初代实验型机甲「重曙」，状态完好仅能源系统损坏，解锁机甲设计的完整记忆碎片，记忆深处闪过陌生的三角形蓝紫色符号与冰冷机械音，他以为是机甲的开机音效没在意；阿禾认出机甲是父亲当年参与研发的机型，机甲胸甲上的编号「ZH-001」与特殊散热纹路是他父亲亲手设计的，坚定了协助林野的决心，阿禾的父亲当年是研究所的机械工程师，大陨落时没能逃出来，重曙是他参与研发的最后一个项目，阿禾的执念是完成父亲的遗愿，让重曙机甲重新上天"
        event {
          type = "discovery"
          state_delta {
            target = "初代机甲重曙"
            kind = "item"
            field = "find"
            to = "completed"
            note = "林野找到自己当年主导研发的初代实验型机甲「重曙」，状态完好仅能源系统损坏，解锁机甲设计的完整记忆碎片，记忆深处闪过陌生的三角形蓝紫色符号与冰冷机械音，他以为是机甲的开机音效没在意；阿禾认出机甲是父亲当年参与研发的机型，机甲胸甲上的编号「ZH-001」与特殊散热纹路是他父亲亲手设计的，坚定了协助林野的决心，阿禾的父亲当年是研究所的机械工程师，大陨落时没能逃出来，重曙是他参与研发的最后一个项目，阿禾的执念是完成父亲的遗愿，让重曙机甲重新上天"
          }
        }
      }
      step 3 {
        description = "在机械师阿禾的协助下，用收集到的5枚能量晶核修复机甲的动力核心，阿禾主动提出以后当林野的专属机师，完成父亲未完成的遗愿"
