
metadata {
  title = "虫巢远征"
  genre = ["科幻", "废土", "机甲", "末世"]
  power_system = "基因进化与火种机甲体系"
  tone = "热血激昂，硬核科幻，末世苍凉，爽感充足"
  dsl_version = "0.2.0"
  phase = "outline"
}

characters {
  enemy "虫族幼虫" {
    id = "虫族_低级_虫族幼虫"
    type = "虫族"
    level = 1
    description = "休眠舱区游荡觅食"
  }
  enemy "机械斥候" {
    id = "叛变ai「零」_低级_机械斥候"
    type = "叛变AI「零」"
    level = 2
    description = "AI零的地下巡逻部队，巡查废弃科研区的能量波动"
  }
  enemy "虫族工蜂" {
    id = "虫族_低级_虫族工蜂"
    type = "虫族"
    level = 2
    description = "地表巡逻虫族小队，为之前袭击游击营地的残余兵力"
  }
  enemy "虫族侦察小队" {
    id = "虫族_低级_虫族侦察小队"
    type = "虫族"
    level = 2
    description = "追踪人类踪迹突袭营地，被林野击杀3只，剩余2只被小队的能量步枪击杀"
  }
  enemy "营地叛徒" {
    id = "人类/沈氏内应_低级_营地叛徒"
    type = "人类/沈氏内应"
    level = 1
    description = "为了粮食打算绑架林野换沈氏的悬赏"
  }
  enemy "虫族巡逻队" {
    id = "虫族_中级_虫族巡逻队"
    type = "虫族"
    level = 3
    description = "机甲库入口巡逻，定期巡查门禁状态"
  }
  enemy "机械清扫兵" {
    id = "叛变ai「零」_中级_机械清扫兵"
    type = "叛变AI「零」"
    level = 3
    description = "AI零的部队追踪机甲库的能量波动闯入"
  }
  enemy "虫族作战小队" {
    id = "虫族_中级_虫族作战小队"
    type = "虫族"
    level = 3
    description = "前往研究所巡逻的虫族部队"
  }
  enemy "虫族近卫虫" {
    id = "虫族_高级_虫族近卫虫"
    type = "虫族"
    level = 4
    description = "虫族小队长，带队巡逻"
  }
  enemy "虫族守军" {
    id = "虫族_中级_虫族守军"
    type = "虫族"
    level = 3
    description = "东侧防线守军，大部分被调往西侧对抗机械部队，已经残血"
  }
  enemy "残余机械部队" {
    id = "叛变ai「零」_中级_残余机械部队"
    type = "叛变AI「零」"
    level = 3
    description = "西侧战场残余兵力，几乎被虫族打残"
  }
  enemy "刀锋虫" {
    id = "虫族_高级_刀锋虫"
    type = "虫族"
    level = 5
    description = "前哨站统领，与机械部队激战多时，能量消耗过半，战力下降30%"
  }
  npc "protagonist" {
    id = "protagonist"
    __placeholder__ = true
    __source_phase__ = "outline"
  }
}

world {
  location "wasteland" {
    id = "wasteland"
    __placeholder__ = true
    __source_phase__ = "outline"
  }
  location "cryo_facility" {
    id = "cryo_facility"
    __placeholder__ = true
    __source_phase__ = "outline"
  }
  item "虫族晶核" {
    id = "resource_01"
    type = "能源/材料"
    rarity = "legendary"
    description = "虫族体内生成的能量结晶，是基因进化的核心原料，也可作为能源驱动火种机甲、据点防御设施等设备"
  }
  item "蓝星草" {
    id = "resource_02"
    type = "材料"
    rarity = "rare"
    description = "仅生长在虫族活动极少的地下溶洞深处，磐石堡周边溶洞产量最高，是制作基因抑制剂的核心原材料，目前被沈氏垄断开采"
  }
  item "基因抑制剂" {
    id = "resource_03"
    type = "消耗品"
    rarity = "rare"
    description = "由虫族体液搭配蓝星草提取制成，可将基因进化时的崩溃风险降低40%，是各幸存者据点的核心战略物资"
  }
  item "旧文明数据芯片" {
    id = "resource_04"
    type = "材料"
    rarity = "rare"
    description = "散落在地表旧人类遗址中的存储芯片，录入了旧时代的科技、文化资料，解锁与林野的基因等级绑定，低级芯片可解锁基础生产技术，高级芯片可解锁武器、机甲相关的额外功能，能大幅提升据点的生产、防御能力"
  }
  item "旧人类核聚变晶块" {
    id = "resource_05"
    type = "能源"
    rarity = "common"
    description = "大陨落前旧人类批量生产的核聚变能量结晶，仅可驱动旧式纯机械武器、据点供电与防御设施，无法用于基因进化与火种机甲供能，是各据点日常运行的通用能源"
  }
  rule "setup_rule_01" {
    trigger = "always"
    effect = "虫族核心母巢会释放全域电磁干扰波，压制所有非基因绑定的人类电子设备，只有适配了基因进化系统的火种机甲可不受干扰正常运行；大陨落前人类已经预判到电磁攻击风险，提前在各地下据点储备了大量纯机械武器的生产图纸与原料，百年间幸存者可以自行生产维护这类无电子控制模块的旧式防御武器，普通人可正常操作，该类武器可有效杀伤工虫、作战兵虫，对初级虫将仅能造成轻伤，无法伤害中级以上虫族，战力边界清晰。"
  }
  rule "setup_rule_02" {
    trigger = "always"
    effect = "火种机甲的最高权限基因锁由林野当年亲自预埋，他是唯一的全权限适配者；除他之外全球仅有不超过5名次一级基因适配者，最高仅能升级至基因等级3级，无法解锁星际航行等高级权限，也无法激活机甲核心数据库；次一级基因适配者升级时不会解锁林野的研发记忆碎片，但会触发自身的基因潜能觉醒，解锁专属的个人异能，可适配简化版火种机甲的额外功能，拥有独立成长路径；全球现存的5名次一级基因适配者中，2名属于沈氏核心成员，1名是独立游走的赏金猎人，1名是异变者阵营的隐藏适配者（该隐藏适配者是异变者首领阿蝉的义兄，十年前为掩护异变者族群撤退被沈氏俘虏，目前被关押在磐石堡地下实验室，为后续营救支线预埋钩子），1名是青藤据点护卫队长苏晴，为后续势力合纵连横预留剧情空间。"
  }
  rule "setup_rule_03" {
    trigger = "always"
    effect = "简化版火种机甲移除了核心数据库与星际航行模块，仅保留基础作战功能，采用次一级基因适配者的基因片段做绑定锁，不受电磁干扰，战力仅为完整版火种机甲的30%，无法升级至更高权限；沈氏百年间仅掌握简化版火种机甲的组装技术，但缺少核心基因编码模块，百年间仅组装出不到10台供家族核心成员使用，批量生产技术只有林野解锁三级基因权限后才能从文明数据库中获取；沈明哲家族当年仅为项目投资方，未掌握核心基因编码技术，因此无法激活机甲核心功能。"
  }
  rule "setup_rule_04" {
    trigger = "always"
    effect = "基因进化等级越高，可解锁的机甲权限越强，每次升级除需要吸收对应等级的虫族核心能量晶核外，还需解锁一段林野当年研发火种机甲的记忆碎片，逐步揭开当年爆炸事故的真相；进化时基因稳定性低于60%即触发崩溃风险，可通过特制基因抑制剂、同伴精神引导等方式降低崩溃概率；补充基因稳定性阈值规则：只要人类基因稳定性长期保持在60%以上，入侵的虫族基因片段仅会强化身体机能，不会整合到人类核心基因链中，因此林野的全权限火种机甲适配资格不会因基因进化过程中吸收虫族晶核而失效，彻底规避战力逻辑隐患。"
  }
  rule "setup_rule_05" {
    trigger = "always"
    effect = "半人半虫异变者的判定标准为异变时基因稳定性是否高于40%：高于40%可保留人类理智，拥有专属异能，可免疫虫族低阶精神干扰，能在虫族领地内隐蔽活动，还可感知10公里范围内的虫族晶核与虫群动向，是反抗军勘探、渗透行动的核心力量；异变者携带的虫族基因片段已整合到人类核心基因链中，即使是5级林野的基因修复波也无法清除，仅能抑制其异变倾向，无法使其适配火种机甲的纯人类基因锁；保留理智的异变者人类基因占比普遍在70%以上，可适配仅要求人类基因占比高于60%的简化版火种机甲基因锁，仅无法适配完整版火种机甲的纯人类基因锁；保留理智的异变者因携带虫族基因片段，低阶虫族不会主动对其发起攻击，但中级以上虫将可通过精神波动识别其人类意识身份，会主动发起围剿，既强化异变者的渗透优势，也明确其生存风险；保留理智的异变者可通过吸收虫族晶核提升异能等级，最高可达到对应虫族初级虫将的战力，异能类型与异变时融合的虫族基因类型绑定，比如融合工虫基因的异变者拥有巨力，融合飞虫基因的异变者拥有短距离飞行能力；低于40%则完全沦为虫族附庸，无自主意识。各幸存者据点均配备基于纯机械原理的基因稳定性检测仪，可在10秒内测出异变者的基因稳定性数值；同时保留理智的异变者瞳孔为淡蓝色，失控异变者瞳孔为深黑色，可通过外观快速初步判定阵营。"
  }
  rule "setup_rule_06" {
    trigger = "always"
    effect = "虫族种群层级严格，低级晶核对应工虫、作战兵虫，每10只兵虫约产出1枚可用低级晶核；中级晶核对应初级虫将，每百只规模虫群才配置1名初级虫将；高级晶核对应高级虫统领，全星球虫族仅不超过10名，母巢核心晶核唯一；高级虫将拥有不亚于人类的智慧，会针对性设局围剿人类幸存者，甚至会安插内奸渗透人类据点。"
  }
  rule "setup_rule_07" {
    trigger = "always"
    effect = "普通幸存者大多聚居在青藤据点、磐石堡、黄土沟据点等地下据点，按贡献分配生存资源，对基因进化者既敬畏又排斥，普通人除可操作旧式防御武器、参与后勤保障外，旧文明数据芯片的修复、基因抑制剂的生产、简化版火种机甲的维护都需要普通科研人员、技术工人的参与，仅靠基因进化者无法完成，拥有不可替代的价值；普通技工老周将在最终母巢决战时，靠纯机械技术临时修复火种机甲的能量管路，为林野争取到吸收母巢晶核的关键10分钟，凸显普通人的不可替代性。"
  }
  rule "setup_rule_08" {
    trigger = "always"
    effect = "火种机甲内置的文明数据库隐藏着百年前虫族入侵的完整真相与旧人类星际探索记录、外星文明坐标，只有林野的基因序列可逐层解锁相关内容；旧文明数据芯片的解锁与林野的基因等级绑定，低级芯片可在基因等级1-2级时解锁基础生产技术，高级芯片需要基因等级3级以上才能解锁武器、机甲相关的额外功能。林野当年研发火种机甲时，同步为旧人类文明备份芯片设置了配套的基因权限锁，避免核心科技落入敌对势力手中，因此只有对应基因等级的权限才能解锁对应芯片内容。"
  }
  rule "setup_rule_09" {
    trigger = "always"
    effect = "沈明哲集团掌握虫族需要的旧人类隐蔽星际星舰坐标数据，该坐标为分段加密格式，9枚密钥是当年沈氏家族参与火种机甲项目时，为保管旧人类星际星舰坐标专门定制的基因绑定存储介质，仅沈氏直系后代的基因可激活感应；9枚密钥分别散落在虫族高级统领的领地、旧人类核心军事禁区（设有纯机械触发的自毁装置，非沈氏基因携带者靠近直接引爆）等极高风险区域，沈氏百年间多次派人搜寻损失惨重，因此仅找到3枚，迟迟无法完成与虫族的交易；沈氏与虫族高级统领的正式交易为近10年才达成，此前百年间双方处于敌对状态，且交易豁免权仅覆盖沈氏登记在册的300名核心成员，外围成员不受保护，低阶虫族未收到指令时也可能误攻外围人员，因此沈氏百年间有上千成员死于虫族突袭，当代家主沈明哲的妻儿也因此丧生；沈氏以此为筹码与虫族高级统领达成交易：虫族承诺给予沈明哲及其300名核心成员「虫族基因改造豁免权」，允许他们保留人类意识并获得10%的地球统治权，虫族拿到完整星舰坐标后将前往银河系扩张，不会销毁沈明哲集团核心成员的人类基因，因此不会主动攻击沈明哲的势力。该交易背后有两条强制规则支撑：一是收割者文明给虫族高层下了精神契约，伤害沈氏核心成员会直接触发精神爆亡；二是9枚密钥只有沈氏家族的基因序列可以感应定位，虫族无法自行搜寻，因此必须和沈氏合作；沈明哲认为普通人类根本不可能对抗虫族，只有通过和虫族交易保留精英火种，后续得知收割者文明收割所有文明成果的终极阴谋后可临阵倒戈，并非纯粹的邪恶反派；沈氏家族在大陨落后依托留存的军工资源建立了磐石堡据点，逐步垄断基因抑制剂的生产与销售，借此巩固了百年统治地位。补充精神契约约束范围：仅禁止虫族主动攻击沈氏登记在册的300名核心成员，沈氏主动攻击虫族时契约不生效；且契约仅在地球大气层范围内有效，离开地球后自动失效，为后续星际剧情中沈氏临阵倒戈预埋伏笔。"
  }
  rule "setup_rule_10" {
    trigger = "always"
    effect = "撮合沈氏与虫族交易的第三方外星文明名为「收割者文明」，以诱导低等文明内斗、收割文明成果为生存方式，当年和人类高层交易的条件是用虫族技术换取地球生物基因库，交易失控后仍在暗中观察虫族与人类的战争，在虫族与人类阵营都安插了卧底，会不定期给弱势一方提供技术支持，刻意维持双方战力平衡，方便最终收割胜利方的文明成果，其已在太阳系外围布置了收割舰队，待地球战局明朗后就会发起入侵，是贯穿整个故事的最终反派势力；收割者文明单舰战力相当于初级虫将，主力舰战力相当于高级虫统领，收割舰队总战力相当于1.5倍虫族全族战力，林野达到5级后联合全人类战力+虫族残余势力（虫族母巢被毁后残余虫群不愿被收割，会选择和人类临时结盟）可与之对抗，战力边界清晰无后期崩盘风险。"
  }
  rule "resource_scarcity_resource_01" {
    trigger = "resource.scarcity"
    effect = "resource=resource_01; scarcity=低级常见、中级稀有、高级极稀有、母巢核心晶核独一无二; category=能源/材料"
  }
  rule "resource_scarcity_resource_02" {
    trigger = "resource.scarcity"
    effect = "resource=resource_02; scarcity=稀有; category=材料"
  }
  rule "resource_scarcity_resource_03" {
    trigger = "resource.scarcity"
    effect = "resource=resource_03; scarcity=稀有; category=消耗品"
  }
  rule "resource_scarcity_resource_04" {
    trigger = "resource.scarcity"
    effect = "resource=resource_04; scarcity=稀有; category=材料"
  }
  rule "resource_scarcity_resource_05" {
    trigger = "resource.scarcity"
    effect = "resource=resource_05; scarcity=常见; category=能源"
  }
  rule "progression_requirement_基因进化与火种机甲体系_L1" {
    trigger = "progression.requirement"
    effect = "system=基因进化与火种机甲体系; level=1; requires=首次接触虫族低级晶核，完成基础基因适配，解锁第一次组装火种机甲核心的记忆碎片"
  }
  rule "progression_requirement_基因进化与火种机甲体系_L2" {
    trigger = "progression.requirement"
    effect = "system=基因进化与火种机甲体系; level=2; requires=吸收10枚低级虫族晶核，基因稳定性达到70%以上，解锁基因锁模块研发的记忆碎片"
  }
  rule "progression_requirement_基因进化与火种机甲体系_L3" {
    trigger = "progression.requirement"
    effect = "system=基因进化与火种机甲体系; level=3; requires=吸收1枚中级虫族晶核，扛过基因崩溃的风险，解锁机甲武器模块测试的记忆碎片"
  }
  rule "progression_requirement_基因进化与火种机甲体系_L4" {
    trigger = "progression.requirement"
    effect = "system=基因进化与火种机甲体系; level=4; requires=吸收3枚高级虫族晶核，完全融合火种系统的核心代码，解锁当年爆炸事故前的最后一段工作记忆碎片"
  }
  rule "progression_requirement_基因进化与火种机甲体系_L5" {
    trigger = "progression.requirement"
    effect = "system=基因进化与火种机甲体系; level=5; requires=吸收虫族母巢的唯一核心晶核，解锁全部文明数据库，解锁当年被暗害的完整真相记忆碎片"
  }
  rule "progression_max_基因进化与火种机甲体系" {
    trigger = "progression.max_level"
    effect = "system=基因进化与火种机甲体系; max_level=5"
  }
  rule "storyline_contract_第一章：荒骨苏醒" {
    trigger = "storyline.contract"
    effect = "id=第一章：荒骨苏醒; name=第一章：荒骨苏醒; type=开篇章节; importance=9; open_question=百年间到底发生了什么，为什么曾经的机甲测试场变成了虫族活动的荒地; desire=林野苏醒后第一要务是活下去，搞清楚自己身处的环境与时间; opposition=周围游荡的虫族工虫、首次基因适配带来的反噬风险; stakes=一旦死在这里，人类唯一的全权限机甲适配者就会消失，文明再无翻盘可能"
  }
  rule "storyline_contract_第二章：青藤据点" {
    trigger = "storyline.contract"
    effect = "id=第二章：青藤据点; name=第二章：青藤据点; type=过渡章节; importance=8; desire=林野要获得据点众人的信任，找到落脚的地方，搞清楚当前人类的生存状态; opposition=据点民众对陌生进化者的排斥、突袭的小规模虫群; stakes=一旦被驱逐，林野孤立无援很可能死在虫族的野外围剿中; payoff=林野首次展露火种机甲战力，获得初步盟友，为后续整合力量打下基础"
  }
  rule "storyline_contract_火种远征主线" {
    trigger = "storyline.contract"
    effect = "id=火种远征主线; name=火种远征主线; type=主线剧情; importance=10; desire=林野要带领人类夺回母星，对抗收割者文明的终极威胁，为人类争取存续的空间; opposition=虫族的持续围剿、沈氏势力的刻意阻挠、收割者文明对双方战力的平衡操纵; stakes=一旦失败，人类将彻底灭绝，地球文明将成为收割者文明的战利品; turn=虫族母巢被毁后残余虫群不愿被收割，选择和人类临时结盟对抗共同的敌人"
  }
  rule "storyline_contract_历史真相支线" {
    trigger = "storyline.contract"
    effect = "id=历史真相支线; name=历史真相支线; type=悬念支线; importance=8; payoff=揭露所有阴谋，让人类认清真正的敌人，放弃内斗一致对外; open_question=当年的人类高层还有多少余孽活着，收割者文明的终极目的到底是什么; desire=林野要查清当年遇袭的真相，以及百年前虫族入侵的完整隐情; opposition=沈氏势力对真相的刻意掩盖、收割者文明安插的卧底的暗中阻挠"
  }
  rule "storyline_contract_势力整合支线" {
    trigger = "storyline.contract"
    effect = "id=势力整合支线; name=势力整合支线; type=成长支线; importance=7; desire=林野要整合所有人类势力，建立统一的反抗联盟，积蓄反攻虫族的足够力量; opposition=各据点之间的历史旧怨、资源分配矛盾、普通人类与异变者的信任裂痕; payoff=建立跨阵营的统一反抗联盟，集齐所有可以团结的力量，为反攻母巢做好充分准备; pressure_points=磐石堡沈氏对其他据点的资源封锁 | 虫潮压力下部分据点为了生存互相掠夺 | 普通幸存者对异变者阵营的排斥情绪 | 营救被沈氏关押的异变者隐藏适配者的紧急需求"
  }
}

storyline {
  chapter "冻土下的苏醒" {
    id = "P1-V1-C1"
    arc = "P1-V1"
    objective "冻土下的苏醒" {
      id = "obj_P1-V1-C1"
      type = "sequence"
      step 1 {
        description = "第一章：荒骨苏醒 | hook | 林野从百年休眠中苏醒，确认身处2249年的废土世界，觉醒基因吸收能力，解锁沈氏暗害的记忆碎片，最终力竭晕倒 | 他即将被外出勘探的游击小队发现，开启废土生存的第一站 | 地下设施内游荡着虫族，休眠舱剩余能源不足2小时，随时可能彻底断电被困"
        event {
          type = "storyline"
          state_delta {
            target = "第一章：荒骨苏醒"
            kind = "storyline"
            field = "stage"
            to = "hook"
            unit = "地下设施内游荡着虫族，休眠舱剩余能源不足2小时，随时可能彻底断电被困"
            cost = "他即将被外出勘探的游击小队发现，开启废土生存的第一站"
            note = "change=林野从百年休眠中苏醒，确认身处2249年的废土世界，觉醒基因吸收能力，解锁沈氏暗害的记忆碎片，最终力竭晕倒; consequence=他即将被外出勘探的游击小队发现，开启废土生存的第一站; pressure=地下设施内游荡着虫族，休眠舱剩余能源不足2小时，随时可能彻底断电被困"
          }
          state_delta {
            target = "第一章：荒骨苏醒"
            kind = "plot_thread"
            field = "storyline"
            to = "raised"
            note = "active pressure in P1-V1-C1"
          }
        }
      }
      step 2 {
        description = "历史真相支线 | hook | 林野解锁沈氏暗害自己的首个记忆碎片，拿到沈氏密钥测试样品 | 后续将逐步揭开当年火种项目被夺、自己被暗害的完整真相 | 沈氏势力目前仍在全球搜捕旧时代科研人员与休眠者"
        event {
          type = "storyline"
          state_delta {
            target = "历史真相支线"
            kind = "storyline"
            field = "stage"
            to = "hook"
            unit = "沈氏势力目前仍在全球搜捕旧时代科研人员与休眠者"
            cost = "后续将逐步揭开当年火种项目被夺、自己被暗害的完整真相"
            note = "change=林野解锁沈氏暗害自己的首个记忆碎片，拿到沈氏密钥测试样品; consequence=后续将逐步揭开当年火种项目被夺、自己被暗害的完整真相; pressure=沈氏势力目前仍在全球搜捕旧时代科研人员与休眠者"
          }
          state_delta {
            target = "历史真相支线"
            kind = "plot_thread"
            field = "storyline"
            to = "raised"
            note = "active pressure in P1-V1-C1"
          }
        }
      }
      step 3 {
        description = "苏醒后记忆碎片化，留存基因计划志愿者登记、机甲研发的零碎片段，新增沈氏负责人拿枪指着他、叫嚣要夺走火种项目的清晰闪回，误以为自己是基因计划志愿者"
        event {
          type = "status"
          state_delta {
            target = "休眠舱苏醒"
            kind = "status"
            field = "awaken"
            to = "progressed"
            note = "苏醒后记忆碎片化，留存基因计划志愿者登记、机甲研发的零碎片段，新增沈氏负责人拿枪指着他、叫嚣要夺走火种项目的清晰闪回，误以为自己是基因计划志愿者"
          }
        }
      }
      step 4 {
        description = "林野确认当前为公元2249年，距离他进入休眠舱已过去109年，初步意识到事态严重性，同时发现测试场角落的纯机械3D打印设备完好无损，是自己当年预埋的应急生产装置"
        event {
          type = "discovery"
          state_delta {
            target = "休眠舱时间显示屏"
            kind = "knowledge"
            field = "check"
            to = "completed"
            note = "林野确认当前为公元2249年，距离他进入休眠舱已过去109年，初步意识到事态严重性，同时发现测试场角落的纯机械3D打印设备完好无损，是自己当年预埋的应急生产装置"
          }
        }
      }
      step 5 {
        description = "获得临时近战武器，战力提升至普通人类的1.5倍，刚好能对抗低级虫族"
        event {
          type = "acquire"
          state_delta {
            target = "临时武器"
            kind = "equipment"
            field = "produce"
            to = "obtained"
            note = "获得临时近战武器，战力提升至普通人类的1.5倍，刚好能对抗低级虫族"
          }
        }
      }
      step 6 {
        description = "林野用外骨骼刃砸烂幼虫头部，右手被利爪划了一道浅伤，力竭之下靠在墙上喘息，对虫族的战力有了初步认知，获得1枚初级能量晶核，战斗后身体酸软，肌肉萎缩症状略有缓解；触碰到虫尸时暖流涌入身体，脑海中出现基因稳定性61%的提示，觉醒基因吸收能力"
        event {
          type = "combat"
          combat {
            enemies = [{id = "虫族_低级_虫族幼虫", count = 1, level = 1}]
          }
          state_delta {
            target = "虫族幼虫"
            kind = "enemy"
            field = "fight"
            to = "resolved"
            note = "林野用外骨骼刃砸烂幼虫头部，右手被利爪划了一道浅伤，力竭之下靠在墙上喘息，对虫族的战力有了初步认知，获得1枚初级能量晶核，战斗后身体酸软，肌肉萎缩症状略有缓解；触碰到虫尸时暖流涌入身体，脑海中出现基因稳定性61%的提示，觉醒基因吸收能力"
          }
        }
      }
      step 7 {
        description = "林野觉醒专属基因能力：击杀异星生物可吸收生命能量强化自身体质，本次吸收后基因稳定性为61%，刚好达安全阈值，对应state_anchor的基因能力觉醒"
        event {
          type = "premise"
          state_delta {
            target = "基因进化系统"
            kind = "skill"
            field = "awaken"
            to = "started"
            note = "林野觉醒专属基因能力：击杀异星生物可吸收生命能量强化自身体质，本次吸收后基因稳定性为61%，刚好达安全阈值，对应state_anchor的基因能力觉醒"
          }
        }
      }
      step 8 {
        description = "林野眼前一黑晕倒在通往上层的通道口，失去意识前仿佛听到了远处人类的说话声，为后续被游击小队救下埋下伏笔，冲突升级为未知人类的身份悬念"
        event {
          type = "status"
          state_delta {
            target = "晕倒在地"
            kind = "status"
            field = "faint"
            to = "deteriorated"
            note = "林野眼前一黑晕倒在通往上层的通道口，失去意识前仿佛听到了远处人类的说话声，为后续被游击小队救下埋下伏笔，冲突升级为未知人类的身份悬念"
          }
        }
      }
      step 9 {
        description = "初级能量晶核 resource change: 0 +1 = 1. 击杀虫族幼虫获得"
        event {
          type = "resource"
          state_delta {
            target = "初级能量晶核"
            kind = "resource"
            field = "quantity"
            from = "0"
            to = "1"
            delta = 1
            note = "击杀虫族幼虫获得"
          }
        }
      }
      step 10 {
        description = "chapter start cultivation: 未觉醒基因能力的普通人类→基因适配者（一阶初级，刚觉醒暂未稳定）"
        event {
          type = "status"
          state_delta {
            target = "protagonist"
            kind = "cultivation"
            field = "realm"
            to = "未觉醒基因能力的普通人类→基因适配者（一阶初级，刚觉醒暂未稳定）"
            note = "chapter start cultivation: 未觉醒基因能力的普通人类→基因适配者（一阶初级，刚觉醒暂未稳定）"
          }
        }
      }
      step 11 {
        description = "chapter start spirit stones"
        event {
          type = "status"
          state_delta {
            target = "spirit_stones"
            kind = "resource"
            field = "quantity"
            to = "1"
            note = "chapter start spirit stones"
          }
        }
      }
      step 12 {
        description = "chapter start injuries: 长期休眠导致的轻度肌肉萎缩, 右手被虫族幼虫划伤的浅伤"
