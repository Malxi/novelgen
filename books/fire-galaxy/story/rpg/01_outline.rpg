world {
  location "wasteland" {
    id = "wasteland"
    __placeholder__ = true
    __source_phase__ = "outline"
  }
  location "cryo_facility" {
    id = "cryo_facility"
    __placeholder__ = true
    __source_phase__ = "outline"
  }
  item "虫族晶核" {
    id = "resource_01"
    type = "能源/材料"
    rarity = "legendary"
    description = "虫族体内能量结晶，基因进化、机甲供能和据点防御的核心原料。低级、中级、高级和母巢核心是同一资源的等级差异，outline 中统一使用该稳定名称。"
  }
  item "蓝星草" {
    id = "resource_02"
    type = "材料"
    rarity = "rare"
    description = "仅生长在虫族活动极少的地下溶洞深处，磐石堡周边溶洞产量最高，是制作基因抑制剂的核心原材料，目前被沈氏垄断。"
  }
  item "基因抑制剂" {
    id = "resource_03"
    type = "消耗品"
    rarity = "rare"
    description = "由虫族体液搭配蓝星草提取制成，可降低基因进化崩溃风险，是各据点的核心战略物资。自产、库存和携带状态都统一使用该稳定名称。"
  }
  item "旧文明数据芯片" {
    id = "resource_04"
    type = "材料"
    rarity = "rare"
    description = "存储旧时代科技文化资料的芯片，解锁与林野基因等级绑定。低级芯片解锁基础生产技术，高级芯片解锁武器与机甲额外功能。"
  }
  item "旧人类核聚变晶块" {
    id = "resource_05"
    type = "能源"
    rarity = "common"
    description = "批量化生产的核聚变能量结晶，仅可驱动旧式纯机械武器、据点供电与防御设施，不可用于基因进化与火种机甲。"
  }
  item "纯机械武器图纸与原料" {
    id = "resource_06"
    type = "材料"
    rarity = "common"
    description = "大陨落前预埋的纯机械武器生产图纸与原料，普通人可操作生产，可有效杀伤工虫与兵虫，对初级虫将仅轻伤。"
  }
  item "简化版火种机甲零件" {
    id = "resource_07"
    type = "材料"
    rarity = "rare"
    description = "简化版火种机甲的组装零件，缺少核心基因编码模块，沈氏百年仅组装出不到10台。"
  }
  item "火种机甲模块蓝图" {
    id = "resource_08"
    type = "数据/技术"
    rarity = "rare"
    description = "记录火种机甲各形态模块的旧文明蓝图，分散在军工遗址、测试场残片和高级数据芯片中，是机甲升级的硬门槛。"
  }
  item "火种核心校准数据" {
    id = "resource_09"
    type = "数据/权限"
    rarity = "rare"
    description = "每次实战后由火种核心生成的同步与损伤数据，用于解锁下一形态的安全阈值，防止机甲强行升级导致驾驶员基因崩溃。"
  }
  rule "setup_rule_01" {
    trigger = "always"
    effect = "虫族核心母巢会释放全域电磁干扰波，压制所有非基因绑定的人类电子设备，只有适配了基因进化系统的火种机甲可不受干扰正常运行；大陨落前人类已经预判到电磁攻击风险，提前在各地下据点储备了大量纯机械武器的生产图纸与原料，百年间幸存者可以自行生产维护这类无电子控制模块的旧式防御武器，普通人可正常操作，该类武器可有效杀伤工虫、作战兵虫，对初级虫将仅能造成轻伤，无法伤害中级以上虫族，战力边界清晰。"
  }
  rule "setup_rule_02" {
    trigger = "always"
    effect = "火种机甲的最高权限基因锁由林野当年亲自预埋，他是唯一的全权限适配者；除他之外全球仅有不超过5名次一级基因适配者，最高仅能升级至基因等级3级，无法解锁星际航行等高级权限，也无法激活机甲核心数据库；次一级基因适配者升级时不会解锁林野的研发记忆碎片，但会触发自身的基因潜能觉醒，解锁专属的个人异能，可适配简化版火种机甲的额外功能，拥有独立成长路径；全球现存的5名次一级基因适配者中，2名属于沈氏核心成员，1名是独立游走的赏金猎人，1名是异变者阵营的隐藏适配者（该隐藏适配者是异变者首领阿蝉的义兄，十年前为掩护异变者族群撤退被沈氏俘虏，目前被关押在磐石堡地下实验室，为后续营救支线预埋钩子），1名是青藤据点护卫队长苏晴，为后续势力合纵连横预留剧情空间。"
  }
  rule "setup_rule_03" {
    trigger = "always"
    effect = "简化版火种机甲移除了核心数据库与星际航行模块，仅保留基础作战功能，采用次一级基因适配者的基因片段做绑定锁，不受电磁干扰，战力仅为完整版火种机甲的30%，无法升级至更高权限；沈氏百年间仅掌握简化版火种机甲的组装技术，但缺少核心基因编码模块，百年间仅组装出不到10台供家族核心成员使用，批量生产技术只有林野解锁三级基因权限后才能从文明数据库中获取；沈明哲家族当年仅为项目投资方，未掌握核心基因编码技术，因此无法激活机甲核心功能。"
  }
  rule "setup_rule_04" {
    trigger = "always"
    effect = "主角成长采用“火种机甲形态/模块”为显性升级主轴，“基因适配/稳定性”为权限钥匙与代价副轴：机甲每次升级必须同时满足模块蓝图、能量核心、战场实测三类条件，基因等级只决定林野能否承受更高权限与更强神经同步，不能单独带来无成本战力暴涨；基因稳定性低于60%即触发反噬风险，可通过基因抑制剂、同伴精神引导、机甲冷却休眠降低风险。"
  }
  rule "setup_rule_05" {
    trigger = "always"
    effect = "半人半虫异变者的判定标准为异变时基因稳定性是否高于40%：高于40%可保留人类理智，拥有专属异能，可免疫虫族低阶精神干扰，能在虫族领地内隐蔽活动，还可感知10公里范围内的虫族晶核与虫群动向，是反抗军勘探、渗透行动的核心力量；异变者携带的虫族基因片段已整合到人类核心基因链中，即使是5级林野的基因修复波也无法清除，仅能抑制其异变倾向，无法使其适配火种机甲的纯人类基因锁；保留理智的异变者人类基因占比普遍在70%以上，可适配仅要求人类基因占比高于60%的简化版火种机甲基因锁，仅无法适配完整版火种机甲的纯人类基因锁；保留理智的异变者因携带虫族基因片段，低阶虫族不会主动对其发起攻击，但中级以上虫将可通过精神波动识别其人类意识身份，会主动发起围剿，既强化异变者的渗透优势，也明确其生存风险；保留理智的异变者可通过吸收虫族晶核提升异能等级，最高可达到对应虫族初级虫将的战力，异能类型与异变时融合的虫族基因类型绑定，比如融合工虫基因的异变者拥有巨力，融合飞虫基因的异变者拥有短距离飞行能力；低于40%则完全沦为虫族附庸，无自主意识。各幸存者据点均配备基于纯机械原理的基因稳定性检测仪，可在10秒内测出异变者的基因稳定性数值；同时保留理智的异变者瞳孔为淡蓝色，失控异变者瞳孔为深黑色，可通过外观快速初步判定阵营。"
  }
  rule "setup_rule_06" {
    trigger = "always"
    effect = "虫族种群层级严格，低级晶核对应工虫、作战兵虫，每10只兵虫约产出1枚可用低级晶核；中级晶核对应初级虫将，每百只规模虫群才配置1名初级虫将；高级晶核对应高级虫统领，全星球虫族仅不超过10名，母巢核心晶核唯一；高级虫将拥有不亚于人类的智慧，会针对性设局围剿人类幸存者，甚至会安插内奸渗透人类据点。"
  }
  rule "setup_rule_07" {
    trigger = "always"
    effect = "普通幸存者大多聚居在青藤据点、磐石堡、黄土沟据点等地下据点，按贡献分配生存资源，对基因进化者既敬畏又排斥，普通人除可操作旧式防御武器、参与后勤保障外，旧文明数据芯片的修复、基因抑制剂的生产、简化版火种机甲的维护都需要普通科研人员、技术工人的参与，仅靠基因进化者无法完成，拥有不可替代的价值；普通技工老周将在最终母巢决战时，靠纯机械技术临时修复火种机甲的能量管路，为林野争取到吸收母巢晶核的关键10分钟，凸显普通人的不可替代性。"
  }
  rule "setup_rule_08" {
    trigger = "always"
    effect = "火种机甲内置的文明数据库隐藏着百年前虫族入侵的完整真相与旧人类星际探索记录、外星文明坐标，只有林野的基因序列可逐层解锁相关内容；旧文明数据芯片的解锁与林野的基因等级绑定，低级芯片可在基因等级1-2级时解锁基础生产技术，高级芯片需要基因等级3级以上才能解锁武器、机甲相关的额外功能。林野当年研发火种机甲时，同步为旧人类文明备份芯片设置了配套的基因权限锁，避免核心科技落入敌对势力手中，因此只有对应基因等级的权限才能解锁对应芯片内容。"
  }
  rule "setup_rule_09" {
    trigger = "always"
    effect = "沈明哲集团掌握虫族需要的旧人类隐蔽星际星舰坐标数据，该坐标为分段加密格式，9枚密钥是当年沈氏家族参与火种机甲项目时，为保管旧人类星际星舰坐标专门定制的基因绑定存储介质，仅沈氏直系后代的基因可激活感应；9枚密钥分别散落在虫族高级统领的领地、旧人类核心军事禁区（设有纯机械触发的自毁装置，非沈氏基因携带者靠近直接引爆）等极高风险区域，沈氏百年间多次派人搜寻损失惨重，因此仅找到3枚，迟迟无法完成与虫族的交易；沈氏与虫族高级统领的正式交易为近10年才达成，此前百年间双方处于敌对状态，且交易豁免权仅覆盖沈氏登记在册的300名核心成员，外围成员不受保护，低阶虫族未收到指令时也可能误攻外围人员，因此沈氏百年间有上千成员死于虫族突袭，当代家主沈明哲的妻儿也因此丧生；沈氏以此为筹码与虫族高级统领达成交易：虫族承诺给予沈明哲及其300名核心成员「虫族基因改造豁免权」，允许他们保留人类意识并获得10%的地球统治权，虫族拿到完整星舰坐标后将前往银河系扩张，不会销毁沈明哲集团核心成员的人类基因，因此不会主动攻击沈明哲的势力。该交易背后有两条强制规则支撑：一是收割者文明给虫族高层下了精神契约，伤害沈氏核心成员会直接触发精神爆亡；二是9枚密钥只有沈氏家族的基因序列可以感应定位，虫族无法自行搜寻，因此必须和沈氏合作；沈明哲认为普通人类根本不可能对抗虫族，只有通过和虫族交易保留精英火种，后续得知收割者文明收割所有文明成果的终极阴谋后可临阵倒戈，并非纯粹的邪恶反派；沈氏家族在大陨落后依托留存的军工资源建立了磐石堡据点，逐步垄断基因抑制剂的生产与销售，借此巩固了百年统治地位。补充精神契约约束范围：仅禁止虫族主动攻击沈氏登记在册的300名核心成员，沈氏主动攻击虫族时契约不生效；且契约仅在地球大气层范围内有效，离开地球后自动失效，为后续星际剧情中沈氏临阵倒戈预埋伏笔。"
  }
  rule "setup_rule_10" {
    trigger = "always"
    effect = "撮合沈氏与虫族交易的第三方外星文明名为「收割者文明」，以诱导低等文明内斗、收割文明成果为生存方式，当年和人类高层交易的条件是用虫族技术换取地球生物基因库，交易失控后仍在暗中观察虫族与人类的战争，在虫族与人类阵营都安插了卧底，会不定期给弱势一方提供技术支持，刻意维持双方战力平衡，方便最终收割胜利方的文明成果，其已在太阳系外围布置了收割舰队，待地球战局明朗后就会发起入侵，是贯穿整个故事的最终反派势力；收割者文明单舰战力相当于初级虫将，主力舰战力相当于高级虫统领，收割舰队总战力相当于1.5倍虫族全族战力，林野达到5级后联合全人类战力+虫族残余势力（虫族母巢被毁后残余虫群不愿被收割，会选择和人类临时结盟）可与之对抗，战力边界清晰无后期崩盘风险。"
  }
