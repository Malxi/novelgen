        event {
          type = "status"
          state_delta {
            target = "protagonist"
            kind = "item"
            field = "key_items"
            to = "火种机甲核心（待组装状态）, 纯机械3D打印机（已启动）, 部分打印完成的基础外骨骼零件"
            note = "chapter start key items: 火种机甲核心（待组装状态）, 纯机械3D打印机（已启动）, 部分打印完成的基础外骨骼零件"
          }
