          type = "storyline"
          state_delta {
            target = "火种远征主线"
            kind = "storyline"
            field = "stage"
            to = "reveal"
            unit = "虫族母巢与沈氏势力都在盯着坐标，收割者文明的舰队已经在太阳系外围待命，随时可能入侵"
            cost = "接下来整合完所有势力后，就能前往地面发射站，离开地球前往星际，重建人类文明"
            note = "change=林野获得近地轨道殖民站的坐标，集结了第一批追随者，人类文明复兴的第一步已经迈出; consequence=接下来整合完所有势力后，就能前往地面发射站，离开地球前往星际，重建人类文明; pressure=虫族母巢与沈氏势力都在盯着坐标，收割者文明的舰队已经在太阳系外围待命，随时可能入侵"
