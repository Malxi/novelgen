          type = "combat"
          combat {
            enemies = [{id = "boss_shen_mech_01", count = 1, level = 3, boss = true}, {id = "shen_soldier_磐石堡搜索队员", count = 10, level = 2}]
          }
          state_delta {
            target = "沈氏简化版火种机甲"
            kind = "character"
            field = "combat"
            to = "首枚火箭弹命中简化版机甲的左肩装甲，炸开一个脸盆大的缺口，机甲行动略微失衡；林野随后弃发射器冲下山坡与沈怀义近战，三分钟后用热能长刃刺穿机甲右腿关节，迫使沈怀义弃机投降"
            note = "首枚火箭弹命中简化版机甲的左肩装甲，炸开一个脸盆大的缺口，机甲行动略微失衡；林野随后弃发射器冲下山坡与沈怀义近战，三分钟后用热能长刃刺穿机甲右腿关节，迫使沈怀义弃机投降"
          }
        }
      }
      step 16 {
        description = "林野制服沈怀义后进行简短审讯。沈怀义起初嘴硬，林野用一支自产基因抑制剂作为交换条件后，沈怀义才开口：沈氏已得知林野的存在，家主沈明哲下令‘活捉优先，若无法活捉则格杀勿论’；沈怀义还透露沈氏在异变者阵营中安插了卧底，但具体身份他不知情；此外沈氏内部对与虫族交易也有分歧，沈怀义本人对此事并不认同"
        event {
          type = "relationship"
          state_delta {
            target = "获取沈氏内部情报"
            kind = "relationship"
            field = "interrogate"
            to = "progressed"
            note = "林野制服沈怀义后进行简短审讯。沈怀义起初嘴硬，林野用一支自产基因抑制剂作为交换条件后，沈怀义才开口：沈氏已得知林野的存在，家主沈明哲下令‘活捉优先，若无法活捉则格杀勿论’；沈怀义还透露沈氏在异变者阵营中安插了卧底，但具体身份他不知情；此外沈氏内部对与虫族交易也有分歧，沈怀义本人对此事并不认同"
          }
        }
      }
      step 17 {
        description = "林野没有杀沈怀义，仅收缴其机甲核心的基因密钥并放他带话回磐石堡：‘告诉沈明哲，当年的账我很快就会去算清楚。’但这种仁慈可能导致沈氏更强烈的报复"
        event {
          type = "gate"
          state_delta {
            target = "留下战俘的道德选择"
            kind = "gate"
            field = "choose"
            to = "progressed"
            note = "林野没有杀沈怀义，仅收缴其机甲核心的基因密钥并放他带话回磐石堡：‘告诉沈明哲，当年的账我很快就会去算清楚。’但这种仁慈可能导致沈氏更强烈的报复"
          }
        }
