          type = "combat"
          combat {
            enemies = [{id = "虫族_中级_虫族守军", count = 12, level = 3}, {id = "叛变ai「零」_中级_残余机械部队", count = 8, level = 3}, {id = "虫族_高级_刀锋虫", count = 1, level = 5, boss = true}]
          }
          state_delta {
            target = "残余机械部队"
            kind = "enemy"
            field = "fight"
            to = "resolved"
            note = "林野全歼残余的8台机械部队，吸收能量补充机甲能源，获得8枚初级能量晶核；在一台机械兵的核心中发现刻有沈氏家族徽记的微型定位器，还在持续发送信号，说明沈氏已经通过机械部队监控到了林野的动向"
          }
        }
      }
      step 4 {
        description = "林野与虫族统领刀锋虫激战15分钟，机甲左臂被刀锋砍断后燃烧3枚能量晶核激活重曙机甲过载模式，严格遵守过载模式仅能持续5分钟的设定，在第4分50秒用机甲的能量核心穿刺炮击穿刀锋虫的甲壳将其击杀，机甲过载模式结束后能源消耗过半，获得1枚顶级能量晶核，冲突解决：击杀前哨站最强的敌人"
        event {
          type = "combat"
          combat {
            enemies = [{id = "虫族_中级_虫族守军", count = 12, level = 3}, {id = "叛变ai「零」_中级_残余机械部队", count = 8, level = 3}, {id = "虫族_高级_刀锋虫", count = 1, level = 5, boss = true}]
          }
          state_delta {
            target = "虫族统领刀锋虫"
            kind = "enemy"
            field = "fight"
            to = "resolved"
            note = "林野与虫族统领刀锋虫激战15分钟，机甲左臂被刀锋砍断后燃烧3枚能量晶核激活重曙机甲过载模式，严格遵守过载模式仅能持续5分钟的设定，在第4分50秒用机甲的能量核心穿刺炮击穿刀锋虫的甲壳将其击杀，机甲过载模式结束后能源消耗过半，获得1枚顶级能量晶核，冲突解决：击杀前哨站最强的敌人"
          }
        }
      }
      step 5 {
        description = "林野发现半块刻有沈氏家族徽记的密钥碎片，通过文档得知此前沈氏勘探队来此寻找密钥被虫族歼灭，碎片被虫族缴获，确认机械部队的进攻目标就是这枚密钥；触碰到密钥时解锁部分记忆碎片，想起当年沈氏家族在火种机甲项目中多次安插眼线窃取资料，为了夺取机甲控制权暗害自己的过往，文档中夹带沈明哲的私人日志片段：「2247年11月，虫族突袭磐石堡外围，妻儿死在虫口下，我知道和虫族交易是与虎谋皮，但只有保住精英火种，人类才有翻盘的可能，我不在乎被骂汉奸」，丰富反派弧光，让沈明哲的行为逻辑更合理；在前哨站的虫族储物洞中发现了之前丢失的2枚印有青藤据点标记的高爆炸药，确认青藤据点有内奸，回收之前的伏笔"
        event {
          type = "acquire"
          state_delta {
            target = "半块沈氏密钥碎片"
            kind = "item"
            field = "find"
            to = "discovered"
            note = "林野发现半块刻有沈氏家族徽记的密钥碎片，通过文档得知此前沈氏勘探队来此寻找密钥被虫族歼灭，碎片被虫族缴获，确认机械部队的进攻目标就是这枚密钥；触碰到密钥时解锁部分记忆碎片，想起当年沈氏家族在火种机甲项目中多次安插眼线窃取资料，为了夺取机甲控制权暗害自己的过往，文档中夹带沈明哲的私人日志片段：「2247年11月，虫族突袭磐石堡外围，妻儿死在虫口下，我知道和虫族交易是与虎谋皮，但只有保住精英火种，人类才有翻盘的可能，我不在乎被骂汉奸」，丰富反派弧光，让沈明哲的行为逻辑更合理；在前哨站的虫族储物洞中发现了之前丢失的2枚印有青藤据点标记的高爆炸药，确认青藤据点有内奸，回收之前的伏笔"
          }
        }
      }
      step 6 {
        description = "小队成功占领前哨站，打通了向南前往青藤据点与信号源的路线，获得前哨站内的大量物资储备；虎子成功救出被关押的妹妹虎妞，虎妞的基因稳定性为55%，是保留人类理智的异变者，拥有感知10公里内虫族动向的异能，之前被沈氏抓捕送到前哨站当诱饵，被虫族俘虏后关押至今，为后续异变者阵营支线、渗透虫巢的剧情埋下伏笔"
        event {
          type = "goal"
          state_delta {
            target = "虫族边境前哨站"
            kind = "location"
            field = "occupy"
            to = "completed"
            note = "小队成功占领前哨站，打通了向南前往青藤据点与信号源的路线，获得前哨站内的大量物资储备；虎子成功救出被关押的妹妹虎妞，虎妞的基因稳定性为55%，是保留人类理智的异变者，拥有感知10公里内虫族动向的异能，之前被沈氏抓捕送到前哨站当诱饵，被虫族俘虏后关押至今，为后续异变者阵营支线、渗透虫巢的剧情埋下伏笔"
          }
        }
      }
      step 7 {
