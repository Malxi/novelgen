            kind = "plot_thread"
            field = "storyline"
            to = "raised"
            note = "active pressure in P1-V1-C10"
          }
        }
      }
      step 3 {
        description = "势力整合支线 | progress | 林野集结了第一批追随者，队伍拥有了作战、维修、医疗、侦察的完整配置，具备了整合更大势力的基础 | 接下来将在青藤据点整合更多幸存者与异变者势力，建立统一的人类反抗联盟 | 各幸存者据点之间矛盾重重，普通人类与异变者互相敌视，沈氏在暗中挑拨离间"
        event {
          type = "storyline"
          state_delta {
            target = "势力整合支线"
            kind = "storyline"
            field = "stage"
            to = "progress"
            unit = "各幸存者据点之间矛盾重重，普通人类与异变者互相敌视，沈氏在暗中挑拨离间"
            cost = "接下来将在青藤据点整合更多幸存者与异变者势力，建立统一的人类反抗联盟"
            note = "change=林野集结了第一批追随者，队伍拥有了作战、维修、医疗、侦察的完整配置，具备了整合更大势力的基础; consequence=接下来将在青藤据点整合更多幸存者与异变者势力，建立统一的人类反抗联盟; pressure=各幸存者据点之间矛盾重重，普通人类与异变者互相敌视，沈氏在暗中挑拨离间"
          }
          state_delta {
