  chapter "星舰坐标" {
    id = "P1-V1-C10"
    arc = "P1-V1"
    objective "星舰坐标" {
      id = "obj_P1-V1-C10"
      type = "sequence"
      step 1 {
        description = "第二章：青藤据点 | hook | 林野感知到青藤据点方向有其他休眠者的基因共振信号与下一枚密钥的方位，怀疑青藤有内奸，集结了第一批追随者，正式出发前往青藤据点 | 接下来将在青藤据点遇到其他休眠者，整合更多反抗力量，同时要应对沈氏安插在青藤据点的内奸，寻找下一枚沈氏密钥 | 沈氏已经知道林野苏醒的消息，正在往青藤据点部署大量兵力，准备抢夺其余休眠者与重曙机甲，内奸在暗处随时可能制造麻烦"
        event {
          type = "storyline"
          state_delta {
            target = "第二章：青藤据点"
            kind = "storyline"
            field = "stage"
