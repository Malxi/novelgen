  chapter "游击营地的真相" {
    id = "P1-V1-C4"
    arc = "P1-V1"
    objective "游击营地的真相" {
      id = "obj_P1-V1-C4"
      type = "sequence"
      step 1 {
        description = "火种远征主线 | pressure | 林野获得小队信任，定下夺取重曙机甲的计划，人类即将获得对抗虫族的核心战力 | 一旦成功夺取机甲，就能打破虫族的边境封锁，打通前往青藤据点的通道，整合更多反抗力量 | 虫族在研究所周边布置了大量巡逻队，之前三次夺甲行动都以失败告终，7名队员牺牲"
        event {
          type = "storyline"
          state_delta {
            target = "火种远征主线"
            kind = "storyline"
            field = "stage"
            to = "pressure"
            unit = "虫族在研究所周边布置了大量巡逻队，之前三次夺甲行动都以失败告终，7名队员牺牲"
            cost = "一旦成功夺取机甲，就能打破虫族的边境封锁，打通前往青藤据点的通道，整合更多反抗力量"
            note = "change=林野获得小队信任，定下夺取重曙机甲的计划，人类即将获得对抗虫族的核心战力; consequence=一旦成功夺取机甲，就能打破虫族的边境封锁，打通前往青藤据点的通道，整合更多反抗力量; pressure=虫族在研究所周边布置了大量巡逻队，之前三次夺甲行动都以失败告终，7名队员牺牲"
          }
          state_delta {
            target = "火种远征主线"
            kind = "plot_thread"
            field = "storyline"
            to = "raised"
            note = "active pressure in P1-V1-C4"
          }
        }
      }
      step 2 {
        description = "头发花白的陈婆拿着消毒药膏过来给林野包扎手上的划伤，念叨着「这伤口再晚处理就要冻坏了，小伙子命大」，陈婆看到林野的军工铭牌后红了眼，说她儿子当年也有一块一模一样的，是林野的助手，大陨落时死在了研究所，她掏出贴身保存的半块和林野同款的铭牌碎片；蹲在旁边修武器的周叔捡过林野变形的外骨骼刃，敲了敲说「这玩意儿材质不错，我帮你整整，下次对付虫子还能用」，周叔认出铭牌上的林家标识，说自己当年是林野父亲的徒弟，见过小时候的林野，两人的善意让林野对营地的归属感大幅提升，周叔作为后续导师角色，将引导林野了解旧人类历史与机甲维护知识"
        event {
          type = "relationship"
          state_delta {
            target = "林野的伤口"
            kind = "character"
            field = "treat"
            to = "established"
            note = "头发花白的陈婆拿着消毒药膏过来给林野包扎手上的划伤，念叨着「这伤口再晚处理就要冻坏了，小伙子命大」，陈婆看到林野的军工铭牌后红了眼，说她儿子当年也有一块一模一样的，是林野的助手，大陨落时死在了研究所，她掏出贴身保存的半块和林野同款的铭牌碎片；蹲在旁边修武器的周叔捡过林野变形的外骨骼刃，敲了敲说「这玩意儿材质不错，我帮你整整，下次对付虫子还能用」，周叔认出铭牌上的林家标识，说自己当年是林野父亲的徒弟，见过小时候的林野，两人的善意让林野对营地的归属感大幅提升，周叔作为后续导师角色，将引导林野了解旧人类历史与机甲维护知识"
          }
        }
      }
      step 3 {
        description = "苏晴提前巡逻发现异动，当场抓住两人，当着所有营地民众的面处决了叛徒，说「谁要是敢卖自己人换粮食，就是这个下场」，既体现了废土生存的残酷性，也强化了苏晴保下林野的决心，苏晴清点勘探物资时发现原本带的10枚高爆炸药少了2枚，以为是落在路上，实为青藤内奸偷走给虫族报信，为后续前哨站的内奸伏笔埋下线索"
        event {
          type = "conflict"
          state_delta {
            target = "两名叛变幸存者"
            kind = "character"
            field = "execute"
            to = "resolved"
            note = "苏晴提前巡逻发现异动，当场抓住两人，当着所有营地民众的面处决了叛徒，说「谁要是敢卖自己人换粮食，就是这个下场」，既体现了废土生存的残酷性，也强化了苏晴保下林野的决心，苏晴清点勘探物资时发现原本带的10枚高爆炸药少了2枚，以为是落在路上，实为青藤内奸偷走给虫族报信，为后续前哨站的内奸伏笔埋下线索"
          }
        }
      }
      step 4 {
        description = "林野得知当前地球分为虫族控制区、AI机械区、人类反抗区三大势力范围，游击小队属于北境最大的幸存者据点青藤据点的分支；苏晴提及此前三次带队攻打研究所夺取机甲均失败，牺牲了7名队员，对机甲抱有极强执念；外出勘探的队员浑身是伤逃回，讲述遭遇沈氏人员抢夺资源的经历，有营地民众主张把林野交出去换沈氏的粮食，苏晴顶着压力保下了他；队员闲聊时提到苏晴当年为了救被虫族抓伤的妹妹，一直珍藏着半支基因抑制剂，妹妹遇难后就再也没动过"
        event {
          type = "knowledge"
          state_delta {
            target = "勘探队员的汇报"
            kind = "knowledge"
            field = "listen"
            to = "learned"
            note = "林野得知当前地球分为虫族控制区、AI机械区、人类反抗区三大势力范围，游击小队属于北境最大的幸存者据点青藤据点的分支；苏晴提及此前三次带队攻打研究所夺取机甲均失败，牺牲了7名队员，对机甲抱有极强执念；外出勘探的队员浑身是伤逃回，讲述遭遇沈氏人员抢夺资源的经历，有营地民众主张把林野交出去换沈氏的粮食，苏晴顶着压力保下了他；队员闲聊时提到苏晴当年为了救被虫族抓伤的妹妹，一直珍藏着半支基因抑制剂，妹妹遇难后就再也没动过"
          }
        }
      }
      step 5 {
        description = "林野主动要求参与防守，靠着强化的身体素质与敏捷的速度，用周叔修复好的外骨骼刃连杀3只虫族，在战斗中刻意留手不暴露自己的基因吸收能力，避免被当成异变者处决，苏晴带队在外围支援射杀剩余2只，防守成功，营地零伤亡，获得3枚初级能量晶核"
        event {
          type = "combat"
          combat {
            enemies = [{id = "虫族_低级_虫族侦察小队", count = 5, level = 2}, {id = "人类/沈氏内应_低级_营地叛徒", count = 2, level = 1}]
          }
          state_delta {
            target = "虫族侦察小队"
            kind = "enemy"
            field = "fight"
            to = "resolved"
            note = "林野主动要求参与防守，靠着强化的身体素质与敏捷的速度，用周叔修复好的外骨骼刃连杀3只虫族，在战斗中刻意留手不暴露自己的基因吸收能力，避免被当成异变者处决，苏晴带队在外围支援射杀剩余2只，防守成功，营地零伤亡，获得3枚初级能量晶核"
          }
        }
      }
      step 6 {
        description = "林野基因稳定性提升至75%，正式突破至基因适配者一阶中级，身体强度达到普通人类的5倍，解锁一段机甲零件研发的记忆碎片，对应state_anchor的境界突破；苏晴在远处看到了他吸收能量的全过程，确认他不是异变者（异变者吸收能量时瞳孔会变成淡蓝色，林野瞳孔没有变化），归还了此前暂扣的3枚晶核，还赠送他一支能量匕首作为奖励，营地民众对他的态度大幅好转，冲突解决：林野获得了营地的初步信任"
