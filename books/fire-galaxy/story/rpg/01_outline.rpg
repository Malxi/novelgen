
metadata {
  title = "星骸火种"
  genre = ["科幻", "废土", "机甲", "末世"]
  power_system = "火种机甲形态与模块解锁体系 + 林野基因适配与稳定性体系 + 火种数据库与模块蓝图体系 + 异变者异能体系 + 沈氏简化机甲与技术垄断体系 + 据点资源与生产体系 + 虫族阶层与天敌体系 + 收割者文明威胁体系"
  tone = "热血激昂，硬核科幻，末世苍凉，爽感充足"
  dsl_version = "0.2.0"
  phase = "outline"
}

characters {
  player "林野" {
    id = "林野"
    class = "mecha_pilot"
    description = "公元2140年，出身军工世家、父母早年牺牲于外星碎片撞击事故的火种机甲项目核心研发工程师林野，性格沉稳务实、重情重义，在测试机甲核心基因锁模块时遭投资方沈氏家族暗害发生爆炸，被紧急封入休眠仓送往秘密基地保存。2149年外星虫族突袭地球，人类高层勾结第三方收割者文明的交易失控，全球文明崩溃，残存幸存者躲入地下据点苟活。"
    background = "公元2140年，出身军工世家、父母早年牺牲于外星碎片撞击事故的火种机甲项目核心研发工程师林野，性格沉稳务实、重情重义，在测试机甲核心基因锁模块时遭投资方沈氏家族暗害发生爆炸，被紧急封入休眠仓送往秘密基地保存。2149年外星虫族突袭地球，人类高层勾结第三方收割者文明的交易失控，全球文明崩溃，残存幸存者躲入地下据点苟活。"
    personality = ["沉稳务实", "重情重义"]
    motivation = "林野要带领人类夺回母星，对抗收割者文明的终极威胁，为人类争取存续的空间"
    abilities = ["火种机甲形态与模块解锁体系", "林野基因适配与稳定性体系", "火种数据库与模块蓝图体系", "异变者异能体系"]
    role_in_story = "protagonist"
    str = 10
    agi = 12
    int = 10
    vit = 10
    hp = 120
    mp = 60
    skills = ["快速学习", "适应环境"]
  }
  enemy "低级虫族工虫" {
    id = "zerg_drone_低级虫族工虫"
    type = "zerg"
    level = 1
    description = "西北方向岩洞涌出，兵虫驱动它们集结冲锋"
  }
  enemy "低级虫族兵虫" {
    id = "zerg_soldier_低级虫族兵虫"
    type = "zerg"
    level = 2
    description = "虫群头部位置，体长3米，螯肢滴落酸性液体"
  }
  enemy "磐石堡补给队副队长" {
    id = "shen_agent_磐石堡补给队副队长"
    type = "shen"
    level = 2
    description = "代表沈氏家族来据点收集情报"
  }
  enemy "据点年轻护卫刘三" {
    id = "shen_informant_据点年轻护卫刘三"
    type = "shen"
    level = 1
    description = "青藤据点内的沈氏内线"
  }
  enemy "初级虫将·掘地者" {
    id = "boss_tunnel_captain"
    type = "zerg"
    level = 4
    description = "占据旧军事禁区，统领约200只工虫与30只兵虫"
  }
  enemy "沈氏简化版火种机甲（未知型号）" {
    id = "boss_shen_mech_01"
    type = "shen"
    level = 3
    description = "正北方向搜索队核心战力"
  }
  enemy "磐石堡搜索队员" {
    id = "shen_soldier_磐石堡搜索队员"
    type = "shen"
    level = 2
    description = "两支搜索队合计约20人，装备旧式突击步枪与近战武器"
  }
  enemy "虫族初级虫将·裂颅者" {
    id = "zerg_captain_虫族初级虫将·裂颅者"
    type = "zerg"
    level = 4
    description = "荒骨台围剿行动核心，曾在十年前撕碎三台简化机甲"
  }
  enemy "虫族初级虫将×2（未知类型）" {
    id = "zerg_captain_虫族初级虫将×2（未知类型）"
    type = "zerg"
    level = 4
    description = "荒骨台围剿行动，与沈氏两台简化版火种机甲协同"
  }
  enemy "沈氏简化版火种机甲×2（未知驾驶员）" {
    id = "shen_mech_沈氏简化版火种机甲×2（未知驾驶员）"
    type = "shen"
    level = 3
    description = "荒骨台围剿行动"
  }
