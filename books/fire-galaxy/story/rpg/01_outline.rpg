        description = "铁鳞说：‘这个废弃实验室十年前的地图上没有，是沈氏后来加盖的，而且用修正液涂改说明他们不想让别人知道里面有什么。’增加了营救行动的不确定性"
        event {
          type = "knowledge"
          state_delta {
            target = "被涂改的未知实验室"
            kind = "knowledge"
            field = "discover"
            to = "get"
            note = "铁鳞说：‘这个废弃实验室十年前的地图上没有，是沈氏后来加盖的，而且用修正液涂改说明他们不想让别人知道里面有什么。’增加了营救行动的不确定性"
          }
        }
      }
      step 19 {
        description = "林野经过内心权衡：计算营救需时4天，从磐石堡赶回荒骨台需1天，时间刚好。决定先前往磐石堡完成营救，然后利用阿蝉的异变者情报与铁鳞的异能赶在围剿前回援荒骨台；苏晴同步向黄土沟与异变者暗线发送节点握手码，火种核心提示：指挥链路甲前置条件 1/3 已激活。"
        event {
          type = "story"
          state_delta {
            target = "应对联合围剿的行动方案"
            kind = "goal"
            field = "coordinate"
            to = "林野经过内心权衡：计算营救需时4天，从磐石堡赶回荒骨台需1天，时间刚好。决定先前往磐石堡完成营救，然后利用阿蝉的异变者情报与铁鳞的异能赶在围剿前回援荒骨台；苏晴同步向黄土沟与异变者暗线发送节点握手码，火种核心提示：指挥链路甲前置条件 1/3 已激活。"
            note = "林野经过内心权衡：计算营救需时4天，从磐石堡赶回荒骨台需1天，时间刚好。决定先前往磐石堡完成营救，然后利用阿蝉的异变者情报与铁鳞的异能赶在围剿前回援荒骨台；苏晴同步向黄土沟与异变者暗线发送节点握手码，火种核心提示：指挥链路甲前置条件 1/3 已激活。"
          }
        }
      }
      step 20 {
        description = "基因抑制剂 resource change: 0 +3 = 3. 铁鳞带来3份异变者特制渗透药膏，按基因抑制剂类资源记账"
        event {
          type = "resource"
          state_delta {
            target = "基因抑制剂"
            kind = "resource"
            field = "quantity"
            from = "0"
            to = "3"
            delta = 3
            note = "铁鳞带来3份异变者特制渗透药膏，按基因抑制剂类资源记账"
          }
        }
      }
      step 21 {
        description = "青藤据点"
        event {
          type = "transition"
          state_delta {
            kind = "transition"
            field = "time_jump"
            to = "true"
            note = "次日 青藤据点"
          }
        }
      }
    }
  }
}

systems {
  attribute_system "Core Attributes" {
    id = "attr_core"
    description = "Numeric baseline attributes for simulation and continuity checks."
    attribute "Strength" {
      id = "str"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Agility" {
      id = "agi"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Intelligence" {
      id = "int"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Vitality" {
      id = "vit"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "HP" {
      id = "hp"
      type = "resource"
      base_value = 100
      max_value = 999999
      is_resource = true
    }
    attribute "MP" {
      id = "mp"
      type = "resource"
      base_value = 50
      max_value = 999999
      is_resource = true
    }
    attribute "Qi" {
      id = "qi"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "虫族晶核" {
      id = "resource_01"
      description = "虫族体内能量结晶，基因进化、机甲供能和据点防御的核心原料。低级、中级、高级和母巢核心是同一资源的等级差异，outline 中统一使用该稳定名称。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "蓝星草" {
      id = "resource_02"
      description = "仅生长在虫族活动极少的地下溶洞深处，磐石堡周边溶洞产量最高，是制作基因抑制剂的核心原材料，目前被沈氏垄断。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "基因抑制剂" {
      id = "resource_03"
      description = "由虫族体液搭配蓝星草提取制成，可降低基因进化崩溃风险，是各据点的核心战略物资。自产、库存和携带状态都统一使用该稳定名称。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "旧文明数据芯片" {
      id = "resource_04"
      description = "存储旧时代科技文化资料的芯片，解锁与林野基因等级绑定。低级芯片解锁基础生产技术，高级芯片解锁武器与机甲额外功能。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "旧人类核聚变晶块" {
      id = "resource_05"
      description = "批量化生产的核聚变能量结晶，仅可驱动旧式纯机械武器、据点供电与防御设施，不可用于基因进化与火种机甲。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "纯机械武器图纸与原料" {
      id = "resource_06"
      description = "大陨落前预埋的纯机械武器生产图纸与原料，普通人可操作生产，可有效杀伤工虫与兵虫，对初级虫将仅轻伤。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "简化版火种机甲零件" {
      id = "resource_07"
      description = "简化版火种机甲的组装零件，缺少核心基因编码模块，沈氏百年仅组装出不到10台。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "火种机甲模块蓝图" {
      id = "resource_08"
      description = "记录火种机甲各形态模块的旧文明蓝图，分散在军工遗址、测试场残片和高级数据芯片中，是机甲升级的硬门槛。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
    attribute "火种核心校准数据" {
      id = "resource_09"
      description = "每次实战后由火种核心生成的同步与损伤数据，用于解锁下一形态的安全阈值，防止机甲强行升级导致驾驶员基因崩溃。"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
  }
  power_formula "Core Power Formula" {
    id = "power_core"
    description = "Deterministic combat power formula for benchmark simulation."
    base_power = 10
    formula = "base + sum(attr_i * weight_i)"
    factor "Strength" {
      attribute = "str"
      weight = 2
    }
    factor "Agility" {
      attribute = "agi"
      weight = 1.2
    }
    factor "Intelligence" {
      attribute = "int"
      weight = 1.8
    }
    factor "Vitality" {
      attribute = "vit"
      weight = 1.5
    }
    factor "HP" {
      attribute = "hp"
      weight = 0.1
    }
    factor "MP" {
      attribute = "mp"
      weight = 0.2
    }
    factor "Qi" {
      attribute = "qi"
      weight = 1
    }
  }
  counter "chapter_progress" {
    track = "story.chapter"
    description = "Story progression counter"
    milestone 5 {
      title = "Arc Warmup"
    }
    milestone 10 {
      title = "Arc Core"
    }
  }
  counter "火种机甲形态与模块解锁体系_progress" {
    track = "player.progression"
    description = "Primary progression pace tracker"
    milestone 1 {
      title = "System Activated"
    }
    milestone 3 {
      title = "First Breakthrough"
    }
    milestone 5 {
      title = "Mid-Arc Growth"
    }
  }
  progression "火种机甲形态与模块解锁体系" {
    id = "火种机甲形态与模块解锁体系"
    level 1 {
      name = "残骸外骨骼"
      requirements = "火种核心苏醒；测试场残骸金属；1枚低级虫族晶核启动；连续作战不超过15分钟，否则关节过热锁死。"
      bonuses = ["利用测试场纯机械打印设备拼出半开放式外骨骼，只能提供短时力量增幅与基础防护，适合开篇逃生和击退工虫。"]
    }
    level 2 {
      name = "基础火种甲"
      requirements = "林野基因适配1级；完成基础装甲蓝图修复；消耗10枚低级晶核或等价能源；需要老周完成机械校准。"
      bonuses = ["完成躯干装甲、神经同步和基础近战模块，能稳定对抗工虫与少量兵虫，首次形成“主角有机甲”的核心爽点。"]
    }
    level 3 {
      name = "武装集成甲"
      requirements = "林野基因适配2级；回收旧文明武器芯片；完成一次虫潮实战数据采样；每次重火力齐射会快速消耗核心能量。"
      bonuses = ["解锁腕刃、肩炮、短距推进和战场扫描模块，战斗风格从硬扛转向机动压制，可单挑作战兵虫小队。"]
    }
    level 4 {
      name = "空战护盾甲"
      requirements = "林野基因适配3级；1枚中级虫族晶核；修复飞行模块蓝图；基因稳定性低于75%时禁止连续飞行。"
      bonuses = ["解锁短时飞行、能量护盾和空中姿态控制，能与初级虫将正面对抗，也是中期大战的视觉升级节点。"]
    }
    level 5 {
      name = "指挥链路甲"
      requirements = "林野基因适配4级；完成火种核心代码融合；至少三个据点接入有线/机械信标；链路开启时林野精神负荷剧增。"
      bonuses = ["机甲成为移动指挥中枢，可通过非电磁基因链路同步友军位置、虫群动向和简化机甲状态，主角从单兵王牌升级为战场核心。"]
    }
    level 6 {
      name = "星舰核心甲"
      requirements = "解锁旧文明星航数据库；获得高级虫族晶核3枚；修复星际航行模块；启动后需至少一个据点工业体系供养维修。"
      bonuses = ["机甲从地面战斗平台升级为小型星舰核心，可启动轨道突入、深空导航和高能主炮，但维护消耗巨大。"]
    }
    level 7 {
      name = "文明火种甲"
      requirements = "吸收虫族母巢核心晶核；林野基因适配5级；解锁全部文明数据库；只能使用一次全球修复波。"
      bonuses = ["终极形态，释放全球级基因修复波并承载人类文明数据库，可作为新文明旗舰中枢。使用后机甲一年内无法星际航行，避免终局能力滥用。"]
    }
  }
  progression "林野基因适配与稳定性体系" {
    id = "林野基因适配与稳定性体系"
    level 1 {
      name = "基因适配者"
      requirements = "首次吸收低级晶核；基因稳定性保持60%以上；解锁第一段研发记忆碎片。"
      bonuses = ["完成火种核心的初始绑定，可操控残骸外骨骼与基础火种甲，身体素质提升但仍会出现反噬眩晕。"]
    }
    level 2 {
      name = "基因强化者"
      requirements = "吸收10枚低级晶核；基因稳定性达到70%以上；获得基因抑制剂辅助。"
      bonuses = ["神经同步速度提升，能承受武装集成甲的多模块并行，身体素质约为普通人的10倍。"]
    }
    level 3 {
      name = "基因觉醒者"
      requirements = "吸收1枚中级虫族晶核；扛过一次基因崩溃风险；解锁武器模块测试记忆。"
      bonuses = ["觉醒林野专属的机甲共鸣能力，可短时间预判机甲结构故障与敌方攻击轨迹，是空战护盾甲的最低权限。"]
    }
    level 4 {
      name = "基因掌控者"
      requirements = "吸收3枚高级晶核；完成火种核心代码融合；基因稳定性长期维持85%以上。"
      bonuses = ["可主动压制虫族基因污染，承受指挥链路甲带来的群体信息冲击，成为多据点联军的机甲指挥核心。"]
    }
    level 5 {
      name = "文明火种者"
      requirements = "吸收虫族母巢核心晶核；解锁全部文明数据库；接受完整真相记忆冲击且保持自我。"
      bonuses = ["纯人类基因锁完全打开，可承载文明火种甲和全球修复波，但使用终极权限会导致长时间虚弱与机甲停航。"]
    }
  }
  progression "火种数据库与模块蓝图体系" {
    id = "火种数据库与模块蓝图体系"
    level 1 {
      name = "残片读取"
      requirements = "旧文明数据芯片1枚；基础火种核心在线；老周或同等级技术人员协助解码。"
      bonuses = ["读取低级旧文明数据芯片，获得基础维修、金属打印和外骨骼零件图纸。"]
    }
    level 2 {
      name = "武装蓝图"
      requirements = "林野基因适配2级；回收军工遗址数据芯片；据点达到基础工业化。"
      bonuses = ["解锁近战、肩炮、短距推进等武装模块蓝图，让机甲升级具备可制造依据。"]
    }
    level 3 {
      name = "防御航行蓝图"
      requirements = "林野基因适配3级；中级晶核样本；完成一次初级虫将战斗数据回灌。"
      bonuses = ["解锁能量护盾、飞行控制和高负荷冷却系统，为空战护盾甲服务。"]
    }
    level 4 {
      name = "链路协议"
      requirements = "林野基因适配4级；三个据点加入联军；完成沈氏简化机甲协议破解。"
      bonuses = ["解锁非电磁战场链路和简化机甲协同协议，让主角能指挥联军而不是只靠个人战力。"]
    }
    level 5 {
      name = "星航核心"
      requirements = "高级旧文明数据芯片；星舰残骸或深空补给站坐标；高级虫族晶核3枚。"
      bonuses = ["解锁星际航行、轨道突入和文明数据库全量备份，为故事后半的收割者威胁与星际远征铺路。"]
    }
  }
  progression "异变者异能体系" {
    id = "异变者异能体系"
    level 1 {
      name = "初醒异变者"
      requirements = "异变后基因稳定性≥70%（人类基因占比），吸收过1枚低级晶核"
      bonuses = ["刚完成异变时保留理智，拥有基础异能（如巨力、短距离飞行），异变时基因稳定性需>40%。"]
    }
    level 2 {
      name = "熟练异变者"
      requirements = "吸收5枚低级晶核，基因稳定性≥75%"
      bonuses = ["异能强度提升，感知范围扩大至10公里，可短时间潜入虫族领地而不被发现。"]
    }
    level 3 {
      name = "精英异变者"
      requirements = "吸收1枚中级晶核，基因稳定性≥80%，完成至少一次渗透任务"
      bonuses = ["异能可短暂对抗初级虫将，感知能力升级，能识别虫族精神干扰的来源。"]
    }
    level 4 {
      name = "异变者统领"
      requirements = "吸收3枚中级晶核，基因稳定性≥85%，得到族群认可"
      bonuses = ["实力相当于初级虫将顶峰，可统领其他异变者，异能可产生范围效果，能短暂匹敌中级虫将。"]
    }
  }
  progression "沈氏简化机甲与技术垄断体系" {
    id = "沈氏简化机甲与技术垄断体系"
    level 1 {
      name = "组装调试"
      requirements = "拥有次一级适配者基因样本与基础金属原料"
      bonuses = ["沈氏利用残存图纸和次一级适配者基因片段组装基础简化机甲，可抵御工虫。"]
    }
    level 2 {
      name = "武器集成"
      requirements = "回收旧文明军工厂残存武器模块，或从虫族战场回收完整部件"
      bonuses = ["为简化机甲加装远程武器系统，可对抗作战兵虫，但能耗巨大。"]
    }
    level 3 {
      name = "能量护盾改装"
      requirements = "获得至少一枚中级虫族晶核作为供能核心，突破沈氏家族内部技术封锁"
      bonuses = ["安装初代护盾模块，可短暂抵挡初级虫将一击，但需消耗大量蓝星草提炼的稳定剂。"]
    }
    level 4 {
      name = "半智能协同"
      requirements = "林野解锁三级基因后，从文明数据库获取协同协议"
      bonuses = ["将简化机甲与固定据点防御系统联网（有线传输，避免电磁干扰），实现战场辅助指挥，但无法提升单机战力。"]
    }
  }
  progression "据点资源与生产体系" {
    id = "据点资源与生产体系"
    level 1 {
      name = "自给自足"
      requirements = "拥有至少一套纯机械车床与旧式能源储备"
      bonuses = ["据点能够生产基础冷兵器和简单机械防御工事，靠旧核聚变晶块供电，人口上限500人。"]
    }
    level 2 {
      name = "基础工业化"
      requirements = "修复一座旧文明工业废墟，获得至少10枚旧文明数据芯片（低阶）"
      bonuses = ["可批量生产旧式轻武器与简易动力装甲（非机甲），据点防御力提升，人口上限1000人。"]
    }
    level 3 {
      name = "晶核能源化"
      requirements = "猎杀足够工虫收集100枚低级晶核，并组建专门科研小队"
      bonuses = ["掌握利用低级虫族晶核补充据点能源的技术，延长核聚变晶块使用寿命，可支持中小型能量武器原型。"]
    }
    level 4 {
      name = "基因抑制剂量产"
      requirements = "营救被沈氏关押的生物学家，获得培育技术；或林野四级后从数据库获取替代配方"
      bonuses = ["突破蓝星草种植技术（如在特定地下溶洞培育），打破沈氏垄断，使基因抑制剂成为据点可自产资源。"]
    }
    level 5 {
      name = "跨据点贸易网络"
      requirements = "至少三个据点签署互助条约，并清除沿途虫族小型巢穴"
      bonuses = ["建立稳定的据点间物流与信息传递体系（依赖有线电报+机械运输队），实现资源互换与联合防御。"]
    }
  }
  progression "虫族阶层与天敌体系" {
    id = "虫族阶层与天敌体系"
    level 1 {
      name = "工虫层"
      requirements = "无（基础产兵单位）"
      bonuses = ["基础劳动力与炮灰，单只战力约等于普通成年人，晶核产出率10:1，无法威胁火种机甲。"]
    }
    level 2 {
      name = "作战兵虫层"
      requirements = "工虫消耗足够生物质后进化而来"
      bonuses = ["主战兵力，速度、力量是工虫3倍，可破开轻型防御工事。每百只兵虫配一名初级虫将。"]
    }
    level 3 {
      name = "初级虫将层"
      requirements = "兵虫积累足够晶核能量后晋升"
      bonuses = ["统率百虫，拥有简单战术智慧，可干扰低级电子设备（但无法影响火种机甲）。晶核为中级。"]
    }
    level 4 {
      name = "高级虫统领层"
      requirements = "母巢赋予或吞噬多位初级虫将而成"
      bonuses = ["全宇宙族不超过10名，智慧不亚于人类，可设局渗透。单只战力可对抗四级林野。晶核为高级。"]
    }
    level 5 {
      name = "母巢"
      requirements = "虫族文明最高产物，需要大量生物质与能量积累数十年"
      bonuses = ["虫族核心，释放全域电磁干扰波，只有一颗核心晶核。摧毁母巢后虫族体系瓦解，残余虫群不再受控制，可能选择与人类结盟对抗收割者。"]
    }
  }
  progression "收割者文明威胁体系" {
    id = "收割者文明威胁体系"
    level 1 {
      name = "观察诱导"
      requirements = "无（隐藏阶段）"
      bonuses = ["收割者仅通过卧底和远程干扰操纵人类与虫族冲突，不直接介入。"]
    }
    level 2 {
      name = "资源倾斜"
      requirements = "人类或虫族战力失衡持续3个月以上"
      bonuses = ["当一方弱势时，收割者通过匿名信息或物资掉落给予平衡性技术支持（如给沈氏先进武器蓝图）。"]
    }
    level 3 {
      name = "先锋入侵"
      requirements = "地球虫族/人类某一方基本统一"
      bonuses = ["当母巢被毁或人类取得决定性胜利时，收割者前锋舰队突入大气层，单舰战力相当于初级虫将，试探双方残余力量。"]
    }
    level 4 {
      name = "全面收割"
      requirements = "先锋探测到地球文明剩余战力不足以威胁收割者"
      bonuses = ["收割者主力舰队发动总攻，主力舰战力相当于高级虫统领，总战力1.5倍虫族。需要林野5级机甲+全人类联军+残余虫群联合对抗。"]
    }
    level 5 {
      name = "文明重组"
      requirements = "联军打赢全面收割战役"
      bonuses = ["如果联军获胜，收割者被击退或消灭，人类获得外星科技碎片，开启星际探索时代。若失败则文明被归档抹除。"]
    }
  }
}
