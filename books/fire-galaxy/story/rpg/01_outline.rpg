        description = "地质活动引发的震动停止后，休眠舱的自动解锁程序启动，林野从百年沉睡中苏醒"
        event {
          type = "transition"
          state_delta {
            kind = "transition"
            field = "time_jump"
            to = "true"
            note = "无 地质活动引发的震动停止后，休眠舱的自动解锁程序启动，林野从百年沉睡中苏醒"
          }
        }
      }
    }
  }
  chapter "地下设施的逃杀" {
    id = "P1-V1-C2"
    arc = "P1-V1"
    objective "地下设施的逃杀" {
      id = "obj_P1-V1-C2"
      type = "sequence"
      step 1 {
        description = "历史真相支线 | hook | 林野得知大陨落的真相，确认虫族与叛变AI是人类的主要敌人 | 他意识到自己身处的世界远比想象中危险，必须尽快找到其他幸存者 | 地下设施的备用能源即将耗尽，升降梯的预热还需要1小时，随时可能断电被困"
        event {
          type = "storyline"
          state_delta {
            target = "历史真相支线"
            kind = "storyline"
            field = "stage"
            to = "hook"
            unit = "地下设施的备用能源即将耗尽，升降梯的预热还需要1小时，随时可能断电被困"
            cost = "他意识到自己身处的世界远比想象中危险，必须尽快找到其他幸存者"
            note = "change=林野得知大陨落的真相，确认虫族与叛变AI是人类的主要敌人; consequence=他意识到自己身处的世界远比想象中危险，必须尽快找到其他幸存者; pressure=地下设施的备用能源即将耗尽，升降梯的预热还需要1小时，随时可能断电被困"
          }
          state_delta {
            target = "历史真相支线"
            kind = "plot_thread"
            field = "storyline"
            to = "raised"
            note = "active pressure in P1-V1-C2"
          }
        }
      }
      step 2 {
        description = "林野苏醒后简单活动身体，适应了基因强化后的力量，顺着通道往上爬了二十多米，进入地下2层科研区"
        event {
          type = "status"
          state_delta {
            target = "从昏迷中苏醒"
            kind = "status"
            field = "wake_up"
            to = "recovered"
            note = "林野苏醒后简单活动身体，适应了基因强化后的力量，顺着通道往上爬了二十多米，进入地下2层科研区"
          }
        }
      }
      step 3 {
        description = "林野确认地下2层科研区有通往地表的应急升降梯，沿着地图指示的方向前进"
        event {
          type = "discovery"
          state_delta {
            target = "纯金属蚀刻应急通道地图"
            kind = "item"
            field = "find"
            to = "completed"
            note = "林野确认地下2层科研区有通往地表的应急升降梯，沿着地图指示的方向前进"
          }
        }
      }
      step 4 {
        description = "林野读取存储设备内容，得知公元2149年虫族跨星际入侵，AI「零」叛变发动机械叛乱，人类文明在双重打击下濒临灭绝，这场灾难史称「大陨落」，这批存储设备因是火种项目专用抗电磁加固型号，完全不受虫族的电磁干扰波影响，因此得以留存；同时得知当前人类仅存少量反抗军在废土上挣扎求生，虫族释放的全域电磁干扰会压制所有非基因绑定的电子设备"
        event {
          type = "knowledge"
          state_delta {
            target = "火种项目专用抗电磁加固存储设备"
            kind = "item"
            field = "read"
            to = "learned"
            note = "林野读取存储设备内容，得知公元2149年虫族跨星际入侵，AI「零」叛变发动机械叛乱，人类文明在双重打击下濒临灭绝，这场灾难史称「大陨落」，这批存储设备因是火种项目专用抗电磁加固型号，完全不受虫族的电磁干扰波影响，因此得以留存；同时得知当前人类仅存少量反抗军在废土上挣扎求生，虫族释放的全域电磁干扰会压制所有非基因绑定的电子设备"
          }
        }
      }
      step 5 {
        description = "林野利用刚强化的速度躲在立柱后偷袭，先后砸毁两台机械斥候的能量核心，右手的旧伤被扯裂，体能消耗过半，摸索到了吸收机械核心能量的方法，获得2枚初级能量晶核"
        event {
          type = "combat"
          combat {
            enemies = [{id = "叛变ai「零」_低级_机械斥候", count = 2, level = 2}]
          }
          state_delta {
            target = "两台机械斥候"
            kind = "enemy"
            field = "fight"
            to = "resolved"
            note = "林野利用刚强化的速度躲在立柱后偷袭，先后砸毁两台机械斥候的能量核心，右手的旧伤被扯裂，体能消耗过半，摸索到了吸收机械核心能量的方法，获得2枚初级能量晶核"
          }
        }
      }
      step 6 {
        description = "林野的基因稳定性提升至70%，正式稳定至基因适配者一阶初级，身体素质达到普通人类的3倍，体能快速恢复，对应state_anchor的境界突破，冲突解决：获得足够的力量突破地下设施的封锁"
        event {
          type = "status"
          state_delta {
            target = "机械斥候能量核心"
            kind = "item"
            field = "absorb"
            to = "upgraded"
            note = "林野的基因稳定性提升至70%，正式稳定至基因适配者一阶初级，身体素质达到普通人类的3倍，体能快速恢复，对应state_anchor的境界突破，冲突解决：获得足够的力量突破地下设施的封锁"
          }
        }
      }
      step 7 {
        description = "林野找到通往地表的升降梯，检查后确认能源足够支撑一次升降，输入记忆中残留的项目通用密码启动预热程序，等待升降梯上升"
        event {
          type = "goal"
          state_delta {
            target = "地表应急升降梯"
            kind = "location"
            field = "find"
            to = "completed"
