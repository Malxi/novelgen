  chapter "冻土上的相遇" {
    id = "P1-V1-C3"
    arc = "P1-V1"
    objective "冻土上的相遇" {
      id = "obj_P1-V1-C3"
      type = "sequence"
      step 1 {
        description = "势力整合支线 | hook | 林野结识青藤据点的先遣游击小队，获得临时生存机会，但因身份问题被怀疑 | 他必须在营地证明自己的清白，获得小队的信任，才能获得稳定的落脚点 | 沈氏势力在边境大肆搜捕旧科研人员，一旦被认定为沈氏探子就会被当场处决"
        event {
          type = "storyline"
          state_delta {
            target = "势力整合支线"
            kind = "storyline"
            field = "stage"
            to = "hook"
            unit = "沈氏势力在边境大肆搜捕旧科研人员，一旦被认定为沈氏探子就会被当场处决"
            cost = "他必须在营地证明自己的清白，获得小队的信任，才能获得稳定的落脚点"
            note = "change=林野结识青藤据点的先遣游击小队，获得临时生存机会，但因身份问题被怀疑; consequence=他必须在营地证明自己的清白，获得小队的信任，才能获得稳定的落脚点; pressure=沈氏势力在边境大肆搜捕旧科研人员，一旦被认定为沈氏探子就会被当场处决"
          }
          state_delta {
            target = "势力整合支线"
            kind = "plot_thread"
            field = "storyline"
            to = "raised"
            note = "active pressure in P1-V1-C3"
          }
        }
      }
      step 2 {
        description = "林野第一次来到废土地表，面对零下三十度的酷寒与漫天风雪，研究所所处区域正是荒骨台核心区域，他激活基因能力抵御低温，体能快速消耗"
        event {
          type = "status"
          state_delta {
            target = "地表出口"
            kind = "location"
            field = "exit"
            to = "adjusted"
            note = "林野第一次来到废土地表，面对零下三十度的酷寒与漫天风雪，研究所所处区域正是荒骨台核心区域，他激活基因能力抵御低温，体能快速消耗"
          }
        }
      }
      step 3 {
        description = "苏晴在外围用能量步枪精准打击工蜂眼部弱点，牵制了两只工蜂的行动，林野依靠一阶初级的强化身体素质击杀剩余1只工蜂，获得1枚初级能量晶核；但被牵制的两只工蜂突破火力网逼近，他的体能已经消耗过半，被两只工蜂前后夹击，利爪已经逼近他的咽喉，随时可能丧命"
        event {
          type = "combat"
          combat {
            enemies = [{id = "虫族_低级_虫族工蜂", count = 3, level = 2}]
          }
          state_delta {
            target = "三只虫族工蜂"
            kind = "enemy"
            field = "fight"
            to = "progressed"
            note = "苏晴在外围用能量步枪精准打击工蜂眼部弱点，牵制了两只工蜂的行动，林野依靠一阶初级的强化身体素质击杀剩余1只工蜂，获得1枚初级能量晶核；但被牵制的两只工蜂突破火力网逼近，他的体能已经消耗过半，被两只工蜂前后夹击，利爪已经逼近他的咽喉，随时可能丧命"
          }
        }
      }
      step 4 {
        description = "苏晴带队救下林野，虎子用能量步枪精准预判工蜂移动路径，击杀剩余2只工蜂；苏晴发现林野身上的旧时代军工身份牌，提及近期沈氏势力一直在边境搜捕旧时代科研人员，周边还出现淡蓝色瞳孔的异变者无故伤人，沈氏探子和异变者发现就地处决，因此对林野的身份抱有强烈警惕，让虎子暂扣了他身上的3枚能量晶核，要求他跟随小队回营地接受观察，确认不是沈氏探子再归还；苏晴提及家人全被虫族杀害，立志打通边境带幸存者撤离，此次带队是青藤据点派出来的先遣勘探队，苏晴开枪时的预判能力为后续异能觉醒埋下伏笔，冲突升级为林野的身份信任危机"
        event {
          type = "relationship"
          state_delta {
            target = "林野"
            kind = "character"
            field = "rescue"
            to = "established"
            note = "苏晴带队救下林野，虎子用能量步枪精准预判工蜂移动路径，击杀剩余2只工蜂；苏晴发现林野身上的旧时代军工身份牌，提及近期沈氏势力一直在边境搜捕旧时代科研人员，周边还出现淡蓝色瞳孔的异变者无故伤人，沈氏探子和异变者发现就地处决，因此对林野的身份抱有强烈警惕，让虎子暂扣了他身上的3枚能量晶核，要求他跟随小队回营地接受观察，确认不是沈氏探子再归还；苏晴提及家人全被虫族杀害，立志打通边境带幸存者撤离，此次带队是青藤据点派出来的先遣勘探队，苏晴开枪时的预判能力为后续异能觉醒埋下伏笔，冲突升级为林野的身份信任危机"
          }
        }
      }
      step 5 {
