
metadata {
  title = "fire-galaxy"
  dsl_version = "0.2.0"
  phase = "outline"
}

characters {
  npc "protagonist" {
    id = "protagonist"
    __placeholder__ = true
    __source_phase__ = "outline"
  }
}

world {
  location "wasteland" {
    id = "wasteland"
    __placeholder__ = true
    __source_phase__ = "outline"
  }
  location "cryo_facility" {
    id = "cryo_facility"
    __placeholder__ = true
    __source_phase__ = "outline"
  }
}

storyline {
  chapter "冻土下的苏醒" {
    id = "P1-V1-C1"
    arc = "P1-V1"
    objective "冻土下的苏醒" {
      id = "obj_P1-V1-C1"
      type = "sequence"
      step 1 {
        description = "林跃从1200年的休眠中醒来，记忆停留在21世纪基因计划志愿者登记当天"
        event {
          type = "premise"
        }
      }
      step 2 {
        description = "林跃确认当前为星元1247年，距离他进入休眠舱已过去1200年"
        event {
          type = "knowledge"
        }
      }
      step 3 {
        description = "林跃用休眠舱的金属撬棍击杀虫族幼虫"
        event {
          type = "combat"
        }
      }
      step 4 {
        description = "林跃觉醒专属基因能力：击杀异星生物可吸收生命能量强化自身体质"
        event {
          type = "premise"
        }
      }
    }
  }
  chapter "地下设施的逃杀" {
    id = "P1-V1-C2"
    arc = "P1-V1"
    objective "地下设施的逃杀" {
      id = "obj_P1-V1-C2"
      type = "sequence"
      step 1 {
        description = "林跃抵达地下2层的科研档案区"
        event {
          type = "move"
        }
      }
      step 2 {
        description = "林跃得知星元37年虫族跨星际入侵，AI「零」叛变发动机械叛乱，人类文明在双重打击下濒临灭绝"
        event {
          type = "knowledge"
        }
      }
      step 3 {
        description = "林跃利用地形优势击毁两台机械斥候，吸收机械核心的能量体质再次提升"
        event {
          type = "combat"
        }
      }
      step 4 {
        description = "林跃找到通往地表的升降梯，确认能源足够支撑一次升降"
        event {
          type = "goal"
        }
      }
    }
  }
  chapter "冻土上的相遇" {
    id = "P1-V1-C3"
    arc = "P1-V1"
    objective "冻土上的相遇" {
      id = "obj_P1-V1-C3"
      type = "sequence"
      step 1 {
        description = "林跃第一次来到废土地表，面对零下三十度的酷寒与漫天风雪"
        event {
          type = "move"
        }
      }
      step 2 {
        description = "林跃击杀1只工蜂，但被另外2只围攻，体力不支陷入险境"
        event {
          type = "combat"
        }
      }
      step 3 {
        description = "游击小队队长苏晴带队救下林跃，击杀剩余2只工蜂"
        event {
          type = "relationship"
        }
      }
      step 4 {
        description = "林跃跟随小队前往临时营地休整"
        event {
          type = "move"
        }
      }
    }
  }
  chapter "游击营地的真相" {
    id = "P1-V1-C4"
    arc = "P1-V1"
    objective "游击营地的真相" {
      id = "obj_P1-V1-C4"
      type = "sequence"
      step 1 {
        description = "林跃得知当前地球分为虫族控制区、AI机械区、人类反抗区三大势力范围，游击小队属于北境反抗军的分支"
        event {
          type = "knowledge"
        }
      }
      step 2 {
        description = "林跃协助小队击杀3只虫族，防守成功"
        event {
          type = "combat"
        }
      }
      step 3 {
        description = "林跃基因等级提升至一阶中级，身体强度达到普通人类的3倍"
        event {
          type = "status"
        }
      }
      step 4 {
        description = "林跃与小队商议返回研究所，夺取封存的初代机甲打破虫族的边境封锁"
        event {
          type = "goal"
        }
      }
    }
  }
  chapter "机甲库的基因锁" {
    id = "P1-V1-C5"
    arc = "P1-V1"
    objective "机甲库的基因锁" {
      id = "obj_P1-V1-C5"
      type = "sequence"
      step 1 {
        description = "小队顺利抵达研究所地下1层入口，未被虫族主力发现"
        event {
          type = "move"
        }
      }
      step 2 {
        description = "林跃与虎子配合全歼虫族巡逻队，未触发警报"
        event {
          type = "combat"
        }
      }
      step 3 {
        description = "发现机甲库需要当年基因计划志愿者的专属基因才能解锁，小队之前多次尝试都失败"
        event {
          type = "discover"
        }
      }
      step 4 {
        description = "林跃的基因完美匹配门禁系统，尘封1200年的机甲库大门成功开启"
        event {
          type = "achieve"
        }
      }
    }
  }
  chapter "初代机甲重曙" {
    id = "P1-V1-C6"
    arc = "P1-V1"
    objective "初代机甲重曙" {
      id = "obj_P1-V1-C6"
      type = "sequence"
      step 1 {
        description = "林跃找到专为基因计划志愿者定制的初代实验型机甲「重曙」，状态完好仅能源系统损坏"
        event {
          type = "discover"
        }
      }
      step 2 {
        description = "在机械师阿禾的协助下，用收集到的能量晶核修复机甲的动力核心"
        event {
          type = "acquire"
        }
      }
      step 3 {
        description = "林跃首次驾驶半修复的重曙机甲，用机甲的近战臂刃全歼机械清扫兵"
        event {
          type = "combat"
        }
      }
      step 4 {
        description = "重曙机甲完成全部修复，各项性能达到出厂标准，林跃与机甲的基因匹配度高达98%"
        event {
          type = "achieve"
        }
      }
    }
  }
  chapter "冻土上的机甲锋芒" {
    id = "P1-V1-C7"
    arc = "P1-V1"
    objective "冻土上的机甲锋芒" {
      id = "obj_P1-V1-C7"
      type = "sequence"
      step 1 {
        description = "林跃驾驶机甲，带着小队成员沿隐蔽路线返回临时营地"
        event {
          type = "move"
        }
      }
      step 2 {
        description = "林跃驾驶重曙机甲全歼虫族作战小队，测试了机甲的近战、远程武器全部功能"
        event {
          type = "combat"
        }
      }
      step 3 {
        description = "林跃基因等级突破至二阶初级，获得精神力感知能力，可以感知周围1公里内的敌人动向"
        event {
          type = "status"
        }
      }
      step 4 {
        description = "小队顺利返回营地，重曙机甲的出现让所有营地幸存者士气大振"
        event {
          type = "achieve"
        }
      }
    }
  }
  chapter "前哨站的三方博弈" {
    id = "P1-V1-C8"
    arc = "P1-V1"
    objective "前哨站的三方博弈" {
      id = "obj_P1-V1-C8"
      type = "sequence"
      step 1 {
        description = "林跃得知虫族前哨站封锁了所有向南的路线，而近地轨道殖民站的信号源就在前哨站南侧"
        event {
          type = "knowledge"
        }
      }
      step 2 {
        description = "林跃和苏晴潜入前哨站外围山地，侦察前哨站的防御部署"
        event {
          type = "move"
        }
      }
      step 3 {
        description = "发现AI零的机械部队正在进攻前哨站西侧防线，虫族主力被牵制在西侧"
        event {
          type = "discover"
        }
      }
      step 4 {
        description = "小队制定战术，等机械部队和虫族两败俱伤时，从东侧防御薄弱点突袭前哨站"
        event {
          type = "goal"
        }
      }
    }
  }
  chapter "攻破前哨站" {
    id = "P1-V1-C9"
    arc = "P1-V1"
    objective "攻破前哨站" {
      id = "obj_P1-V1-C9"
      type = "sequence"
      step 1 {
        description = "林跃驾驶重曙机甲突袭东侧防线，10分钟内全歼12只虫族守军，突破防线进入前哨站内部"
        event {
          type = "combat"
        }
      }
      step 2 {
        description = "林跃全歼残余的机械部队，吸收能量补充机甲能源"
        event {
          type = "combat"
        }
      }
      step 3 {
        description = "林跃与刀锋虫激战15分钟，最终用机甲的能量核心穿刺炮击穿刀锋虫的甲壳，将其击杀"
        event {
          type = "combat"
        }
      }
      step 4 {
        description = "小队成功占领前哨站，打通了向南前往信号源的路线，获得前哨站内的大量物资储备"
        event {
          type = "achieve"
        }
      }
    }
  }
  chapter "星舰坐标" {
    id = "P1-V1-C10"
    arc = "P1-V1"
    objective "星舰坐标" {
      id = "obj_P1-V1-C10"
      type = "sequence"
      step 1 {
        description = "阿禾修复前哨站的通讯装置，接收到人类近地轨道殖民站发出的坐标信号，同时收到了前往殖民站的地面发射站位置"
        event {
          type = "discover"
        }
      }
      step 2 {
        description = "林跃宣布离开地球前往星际的计划，47名幸存者全部愿意跟随他，成为他的第一批追随者"
        event {
          type = "goal"
        }
      }
      step 3 {
        description = "林跃找到当年的联邦秘密文档，得知休眠舱激活是联邦预设的文明重启计划，他是被选定的文明重启者"
        event {
          type = "knowledge"
        }
      }
      step 4 {
        description = "林跃驾驶重曙机甲开路，带领所有追随者出发前往地面发射站，正式迈出跨星际远征的第一步"
        event {
          type = "move"
        }
      }
    }
  }
}

systems {
}
