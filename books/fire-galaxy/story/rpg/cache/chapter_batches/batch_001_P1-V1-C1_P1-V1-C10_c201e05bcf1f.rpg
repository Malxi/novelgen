metadata {
  title = "废土苏醒"
  dsl_version = "0.2.0"
  source = "novelgen_outline"
}
world {
  location "废土世界" {
    id = "loc_wasteland"
    name = "废土世界"
    description = "危机四伏的未来地球，虫族肆虐，满目疮痍，遍布废墟与辐射，曾是人类繁荣文明的家园，因虫族入侵沦为废土"
    __placeholder__ = false
  }
  location "休眠仓设施" {
    id = "loc_cryo_facility"
    name = "休眠仓设施"
    description = "半埋在地下的废弃冬眠设施，灾难前用于保存人类火种，是陆沉苏醒的地点"
    __placeholder__ = false
  }
  location "3号地下幸存者据点" {
    id = "loc_outpost_3"
    name = "3号地下幸存者据点"
    description = "由旧铁路设施改造的地下据点，居住着大量幸存者，藏有初代灰雀工程机甲"
    __placeholder__ = false
  }
  location "旧凉山核电站" {
    id = "loc_liangshan_nuclear"
    name = "旧凉山核电站"
    description = "废弃的旧时代核电站，被虫族占领为孵化巢，藏有修复机甲所需的高纯度氚晶体"
    __placeholder__ = false
  }
  location "南海发射场" {
    id = "loc_south_sea_launch"
    name = "南海发射场"
    description = "遗留有逐星号远征星舰的发射场，是陆沉一行人前往寻找联邦主力的目标地点"
    __placeholder__ = false
  }
}
characters {
  player "陆沉" {
    id = "char_lu_chen"
    name = "陆沉"
    description = "25岁男性人类，21世纪航天工程师，意外休眠千年穿越到虫族肆虐的废土世界，坚韧好奇求生欲强，拥有辐射抗性，已觉醒S级基因进化能力"
    __placeholder__ = false
    str = 15
    agi = 18
    int = 20
    vit = 22
    hp = 150
    mp = 60
    class = "S级基因进化者/前航天工程师"
  }
  npc "老周" {
    id = "char_lao_zhou"
    name = "老周"
    description = "3号地下据点负责人，沉稳可靠，深得幸存者信任"
    __placeholder__ = false
    role = "据点管理者"
    default_location = "loc_outpost_3"
  }
  npc "林野" {
    id = "char_lin_ye"
    name = "林野"
    description = "3号据点行动队队长，战斗经验丰富，熟悉废土地形"
    __placeholder__ = false
    role = "战斗队长"
    default_location = "loc_outpost_3"
  }
  npc "阿柚" {
    id = "char_a_you"
    name = "阿柚"
    description = "3号据点技术员，擅长设备维修与能量探测"
    __placeholder__ = false
    role = "技术员"
    default_location = "loc_outpost_3"
  }
  npc "虫族工蜂" {
    id = "enemy_zerg_drone"
    name = "虫族工蜂"
    description = "泽格虫族最低阶作战单位，速度快，拥有腐蚀性体液，颈部神经节是弱点"
    __placeholder__ = false
    role = "低阶敌人"
    default_location = "loc_wasteland"
  }
  npc "虫族兵蜂" {
    id = "enemy_zerg_soldier"
    name = "虫族兵蜂"
    description = "泽格虫族A级作战单位，外壳坚硬，普通子弹无法击穿"
    __placeholder__ = false
    role = "中阶敌人"
    default_location = "loc_wasteland"
  }
  npc "虫族哨兵" {
    id = "enemy_zerg_sentry"
    name = "虫族哨兵"
    description = "泽格虫族高阶作战单位，体型是工蜂两倍，外骨骼防御力极强"
    __placeholder__ = false
    role = "高阶敌人"
    default_location = "loc_liangshan_nuclear"
  }
  npc "T-7型智网战斗机器人" {
    id = "enemy_ai_t7"
    name = "T-7型智网战斗机器人"
    description = "反叛AI集群智网的作战单位，战斗力强，主动捕杀人类"
    __placeholder__ = false
    role = "机器人敌人"
    default_location = "loc_wasteland"
  }
}
storyline {
  chapter "休眠仓的冷光" {
    id = "P1-V1-C1"
    objective "从休眠仓苏醒，确认所处时代，收集基础物资应对即将到来的危险" {
      step 1 {
        description = "休眠仓冷却系统停止运行，温度攀升，陆沉从千年深休眠中苏醒，伴随肌肉酸痛不适感"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "injury"
            field = "status"
            to = "轻微肌肉酸痛"
            note = "深休眠苏醒后的正常反应"
          }
          on_complete {
            narration = "陆沉缓缓睁开眼，陌生的黑暗包裹着他，浑身肌肉酸痛无比"
            exp = 10
          }
        }
      }
      step 2 {
        description = "休眠仓开启按键老化故障，陆沉取出应急储物格的钛合金破拆锥，砸17次砸变形锁扣，撞开仓门离开"
        event {
          type = "acquire"
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            from = "none"
            to = "钛合金破拆锥"
            delta = 1
          }
          on_complete {
            narration = "仓门轰然打开，霉味与金属锈蚀味涌入鼻腔，陆沉终于离开困住他的休眠仓"
            exp = 20
          }
        }
      }
      step 3 {
        description = "陆沉发现休眠中心几乎停运，仅余应急灯照明，墙面日历定格在他进入休眠的次日公元2247年10月16日"
        event {
          type = "knowledge"
          on_complete {
            narration = "看着定格的日历，陆沉心头升起不祥的预感，他沉睡的时间恐怕远超预期"
            exp = 10
          }
        }
      }
      step 4 {
        description = "陆沉找到民用身份识别手环，虹膜扫描匹配成功，确认当前为公元3270年，已休眠1023年"
        event {
          type = "acquire"
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            from = "none"
            to = "民用身份识别手环"
            delta = 1
          }
          state_delta {
            target = "char_lu_chen"
            kind = "time"
            field = "elapsed_years"
            delta = 1023
            note = "确认已休眠千年穿越到未来"
          }
          on_complete {
            narration = "手环上跳动的年份让陆沉大脑空白，他竟然来到了一千多年后的未来"
            exp = 30
          }
        }
      }
      step 5 {
        description = "陆沉通过手环推送获知人类遭遇虫族入侵，90%地表被占领，仅余3个据点，总人口不足3亿濒临灭绝"
        event {
          type = "knowledge"
          on_complete {
            narration = "冰冷的事实摆在眼前，人类文明已经走到了灭绝的边缘"
            exp = 20
          }
        }
      }
      step 6 {
        description = "陆沉找到生锈战术匕首、半盒高能营养片，随身携带"
        event {
          type = "acquire"
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            from = "none"
            to = "生锈战术匕首"
            delta = 1
          }
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            from = "none"
            to = "高能营养片"
            delta = 12
          }
          on_complete {
            narration = "陆沉将武器和食物收好，求生的本能让他迅速冷静下来"
            exp = 20
          }
        }
      }
      step 7 {
        description = "手环发出热源预警，120米外虫族工蜂快速逼近，已到通道入口，绿光复眼清晰可见"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_drone", count = 1, level = 1}]
          }
          on_complete {
            narration = "虫族的嘶鸣越来越近，死亡的阴影第一次笼罩住刚苏醒的陆沉"
            exp = 10
          }
        }
      }
      step 8 {
        description = "陆沉握紧战术匕首，弓背做好战斗准备，决心不会刚苏醒就死在虫族手中"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "status"
            field = "combat_readiness"
            to = "ready"
          }
          on_complete {
            narration = "陆沉握紧匕首，眼神坚定，他绝不会轻易死在这个陌生的未来世界"
            exp = 10
          }
        }
      }
    }
  }
  chapter "第一头虫影" {
    id = "P1-V1-C2"
    objective "击杀首个虫族敌人，确认自身异常能力，躲避虫族大部队"
    {
      step 1 {
        description = "陆沉手持废弃支撑钢管躲在拐角，手环预警高危热源距离仅30米"
        event {
          type = "combat"
          on_complete {
            narration = "陆沉屏住呼吸贴紧墙面，未知节肢生物的爬动声越来越近"
            exp = 10
          }
        }
      }
      step 2 {
        description = "半人高的虫族工蜂爬出，发现陆沉后发起攻击，前肢刺穿三厘米厚合金墙面"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_drone", count = 1, level = 1}]
          }
          on_complete {
            narration = "锋利的虫肢擦着陆沉的身体刺入墙面，巨大的力道让墙面开裂"
            exp = 10
          }
        }
      }
      step 3 {
        description = "陆沉靠野战训练记忆躲避攻击，用钢管砸中工蜂一只复眼，激怒工蜂"
        event {
          type = "combat"
          on_complete {
            narration = "工蜂发出尖锐的嘶鸣，攻击更加疯狂"
            exp = 20
          }
        }
      }
      step 4 {
        description = "发狂的工蜂喷出强腐蚀液，陆沉抬臂阻挡，休眠服瞬间碳化，皮肤严重灼伤"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "injury"
            field = "status"
            to = "小臂严重灼伤"
          }
          on_complete {
            narration = "剧烈的灼烧感传来，陆沉咬着牙没有后退"
            exp = 10
          }
        }
      }
      step 5 {
        description = "陆沉忍痛不退，第二次用钢管砸中工蜂剩余复眼，成功将其击杀"
        event {
          type = "combat"
          on_complete {
            narration = "工蜂庞大的身体轰然倒地，陆沉成功击杀了第一个虫族敌人"
            exp = 50
          }
        }
      }
      step 6 {
        description = "手环扫描工蜂尸体，确认其为最低阶作战单位，预警5公里内大概率存在虫巢，建议立即撤离"
        event {
          type = "knowledge"
          on_complete {
            narration = "情况远比陆沉想象的更危险，这里不是久留之地"
            exp = 10
          }
        }
      }
      step 7 {
        description = "陆沉发现被腐蚀的小臂十几秒内完全自愈，没有疤痕，对自身异常感到震惊"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "injury"
            field = "status"
            to = "recovered"
            note = "未知自愈能力生效"
          }
          on_complete {
            narration = "看着完好无损的小臂，陆沉满心震惊，他的身体在沉睡中发生了未知的变化"
            exp = 20
          }
        }
      }
      step 8 {
        description = "陆沉联想到休眠时间差、手环匹配机密基因、基因适配度98%的信息，怀疑自己发生了基因变异"
        event {
          type = "knowledge"
          on_complete {
            narration = "种种迹象表明，千年的休眠给陆沉带来了意想不到的变化"
            exp = 10
          }
        }
      }
      step 9 {
        description = "手环再次预警，20只以上虫族热源从800米外快速接近"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_drone", count = 20, level = 1}]
          }
          on_complete {
            narration = "虫族大部队即将赶到，陆沉必须立刻撤离"
            exp = 10
          }
        }
      }
      step 10 {
        description = "陆沉坚定活下去、查明真相、驱逐虫族的信念，转身向休眠中心深处走去"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "status"
            field = "resolve"
            to = "confirmed"
          }
          move {
            to = "loc_cryo_facility"
          }
          on_complete {
            narration = "陆沉的身影消失在通道深处，他的废土生存之旅正式开始"
            exp = 20
          }
        }
      }
    }
  }
  chapter "基因觉醒" {
    id = "P1-V1-C3"
    objective "躲避虫族大部队，收集物资，确认自身基因进化能力，踏上救援幸存者的征途"
    {
      step 1 {
        description = "陆沉在通道躲避每秒3米逼近的虫族，定位到700米外无热源的A级物资储备室，持钢管前往"
        event {
          type = "location"
          move {
            to = "loc_cryo_facility"
          }
          on_complete {
            narration = "陆沉放轻脚步在通道中快速移动，身后虫族的爬动声越来越近"
            exp = 10
          }
        }
      }
      step 2 {
        description = "陆沉撬开锈死的储备室合金门进入，发现应急灯、恒温系统仍低功率运转，物资保存完好"
        event {
          type = "location"
          move {
            to = "loc_cryo_facility"
          }
          on_complete {
            narration = "看着完好的物资，陆沉悬着的心终于放下了一点"
            exp = 20
          }
        }
      }
      step 3 {
        description = "陆沉清点物资，获得压缩干粮、净水片、医疗物资、新战术匕首、防腐蚀防护服"
        event {
          type = "acquire"
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            delta = 1
            to = "真空压缩干粮"
          }
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            delta = 20
            to = "净水片"
          }
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            delta = 1
            to = "防腐蚀防护服"
          }
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            delta = 1
            to = "全新战术匕首"
          }
          on_complete {
            narration = "充足的物资给了陆沉更多生存的底气"
            exp = 30
          }
        }
      }
      step 4 {
        description = "陆沉划伤指尖测试，伤口3秒自愈，手环检测显示基因活性为普通人类327%，属于S级进化者，自愈能力排前0.1%，确认变异来自千年休眠"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "cultivation"
            field = "level"
            from = "normal_human"
            to = "s_class_evolver"
            delta = 1
          }
          on_complete {
            narration = "陆沉终于确认，自己在千年休眠中觉醒了S级基因进化能力"
            exp = 50
          }
        }
      }
      step 5 {
        description = "储备室广播传来断断续续的求救信号，得知15公里外3号幸存者据点被虫族包围3天，仅剩37人其中12名伤员，随后信号中断"
        event {
          type = "knowledge"
          on_complete {
            narration = "陌生的求救信号传入耳中，陆沉知道还有其他幸存者在生死边缘挣扎"
            exp = 20
          }
        }
      }
      step 6 {
        description = "陆沉确定自己有能力救援，换好防护服，清点物资，替换高强度合金工兵铲"
        event {
          type = "acquire"
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            delta = 1
            to = "高强度合金工兵铲"
          }
          on_complete {
            narration = "陆沉做好了出发救援的准备"
            exp = 10
          }
        }
      }
      step 7 {
        description = "虫族逼近至储备室不足300米，陆沉走另一侧通往地面的应急通道避开虫族大部队"
        event {
          type = "location"
          move {
            to = "loc_cryo_facility"
          }
          on_complete {
            narration = "陆沉顺利避开虫族大部队，向着地面出口前进"
            exp = 20
          }
        }
      }
      step 8 {
        description = "陆沉到达地面出口，确认求救信号方向后，踏入黄沙戈壁废土，踏上救援征途"
        event {
          type = "location"
          move {
            to = "loc_wasteland"
          }
          on_complete {
            narration = "漫天黄沙扑面而来，陆沉的救援之旅正式开启"
            exp = 30
          }
        }
      }
    }
  }
  chapter "黄沙中的求救" {
    id = "P1-V1-C4"
    objective "救援被虫族围困的幸存者，前往3号地下据点，应对即将到来的A级虫族威胁"
    {
      step 1 {
        description = "陆沉身着防护服在戈壁前行，距离信号源11公里时听到前方枪声、惨叫声与虫族声响"
        event {
          type = "combat"
          on_complete {
            narration = "战斗的声音越来越清晰，陆沉加快了脚步"
            exp = 10
          }
        }
      }
      step 2 {
        description = "陆沉发现林野、阿柚及一名受伤队员被三只工蜂围困在岩堆后方"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_drone", count = 3, level = 1}]
          }
          spawn {
            actor = "char_lin_ye"
            location = "loc_wasteland"
          }
          spawn {
            actor = "char_a_you"
            location = "loc_wasteland"
          }
          on_complete {
            narration = "三名幸存者已经被逼到了绝路，情况十分危急"
            exp = 10
          }
        }
      }
      step 3 {
        description = "陆沉利用工蜂颈部神经节弱点，绕到后方突袭刺杀了第一只工蜂"
        event {
          type = "combat"
          on_complete {
            narration = "锋利的匕首精准刺入工蜂神经节，第一只工蜂瞬间倒地"
            exp = 20
          }
        }
      }
      step 4 {
        description = "林野与阿柚趁剩余两只工蜂分心配合作战，与陆沉联手三分钟将三只工蜂全部击杀"
        event {
          type = "combat"
          on_complete {
            narration = "三人配合默契，顺利解决了所有围困的虫族"
            exp = 50
          }
        }
      }
      step 5 {
        description = "林野、阿柚自报身份，阿柚提及据点内存有损坏的初代民用机甲，缺少联邦权限无法修复"
        event {
          type = "knowledge"
          on_complete {
            narration = "得知据点内有机甲，作为前航天工程师的陆沉心中一动"
            exp = 20
          }
        }
      }
      step 6 {
        description = "林野邀请陆沉前往3公里外的3号据点暂避，陆沉同意后拿出净水片与压缩干粮分给三人"
        event {
          type = "location"
          move {
            to = "loc_outpost_3"
          }
          on_complete {
            narration = "三名幸存者对陆沉的帮助十分感激"
            exp = 20
          }
        }
      }
      step 7 {
        description = "手环发出红色警报，1.2公里外A级虫族兵蜂以每秒8米速度逼近，普通子弹无法击穿其甲壳"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_soldier", count = 1, level = 3}]
          }
          on_complete {
            narration = "更强大的敌人即将到来，众人必须立刻撤离"
            exp = 10
          }
        }
      }
      step 8 {
        description = "众人立刻向3号据点逃跑，陆沉护在受伤队员身后同行，远处西昌发射场轮廓在风沙中越来越清晰"
        event {
          type = "location"
          move {
            to = "loc_outpost_3"
          }
          on_complete {
            narration = "众人全力向着据点狂奔，生存的希望就在前方"
            exp = 20
          }
        }
      }
    }
  }
  chapter "地下据点的秘密" {
    id = "P1-V1-C5"
    objective "安全进入3号据点，了解幸存者现状，发现灰雀机甲，主动承担获取氚晶体的任务"
    {
      step 1 {
        description = "陆沉一行人被兵蜂追杀，赶在兵蜂攻破入口前触发密码锁打开合金防爆门逃入据点，防爆门挡下兵蜂攻击和腐蚀液"
        event {
          type = "location"
          move {
            to = "loc_outpost_3"
          }
          on_complete {
            narration = "厚重的防爆门轰然关闭，将危险的虫族挡在了外面"
            exp = 30
          }
        }
      }
      step 2 {
        description = "据点负责人老周迎接众人，带他们穿行据点内部，可见大量幸存者靠捡拾旧时代物资维生"
        event {
          type = "spawn"
          spawn {
            actor = "char_lao_zhou"
            location = "loc_outpost_3"
          }
          on_complete {
            narration = "看着据点内艰难生存的老人、孩子，陆沉心中五味杂陈"
            exp = 10
          }
        }
      }
      step 3 {
        description = "老周向陆沉说明现状：107年前虫族突破太阳系防线，联邦主力撤往半人马座，遗留幸存者躲在地下，如今60%区域被虫族占领，还有反叛AI智网游荡捕杀人类，东亚仅存不到20个据点"
        event {
          type = "knowledge"
          on_complete {
            narration = "人类的处境比陆沉想象的还要艰难"
            exp = 20
          }
        }
      }
      step 4 {
        description = "老周带众人前往机甲仓库，展示出土的初代民用灰雀工程机甲，称埋藏百年外壳完好，但维修五个月无法启动，修好后可大幅提升据点生存能力"
        event {
          type = "knowledge"
          on_complete {
            narration = "看着熟悉的灰雀机甲，陆沉心中涌起亲切感，他曾参与过这款机甲的动力系统测试"
            exp = 20
          }
        }
      }
      step 5 {
        description = "陆沉用旧联邦手环扫描机甲能源仓接口，查出故障是核心主供电线路老化氧化接触不良，称自己有能力维修"
        event {
          type = "knowledge"
          on_complete {
            narration = "陆沉的话让在场所有人都看到了希望"
            exp = 30
          }
        }
      }
      step 6 {
        description = "林野告知维修所需的高纯度氚晶体仅存于十公里外被虫族占领的旧凉山核电站，此前两支外勤小队全部牺牲"
        event {
          type = "knowledge"
          on_complete {
            narration = "获取氚晶体的任务十分危险，几乎是九死一生"
            exp = 20
          }
        }
      }
      step 7 {
        description = "陆沉沉默片刻后主动提出自己愿意前往虫族巢穴获取氚晶体"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "status"
            field = "mission_accept"
            to = "tritium_crystal_retrieval"
          }
          on_complete {
            narration = "陆沉做出了决定，他要为据点的所有人搏出一条生路"
            exp = 30
          }
        }
      }
    }
  }
  chapter "核电站的魅影" {
    id = "P1-V1-C6"
    objective "组队前往旧凉山核电站，定位氚晶体位置，遭遇虫族哨兵暴露行踪"
    {
      step 1 {
        description = "陆沉提出独自前往核电站找氚晶体，遭到林野、阿柚、老周一致反对"
        event {
          type = "status"
          on_complete {
            narration = "众人都担心陆沉的安全，不愿让他独自冒险"
            exp = 10
          }
        }
      }
      step 2 {
        description = "老周提出三人组队方案：认路的林野、懂技术的阿柚与陆沉同行可提升一倍存活率，陆沉同意"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "status"
            field = "team_formed"
            to = "true"
          }
          on_complete {
            narration = "三人小队正式组建，做好了出发的准备"
            exp = 20
          }
        }
      }
      step 3 {
        description = "三人耗时3小时整理行装，备齐改装防腐蚀防护服、武器、补给及专用工具"
        event {
          type = "acquire"
          on_complete {
            narration = "所有准备工作完成，只等合适的出发时机"
            exp = 10
          }
        }
      }
      step 4 {
        description = "三人趁黎明低温、虫族活跃度低的窗口期出发，步行2小时后抵达核电站外围"
        event {
          type = "location"
          move {
            to = "loc_liangshan_nuclear"
          }
          state_delta {
            kind = "time"
            field = "elapsed_hours"
            delta = 2
          }
          on_complete {
            narration = "废弃的核电站出现在眼前，死寂的气氛让人不寒而栗"
            exp = 20
          }
        }
      }
      step 5 {
        description = "三人在核电站外围发现此前牺牲的外勤队遗骸与虫族残躯，陆沉捡到一块不属于人类或虫族的未知银灰色金属碎片，收进口袋"
        event {
          type = "acquire"
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            delta = 1
            to = "未知银灰色金属碎片"
          }
          on_complete {
            narration = "看着牺牲队员的遗骸，三人心中都沉甸甸的"
            exp = 10
          }
        }
      }
      step 6 {
        description = "阿柚用改装能量探测器定位到核心机房安全壳下的高纯度氚晶体位置，随后探测器警报，探测到至少300只虫族生命信号，几只正在向三人位置靠近"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_drone", count = 300, level = 1}]
          }
          on_complete {
            narration = "情况十分危急，三人必须立刻隐蔽"
            exp = 10
          }
        }
      }
      step 7 {
        description = "三人躲到混凝土废墟后隐蔽，一只体型是普通工蜂两倍的虫族哨兵出现在厂区空地，发出尖锐嘶鸣向巢穴通报了三人的位置"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_sentry", count = 1, level = 5}]
          }
          on_complete {
            narration = "行踪已经暴露，三人已经没有退路，只能正面迎敌"
            exp = 20
          }
        }
      }
    }
  }
  chapter "孵化巢的核心" {
    id = "P1-V1-C7"
    objective "击杀虫族哨兵，潜入核心机房获取氚晶体，遭遇虫族大部队围堵"
    {
      step 1 {
        description = "陆沉向林野、阿柚布置击杀虫族哨兵的作战方案，告知虫族大部队还有八分钟抵达"
        event {
          type = "status"
          on_complete {
            narration = "作战方案快速敲定，三人做好了战斗准备"
            exp = 10
          }
        }
      }
      step 2 {
        description = "陆沉主动制造动静吸引哨兵注意力，缠斗中防护服被螯爪划开，小臂被腐蚀液溅到，靠自愈能力快速恢复"
        event {
          type = "combat"
          on_complete {
            narration = "陆沉成功吸引了哨兵的全部注意力，为队友创造了攻击机会"
            exp = 20
          }
        }
      }
      step 3 {
        description = "林野抓住时机开枪击穿哨兵左侧复眼，哨兵受创出现僵直"
        event {
          type = "combat"
          on_complete {
            narration = "精准的一击让哨兵暂时失去了行动能力"
            exp = 20
          }
        }
      }
      step 4 {
        description = "阿柚按下电磁脉冲棒启动键，脉冲波击中哨兵胸甲下神经节使其彻底失能"
        event {
          type = "combat"
          on_complete {
            narration = "电磁脉冲成功生效，哨兵彻底失去了反抗能力"
            exp = 20
          }
        }
      }
      step 5 {
        description = "陆沉跃起用战术匕首刺入哨兵神经节，成功将其击杀"
        event {
          type = "combat"
          on_complete {
            narration = "高阶虫族哨兵轰然倒地，三人顺利解决了眼前的危机"
            exp = 80
          }
        }
      }
      step 6 {
        description = "三人沿标记路线找到通风管道入口，清理混凝土块后进入管道，中途屏住呼吸避开下方巡逻的十余只工蜂"
        event {
          type = "location"
          move {
            to = "loc_liangshan_nuclear"
          }
          on_complete {
            narration = "三人顺利绕过巡逻虫族，向着核心机房前进"
            exp = 20
          }
        }
      }
      step 7 {
        description = "三人爬完五百米通风管道进入核心机房，在主控制台凹槽内发现高纯度氚晶体"
        event {
          type = "knowledge"
          on_complete {
            narration = "散发着微光的氚晶体就在眼前，任务已经成功了一半"
            exp = 30
          }
        }
      }
      step 8 {
        description = "陆沉撬开固定卡扣将氚晶体取出，放入背包内的特制防辐射密封袋妥善收纳"
        event {
          type = "acquire"
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            delta = 1
            to = "高纯度氚晶体"
          }
          on_complete {
            narration = "氚晶体顺利到手，众人悬着的心放下了一半"
            exp = 50
          }
        }
      }
      step 9 {
        description = "陆沉在机房墙角发现被虫族撕毁的智网战斗机器人残骸，读取到其搜寻氚晶体、清除沿途活物的任务信息"
        event {
          type = "knowledge"
          on_complete {
            narration = "原来智网势力也在寻找氚晶体，情况变得更加复杂"
            exp = 20
          }
        }
      }
      step 10 {
        description = "核心机房突发震动，三百余只虫族将机房团团包围，不断撞击密封门，预计十分钟内即可破门"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_drone", count = 300, level = 1}]
          }
          on_complete {
            narration = "虫族大部队已经将核心机房团团围住，三人陷入了绝境"
            exp = 10
          }
        }
      }
    }
  }
  chapter "死里逃生" {
    id = "P1-V1-C8"
    objective "摆脱虫族围堵，安全携带氚晶体返回据点，解锁一阶基因进化，发现智网势力威胁"
    {
      step 1 {
        description = "陆沉发现备用排气通道直通外侧排风井，距离汇合点更近"
        event {
          type = "knowledge"
          on_complete {
            narration = "一条逃生之路出现在眼前，三人还有一线生机"
            exp = 10
          }
        }
      }
      step 2 {
        description = "陆沉安排林野、阿柚携带氚晶体从排气通道撤离，自己留下断后，林野不愿抛下陆沉，被阿柚以拖后腿为由劝服"
        event {
          type = "status"
          on_complete {
            narration = "撤离方案确定，陆沉选择独自留下断后，为队友争取逃生时间"
            exp = 20
          }
        }
      }
      step 3 {
        description = "林野临走前将仅剩的两枚高爆手雷交给陆沉，约定在出口等陆沉十分钟，超时就返回找人"
        event {
          type = "acquire"
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            delta = 2
            to = "高爆手雷"
          }
          on_complete {
            narration = "队友的信任给了陆沉更多的力量"
            exp = 10
          }
        }
      }
      step 4 {
        description = "密封门破裂，十多只工蜂涌入机房，陆沉在生死关头解锁一阶基因进化，力量速度翻五倍，生成皮下银灰色外骨骼，三分钟内击杀全部13只冲进来的工蜂"
        event {
          type = "combat"
          state_delta {
            target = "char_lu_chen"
            kind = "cultivation"
            field = "level"
            from = "s_class_evolver"
            to = "first_order_evolver"
            delta = 1
          }
          on_complete {
            narration = "一阶基因进化成功解锁，陆沉的战斗力得到了质的提升"
            exp = 100
          }
        }
      }
      step 5 {
        description = "陆沉将高爆手雷扔向密封门后的虫群，爆炸引发通道坍塌，撤离时发现半吨重的混凝土块即将堵死排气通道入口，陆沉拼尽全力挪开石块，顺带砸死几只追来的工蜂"
        event {
          type = "combat"
          on_complete {
            narration = "爆炸暂时阻挡了虫群，陆沉成功为自己打通了撤离通道"
            exp = 50
          }
        }
      }
      step 6 {
        description = "陆沉在通道完全坍塌前爬出排风井，与林野、阿柚汇合，林野引爆预先埋在核电站各处的炸药，将所有追来的虫族封死在坍塌的核电站内"
        event {
          type = "location"
          move {
            to = "loc_wasteland"
          }
          on_complete {
            narration = "剧烈的爆炸响起，核电站彻底坍塌，所有虫族都被封在了里面"
            exp = 50
          }
        }
      }
      step 7 {
        description = "阿柚用探测器确认周边三公里内无存活虫族，陆沉检查确认氚晶体完好无损，三人决定立刻返回地下据点"
        event {
          type = "status"
          on_complete {
            narration = "任务顺利完成，三人踏上了返回据点的路程"
            exp = 30
          }
        }
      }
      step 8 {
        description = "返程途中陆沉摸到口袋里的智网机器人碎片，想起撤离时瞥见西北高地上的银灰色光点，意识到智网势力已经找到此处，大概率盯上了据点"
        event {
          type = "knowledge"
          on_complete {
            narration = "新的威胁已经出现，智网势力的存在让陆沉心中升起警惕"
            exp = 20
          }
        }
      }
      step 9 {
        description = "三人狂奔四十分钟抵达地下据点，受到幸存者欢迎，阿柚将氚晶体交给负责人，众人得知有了重启灰雀机甲、升级防御系统的关键能源，十分振奋"
        event {
          type = "location"
          move {
            to = "loc_outpost_3"
          }
          on_complete {
            narration = "整个据点都沉浸在喜悦的氛围中，他们终于有了更强的生存保障"
            exp = 30
          }
        }
      }
      step 10 {
        description = "陆沉靠在门框上放松时突然产生强烈眩晕，四肢力气被瞬间抽干，直直向地面晕倒，失去意识前仍记挂着智网的潜在威胁"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "injury"
            field = "status"
            to = "unconscious"
            note = "基因进化后的副作用"
          }
          on_complete {
            narration = "陆沉的身影直直倒下，彻底失去了意识"
            exp = 10
          }
        }
      }
    }
  }
  chapter "灰雀的轰鸣" {
    id = "P1-V1-C9"
    objective "苏醒后修复灰雀机甲，应对智网机器人的入侵"
    {
      step 1 {
        description = "陆沉在据点医疗室苏醒，经阿柚检测确认基因链完全稳定，成功进化为一阶进化者，身体素质大幅提升，随身携带的智网机器人碎片仍在口袋中"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "injury"
            field = "status"
            to = "recovered"
          }
          on_complete {
            narration = "陆沉缓缓睁开眼睛，身体已经完全恢复，基因进化已经稳定"
            exp = 20
          }
        }
      }
      step 2 {
        description = "据点负责人老周带来陆沉拼死带回的氚晶体，告知该物资是所有据点成员生存的关键"
        event {
          type = "status"
          on_complete {
            narration = "老周的话让陆沉深知自己肩上的责任重大"
            exp = 10
          }
        }
      }
      step 3 {
        description = "陆沉提出立刻维修灰雀机甲提升据点安全性，由林野带路前往机甲维修库，阿柚随行提供数据支持"
        event {
          type = "location"
          move {
            to = "loc_outpost_3"
          }
          on_complete {
            narration = "维修机甲的工作正式提上日程"
            exp = 10
          }
        }
      }
      step 4 {
        description = "陆沉凭借前航天工程师的经验，耗时三小时排查修复灰雀机甲的所有故障点，将高纯度氚晶体装入机甲能源核心卡槽"
        event {
          type = "status"
          state_delta {
            kind = "time"
            field = "elapsed_hours"
            delta = 3
          }
          on_complete {
            narration = "所有故障都被修复，氚晶体顺利装入能源核心，只等启动测试"
            exp = 30
          }
        }
      }
      step 5 {
        description = "灰雀机甲成功启动，陆沉操控机甲完成武器、动力、操作系统全流程性能测试，所有指标全部达标可投入实战，围观幸存者十分振奋"
        event {
          type = "status"
          on_complete {
            narration = "灰雀机甲发出低沉的轰鸣，正式具备了实战能力，整个据点都沸腾了"
            exp = 80
          }
        }
      }
      step 6 {
        description = "据点突然拉响红色警报，10台T-7型智网战斗机器人突破外门向内部突进，老周通过广播通知非战斗人员撤入防爆掩体，战斗人员到一号通道集合"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_ai_t7", count = 10, level = 4}]
          }
          on_complete {
            narration = "刺耳的警报声响起，智网机器人已经入侵到据点内部，大战一触即发"
            exp = 20
          }
        }
      }
      step 7 {
        description = "陆沉主动提出操控灰雀机甲正面阻挡入侵的智网机器人，安抚慌乱的人群，林野主动提出带领战斗人员为陆沉打掩护"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "status"
            field = "combat_readiness"
            to = "ready"
          }
          on_complete {
            narration = "陆沉站了出来，他将驾驶灰雀机甲守护整个据点的安全"
            exp = 20
          }
        }
      }
      step 8 {
        description = "陆沉操控灰雀机甲停在据点入口通道中央，预热武器做好战斗准备，等待智网机器人到来"
        event {
          type = "combat"
          on_complete {
            narration = "灰雀机甲伫立在通道中央，陆沉做好了迎战的准备，守护据点的战斗即将开始"
            exp = 20
          }
        }
      }
    }
  }
  chapter "逐星的第一步" {
    id = "P1-V1-C10"
    objective "击退智网机器人入侵，成为据点领袖，带领幸存者出发前往南海发射场，开启逐星计划"
    {
      step 1 {
        description = "10台T-7型智网战斗机器人攻入地下据点入口大厅，瞄准掩体后的老周及非战斗人员，众人陷入绝境"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_ai_t7", count = 10, level = 4}]
          }
          on_complete {
            narration = "冰冷的机器人枪口对准了手无寸铁的幸存者，死亡的阴影笼罩了整个大厅"
            exp = 10
          }
        }
      }
      step 2 {
        description = "陆沉操控灰雀机甲冲入大厅，精准击毁三台尚未开火的机器人"
        event {
          type = "combat"
          on_complete {
            narration = "灰雀机甲的炮火精准命中目标，三台机器人瞬间报废，及时救下了险境中的幸存者"
            exp = 50
          }
        }
      }
      step 3 {
        description = "剩余七台机器人围攻陆沉，陆沉操控机甲灵活闪避，配合机枪、格斗刃用时不到十分钟击毁全部机器人，据点实现零伤亡"
        event {
          type = "combat"
          on_complete {
            narration = "陆沉凭借精湛的操作技术，顺利击毁所有入侵的智网机器人，据点守卫战大获全胜"
            exp = 100
          }
        }
      }
      step 4 {
        description = "幸存者爆发欢呼，老周代表全体人员推举陆沉为领袖，表示愿意听从他的指挥行动"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "status"
            field = "role"
            to = "据点领袖"
          }
          on_complete {
            narration = "所有人都心悦诚服，陆沉成为了整个据点的领导者"
            exp = 50
          }
        }
      }
      step 5 {
        description = "陆沉当众说明自己来自一百年前的人类联邦，告知众人联邦主力目前驻守在半人马座阿尔法星，宣布下一步目标是穿过西南戈壁前往南海发射场，驾驶遗留的逐星号远征星舰去找联邦主力，联合反攻夺回人类家园"
        event {
          type = "knowledge"
          on_complete {
            narration = "陆沉的话点燃了所有幸存者的希望，他们终于有了明确的奋斗目标"
            exp = 30
          }
        }
      }
      step 6 {
        description = "两小时后全体幸存者收拾好物资整装待发，据点合金门打开，队伍正式出发：陆沉驾驶灰雀机甲走在最前方，林野带20名战斗人员在两侧护卫，阿柚持生命探测器开路，老周在队伍中间照看老弱"
        event {
          type = "location"
          move {
            to = "loc_wasteland"
          }
          state_delta {
            kind = "time"
            field = "elapsed_hours"
            delta = 2
          }
          on_complete {
            narration = "庞大的幸存者队伍正式踏出据点，踏上了前往南海发射场的路程"
            exp = 30
          }
        }
      }
      step 7 {
        description = "队伍踏入西南戈壁，朝着南海发射场的方向前进，逐星计划正式迈出第一步"
        event {
          type = "status"
          state_delta {
            kind = "status"
            field = "starseeker_plan"
            to = "started"
          }
          on_complete {
            narration = "漫天黄沙中，幸存者队伍坚定地向前走去，人类反攻的号角已经吹响，逐星之路正式开启"
            exp = 100
          }
        }
      }
    }
  }
}