
metadata {
  title = "虫巢远征"
  dsl_version = "0.2.0"
}

characters {
  player "陆沉" {
    id = "char_luchen"
    class = "S级基因进化者/航天工程师"
    str = 16
    agi = 19
    int = 21
    vit = 25
    hp = 250
    mp = 120
  }
  npc "林野" {
    id = "char_linye"
    role = "行动队队长"
    description = "3号幸存者据点行动队队长，作战经验丰富，负责外勤补给与警戒任务"
    default_location = "loc_3rd_survivor_outpost"
  }
  npc "阿柚" {
    id = "char_ayou"
    role = "技术员"
    description = "3号幸存者据点技术员，精通旧时代设备维修与改装"
    default_location = "loc_3rd_survivor_outpost"
  }
  npc "老周" {
    id = "char_laozhou"
    role = "据点负责人"
    description = "3号幸存者据点负责人，左脸有旧疤，左手缺两根手指，经验丰富处事沉稳"
    default_location = "loc_3rd_survivor_outpost"
  }
}

world {
  location "西昌战区地下休眠中心" {
    id = "loc_xichang_cryo_facility"
    description = "大陨落前联邦建造的地下休眠设施，用于保存航天军远征预备人员，停运千年后部分区域暴露"
  }
  location "A级物资储备室" {
    id = "loc_a_level_storage"
    description = "休眠中心配套的A级物资储备库，千年间持续低功率运转，内部物资保存完好"
  }
  location "戈壁废土" {
    id = "loc_gobi_wasteland"
    description = "大陨落后被黄沙覆盖的西昌周边区域，遍布虫族踪迹与旧时代文明遗迹"
  }
  location "3号地下幸存者据点" {
    id = "loc_3rd_survivor_outpost"
    description = "由旧铁路设施改造的地下幸存者据点，现存37名幸存者，是西昌周边仅存的人类据点之一"
  }
  location "西昌旧核电站虫族孵化巢" {
    id = "loc_xichang_nuclear_zerg_nest"
    description = "废弃的旧西昌核电站，三个月前被虫族占领改造为孵化巢，有大量虫族驻守"
  }
  location "地下幸存者据点" {
    id = "loc_underground_shelter"
    description = "人类幸存者躲避虫族与智网威胁的地下据点，配备维修库、医疗室、机甲测试场、防御工事等设施，是幸存者的生存基地。"
  }
  location "旧凉山核电站" {
    id = "loc_liangshan_npp"
    description = "废弃的旧时代核电站，被虫族占据为孵化巢，核心机房内存有高纯度氚晶体，是机甲与防御系统的关键能源。"
  }
  location "旧凉山核电站核心机房" {
    id = "loc_liangshan_npp_core_room"
    description = "旧凉山核电站的密封核心机房，三米厚的安全壳隔绝外部虫族与腐蚀气体，存放有高纯度氚晶体。"
  }
  location "西南戈壁" {
    id = "loc_southwest_gobi"
    description = "废土世界的荒芜戈壁区域，是地下据点通往南海发射场的必经之路，常有虫族与智网部队活动。"
  }
  location "南海发射场" {
    id = "loc_nanhai_launch_site"
    description = "旧人类联邦遗留的航天发射场，存放有「逐星号」远征星舰，是幸存者前往半人马座阿尔法星寻找联邦主力的关键节点。"
  }
  location "废土野外" {
    id = "loc_wasteland"
    description = "人类文明崩溃后的地表世界，满目疮痍，遍布虫族、变异生物与旧时代废墟，辐射尘弥漫，生存环境恶劣。"
  }
}

storyline {
  chapter "休眠仓的冷光" {
    id = "P1-V1-C1"
    objective "从千年休眠中苏醒，探明世界现状，应对首次虫族威胁" {
      step 1 {
        description = "休眠仓冷却系统突然停止运行，仓内温度快速攀升，陆沉从千年深休眠中苏醒，全身肌肉伴随冻僵后的酸痛不适感"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "injury"
            field = "status"
            to = "肌肉酸痛"
            note = "千年深休眠对身体造成侵蚀，行动暂时受限"
          }
        }
      }
      step 2 {
        description = "休眠仓开启按键老化故障，多次按动无响应，陆沉取出提前放在应急储物格的钛合金破拆锥，砸17次砸变形仓门锁扣，撞开仓门离开休眠仓"
        event {
          type = "transition"
          state_delta {
            target = "char_luchen"
            kind = "transition"
            field = "location"
            from = "休眠仓内部"
            to = "休眠中心大厅"
          }
        }
      }
      step 3 {
        description = "陆沉发现地下休眠中心几乎完全停运，仅余少量应急灯照明，墙面电子日历定格在他进入休眠的次日即公元2247年10月16日"
        event {
          type = "knowledge"
          state_delta {
            target = "char_luchen"
            kind = "knowledge"
            field = "time_anomaly"
            to = "休眠中心停运时间极早"
            note = "电子日历停在休眠次日，与原定50年休眠计划严重不符"
          }
        }
      }
      step 4 {
        description = "陆沉在管理员工位抽屉中找到一款民用身份识别手环，开机后虹膜扫描匹配基因成功，确认当前时间为公元3270年（星元327年），自己已休眠1023年"
        event {
          type = "acquire"
          state_delta {
            target = "resource_federal_id_bracelet"
            kind = "resource"
            delta = 1
            note = "获取联邦民用身份识别手环，可匹配军方最高机密基因信息"
          }
          state_delta {
            target = "char_luchen"
            kind = "time"
            field = "timeline_marker"
            to = "公元3270年，已休眠1023年"
            note = "原定休眠50年，实际沉睡超千年"
          }
        }
      }
      step 5 {
        description = "陆沉通过手环历史推送信息获知，人类在他休眠后遭遇虫族入侵，90%地球地表被占领，当前仅余地球、月球、木卫二三个据点，总人口不足3亿濒临灭绝"
        event {
          type = "knowledge"
          state_delta {
            target = "char_luchen"
            kind = "knowledge"
            field = "world_status"
            to = "人类濒临灭绝"
            note = "星元79年虫族入侵，人类退守地下据点近两百年"
          }
        }
      }
      step 6 {
        description = "陆沉在工位中找到刀刃锋利的生锈战术匕首、半盒未过期的高能营养片，分别放在腰带和衣兜中随身携带"
        event {
          type = "acquire"
          state_delta {
            target = "resource_tactical_dagger"
            kind = "resource"
            delta = 1
          }
          state_delta {
            target = "resource_high_energy_nutrition_pills"
            kind = "resource"
            note = "获取半盒高能营养片，可支撑3天生存所需"
          }
        }
      }
      step 7 {
        description = "手环发出热源预警，检测到120米外有未知生命体快速靠近，陆沉确认来者是虫族工蜂，对方已逼近到通道入口处，绿光复眼清晰可见，陆沉握紧战术匕首做好战斗准备"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 1, level = 1}]
          }
        }
      }
    }
  }
  chapter "第一头虫影" {
    id = "P1-V1-C2"
    objective "击杀来袭工蜂，探明自身身体异常，躲避虫族大部队" {
      step 1 {
        description = "陆沉手持从通道壁脱落的废弃支撑钢管，躲在通道拐角躲避未知节肢生物，腕上手环预警高危热源距离仅30米，半人高的泽格虫族工蜂从黑暗中爬出"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 1, level = 1}]
          }
        }
      }
      step 2 {
        description = "工蜂发现陆沉气息后发起猛烈攻击，前肢轻易刺穿三厘米厚的高强度合金墙面，陆沉依靠航天军野战训练的肌肉记忆躲避攻击，用钢管砸中工蜂的一只复眼，激怒工蜂"
        event {
          type = "status"
          state_delta {
            target = "enemy_worker_bee"
            kind = "injury"
            field = "status"
            to = "单眼受损 发狂"
          }
        }
      }
      step 3 {
        description = "发狂的工蜂喷出强腐蚀液，陆沉抬臂阻挡，小臂处的休眠服瞬间碳化，皮肤被严重灼伤溃烂"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "injury"
            field = "status"
            to = "小臂严重腐蚀溃烂"
            note = "虫族腐蚀液毒性极强，普通人类受此伤会直接致命"
          }
        }
      }
      step 4 {
        description = "陆沉忍痛不退，第二次用钢管砸中工蜂剩余的完好复眼，成功将其击杀"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 1, level = 1}]
          }
        }
      }
      step 5 {
        description = "手环扫描工蜂尸体，确认其为泽格虫族最低级作战单位，同时预警其活动区域5公里内大概率存在虫巢，建议立即撤离"
        event {
          type = "knowledge"
          state_delta {
            target = "char_luchen"
            kind = "knowledge"
            field = "zerg_info"
            to = "工蜂为最低级作战单位，附近存在虫巢"
          }
        }
      }
      step 6 {
        description = "陆沉发现自己被严重腐蚀的小臂竟在十几秒内完全自愈，没有留下任何疤痕，联想到休眠时间差、手环匹配军方最高机密基因、扫描时闪过的基因适配度98%的信息，怀疑自己沉睡千年间发生了未知基因变异"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "status"
            delta = 100
            note = "觉醒超高速自愈能力，基因适配度达98%"
          }
        }
      }
      step 7 {
        description = "手环再次发出警报，检测到20只以上的虫族热源正从800米外快速接近，陆沉坚定了活下去、查明真相、驱逐虫族的信念，转身朝着休眠中心的深处走去"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 20, level = 1}]
          }
          state_delta {
            target = "char_luchen"
            kind = "transition"
            field = "goal"
            to = "查清变异真相 驱逐虫族 收复人类家园"
          }
        }
      }
    }
  }
  chapter "基因觉醒" {
    id = "P1-V1-C3"
    objective "获取生存物资，确认自身进化等级，决定救援3号幸存者据点" {
      step 1 {
        description = "陆沉在休眠中心通道躲避后方以每秒3米速度逼近的虫族，定位到700米外无热源的A级物资储备室，持变形支撑钢管轻步前往"
        event {
          type = "transition"
        }
      }
      step 2 {
        description = "陆沉撬开锈死的物资储备室合金门进入，发现室内应急灯、恒温系统仍在低功率运转，物资保存完好"
        event {
          type = "location"
          state_delta {
            target = "loc_a_level_storage"
            kind = "transition"
            field = "access_status"
            to = "已解锁"
          }
        }
      }
      step 3 {
        description = "陆沉开箱清点物资，获得真空压缩干粮、净水片、医疗物资、崭新战术匕首、防腐蚀防护服"
        event {
          type = "acquire"
          state_delta {
            target = "resource_compressed_rations"
            kind = "resource"
            delta = 7
            note = "获取可支撑7天的压缩干粮"
          }
          state_delta {
            target = "resource_water_purification_tablets"
            kind = "resource"
            delta = 2
          }
          state_delta {
            target = "resource_anti_corrosion_suit"
            kind = "resource"
            delta = 1
          }
          state_delta {
            target = "resource_engineering_shovel"
            kind = "resource"
            delta = 1
          }
        }
      }
      step 4 {
        description = "陆沉用战术匕首划伤指尖测试，发现伤口3秒即可完全自愈，手环检测显示其基因活性为普通人类的327%，属于联邦S级进化者序列，自愈能力位列已知进化者前0.1%，确认该基因变异来自千年休眠"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "cultivation"
            field = "gene_level"
            from = "普通人类"
            to = "S级进化者"
            note = "基因活性为普通人类327%，自愈能力位列前0.1%"
          }
        }
      }
      step 5 {
        description = "陆沉听到储备室内老旧广播传来断断续续的求救信号，得知15公里外的发射场外围3号幸存者据点被虫族包围3天，仅剩37人其中12名伤员，随后信号中断"
        event {
          type = "knowledge"
          state_delta {
            target = "char_luchen"
            kind = "knowledge"
            field = "survivor_outpost"
            to = "15公里外3号据点被围 急需救援"
          }
        }
      }
      step 6 {
        description = "陆沉确定自己有能力救援幸存者，当即换好防腐蚀防护服，清点物资，替换更顺手的高强度合金工兵铲"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "transition"
            field = "equipment_status"
            to = "已更换全套外勤装备"
          }
        }
      }
      step 7 {
        description = "虫族逼近至物资储备室不足300米处，陆沉选择走另一侧通往地面的应急通道避开虫族大部队，到达休眠中心地面出口，确认求救信号方向后，毫不犹豫踏入漫天黄沙的戈壁废土，踏上救援征途"
        event {
          type = "transition"
        }
      }
    }
  }
  chapter "黄沙中的求救" {
    id = "P1-V1-C4"
    objective "救援遇袭幸存者小队，前往3号幸存者据点" {
      step 1 {
        description = "陆沉身着联邦防腐蚀防护服在黄沙戈壁中响应急救信号前行，距离信号源11公里时听到前方的枪声、惨叫声与虫族活动声响"
        event {
          type = "knowledge"
          state_delta {
            target = "char_luchen"
            kind = "knowledge"
            field = "nearby_combat"
            to = "前方有人类与虫族战斗"
          }
        }
      }
      step 2 {
        description = "陆沉发现林野、阿柚及一名受伤男队员共三名幸存者被三只工蜂虫围困在岩堆后方"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 3, level = 1}]
          }
        }
      }
      step 3 {
        description = "陆沉利用工蜂颈部神经节无硬壳保护的弱点，绕到后方突袭刺杀了第一只工蜂，林野与阿柚趁剩余两只工蜂分心的空隙配合作战，与陆沉联手仅用三分钟就将三只工蜂全部击杀"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 3, level = 1}]
          }
        }
      }
      step 4 {
        description = "林野、阿柚向陆沉自报身份，阿柚提及据点内存有损坏的初代民用机甲，缺少联邦权限无法修复"
        event {
          type = "relationship"
          state_delta {
            target = "char_luchen,char_linye,char_ayou"
            kind = "status"
            field = "relation_status"
            to = "友好 已结识"
          }
        }
      }
      step 5 {
        description = "林野邀请陆沉前往三公里外的3号地下据点暂避，陆沉同意后拿出随身携带的净水片与压缩干粮分给三名幸存者"
        event {
          type = "resource"
          state_delta {
            target = "resource_compressed_rations"
            kind = "resource"
            delta = -2
          }
          state_delta {
            target = "resource_water_purification_tablets"
            kind = "resource"
            delta = -2
            note = "分给三名幸存者2份干粮与2板净水片"
          }
        }
      }
      step 6 {
        description = "陆沉的联邦手环发出红色警报，检测到1.2公里外有A级虫族单位兵蜂正以每秒8米的速度向当前位置逼近，普通子弹无法击穿兵蜂的甲壳"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_soldier_bee", count = 1, level = 3}]
          }
        }
      }
      step 7 {
        description = "众人立刻向3号据点方向逃跑，陆沉护在受伤队员身后同行，远处西昌发射场的轮廓在风沙中越来越清晰，而3号据点内藏有足以改变整个废土局势的未知秘密"
        event {
          type = "transition"
        }
      }
    }
  }
  chapter "地下据点的秘密" {
    id = "P1-V1-C5"
    objective "了解据点现状，查明机甲故障原因，决定前往虫族巢穴获取维修材料" {
      step 1 {
        description = "陆沉、林野、阿柚带着受伤队员被虫族兵蜂追杀，赶在兵蜂攻破入口前触发密码锁打开合金防爆门逃入据点，关闭的防爆门成功挡下兵蜂的攻击和腐蚀液"
        event {
          type = "transition"
        }
      }
      step 2 {
        description = "据点负责人老周迎接众人，带他们穿行据点内部，可见据点内居住着大量幸存人类，靠捡拾旧时代遗留物资维生；老周向陆沉说明现状：107年前泽格虫族突破太阳系防线，联邦政府苦战12年后带着主力、科研人员和半数平民撤往半人马座殖民星，遗留的幸存者只能躲在地下；如今地球60%区域被虫族占领，剩余区域还有反叛AI集群“智网”游荡捕杀人类，东亚片区仅存不到20个同类幸存者据点"
        event {
          type = "knowledge"
          state_delta {
            target = "char_luchen"
            kind = "knowledge"
            field = "full_world_status"
            to = "联邦撤离 地球仅存少量人类据点 同时受虫族与智网威胁"
          }
        }
      }
      step 3 {
        description = "老周带众人前往机甲仓库，展示半年前挖隧道时出土的初代民用“灰雀”工程机甲，称机甲埋藏近百年外壳完好，但众人维修五个月始终无法启动，修好后将大幅提升据点外勤补给的生存能力和运输效率"
        event {
          type = "knowledge"
          state_delta {
            target = "char_luchen"
            kind = "knowledge"
            field = "grey_sparrow_mech"
            to = "出土初代灰雀工程机甲 故障无法启动"
          }
        }
      }
      step 4 {
        description = "陆沉用自己的旧联邦民用手环扫描机甲能源仓接口，一眼查出故障原因是核心主供电线路老化氧化、接触不良，称自己曾参与灰雀机甲的动力系统测试，完全有能力维修"
        event {
          type = "knowledge"
          state_delta {
            target = "char_luchen"
            kind = "knowledge"
            field = "mech_fault"
            to = "供电线路老化氧化 可维修"
          }
        }
      }
      step 5 {
        description = "林野告知众人维修机甲所需的高纯度氚晶体仅存于十公里外的西昌旧核电站，该核电站三个月前被虫族占领改造成孵化巢，此前据点派出的两支外勤小队全部牺牲无人生还"
        event {
          type = "knowledge"
          state_delta {
            target = "char_luchen"
            kind = "knowledge"
            field = "tritium_location"
            to = "氚晶体位于西昌旧核电站虫族孵化巢"
          }
        }
      }
      step 6 {
        description = "陆沉沉默片刻后主动提出自己愿意前往虫族巢穴获取氚晶体"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "transition"
            field = "next_goal"
            to = "前往虫族孵化巢获取氚晶体 修复灰雀机甲"
          }
        }
      }
    }
  }
  chapter "核电站的魅影" {
    id = "P1-V1-C6"
    objective "前往旧凉山核电站夺取高纯度氚晶体" {
      step 1 {
        description = "陆沉主动提出独自前往被虫族占据为孵化巢的旧凉山核电站寻找氚晶体，遭到林野、阿柚、老周的一致反对，老周提议三人组队提升存活率，陆沉同意方案。"
        event {
          type = "knowledge"
        }
      }
      step 2 {
        description = "三人耗时3小时整理行装，备齐改装防腐蚀防护服、武器、补给及专用工具，趁黎明低温、虫族活跃度低的窗口期出发，步行2小时抵达核电站外围。"
        event {
          type = "location"
        }
      }
      step 3 {
        description = "三人在核电站外围发现此前牺牲的两支外勤队遗骸与虫族残躯，陆沉捡到一块不属于人类装备也不属于虫族甲壳的未知银灰色金属碎片，收进口袋。"
        event {
          type = "acquire"
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "unknown_metal_fragment"
            delta = 1
            note = "捡到未知银灰色金属碎片"
          }
        }
      }
      step 4 {
        description = "阿柚用改装的能量探测器定位到核心机房安全壳下的高纯度氚晶体位置，随后探测器发出警报，探测到至少300只虫族生命信号，有几只正快速靠近。"
        event {
          type = "knowledge"
        }
      }
      step 5 {
        description = "三人躲到混凝土废墟后隐蔽，一只体型是普通工蜂两倍、外骨骼防御力极强的虫族哨兵出现，发出尖锐嘶鸣向巢穴内其他虫族通报三人位置，虫族大部队10分钟内即将抵达。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_sentinel", count = 1, level = 2}]
          }
        }
      }
    }
  }
  chapter "孵化巢的核心" {
    id = "P1-V1-C7"
    objective "击杀拦路虫族哨兵，潜入核心机房夺取氚晶体" {
      step 1 {
        description = "陆沉向林野、阿柚布置作战方案：陆沉吸引哨兵注意力，林野瞄准哨兵复眼开枪，阿柚待哨兵僵直时释放电磁脉冲攻击神经节，虫族大部队8分钟后抵达。"
        event {
          type = "knowledge"
        }
      }
      step 2 {
        description = "陆沉制造动静吸引哨兵注意力，缠斗中防护服被螯爪划开，小臂被腐蚀液溅到，靠基因自愈能力快速恢复。林野抓住时机开枪击穿哨兵左侧复眼，哨兵受创僵直。"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "injury"
            field = "status"
            to = "recovered"
            note = "被腐蚀液溅伤后靠基因自愈能力快速恢复"
          }
        }
      }
      step 3 {
        description = "阿柚按下电磁脉冲棒启动键，脉冲波击中哨兵神经节使其失能，陆沉跃起用战术匕首刺入哨兵神经节，成功将其击杀。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_sentinel", count = 1, level = 2}]
          }
          state_delta {
            target = "enemy_zerg_sentinel"
            kind = "death"
            to = "dead"
            note = "虫族哨兵被击杀"
          }
        }
      }
      step 4 {
        description = "三人找到通风管道入口，清理压在格栅上的混凝土块后进入管道，中途屏住呼吸避开下方巡逻的十余只虫族工蜂，爬完500米管道进入核心机房。"
        event {
          type = "location"
        }
      }
      step 5 {
        description = "三人在主控制台凹槽内发现高纯度氚晶体，陆沉撬开卡扣将晶体取出，放入防辐射密封袋妥善收纳。"
        event {
          type = "acquire"
          state_delta {
            target = "resource_tritium_crystal"
            kind = "resource"
            delta = 1
            note = "获得高纯度氚晶体，可支撑灰雀机甲满负荷运行三个月"
          }
        }
      }
      step 6 {
        description = "陆沉在机房墙角发现被虫族撕毁的智网战斗机器人残骸，读取到其搜寻氚晶体、清除沿途活物的任务信息，意识到智网也在觊觎氚晶体。"
        event {
          type = "knowledge"
        }
      }
      step 7 {
        description = "核心机房突发震动，三百余只虫族将机房团团包围，不断撞击密封门，预计十分钟内即可破门，三人无退路。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_worker", count = 300, level = 1}]
          }
        }
      }
    }
  }
  chapter "死里逃生" {
    id = "P1-V1-C8"
    objective "突破虫族包围，携带氚晶体安全返回地下据点" {
      step 1 {
        description = "陆沉发现备用排气通道直通外侧排风井，安排林野、阿柚携带氚晶体先行撤离，自己留下断后，林野临走前将两枚高爆手雷交给陆沉，约定在出口等10分钟。"
        event {
          type = "knowledge"
        }
      }
      step 2 {
        description = "密封门破裂，十多只工蜂虫涌入机房，陆沉在生死关头解锁一阶基因进化，力量、速度翻五倍，生成皮下银灰色外骨骼，三分钟内击杀全部13只冲进来的工蜂。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_worker", count = 13, level = 1}]
          }
          state_delta {
            target = "char_luchen"
            kind = "breakthrough"
            field = "gene_level"
            from = "普通人类"
            to = "一阶基因进化者"
            note = "生死关头解锁一阶基因进化，力量速度提升五倍，获得皮下外骨骼"
          }
        }
      }
      step 3 {
        description = "陆沉将高爆手雷扔向密封门后虫群，爆炸引发通道坍塌，撤离时发现半吨重混凝土块即将堵死排气通道入口，陆沉拼尽全力挪开石块，顺带砸死几只追来的工蜂。"
        event {
          type = "status"
        }
      }
      step 4 {
        description = "陆沉在通道完全坍塌前爬出排风井，与林野、阿柚汇合，林野引爆预先埋在核电站各处的炸药，将所有追来的虫族封死在坍塌的建筑内。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_zerg_worker", count = 287, level = 1}]
          }
          state_delta {
            target = "enemy_zerg_worker"
            kind = "death"
            to = "dead"
            note = "剩余虫族全部被封死在坍塌的核电站内"
          }
        }
      }
      step 5 {
        description = "阿柚用探测器确认周边三公里内无存活虫族，陆沉检查确认氚晶体完好无损，三人狂奔四十分钟返回地下据点，受到幸存者欢迎，阿柚将氚晶体交给据点负责人。"
        event {
          type = "location"
        }
      }
      step 6 {
        description = "陆沉靠在门框上放松时突然产生强烈眩晕，四肢力气被瞬间抽干，直直向地面晕倒，失去意识前仍记挂着智网的潜在威胁。"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "injury"
            field = "status"
            to = "unconscious"
            note = "基因进化副作用引发眩晕昏迷"
          }
        }
      }
    }
  }
  chapter "灰雀的轰鸣" {
    id = "P1-V1-C9"
    objective "维修启动灰雀机甲，击退入侵据点的智网战斗机器人" {
      step 1 {
        description = "陆沉在据点医疗室苏醒，经阿柚检测确认基因链完全稳定，成功进化为一阶进化者，身体素质大幅提升，此前携带的智网机器人碎片仍保存完好。"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "injury"
            field = "status"
            to = "healthy"
            note = "从昏迷中苏醒，基因进化完全稳定"
          }
        }
      }
      step 2 {
        description = "陆沉提出立刻维修灰雀机甲提升据点安全性，凭借前航天工程师的经验，耗时三小时排查修复机甲所有故障点，将高纯度氚晶体装入机甲能源核心卡槽。"
        event {
          type = "status"
        }
      }
      step 3 {
        description = "灰雀机甲成功启动，陆沉操控机甲完成武器、动力、操作系统全流程性能测试，所有指标全部达标可投入实战，围观幸存者十分振奋。"
        event {
          type = "acquire"
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "灰雀机甲"
            delta = 1
            note = "灰雀机甲维修完成，可投入实战"
          }
        }
      }
      step 4 {
        description = "据点突然拉响红色警报，10台T-7型智网战斗机器人突破外门向内部突进，老周通过广播通知非战斗人员撤入防爆掩体，战斗人员到一号通道集合。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_t7_robot", count = 10, level = 2}]
          }
        }
      }
      step 5 {
        description = "陆沉主动提出操控灰雀机甲正面阻挡入侵的智网机器人，安抚慌乱的人群，林野主动提出带领战斗人员为陆沉打掩护。陆沉操控灰雀机甲停在据点入口通道中央，预热武器做好战斗准备，等待智网机器人到来。"
        event {
          type = "status"
        }
      }
    }
  }
  chapter "逐星的第一步" {
    id = "P1-V1-C10"
    objective "击退入侵的智网机器人，带领幸存者出发前往南海发射场启动逐星号星舰" {
      step 1 {
        description = "10台T-7型智网战斗机器人攻入据点入口大厅，瞄准掩体后的老周及非战斗人员，众人陷入绝境。陆沉操控灰雀机甲冲入大厅，精准击毁三台尚未开火的机器人。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_t7_robot", count = 3, level = 2}]
          }
          state_delta {
            target = "enemy_t7_robot"
            kind = "death"
            to = "dead"
            note = "三台T-7机器人被击毁"
          }
        }
      }
      step 2 {
        description = "剩余7台机器人围攻陆沉，陆沉操控机甲灵活闪避，配合机枪、格斗刃用时不到十分钟击毁全部机器人，据点实现零伤亡。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_t7_robot", count = 7, level = 2}]
          }
          state_delta {
            target = "enemy_t7_robot"
            kind = "death"
            to = "dead"
            note = "剩余七台T-7机器人全部被击毁"
          }
        }
      }
      step 3 {
        description = "幸存者爆发欢呼，老周代表全体人员推举陆沉为领袖，表示愿意听从他的指挥行动。陆沉当众宣布下一步目标是穿过西南戈壁前往南海发射场，驾驶「逐星号」远征星舰寻找联邦主力，联合反攻夺回人类家园。"
        event {
          type = "relationship"
          state_delta {
            target = "char_luchen"
            kind = "status"
            field = "leader_status"
            to = "confirmed"
            note = "陆沉被全体幸存者推举为据点领袖"
          }
        }
      }
      step 4 {
        description = "两小时后全体幸存者收拾好物资整装待发，据点合金门打开，队伍正式出发：陆沉驾驶灰雀机甲走在最前方，林野带20名战斗人员在两侧护卫，阿柚持生命探测器开路，老周在队伍中间照看老弱。"
        event {
          type = "location"
        }
      }
      step 5 {
        description = "队伍踏入西南戈壁，朝着南海发射场的方向前进，逐星计划正式迈出第一步。前路虽有虫族巢穴、智网封锁等未知危险，众人信念坚定，跟随陆沉前行。"
        event {
          type = "plot_thread"
          state_delta {
            target = "plot_recover_homeland"
            kind = "plot_thread"
            field = "status"
            to = "started"
            note = "夺回母星、逐星远征的主线计划正式启动"
          }
        }
      }
    }
  }
}

systems {
}
