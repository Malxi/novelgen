
metadata {
  title = "星骸火种"
  dsl_version = "0.2.0"
}

characters {
  player "林野" {
    id = "char_linye"
    class = "机甲工程师"
    description = "火种机甲核心工程师，百年后苏醒"
    str = 10
    agi = 10
    int = 18
    vit = 12
    hp = 100
    mp = 50
  }
  npc "陆沉" {
    id = "char_luchen"
    role = "进化者/机甲驾驶员"
    description = "百年休眠后苏醒的一阶进化者，前航天工程师"
    default_location = "loc_outpost3"
  }
  npc "苏晴" {
    id = "char_suqing"
    role = "护卫队长"
    description = "青藤据点护卫队长"
    default_location = "loc_qingteng_outpost"
  }
  npc "老周(青藤)" {
    id = "char_laozhou_qingteng"
    role = "维修技工"
    description = "青藤据点维修技工"
    default_location = "loc_qingteng_outpost"
  }
  npc "吴伯" {
    id = "char_wubo"
    role = "守门长老"
    description = "青藤据点守门长老"
    default_location = "loc_qingteng_outpost"
  }
  npc "阿柚" {
    id = "char_ayou"
    role = "技术员"
    description = "3号据点技术员"
    default_location = "loc_outpost3"
  }
  npc "老周(3号据点)" {
    id = "char_laozhou_3"
    role = "据点负责人"
    description = "3号据点负责人"
    default_location = "loc_outpost3"
  }
  npc "林野(3号)" {
    id = "char_linye_3"
    role = "行动队长"
    description = "3号据点行动队队长"
    default_location = "loc_outpost3"
  }
  npc "苏晴" {
    id = "char_suqin"
    role = "护卫队长"
    description = "青藤据点护卫队长，带领勘探队救回林野。身形干练，决策果断。"
    default_location = "loc_qingteng_stronghold"
  }
  npc "老周" {
    id = "char_laozhou"
    role = "维修技工"
    description = "全名周世昌，据点最资深的维修技工，人称‘铁手老周’。识别出林野的铭牌并私藏抑制剂施救。"
    default_location = "loc_qingteng_stronghold"
  }
  npc "老刘" {
    id = "char_laoliu"
    role = "司机"
    description = "青藤据点货车司机，驾驶改装重型货车。"
    default_location = "loc_greenvine_hall"
  }
}

world {
  location "荒骨台休眠仓" {
    id = "loc_cryo_facility"
    description = "百年尘封的地下室，有火种核心和3D打印设备"
  }
  location "青藤据点" {
    id = "loc_qingteng_outpost"
    description = "利用天然地下溶洞扩建的幸存者据点"
  }
  location "3号地下据点" {
    id = "loc_outpost3"
    description = "旧铁路设施改造的地下据点"
  }
  location "西昌旧核电站" {
    id = "loc_nuclear_plant"
    description = "被虫族占据为孵化巢的废弃核电站"
  }
  location "西南戈壁" {
    id = "loc_gobi"
    description = "废土荒漠，通往南海发射场"
  }
  location "据点入口大厅" {
    id = "loc_entry_hall"
    description = "据点最重要的防线"
  }
  location "据点机甲维修库" {
    id = "loc_mech_bay"
    description = "存放灰雀机甲"
  }
  location "青藤据点" {
    id = "loc_qingteng_stronghold"
    description = "利用天然地下溶洞扩建而成的避难据点，入口有隐蔽铸铁门，主厅顶部最高处距地面约十五米，钢制支架撑住岩层，旧式柴油灯照明，青石板地面。物资散落，有金属板条箱、纯机械弹簧弩、柴油发电机等。"
  }
  location "青藤据点主厅" {
    id = "loc_greenvine_hall"
    description = "由天然溶洞扩建而成，钢制支架撑住岩层，柴油灯照明。青石板地面上散落物资：堆叠的金属板条箱、维修到一半的弹簧弩、被拆开的柴油发电机。"
  }
  location "医疗隔离室" {
    id = "loc_medical_room"
    description = "十平方米，混凝土墙，一盏柴油灯，一张铁架床。残骸外骨骼和火种核心靠墙放好。"
  }
  location "指挥中心" {
    id = "loc_command_center"
    description = "设有老旧地图和办公桌，吴伯与苏晴、老周商议地点。"
  }
}

storyline {
  chapter "荒骨苏醒" {
    id = "P1-V1-C1"
    objective "从废墟中存活" {
      step 1 {
        description = "林野从休眠仓苏醒，破拆仓门走出，发现百年后的废墟"
        event {
          type = "location"
          on_complete {
            narration = "林野苏醒在废弃测试场地下"
          }
        }
      }
      step 2 {
        description = "林野找到火种核心，输入基因密码启动，发现已过100年7个月零23天"
        event {
          type = "knowledge"
          on_complete {
            narration = "林野确认沉睡百年"
          }
          state_delta {
            target = "char_linye"
            kind = "time"
            field = "timeline_marker"
            to = "100年7个月零23天"
            note = "计数器显示100年7个月零23天"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "level"
            to = "23"
            note = "normalized from step description"
          }
          state_delta {
            target = "char_linye"
            kind = "mech"
            field = "form"
            to = "林野找到火种核心，输入基因密码启动，发现已过100年7个月零23天"
            note = "normalized from step description"
          }
        }
      }
      step 3 {
        description = "利用3D打印机和废墟金属制造残骸外骨骼，安装低级虫族晶核，激活基因适配程序，稳定性62%"
        event {
          type = "status"
          on_complete {
            narration = "外骨骼组装完成，基因适配合格"
          }
          state_delta {
            target = "char_linye"
            kind = "power_change"
            delta = 50
            note = "基因适配完成，身体素质提升"
          }
          state_delta {
            target = "resource_01"
            kind = "resource"
            field = "item"
            delta = -1
            note = "消耗1枚低级虫族晶核启动外骨骼"
          }
          state_delta {
            target = "char_linye"
            kind = "cultivation"
            field = "稳定"
            from = "0"
            to = "62"
            unit = "%"
            note = "基因适配后稳定性62%"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "level"
            to = "62"
            note = "normalized from progression signal"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "stability"
            to = "62"
            note = "normalized from stability signal"
          }
          state_delta {
            target = "char_linye"
            kind = "mech"
            field = "form"
            to = "消耗1枚低级虫族晶核启动外骨骼"
            note = "normalized from equipment signal"
          }
          state_delta {
            target = "char_linye"
            kind = "mech"
            field = "energy"
            to = "80"
            note = "normalized initial equipment energy"
          }
        }
      }
      step 4 {
        description = "遭遇三只工虫，战斗后击杀全部，但基因稳定性快速下降，昏迷"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 3, level = 1}]
          }
          on_complete {
            narration = "林野击杀三只工虫后晕倒"
          }
          state_delta {
            target = "char_linye"
            kind = "injury"
            field = "status"
            to = "injured"
            note = "基因稳定性下降至接近临界"
          }
          state_delta {
            target = "char_linye"
            kind = "power_change"
            delta = -30
            note = "战斗消耗能量"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "stability"
            to = "injured"
            note = "normalized from stability signal"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "level"
            to = "-30"
            note = "normalized from progression signal"
          }
        }
      }
    }
  }
  chapter "外来者" {
    id = "P1-V1-C3"
    objective "获得据点信任" {
      step 1 {
        description = "苏晴带昏迷的林野和火种核心进入青藤据点，基因检测仪报警"
        event {
          type = "location"
          on_complete {
            narration = "据点警戒"
          }
          state_delta {
            target = "char_linye"
            kind = "risk"
            field = "被怀疑"
            to = "虫族波动"
            note = "检测仪显示63%虫族基因波动"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "level"
            to = "1"
            note = "normalized from step description"
          }
          state_delta {
            target = "char_linye"
            kind = "mech"
            field = "form"
            to = "苏晴带昏迷的林野和火种核心进入青藤据点，基因检测仪报警"
            note = "normalized from step description"
          }
        }
      }
      step 2 {
        description = "苏晴阻止守卫，吴伯下令隔离观察"
        event {
          type = "status"
          on_complete {
            narration = "林野被送入隔离室"
          }
        }
      }
      step 3 {
        description = "老周认出军工铭牌，给林野注射半支基因抑制剂，检测基因适配度77%"
        event {
          type = "status"
          on_complete {
            narration = "老周私藏抑制剂救人"
          }
          state_delta {
            target = "resource_03"
            kind = "resource"
            field = "item"
            note = "消耗半支基因抑制剂"
          }
          state_delta {
            target = "char_linye"
            kind = "cultivation"
            field = "适配度"
            from = "63"
            to = "77"
            unit = "%"
            note = "基因适配度77%"
          }
          state_delta {
            target = "char_linye"
            kind = "status"
            field = "稳定性"
            to = "恢复"
            note = "抑制剂缓解反噬"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "level"
            from = "63"
            to = "77"
            note = "normalized from progression signal"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "stability"
            to = "77"
            note = "normalized from stability signal"
          }
        }
      }
      step 4 {
        description = "老周向吴伯汇报适配度77%，吴伯决定留观察三天"
        event {
          type = "knowledge"
          on_complete {
            narration = "吴伯决定暂时收留林野"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "level"
            to = "77"
            note = "normalized from step description"
          }
        }
      }
    }
  }
  chapter "基因觉醒" {
    id = "P1-V1-C4"
    objective "检测自身进化" {
      step 1 {
        description = "陆沉在储备室寻找物资，测试发现自愈能力，手环检测为S级进化者"
        event {
          type = "status"
          on_complete {
            narration = "陆沉确认自身变成S级进化者"
          }
          state_delta {
            target = "char_luchen"
            kind = "power_change"
            delta = 100
            note = "自愈能力激活，身体素质大幅提升"
          }
          state_delta {
            target = "char_luchen"
            kind = "breakthrough"
            field = "等级"
            from = "普通"
            to = "S级进化者"
            note = "基因变异"
          }
          state_delta {
            target = "char_luchen"
            kind = "gene"
            field = "level"
            from = "普通"
            to = "S级进化者"
            note = "normalized from progression signal"
          }
        }
      }
      step 2 {
        description = "收到来自发射场外围3号据点的求救信号，约37人被困"
        event {
          type = "knowledge"
          on_complete {
            narration = "陆沉决定前往救援"
          }
          state_delta {
            target = "myst_3号据点围困"
            kind = "plot_thread"
            field = "status"
            to = "raised"
            note = "收到求救信号，据点被虫族包围"
          }
        }
      }
      step 3 {
        description = "陆沉穿上防腐蚀防护服，拿起武器，从应急通道出发"
        event {
          type = "location"
          on_complete {
            narration = "陆沉踏入废土"
          }
        }
      }
    }
  }
  chapter "黄沙中的求救" {
    id = "P1-V1-C5"
    objective "响应求救信号" {
      step 1 {
        description = "陆沉突袭杀死一只工蜂"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 1, level = 1}]
          }
          on_complete {
            narration = "击杀一只工蜂"
          }
        }
      }
      step 2 {
        description = "陆沉与林野、阿柚配合击杀剩余两只工蜂"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 2, level = 1}]
          }
          on_complete {
            narration = "三只工蜂全部击杀"
          }
          state_delta {
            target = "char_luchen"
            kind = "relationship"
            field = "认识"
            from = "无"
            to = "林野小队"
            note = "救下三人"
          }
        }
      }
      step 3 {
        description = "林野自报身份，邀请陆沉去据点，陆沉拿出干粮"
        event {
          type = "status"
          on_complete {
            narration = "林野邀请陆沉"
          }
          state_delta {
            target = "resource_01"
            kind = "resource"
            field = "item"
            delta = -2
            note = "给林野两包压缩干粮"
          }
        }
      }
      step 4 {
        description = "手环检测到兵蜂接近，众人向3号据点逃跑"
        event {
          type = "location"
          combat {
            enemies = [{id = "enemy_soldier_bee", count = 1, level = 2}]
          }
          on_complete {
            narration = "众人逃往据点，兵蜂追击"
          }
        }
      }
    }
  }
  chapter "地下据点的秘密" {
    id = "P1-V1-C6"
    objective "了解据点情况" {
      step 1 {
        description = "众人成功逃入3号据点，防爆门挡住兵蜂"
        event {
          type = "location"
          on_complete {
            narration = "安全进入据点"
          }
        }
      }
      step 2 {
        description = "老周介绍地球现状：107年前虫族入侵，联邦撤走，地球60%被占"
        event {
          type = "knowledge"
          on_complete {
            narration = "陆沉了解现状"
          }
          state_delta {
            target = "char_luchen"
            kind = "knowledge"
            field = "地球现状"
            to = "虫族占领60%"
          }
        }
      }
      step 3 {
        description = "老周展示灰雀机甲，陆沉扫描发现主电源线路老化"
        event {
          type = "knowledge"
          on_complete {
            narration = "陆沉确认能修好机甲"
          }
          state_delta {
            target = "char_linye"
            kind = "mech"
            field = "form"
            to = "老周展示灰雀机甲，陆沉扫描发现主电源线路老化"
            note = "normalized from step description"
          }
        }
      }
      step 4 {
        description = "林野告知氚晶体需到十公里外被虫族占领的核电站获取，此前两队全灭"
        event {
          type = "knowledge"
          state_delta {
            target = "myst_nuclear_plant"
            kind = "plot_thread"
            field = "status"
            to = "raised"
            note = "氚晶体在核电站，危险"
          }
        }
      }
      step 5 {
        description = "陆沉决定独自前往核电站"
        event {
          type = "status"
          on_complete {
            narration = "陆沉出发"
          }
        }
      }
    }
  }
  chapter "核电站的魅影" {
    id = "P1-V1-C7"
    objective "潜入核电站" {
      step 1 {
        description = "老周要求组队，陆沉、林野、阿柚三人凌晨出发前往核电站"
        event {
          type = "location"
          on_complete {
            narration = "出发"
          }
        }
      }
      step 2 {
        description = "在核电站外围发现前两支外勤队遗骸和一块银灰色金属碎片"
        event {
          type = "knowledge"
          state_delta {
            target = "char_luchen"
            kind = "item"
            field = "智网碎片"
            to = "获得"
            note = "捡到智网机器人碎片"
          }
        }
      }
      step 3 {
        description = "阿柚用探测器定位到核心机房内的高纯度氚晶体"
        event {
          type = "knowledge"
          on_complete {
            narration = "找到目标位置"
          }
        }
      }
      step 4 {
        description = "探测器警报，发现至少300只虫族生命信号，一只虫族哨兵从废墟跳下并发出警报"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_sentinel", count = 1, level = 2}]
          }
          on_complete {
            narration = "哨兵发出警报，虫族大军将至"
          }
          state_delta {
            target = "char_luchen"
            kind = "risk"
            field = "被发现"
            to = "虫族警报"
          }
        }
      }
    }
  }
  chapter "孵化巢的核心" {
    id = "P1-V1-C8"
    objective "夺取氚晶体" {
      step 1 {
        description = "陆沉战术指挥，三人配合击杀虫族哨兵"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_sentinel", count = 1, level = 2}]
          }
          on_complete {
            narration = "哨兵击杀"
          }
          state_delta {
            target = "char_luchen"
            kind = "power_change"
            delta = 10
            note = "击杀哨兵"
          }
        }
      }
      step 2 {
        description = "三人通过通风管道进入核心机房"
        event {
          type = "location"
          on_complete {
            narration = "进入核心机房"
          }
        }
      }
      step 3 {
        description = "阿柚定位氚晶体，陆沉将其取出放入密封袋"
        event {
          type = "item"
          on_complete {
            narration = "获取氚晶体"
          }
          state_delta {
            target = "tritium_crystal"
            kind = "resource"
            field = "item"
            delta = 1
            note = "获得高纯度氚晶体"
          }
        }
      }
      step 4 {
        description = "陆沉发现被虫族撕毁的智网战斗机器人残骸，读取到也在搜寻氚晶体"
        event {
          type = "knowledge"
          on_complete {
            narration = "发现智网威胁"
          }
          state_delta {
            target = "myst_智网"
            kind = "plot_thread"
            field = "status"
            to = "raised"
            note = "智网也在搜集氚晶体"
          }
        }
      }
      step 5 {
        description = "核心机房外被数百虫族包围，密封门即将被攻破"
        event {
          type = "location"
          on_complete {
            narration = "无路可退"
          }
          state_delta {
            target = "char_luchen"
            kind = "risk"
            field = "被围"
            to = "三百只虫族"
          }
        }
      }
    }
  }
  chapter "死里逃生" {
    id = "P1-V1-C9"
    objective "突围返回" {
      step 1 {
        description = "陆沉发现备用排气通道，安排林野和阿柚带着氚晶体先撤，自己断后"
        event {
          type = "status"
          on_complete {
            narration = "决定断后"
          }
        }
      }
      step 2 {
        description = "密封门破裂，13只工蜂涌入，陆沉在危机中解锁一阶基因进化，力量速度翻五倍，生成皮下外骨骼，三分钟内击杀全部工蜂"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 13, level = 1}]
          }
          on_complete {
            narration = "击杀13只工蜂，进化一阶"
          }
          state_delta {
            target = "char_luchen"
            kind = "breakthrough"
            field = "基因等级"
            from = "0"
            to = "1"
            note = "一阶进化解锁"
          }
          state_delta {
            target = "char_luchen"
            kind = "power_change"
            delta = 200
            note = "进化后战力飙升"
          }
          state_delta {
            target = "char_luchen"
            kind = "gene"
            field = "level"
            from = "0"
            to = "1"
            note = "normalized from progression signal"
          }
          state_delta {
            target = "char_linye"
            kind = "mech"
            field = "form"
            to = "密封门破裂，13只工蜂涌入，陆沉在危机中解锁一阶基因进化，力量速度翻五倍，生成皮下外骨骼，三分钟内击杀全部工蜂"
            note = "normalized from step description"
          }
        }
      }
      step 3 {
        description = "陆沉将两枚高爆手雷扔向虫群，通道开始坍塌，陆沉用进化后的力量举起半吨重混凝土块挪开，从排气通道爬出"
        event {
          type = "status"
          on_complete {
            narration = "逃出核电站"
          }
          state_delta {
            target = "char_luchen"
            kind = "injury"
            field = "肩膀"
            to = "划伤"
            note = "被碎石划伤，但自愈"
          }
        }
      }
      step 4 {
        description = "林野引爆炸药，封死核电站，三人在排风井出口汇合"
        event {
          type = "location"
          on_complete {
            narration = "汇合"
          }
        }
      }
      step 5 {
        description = "返回据点的路上陆沉注意到西北高地银灰色光点，返回据点后向老周交付氚晶体，然后晕倒"
        event {
          type = "status"
          on_complete {
            narration = "陆沉晕倒"
          }
          state_delta {
            target = "tritium_crystal"
            kind = "resource"
            field = "item"
            note = "安全带回"
          }
          state_delta {
            target = "char_luchen"
            kind = "injury"
            field = "状态"
            to = "晕倒"
            note = "体力透支"
          }
        }
      }
    }
  }
  chapter "灰雀的轰鸣" {
    id = "P1-V1-C10"
    objective "修复机甲并迎敌" {
