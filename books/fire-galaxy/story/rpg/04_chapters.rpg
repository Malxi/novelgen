  chapter "外来者" {
    id = "P1-V1-C2"
    objective "确认林野安全并决定去留" {
      step 1 {
        description = "改装重型货车抵达青藤据点入口，吴伯开门后货车进入主厅，基因稳定性检测仪因林野身上的虫族基因波动发出警报，守卫紧张戒备。"
        event {
          type = "location"
          state_delta {
            target = "char_wubo"
            kind = "status"
            field = "alert"
            to = "high"
            note = "检测仪报警，守卫拉弓示警"
          }
          state_delta {
            target = "char_wubo"
            kind = "gene"
            field = "stability"
            to = "high"
            note = "normalized from stability signal"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "level"
            to = "1"
            note = "normalized from step description"
          }
        }
      }
      step 2 {
        description = "苏晴拦住守卫，向吴伯解释林野是从荒骨台救回的昏迷者。吴伯下令将林野抬入医疗隔离室。老周在林野口袋中发现2236年旧时代军工铭牌（编号LS-AD-0037），判断其来自旧人类军工核心阶层。随后老周取出私藏的半支基因抑制剂为林野注射，缓解其基因反噬。"
        event {
          type = "status"
          state_delta {
            target = "gene_inhibitor"
            kind = "resource"
            field = "item"
            delta = -1
            note = "老周使用私藏的半支基因抑制剂注射林野"
          }
          state_delta {
            target = "char_laozhou"
            kind = "knowledge"
            field = "observation"
            to = "发现旧时代军工铭牌LS-AD-0037"
            note = "老周认出铭牌属于2236年青藤军工厂甲级技师"
          }
          state_delta {
            target = "char_linye"
            kind = "injury"
            field = "status"
            to = "treated"
            note = "注射抑制剂后反噬缓解"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "level"
            to = "0037"
            note = "normalized from step description"
          }
        }
      }
      step 3 {
        description = "抑制剂在林野体内生效，基因稳定性从61%回升至63%，同时他在意识深处短暂觉醒基因感知能力，感受到自身基因链网络的流动。"
        event {
          type = "status"
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "stability"
            from = "61%"
            to = "63%"
            delta = 2
            note = "抑制剂作用下回升2个百分点"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "perception"
            to = "awakened"
            note = "短暂觉醒基因感知能力，可内视基因链网络"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "level"
            to = "63"
            note = "normalized from step description"
          }
        }
      }
      step 4 {
        description = "老周使用据点的旧式基因扫描仪检测林野的基因适配度，指针停在77%，远超据点任何人。老周确认设备无误后震惊不已。"
        event {
          type = "knowledge"
          state_delta {
            target = "char_laozhou"
            kind = "knowledge"
            field = "observation"
            to = "基因适配度77%"
            note = "检测三次确认，设备正常"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "affinity"
            to = "77%"
            note = "远超据点最高21%"
          }
          state_delta {
            target = "char_linye"
            kind = "gene"
            field = "level"
            to = "77"
            note = "normalized from step description"
          }
        }
      }
      step 5 {
        description = "老周将检测结果和铭牌信息告知苏晴和吴伯。吴伯权衡后决定暂时留下林野观察三天，由老保管火种核心，并警告如有威胁将驱逐。苏晴松了口气。"
        event {
          type = "status"
          state_delta {
            target = "char_wubo"
            kind = "status"
            field = "decision"
            to = "留三天观察"
            note = "基于基因适配度和旧时代身份判断"
          }
          state_delta {
            target = "char_suqing"
            kind = "status"
            field = "relief"
            to = "true"
            note = "林野暂时安全"
          }
          state_delta {
            target = "fire_seed_core"
            kind = "item"
            field = "possession"
            to = "char_laozhou"
            note = "火种核心由老周保管"
          }
          state_delta {
            target = "fire_seed_core"
            kind = "mech"
            field = "form"
            to = "char_laozhou"
            note = "normalized from equipment signal"
          }
          state_delta {
            target = "fire_seed_core"
            kind = "mech"
            field = "energy"
            to = "80"
            note = "normalized initial equipment energy"
          }
        }
      }
    }
  }
