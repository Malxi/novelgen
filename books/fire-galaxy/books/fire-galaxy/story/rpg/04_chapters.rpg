
metadata {
  title = "逐星"
  genre = ["科幻", "废土求生", "虫族", "机甲", "基因进化", "AI", "机器人", "宇宙远征"]
  tone = "史诗感"
  dsl_version = "0.2.0"
}

characters {
  player "陆沉" {
    id = "char_luchen"
    class = "S级进化者/前航天军少校"
    str = 15
    agi = 18
    int = 16
    vit = 22
    hp = 150
    mp = 80
  }
  npc "林野" {
    id = "char_linye"
    role = "行动队队长"
    description = "3号据点行动队队长，战斗力强，负责带领外勤小队外出寻找补给，性格直爽重情义"
    default_location = "loc_3rd_survivor_outpost"
  }
  npc "阿柚" {
    id = "char_ayou"
    role = "技术员"
    description = "3号据点技术员，擅长维修电子设备和机械，性格活泼好奇心强"
    default_location = "loc_3rd_survivor_outpost"
  }
  npc "老周" {
    id = "char_laozhou"
    role = "据点负责人"
    description = "3号据点负责人，左脸有旧疤左手缺两根手指，性格沉稳负责，带领据点幸存者求生"
    default_location = "loc_3rd_survivor_outpost"
  }
  npc "老周" {
    id = "char_lao_zhou"
    role = "据点管理者"
    description = "五十多岁的地下据点负责人，性格沉稳负责，带领幸存者在地下躲避了三年，信任陆沉。"
    default_location = "loc_underground_bunker"
  }
  npc "林野" {
    id = "char_lin_ye"
    role = "战斗人员队长"
    description = "年轻的据点战斗人员，左腿有旧伤，熟悉旧凉山核电站周边路线，作战勇猛，忠心跟随陆沉。"
    default_location = "loc_underground_bunker"
  }
}

world {
  location "废土世界" {
    id = "loc_wasteland"
    description = "危机四伏的未来世界，充满虫族和废墟，满目疮痍的大地，废弃的城市遗迹，辐射尘弥漫的天空，压抑危险充满未知恐惧，曾经是人类繁荣的文明世界，因灾难变成废土，栖息着虫族、变异生物、幸存者"
  }
  location "休眠仓设施" {
    id = "loc_cryo_facility"
    description = "主角醒来的废弃冬眠设施，半埋在地下的圆形建筑，外表布满锈迹和藤蔓，神秘寂静时间凝固的感觉，建于灾难前用于保存人类火种，设施内可能还有其他冬眠者或重要资料"
  }
  location "3号地下幸存者据点" {
    id = "loc_3rd_survivor_outpost"
    description = "位于沙漠边缘由旧铁路设施改造的人类地下据点，包含入口隧道、内部居住区、调度室改建的会议室、旧铁路维修站改建的机甲仓库，现存37名幸存者，12名伤员"
  }
  location "西昌旧核电站" {
    id = "loc_xichang_nuclear_plant"
    description = "距离3号据点10公里的旧时代核电站，三个月前被虫族占领改造成孵化巢，储存有高纯度氚晶体"
  }
  location "地下幸存者据点" {
    id = "loc_underground_bunker"
    description = "人类幸存者藏身的地下据点，包含维修库、装备室、医疗室、机甲维修库、测试场、入口大厅等区域，是幸存者的临时生存基地。"
  }
  location "旧凉山核电站" {
    id = "loc_liangshan_npp"
    description = "废弃的旧时代核电站，被虫族占据为孵化巢，核心机房内存有高纯度氚晶体，曾有两队外勤队在此牺牲。"
  }
  location "西南戈壁" {
    id = "loc_southwest_gobi"
    description = "废土世界的戈壁区域，是从地下据点前往南海发射场的必经之路，栖息有虫族，环境恶劣。"
  }
}

storyline {
  chapter "休眠仓的冷光" {
    id = "P1-V1-C1"
    objective "从休眠仓苏醒，了解当前世界现状，应对首次虫族威胁" {
      step 1 {
        description = "休眠仓冷却系统突然停止运行，仓内温度快速攀升，陆沉从千年深休眠中苏醒，身体伴随肌肉酸痛的不适感"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "status"
            field = "consciousness"
            from = "hibernating"
            to = "awake"
            note = "从1023年深休眠中苏醒，全身肌肉酸痛"
          }
        }
      }
      step 2 {
        description = "休眠仓开启按键老化故障，多次按动无响应，陆沉取出提前放在应急储物格的钛合金破拆锥，砸了17次砸变形仓门锁扣，撞开仓门离开休眠仓"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "item"
            delta = 1
            unit = "钛合金破拆锥"
          }
        }
      }
      step 3 {
        description = "陆沉发现地下休眠中心几乎完全停运，仅余少量应急灯照明，墙面电子日历定格在他进入休眠的次日即公元2247年10月16日"
        event {
          type = "knowledge"
          state_delta {
            target = "thread_time_anomaly"
            kind = "plot_thread"
            field = "status"
            to = "raised"
            note = "电子日历定格在休眠次日，休眠中心停运时间存疑"
          }
        }
      }
      step 4 {
        description = "陆沉在管理员工位抽屉中找到一款民用身份识别手环，开机后虹膜扫描匹配基因成功，确认当前时间为公元3270年（星元327年），自己已休眠1023年"
        event {
          type = "acquire"
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "item"
            delta = 1
            unit = "联邦民用身份识别手环"
          }
          state_delta {
            kind = "time"
            field = "elapsed_years"
            delta = 1023
            note = "确认已休眠1023年，时间线与预期严重不符"
          }
        }
      }
      step 5 {
        description = "陆沉通过手环历史推送信息获知，人类在他休眠后遭遇虫族入侵，90%地球地表被占领，当前仅余地球、月球、木卫二三个据点，总人口不足3亿濒临灭绝"
        event {
          type = "knowledge"
          state_delta {
            target = "thread_zerg_invasion"
            kind = "plot_thread"
            field = "status"
            to = "raised"
            note = "人类遭遇虫族入侵，濒临灭绝"
          }
        }
      }
      step 6 {
        description = "陆沉在工位中找到刀刃锋利的生锈战术匕首、半盒未过期的高能营养片，分别放在腰带和衣兜中随身携带"
        event {
          type = "acquire"
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "item"
            delta = 1
            unit = "生锈战术匕首"
          }
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "item"
            delta = 1
            unit = "半盒高能营养片"
          }
        }
      }
      step 7 {
        description = "手环发出热源预警，检测到120米外有未知生命体快速靠近，陆沉确认来者是虫族工蜂，对方已逼近到通道入口处，绿光复眼清晰可见"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 1, level = 1}]
          }
        }
      }
    }
  }
  chapter "第一头虫影" {
    id = "P1-V1-C2"
    objective "击杀来袭的虫族工蜂，发现自身基因变异的秘密，躲避虫族大部队" {
      step 1 {
        description = "陆沉手持从通道壁脱落的废弃支撑钢管，躲在通道拐角躲避未知节肢生物，腕上手环预警高危热源距离仅30米"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "item"
            delta = 1
            unit = "废弃支撑钢管"
          }
        }
      }
      step 2 {
        description = "半人高的泽格虫族工蜂从黑暗中爬出，发现陆沉的气息后发起猛烈攻击，前肢轻易刺穿三厘米厚的高强度合金墙面"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 1, level = 1}]
          }
        }
      }
      step 3 {
        description = "陆沉依靠航天军野战训练的肌肉记忆躲避攻击，用钢管砸中工蜂的一只复眼，激怒了工蜂"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 1, level = 1}]
          }
        }
      }
      step 4 {
        description = "发狂的工蜂喷出强腐蚀液，陆沉抬臂阻挡，小臂处的休眠服瞬间碳化，皮肤被严重灼伤溃烂"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "injury"
            field = "status"
            from = "normal"
            to = "severe_corrosion_burn"
            note = "左臂被虫族腐蚀液严重灼伤"
          }
        }
      }
      step 5 {
        description = "陆沉忍痛不退，第二次用钢管砸中工蜂剩余的完好复眼，成功将其击杀"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 1, level = 1}]
          }
          state_delta {
            target = "enemy_worker_bee"
            kind = "death"
            note = "虫族工蜂被击杀"
          }
        }
      }
      step 6 {
        description = "手环扫描工蜂尸体，确认其为泽格虫族最低级作战单位，同时预警其活动区域5公里内大概率存在虫巢，建议立即撤离"
        event {
          type = "knowledge"
        }
      }
      step 7 {
        description = "陆沉发现自己被严重腐蚀的小臂竟在十几秒内完全自愈，没有留下任何疤痕，对自身的异常感到震惊"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "injury"
            field = "status"
            from = "severe_corrosion_burn"
            to = "recovered"
            note = "左臂灼伤十几秒内完全自愈，无疤痕残留"
          }
          state_delta {
            target = "thread_gene_mutation"
            kind = "plot_thread"
            field = "status"
            to = "raised"
            note = "身体出现未知超强自愈能力，疑似基因变异"
          }
        }
      }
      step 8 {
        description = "陆沉联想到休眠时间差、手环匹配军方最高机密基因、扫描时闪过的基因适配度98%的信息，怀疑自己沉睡千年间发生了未知基因变异"
        event {
          type = "knowledge"
        }
      }
      step 9 {
        description = "手环再次发出警报，检测到20只以上的虫族热源正从800米外快速接近"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 20, level = 1}]
          }
        }
      }
      step 10 {
        description = "陆沉坚定了活下去、查明真相、驱逐虫族的信念，转身朝着休眠中心的深处走去"
        event {
          type = "status"
        }
      }
    }
  }
  chapter "基因觉醒" {
    id = "P1-V1-C3"
    objective "获取物资，确认自身进化者身份，响应幸存者求救信号踏上征途" {
      step 1 {
        description = "陆沉在休眠中心通道躲避后方以每秒3米速度逼近的虫族，定位到700米外无热源的A级物资储备室，持变形支撑钢管轻步前往"
        event {
          type = "status"
        }
      }
      step 2 {
        description = "陆沉撬开锈死的物资储备室合金门进入，发现室内应急灯、恒温系统仍在低功率运转，物资保存完好"
        event {
          type = "location"
        }
      }
      step 3 {
        description = "陆沉开箱清点物资，获得真空压缩干粮、净水片、医疗物资、崭新战术匕首、防腐蚀防护服"
        event {
          type = "acquire"
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "item"
            delta = 7
            unit = "真空压缩干粮"
          }
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "item"
            delta = 2
            unit = "净水片"
          }
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "item"
            delta = 1
            unit = "崭新战术匕首"
          }
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "item"
            delta = 1
            unit = "防腐蚀防护服"
          }
        }
      }
      step 4 {
        description = "陆沉用战术匕首划伤指尖测试，发现伤口3秒即可完全自愈，手环检测显示其基因活性为普通人类的327%，属于联邦S级进化者序列，自愈能力位列已知进化者前0.1%，确认该基因变异来自千年休眠"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "breakthrough"
            field = "evolution_level"
            from = "ordinary_human"
            to = "s_class_evolver"
            note = "基因活性为普通人类327%，自愈能力位列已知进化者前0.1%"
          }
        }
      }
      step 5 {
        description = "陆沉听到储备室内老旧广播传来断断续续的求救信号，得知15公里外的发射场外围3号幸存者据点被虫族包围3天，仅剩37人其中12名伤员，随后信号中断"
        event {
          type = "knowledge"
          state_delta {
            target = "thread_survivor_rescue"
            kind = "plot_thread"
            field = "status"
            to = "raised"
            note = "15公里外3号幸存者据点被虫族包围，危在旦夕"
          }
        }
      }
      step 6 {
        description = "陆沉确定自己有能力救援幸存者，当即换好防腐蚀防护服，清点物资，替换更顺手的高强度合金工兵铲"
        event {
          type = "status"
          state_delta {
            target = "char_luchen"
            kind = "resource"
            field = "item"
            delta = 1
            unit = "高强度合金工兵铲"
          }
        }
      }
      step 7 {
        description = "虫族逼近至物资储备室不足300米处，陆沉选择走另一侧通往地面的应急通道避开虫族大部队"
        event {
          type = "move"
        }
      }
      step 8 {
        description = "陆沉到达休眠中心地面出口，确认求救信号方向后，毫不犹豫踏入漫天黄沙的戈壁废土，踏上救援征途"
        event {
          type = "status"
        }
      }
    }
  }
  chapter "黄沙中的求救" {
    id = "P1-V1-C4"
    objective "营救被困幸存者，前往3号地下据点，遭遇兵蜂追杀" {
      step 1 {
        description = "陆沉身着联邦防腐蚀防护服在黄沙戈壁中响应急救信号前行，距离信号源11公里时听到前方的枪声、惨叫声与虫族活动声响"
        event {
          type = "status"
        }
      }
      step 2 {
        description = "陆沉发现林野、阿柚及一名受伤男队员共三名幸存者被三只工蜂虫围困在岩堆后方"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 3, level = 1}]
          }
        }
      }
      step 3 {
        description = "陆沉利用工蜂颈部神经节无硬壳保护的弱点，绕到后方突袭刺杀了第一只工蜂"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 3, level = 1}]
          }
          state_delta {
            target = "enemy_worker_bee"
            kind = "death"
            note = "第一只工蜂被突袭击杀"
          }
        }
      }
      step 4 {
        description = "林野与阿柚趁剩余两只工蜂分心的空隙配合作战，与陆沉联手仅用三分钟就将三只工蜂全部击杀"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 2, level = 1}]
          }
          state_delta {
            target = "enemy_worker_bee"
            kind = "death"
            note = "剩余两只工蜂被联手击杀"
          }
        }
      }
      step 5 {
        description = "林野、阿柚向陆沉自报身份，阿柚提及据点内存有损坏的初代民用机甲，缺少联邦权限无法修复"
        event {
          type = "knowledge"
        }
      }
      step 6 {
        description = "林野邀请陆沉前往三公里外的3号地下据点暂避，陆沉同意后拿出随身携带的净水片与压缩干粮分给三名幸存者"
        event {
          type = "status"
        }
      }
      step 7 {
        description = "陆沉的联邦手环发出红色警报，检测到1.2公里外有A级虫族单位兵蜂正以每秒8米的速度向当前位置逼近，普通子弹无法击穿兵蜂的甲壳"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_soldier_bee", count = 1, level = 3}]
          }
        }
      }
      step 8 {
        description = "众人立刻向3号据点方向逃跑，陆沉护在受伤队员身后同行，远处西昌发射场的轮廓在风沙中越来越清晰，而3号据点内藏有足以改变整个废土局势的未知秘密"
        event {
          type = "move"
        }
      }
    }
  }
  chapter "地下据点的秘密" {
    id = "P1-V1-C5"
    objective "了解据点现状，发现灰雀机甲，主动前往虫族巢穴获取维修材料" {
      step 1 {
        description = "陆沉、林野、阿柚带着受伤队员被虫族兵蜂追杀，赶在兵蜂攻破入口前触发密码锁打开合金防爆门逃入据点，关闭的防爆门成功挡下兵蜂的攻击和腐蚀液"
        event {
          type = "location"
        }
      }
      step 2 {
        description = "据点负责人老周迎接众人，带他们穿行据点内部，可见据点内居住着大量幸存人类，靠捡拾旧时代遗留物资维生"
        event {
          type = "knowledge"
        }
      }
      step 3 {
        description = "老周向休眠了一百年的陆沉说明现状：107年前泽格虫族突破太阳系防线，联邦政府苦战12年后带着主力、科研人员和半数平民撤往半人马座殖民星，遗留的幸存者只能躲在地下；如今地球60%区域被虫族占领，剩余区域还有反叛AI集群‘智网’游荡捕杀人类，东亚片区仅存不到20个同类幸存者据点"
        event {
          type = "knowledge"
        }
      }
      step 4 {
        description = "老周带众人前往机甲仓库，展示半年前挖隧道时出土的初代民用‘灰雀’工程机甲，称机甲埋藏近百年外壳完好，但众人维修五个月始终无法启动，修好后将大幅提升据点外勤补给的生存能力和运输效率"
        event {
          type = "knowledge"
        }
      }
      step 5 {
        description = "陆沉用自己的旧联邦民用手环扫描机甲能源仓接口，一眼查出故障原因是核心主供电线路老化氧化、接触不良，称自己曾参与灰雀机甲的动力系统测试，完全有能力维修"
        event {
          type = "knowledge"
        }
      }
      step 6 {
        description = "林野告知众人维修机甲所需的高纯度氚晶体仅存于十公里外的西昌旧核电站，该核电站三个月前被虫族占领改造成孵化巢，此前据点派出的两支外勤小队全部牺牲无人生还"
        event {
          type = "knowledge"
          state_delta {
            target = "thread_tritium_mission"
            kind = "plot_thread"
            field = "status"
            to = "raised"
            note = "维修机甲需要的氚晶体位于虫族占领的西昌旧核电站孵化巢"
          }
        }
      }
      step 7 {
        description = "陆沉沉默片刻后主动提出自己愿意前往虫族巢穴获取氚晶体"
        event {
          type = "status"
        }
      }
    }
  }
  chapter "核电站的魅影" {
    id = "P1-V1-C6"
    objective "前往旧凉山核电站获取高纯度氚晶体" {
      step 1 {
        description = "陆沉主动提出独自前往被虫族占据为孵化巢的旧凉山核电站寻找氚晶体，遭到林野、阿柚、老周的一致反对，老周提出三人组队方案，陆沉同意。"
        event {
          type = "knowledge"
        }
      }
      step 2 {
        description = "三人耗时3小时整理行装，备齐改装防腐蚀防护服、武器、补给及专用工具，于黎明虫族活跃度最低的窗口期出发。"
        event {
          type = "acquire"
        }
      }
      step 3 {
        description = "三人步行2小时抵达旧凉山核电站外围，发现此前牺牲的两支外勤队遗骸与虫族残躯，陆沉捡到一块未知银灰色金属碎片。"
        event {
          type = "knowledge"
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            to = "unknown_metal_fragment"
            delta = 1
          }
        }
      }
      step 4 {
        description = "阿柚用改装能量探测器定位到核心机房内的高纯度氚晶体，随后探测器发出警报，探测到至少300只虫族生命信号，数只正朝三人靠近。"
        event {
          type = "knowledge"
        }
      }
      step 5 {
        description = "三人躲到混凝土废墟后隐蔽，一只体型是普通工蜂两倍的虫族哨兵出现，发出嘶鸣向巢穴通报三人位置，陷入九死一生险境。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_sentinel", count = 1, level = 5}]
          }
        }
      }
    }
  }
  chapter "孵化巢的核心" {
    id = "P1-V1-C7"
    objective "击杀虫族哨兵，潜入核心机房获取氚晶体" {
      step 1 {
        description = "陆沉布置作战方案，让林野瞄准哨兵复眼射击，阿柚伺机释放电磁脉冲攻击神经节，自己吸引哨兵注意力。"
        event {
          type = "status"
        }
      }
      step 2 {
        description = "陆沉吸引哨兵注意力，缠斗中防护服被划开，小臂被腐蚀液溅到，靠基因自愈能力快速恢复。林野开枪击穿哨兵左侧复眼，哨兵受创僵直。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_sentinel", count = 1, level = 5}]
          }
          state_delta {
            target = "char_lu_chen"
            kind = "injury"
            field = "status"
            from = "normal"
            to = "minor_injury"
          }
        }
      }
      step 3 {
        description = "阿柚释放电磁脉冲击中哨兵神经节使其失能，陆沉跃起用战术匕首刺入哨兵神经节，成功击杀哨兵。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_sentinel", count = 1, level = 5}]
          }
        }
      }
      step 4 {
        description = "三人沿通风管道潜入核心机房，中途屏住呼吸避开下方巡逻的十余只工蜂，成功抵达核心密封机房。"
        event {
          type = "location"
        }
      }
      step 5 {
        description = "三人在主控制台凹槽内发现高纯度氚晶体，陆沉取出晶体妥善放入防辐射密封袋收纳。"
        event {
          type = "acquire"
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            to = "high_purity_tritium_crystal"
            delta = 1
          }
        }
      }
      step 6 {
        description = "陆沉发现墙角被虫族撕毁的智网战斗机器人残骸，读取到其搜寻氚晶体、清除活物的任务信息，意识到智网也在抢夺该资源。"
        event {
          type = "knowledge"
          state_delta {
            target = "plot_thread_zhineng_threat"
            kind = "plot_thread"
            field = "status"
            to = "raised"
            note = "智网势力也在抢夺高纯度氚晶体，对人类据点构成潜在威胁。"
          }
        }
      }
      step 7 {
        description = "核心机房突发震动，三百余只虫族将机房团团包围，不断撞击密封门，预计十分钟内即可破门，三人陷入绝境。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 300, level = 2}]
          }
        }
      }
    }
  }
  chapter "死里逃生" {
    id = "P1-V1-C8"
    objective "携带氚晶体突破虫族包围，安全返回地下据点" {
      step 1 {
        description = "陆沉发现备用排气通道，安排林野、阿柚携带氚晶体先行撤离，自己留下断后，林野留下两枚高爆手雷，约定在出口等候十分钟。"
        event {
          type = "status"
        }
      }
      step 2 {
        description = "密封门破裂，13只工蜂涌入机房，陆沉在生死关头解锁一阶基因进化，力量速度翻五倍，生成皮下外骨骼，三分钟内击杀全部工蜂。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_worker_bee", count = 13, level = 2}]
          }
          state_delta {
            target = "char_lu_chen"
            kind = "breakthrough"
            field = "evolution_stage"
            from = "normal_human"
            to = "first_order_evolutionist"
            note = "基因进化突破到一阶，力量、速度提升5倍，解锁皮下外骨骼能力。"
          }
        }
      }
      step 3 {
        description = "陆沉投掷高爆手雷引发通道坍塌，挪开即将堵死排气通道的混凝土块，在通道完全坍塌前爬出排风井与林野、阿柚汇合。"
        event {
          type = "location"
        }
      }
      step 4 {
        description = "林野引爆预先埋设的炸药，将剩余虫族封死在坍塌的核电站内，阿柚确认周边三公里内无存活虫族，三人启程返回据点。"
        event {
          type = "status"
        }
      }
      step 5 {
        description = "返程途中陆沉想起撤离时瞥见的西北高地银灰色光点，意识到智网势力已发现据点位置，威胁临近。"
        event {
          type = "knowledge"
          state_delta {
            target = "plot_thread_zhineng_threat"
            kind = "plot_thread"
            field = "status"
            to = "escalated"
            note = "智网已定位到人类地下据点位置，即将发动袭击。"
          }
        }
      }
      step 6 {
        description = "三人返回据点，受到幸存者欢迎，阿柚将氚晶体交给据点负责人，众人十分振奋。陆沉突然因基因进化副作用眩晕晕倒，失去意识前仍记挂智网威胁。"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "injury"
            field = "status"
            from = "minor_injury"
            to = "unconscious"
          }
        }
      }
    }
  }
  chapter "灰雀的轰鸣" {
    id = "P1-V1-C9"
    objective "修复灰雀机甲，抵御智网机器人对据点的袭击" {
      step 1 {
        description = "陆沉昏迷一天一夜后在医疗室苏醒，经检测确认基因链完全稳定，正式成为一阶进化者，身体素质大幅提升。"
        event {
          type = "status"
          state_delta {
            target = "char_lu_chen"
            kind = "injury"
            field = "status"
            from = "unconscious"
            to = "recovered"
          }
        }
      }
      step 2 {
        description = "陆沉前往机甲维修库，凭借前航天工程师的经验耗时三小时修复灰雀机甲所有故障，将高纯度氚晶体装入能源核心，机甲成功启动。"
        event {
          type = "acquire"
          state_delta {
            target = "char_lu_chen"
            kind = "resource"
            field = "item"
            to = "grey_sparrow_mech"
            delta = 1
          }
        }
      }
      step 3 {
        description = "陆沉操控灰雀机甲完成武器、动力、操作系统全流程测试，所有指标全部达标，可投入实战，围观幸存者十分振奋。"
        event {
          type = "status"
        }
      }
      step 4 {
        description = "据点突然拉响红色警报，10台T-7型智网战斗机器人突破外门向内部突进，非战斗人员紧急撤入防爆掩体。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_t7_robot", count = 10, level = 3}]
          }
        }
      }
      step 5 {
        description = "陆沉主动操控灰雀机甲前往据点入口通道阻挡入侵者，林野带领战斗人员紧随其后打掩护，机甲做好战斗准备等待敌人到来。"
        event {
          type = "status"
        }
      }
    }
  }
  chapter "逐星的第一步" {
    id = "P1-V1-C10"
    objective "击退智网机器人袭击，带领幸存者启动逐星计划前往南海发射场" {
      step 1 {
        description = "10台T-7型智网战斗机器人攻入据点入口大厅，瞄准掩体后的老周及非战斗人员，众人陷入绝境。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_t7_robot", count = 10, level = 3}]
          }
        }
      }
      step 2 {
        description = "陆沉操控灰雀机甲冲入大厅，精准击毁三台尚未开火的机器人，剩余七台机器人围攻陆沉，陆沉操控机甲灵活闪避，配合机枪、格斗刃用时不到十分钟击毁全部机器人，据点零伤亡。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_t7_robot", count = 10, level = 3}]
          }
        }
      }
      step 3 {
        description = "幸存者爆发欢呼，老周代表全体人员推举陆沉为领袖，表示愿意听从他的指挥行动。"
        event {
          type = "relationship"
          state_delta {
            target = "char_lu_chen"
            kind = "status"
            field = "leadership"
            to = "elected_leader_of_survivors"
          }
        }
      }
      step 4 {
        description = "陆沉当众说明自己来自一百年前的人类联邦，告知众人联邦主力驻守在半人马座阿尔法星，宣布下一步目标是穿过西南戈壁前往南海发射场，驾驶「逐星号」星舰寻找联邦主力，联合反攻夺回人类家园。"
        event {
          type = "knowledge"
          state_delta {
            target = "plot_thread_star_seeking_plan"
            kind = "plot_thread"
            field = "status"
            to = "initiated"
            note = "逐星远征计划正式启动，目标是前往半人马座与联邦主力汇合，夺回母星。"
          }
        }
      }
      step 5 {
        description = "两小时后全体幸存者收拾好物资整装待发，据点合金门打开，队伍正式出发：陆沉驾驶灰雀机甲走在最前方，林野带20名战斗人员在两侧护卫，阿柚持生命探测器开路，老周在队伍中间照看老弱。"
        event {
          type = "location"
        }
      }
      step 6 {
        description = "队伍踏入西南戈壁，朝着南海发射场的方向前进，逐星计划正式迈出第一步，所有人坚定跟随陆沉，坚信终将夺回属于人类的家园。"
        event {
          type = "transition"
          state_delta {
            target = "plot_thread_star_seeking_plan"
            kind = "plot_thread"
            field = "status"
            to = "in_progress"
          }
        }
      }
    }
  }
}

systems {
}
