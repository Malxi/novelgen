metadata {
    title = "mine"
    genre = ["穿越修仙", "智斗博弈", "群像悬疑", "矿场求生"]
    power_system = "练气/筑基/金丹+穿越者题材绑定金手指+禁术/天道碎片体系"
    dsl_version = "0.2.0"
    source = "novelgen_outline"
}

world {
    location "黑风矿地下遗迹入口石壁前" {
        id = "loc_黑风矿地下遗迹入口"
        name = "黑风矿地下遗迹入口石壁前"
        type = "dungeon"
        description = "位于黑风矿最深废弃矿道的尽头，是通往封印禁术「死后夺取」的核心区域的唯一入口，表面布满血色封印符文，可通过符文节点关闭伪装成普通岩壁。"
        __placeholder__ = false
    }
    location "黑风灵石矿废弃矿道" {
        id = "loc_黑风矿废弃矿道"
        name = "黑风灵石矿废弃矿道"
        type = "dungeon"
        description = "黑风灵石矿早年开采枯竭后被官方封禁的老旧矿道分支，因坍塌风险高被列为禁区，内部连通地下禁术遗迹，岩层松动易触发定向坍塌。"
        __placeholder__ = false
    }
    location "青牛镇西岔道" {
        id = "loc_青牛镇西岔道"
        name = "青牛镇西岔道"
        type = "outdoor"
        description = "黑风矿通往青牛镇沿途的偏僻岔路口，背光隐蔽，是矿奴私下碰头、传递暗号的常用地点。"
        __placeholder__ = false
    }
    location "黑风灵石矿矿奴大通铺" {
        id = "loc_黑风矿矿奴大通铺"
        name = "黑风灵石矿矿奴大通铺"
        type = "indoor"
        description = "黑风灵石矿底层矿奴的集体居所，环境恶劣拥挤，是矿奴休息、藏匿小体积物资的场所。"
        __placeholder__ = false
    }
    location "黑风矿废弃矿道隐藏岩洞" {
        id = "loc_黑风矿隐藏岩洞"
        name = "黑风矿废弃矿道隐藏岩洞"
        type = "dungeon"
        description = "位于丁字八号废弃矿道尽头的天然岩洞，被早年逃亡矿奴改造为秘密藏身处，位置隐蔽不易被监工发现。"
        __placeholder__ = false
    }
    location "黑风矿外围黑松林" {
        id = "loc_黑风矿外围黑松林"
        name = "黑风矿外围黑松林"
        type = "outdoor"
        description = "环绕黑风灵石矿的大片原始松林，是矿场与外界连通的天然屏障，常年被矿尘笼罩，地形复杂易藏匿行踪。"
        __placeholder__ = false
    }
    location "黑风矿管控区边界木栅栏" {
        id = "loc_黑风矿管控边界"
        name = "黑风矿管控区边界木栅栏"
        type = "outdoor"
        description = "黑风矿外围的木质隔离栅栏，划分矿奴管控区与外部山林的边界，有矿卫定期巡逻。"
        __placeholder__ = false
    }
    location "黑风矿至青牛镇林间土路" {
        id = "loc_黑风矿至青牛镇土路"
        name = "黑风矿至青牛镇林间土路"
        type = "outdoor"
        description = "连接黑风矿与青牛镇的偏僻林间土路，常年少有人走，是逃矿矿奴的首选逃亡路线。"
        __placeholder__ = false
    }
    location "黑风灵石矿矿道入口广场" {
        id = "loc_黑风矿矿道入口广场"
        name = "黑风灵石矿矿道入口广场"
        type = "outdoor"
        description = "黑风灵石矿所有矿道出入口前的露天公共广场，是矿奴上下工点名、灵石上缴核验、监工执行处罚的核心管控区域。"
        __placeholder__ = false
    }
    location "黑风灵石矿主支矿道" {
        id = "loc_黑风矿主支矿道"
        name = "黑风灵石矿主支矿道"
        type = "dungeon"
        description = "黑风灵石矿核心开采矿道，连通所有分支矿道、废弃矿道与矿场出口，是矿奴日常挖矿作业的主要区域。"
        __placeholder__ = false
    }
    location "黑风矿监工棚" {
        id = "loc_黑风矿监工棚"
        name = "黑风矿监工棚"
        type = "indoor"
        description = "黑风矿监工值守、办公的临时棚屋，紧邻矿道入口，是监工商议管控措施、处置违规矿奴的场所。"
        __placeholder__ = false
    }
    location "黑风矿矿道公共作业区" {
        id = "loc_黑风矿公共作业区"
        name = "黑风矿矿道公共作业区"
        type = "dungeon"
        description = "黑风矿主矿道内监工视线最清晰的公开挖矿作业区域，无隐蔽死角，监工可随时监控所有矿奴的作业情况。"
        __placeholder__ = false
    }
}

characters {
    player "林砚" {
        id = "char_林砚"
        name = "林砚"
        description = "穿越而来的矿场题材网文作者，黑风矿底层矿奴，拥有「附矿场复活」「剧情预判」专属金手指，精通矿山岩体力学与矿井灾害防治，正筹备逃离黑风矿。"
        __placeholder__ = false
        str = 7
        agi = 8
        int = 15
        vit = 8
        hp = 80
        mp = 30
        class = "穿越者·底层矿奴"
        skills = ["附矿场复活", "剧情预判", "定向坍塌测算", "基础挖矿", "低级掩息术"]
    }
    npc "小石头" {
        id = "char_小石头"
        name = "小石头"
        description = "黑风矿土生土长的孤儿矿奴，父母死于早年矿难，熟悉黑风矿所有明暗道与隐蔽角落，机灵嘴严重情义，是林砚的逃亡搭档，持有半块缉厄司云纹碎玉。"
        __placeholder__ = false
        role = "核心盟友"
        default_location = "loc_黑风矿主支矿道"
    }
    npc "周虎" {
        id = "char_周虎"
        name = "周虎"
        description = "黑风矿丙字矿区监工，练气五层修为，残暴嗜虐贪财如命，已被缉厄司以百块灵石收买，负责盯梢疑似拥有复活能力的林砚。"
        __placeholder__ = false
        role = "前期核心反派"
        default_location = "loc_黑风矿监工棚"
    }
    npc "周小旺（小监工）" {
        id = "char_周小旺"
        name = "周小旺"
        description = "周虎的远房外甥，黑风矿底层小监工，贪财好赌狐假虎威，被周虎安排寸步不离盯梢林砚的动向。"
        __placeholder__ = false
        role = "反派喽啰"
        default_location = "loc_黑风矿公共作业区"
    }
    npc "老矿头（郑老根）" {
        id = "char_老矿头"
        name = "郑老根"
        description = "在黑风矿熬了十年的老矿奴，消息灵通，靠私下贩卖矿场各类消息赚取灵石补贴生计。"
        __placeholder__ = false
        role = "中立情报NPC"
        default_location = "loc_黑风矿矿道入口广场"
    }
    npc "缉厄司暗卫（赵戍）" {
        id = "char_赵戍"
        name = "赵戍"
        description = "缉厄司高层「三哥」直属暗卫，练气九层修为，擅长气息隐匿与潜行追踪，负责黑风矿穿越者排查行动，缉拿复活类穿越者。"
        __placeholder__ = false
        role = "反派精锐"
        default_location = "loc_黑风矿废弃矿道"
    }
    npc "顾衍（三哥）" {
        id = "char_顾衍"
        name = "顾衍"
        description = "缉厄司核心高层，穿越者卧底，黑风矿穿越者排查行动的主导者，布局夺取禁术「死后夺取」，是前期最大幕后黑手。"
        __placeholder__ = false
        role = "核心反派"
        default_location = "loc_黑风矿外围黑松林"
    }
    npc "苏晚（苏小姐）" {
        id = "char_苏晚"
        name = "苏晚"
        description = "缉厄司安插在书友会的核心卧底，擅长伪装与情报传递，协助顾衍主导黑风矿穿越者排查行动。"
        __placeholder__ = false
        role = "核心反派"
        default_location = "loc_黑风矿外围黑松林"
    }
    npc "巡逻矿卫" {
        id = "char_巡逻矿卫"
        name = "巡逻矿卫"
        description = "周虎手下的监工打手，负责矿场日常巡逻、搜捕违规矿奴，听从周虎指令行事。"
        __placeholder__ = false
        role = "反派喽啰"
        default_location = "loc_黑风矿主支矿道"
    }
    npc "普通矿奴" {
        id = "char_普通矿奴"
        name = "普通矿奴"
        description = "被抓来黑风矿挖矿的底层民众与低阶散修，麻木求生，是矿场最底层的被剥削群体。"
        __placeholder__ = false
        role = "背景NPC"
        default_location = "loc_黑风矿公共作业区"
    }
}

storyline {
    chapter "落石封门，秘藏禁踪" {
        id = "chap_p1v2c8"
        objective "封堵上古遗迹入口，测算定向坍塌方案应对缉厄司排查" {
            step 1 {
                description = "林砚按照记忆精准点按岩壁上的符文节点，成功关闭遗迹入口，将入口伪装得与周围岩壁毫无二致，完全看不出拼接痕迹"
                event {
                    type = "status"
                }
            }
            step 2 {
                description = "林砚确认贴身藏匿的残玉仅需每三个时辰消耗十分之一练气一层的灵力即可维持隐匿效果，无需折损阳寿"
                event {
                    type = "status"
                }
            }
            step 3 {
                description = "林砚回忆此前听到的暗卫对话，得知遗迹封印下个月即将松动，缉厄司会提前排查这片废弃矿道，当前的入口机关最多只能瞒过对方半个月，一旦禁术「死后夺取」落入缉厄司手中，方圆千里内的所有穿越者都会遭遇灭顶之灾"
                event {
                    type = "knowledge"
                }
            }
            step 4 {
                description = "林砚回忆书友会旧档案：二十年前持有「死后夺取」禁术的悬疑作者曾三个月屠杀三百二十七名穿越者，折损缉厄司十七名筑基修士，最终被书友会卧底传递消息拿下，禁术便封印在此处遗迹"
                event {
                    type = "knowledge"
                }
            }
            step 5 {
                description = "林砚担心缉厄司拿到禁术后，自己尚未实施的逃去修仙界的计划会泡汤，连后天约定在西岔道碰头商议逃离计划的小石头也会受牵连丧命"
                event {
                    type = "status"
                }
            }
            step 6 {
                description = "林砚想起自己此前为写矿场题材修仙文，曾钻研矿山岩体力学、矿井灾害防治等专业教材，还请教过从业三十年的矿山安全员，具备定向坍塌测算的专业能力"
                event {
                    type = "status"
                }
            }
            step 7 {
                description = "林砚回忆自己三个月来在黑风矿当矿奴期间，已经反复勘测过这片区域的岩层情况，所有参数早已熟记于心"
                event {
                    type = "status"
                }
            }
            step 8 {
                description = "林砚现场敲击勘测岩壁、地面的岩层情况，确认松散岩层的范围、应力点位置、落石坍塌效果均符合预期，测算出用脚边二十斤重的玄铁矿石砸向应力点即可触发定向坍塌，不会留下人为痕迹，还能为自己争取十天以上的缓冲时间"
                event {
                    type = "knowledge"
                }
            }
            step 9 {
                description = "林砚核对完全部坍塌细节、撤退路线，确认无任何纰漏，正准备动手触发坍塌时，突然听到远处矿道传来暗卫甲胄碰撞的声响，暗卫巡逻时间比预判早了整整一刻钟"
                event {
                    type = "combat"
                }
            }
        }
    }
    chapter "岩崩尘散，凶迹全消" {
        id = "chap_p1v2c9"
        objective "触发定向坍塌封堵遗迹，应对周虎盘查，提前逃亡时间" {
            step 1 {
                description = "林砚发现暗卫巡逻时间比预判早了一刻钟，仅剩下不到三分钟时间处理遗迹入口"
                event {
                    type = "combat"
                }
            }
            step 2 {
                description = "林砚为避免灵波被探测到，没有动用灵力，仅靠肉身力气用玄铁矿石砸岩壁应力点七次，触发矿道自然坍塌，完全封堵住遗迹入口，抹除了所有人为操作痕迹"
                event {
                    type = "status"
                }
            }
            step 3 {
                description = "巡逻暗卫误以为是常规自然坍塌，怕被落石伤到，没有进入废矿道查看，直接转向其他岔口巡逻"
                event {
                    type = "status"
                }
            }
            step 4 {
                description = "林砚取出之前藏好的五块下品灵石，往矿道出口走，路上特意蹭灰掩盖虎口的血痕，伪装成普通矿奴的样子"
                event {
                    type = "status"
                }
            }
            step 5 {
                description = "林砚在废弃矿道入口撞见前来查看坍塌情况的周虎及其手下，刻意表现出被坍塌吓到的惧怕状态，符合普通矿奴见监工的常态"
                event {
                    type = "status"
                }
            }
            step 6 {
                description = "周虎手下清点林砚的五块灵石，周虎因知晓废弃矿道近期因封印溢散灵气、出矿率高一倍的通报，打消了对林砚的疑虑，没收两块灵石作为孝敬，抽了林砚一鞭后便赶去处理其他矿奴偷懒的事"
                event {
                    type = "status"
                }
            }
            step 7 {
                description = "林砚绕到西岔道背光处，用玄铁碎渣刻下和小石头约定的「提前两天碰头」的三角暗号，通过书友会联络石确认附近没有缉厄司人员和其他穿越者"
                event {
                    type = "status"
                }
            }
            step 8 {
                description = "林砚得知缉厄司下个月就要来矿场排查，最多十天就可能挖到他封起来的落石堆，原本定的三个月后借大型矿难逃离的计划时间不够，决定将逃离时间提前一个月，同时要把贴身的残玉找安全地方藏好"
                event {
                    type = "status"
                }
            }
        }
    }
    chapter "岩洞密约，雨夜逃期" {
        id = "chap_p1v3c1"
        objective "与小石头敲定最终逃亡计划，获得缉厄司相关关键线索" {
            step 1 {
                description = "林砚在矿道挖矿时收到小石头提前碰头的暗号，故意延迟交矿绕开监工前往约定地点"
                event {
                    type = "status"
                }
            }
            step 2 {
                description = "林砚进入隐藏岩洞清点半个月攒下的逃生物资，确认隐匿残玉为应急后手，将其余物资打包妥当"
                event {
                    type = "acquire"
                }
            }
            step 3 {
                description = "林砚在西岔道与小石头汇合，得知三日后缉厄司将带人来矿场开展全矿大排查，原定一个月的逃期完全赶不及"
                event {
                    type = "knowledge"
                }
            }
            step 4 {
                description = "林砚提出带小石头一同逃去青牛镇，给出三日后暴雨时制造矿道坍塌引开巡逻队、从后山废弃隘口逃生的方案，说服犹豫的小石头同意合作"
                event {
                    type = "status"
                }
            }
            step 5 {
                description = "小石头拿出父亲当年修地下遗迹时捡到的半块带云纹的淡蓝碎玉，告知前几日见过袖口有相同云纹的黑袍人来矿场打听死而复生的人，还给了监工周虎一大袋灵石封口"
                event {
                    type = "knowledge"
                }
            }
            step 6 {
                description = "林砚触碰碎玉时神魂出现刺痛感，身上的书友会联络石同步震动，确认碎玉与缉厄司针对穿越者的压制法器有关，将碎玉收为保命底牌"
                event {
                    type = "acquire"
                }
            }
            step 7 {
                description = "二人核对三日后雨夜亥时在废弃矿道出口汇合的细节和暗号后分头离开，林砚将物资放回隐藏岩洞，潜回矿奴大通铺，逃亡正式进入最后倒计时"
                event {
                    type = "status"
                }
            }
        }
    }
    chapter "暗标支点，矿脉伏机" {
        id = "chap_p1v3c2"
        objective "标记坍塌支点，获知自身已被缉厄司盯上的情报" {
            step 1 {
                description = "天刚亮林砚混在待上工的矿奴队伍中准备进矿，撞见周虎带矿卫前往西二矿道搜捕可疑分子，花碎灵石从老矿头处打听得知昨夜起矿场全矿搜捕行踪诡异人员，天亮就将封禁所有偏僻支脉排查"
                event {
                    type = "knowledge"
                }
            }
            step 2 {
                description = "林砚原定等监工注意力分散后再标记坍塌支点的计划无法继续等待，趁换岗最后混乱提前潜入矿道"
                event {
                    type = "status"
                }
            }
            step 3 {
                description = "林砚绕开监工巡逻主路走偏僻支脉，先后找到西二矿道最深处、东一主矿道岔口上方两个核心坍塌支点，做好专属标记并掩盖了自身足迹"
                event {
                    type = "status"
                }
            }
            step 4 {
                description = "林砚前往南三矿道找第三个核心支点时，撞见缉厄司暗卫用传讯符汇报排查情况，立刻躲进空矿篓催动掩息符隐蔽，听到暗卫提到已经注意到他总往废弃矿道钻的异常，此次排查目标是找有复活能力的人，背后有上级“三哥”和权位更高的“苏小姐”主导"
                event {
                    type = "knowledge"
                }
            }
            step 5 {
                description = "暗卫嫌矿篓太脏没有翻查，转身离开后，林砚等了一刻钟才从矿篓出来，标记好第三个核心坍塌支点，绕路确认之前埋的黑火药位置完好未被移动"
                event {
                    type = "status"
                }
            }
            step 6 {
                description = "林砚混在早班进矿的矿奴队伍里准备归队，意识到自己已经被缉厄司盯上，逃亡计划出现未知变数"
                event {
                    type = "status"
                }
            }
        }
    }
    chapter "监工疑踪，份额陡增" {
        id = "chap_p1v3c3"
        objective "应对周虎的刻意刁难，调整逃亡计划优先解决周虎的威胁" {
            step 1 {
                description = "林砚结束十个时辰的早班混在矿奴队伍中出矿道，此时炸矿逃亡的准备已完成六成，原定三日后和小石头在雨夜汇合一同逃亡"
                event {
                    type = "status"
                }
            }
            step 2 {
                description = "监工周虎当众叫住林砚，宣布将他的每日挖矿份额提升至十块下品灵石，完不成就会遭到重罚"
                event {
                    type = "combat"
                }
            }
            step 3 {
                description = "林砚发现小监工一直紧盯自己的动作，推测上周自己去隐藏岩洞送干粮时就被对方撞见，此次刁难是专门针对自己的刻意安排"
                event {
                    type = "knowledge"
                }
            }
            step 4 {
                description = "林砚路过周虎身边时偷听到对方和小监工的对话，得知三日后缉厄司的高层「三哥」会带探魂石来全矿大排查，专门搜捕「死了又活的」穿越者，周虎已被收买负责盯紧林砚，抓活的可获百块灵石赏金"
                event {
                    type = "knowledge"
                }
            }
            step 5 {
                description = "林砚意识到原定逃亡时间刚好和大排查时间重合，缉厄司已经锁定复活类穿越者的特征，留给自己的准备时间远少于预期"
                event {
                    type = "status"
                }
            }
            step 6 {
                description = "林砚故意装作怯懦害怕的样子蒙骗周虎和小监工，进入矿道后没有去偏僻支脉，反而选了监工视线最好的公共作业区挖矿，故意放慢动作摆出体力不支的样子麻痹盯梢的人"
                event {
                    type = "status"
                }
            }
            step 7 {
                description = "林砚梳理处境后判断，推迟逃亡计划等于主动送死，只能按原计划执行，但必须先解决周虎和盯梢的小监工，才能继续完成逃亡的剩余准备工作"
                event {
                    type = "status"
                }
            }
            step 8 {
                description = "林砚磨了一整天只挖出来两块下品碎灵石，周虎大怒，勒令小监工次日起寸步不离跟着林砚，承诺事成之后给小监工十块灵石赏钱"
                event {
                    type = "combat"
                }
            }
            step 9 {
                description = "林砚表面惶恐应下处罚，内心已经决定先解决周虎的麻烦，再推进逃亡计划"
                event {
                    type = "status"
                }
            }
        }
    }
    chapter "破笼而出，仙途启行" {
        id = "chap_p1v3c10"
        objective "成功逃离黑风矿，踏入修仙界遭遇未知势力监视" {
            step 1 {
                description = "林砚扣住小石头的手腕沿隐秘小路往黑松林东南方向逃亡，粗布鞋被碎石磨出破洞，脚趾被蹭得生疼"
                event {
                    type = "status"
                }
            }
            step 2 {
                description = "二人走了半个时辰抵达黑风矿管控区边界的木栅栏，确认成功逃出矿场范围，小石头情绪十分激动"
                event {
                    type = "status"
                }
            }
            step 3 {
                description = "林砚提前布置的矿难炸点按时引爆，周虎及两名缉厄司暗卫被埋在矿道身亡，悬在二人头顶的威胁暂时解除"
                event {
                    type = "combat"
                }
            }
            step 4 {
                description = "林砚复盘复活规则，三次复活共折损20年寿元，仅剩不足40年寿命，最多还能死三次就会魂飞魄散"
                event {
                    type = "status"
                }
            }
            step 5 {
                description = "林砚清点随身物品，确认所有关键物品完好，同时得知小石头脖子上挂的半块玉和自己怀里的封印玉佩是一对，合并可解锁「死后夺取」禁术封印"
                event {
                    type = "knowledge"
                }
            }
            step 6 {
                description = "林砚瞥见黑风矿岩台上站着黑袍蒙面人和素衣木簪女子，对方指向二人所在方向后凭空消失，确认自己的行踪早已被对方监视，为免小石头担心谎称自己看花眼"
                event {
                    type = "status"
                }
            }
            step 7 {
                description = "林砚拉着小石头连夜赶路，计划天亮前赶到青牛镇外围，伪装成进山采药的爷孙俩混进城，避免被城防军当成逃奴抓捕"
                event {
                    type = "status"
                }
            }
            step 8 {
                description = "赶路途中林砚感知到书友会的安全联络信号，知晓前方有自己人接应，并未将此事告知小石头"
                event {
                    type = "knowledge"
                }
            }
            step 9 {
                description = "二人沿着土路往青牛镇方向走，彻底摆脱矿奴身份正式踏入修仙界，暗处未知的危机早已在等候他们"
                event {
                    type = "status"
                }
            }
        }
    }
}