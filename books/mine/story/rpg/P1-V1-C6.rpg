# Chapter P1-V1-C6: 灰衣现踪，溢出设定的变数

storyline {
  chapter "灰衣现踪，溢出设定的变数" {
    id = "P1-V1-C6"

    objective "主要剧情" {
      step 1 {
        description = "林砚凌晨潜回大通铺，发现老郑在等搜身风头过了兑现此前的约定，同时想起昨夜撞见缉厄司人员潜入隐脉入口，对方比原剧情提前三个月现身"
        event {
          type = "status"
        }
      }
      step 2 {
        description = "白天林砚刻意按照原主的麻木节奏挖矿，多凿两斤碎渣不留可私藏的完整矿块，挨了周虎一脚也毫无反应，交矿时被周虎故意抬高定额盘剥，林砚伪装�..."
        event {
          type = "status"
        }
      }
      step 3 {
        description = "收工时林砚在矿道入口撞见缉厄司灰衣暗卫，认出对方穿的是缉厄司制式青灰纺面料，佩戴的缉字铜牌、佩刀上的十七道刻痕都是猎杀穿越者的标记，�..."
        event {
          type = "status"
        }
      }
      step 4 {
        description = "偷藏灵石的矿奴瘦猴被探测出异常，当场被灰衣暗卫制住收进玄色布囊带走，在场所有人都不敢出声，林砚得知此前失踪的矿奴都是被缉厄司清理"
        event {
          type = "status"
        }
      }
      step 5 {
        description = "灰衣暗卫的视线扫到林砚，林砚伪装成患肺痨的懦弱病秧子，成功蒙混过关"
        event {
          type = "status"
        }
      }
    }
  }
}
