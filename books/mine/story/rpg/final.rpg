  }
  location "黑风矿地下遗迹入口石壁前" {
    id = "loc_黑风矿地下遗迹入口"
    type = "dungeon"
    description = "位于黑风矿最深废弃矿道的尽头，是通往封印禁术「死后夺取」的核心区域的唯一入口，表面布满血色封印符文，可通过符文节点关闭伪装成普通岩壁。"
  }
  location "黑风灵石矿废弃矿道" {
    id = "loc_黑风矿废弃矿道"
    type = "dungeon"
    description = "黑风灵石矿早年开采枯竭后被官方封禁的老旧矿道分支，因坍塌风险高被列为禁区，内部连通地下禁术遗迹，岩层松动易触发定向坍塌。"
  }
  location "青牛镇西岔道" {
    id = "loc_青牛镇西岔道"
    type = "outdoor"
    description = "黑风矿通往青牛镇沿途的偏僻岔路口，背光隐蔽，是矿奴私下碰头、传递暗号的常用地点。"
  }
  location "黑风灵石矿矿奴大通铺" {
    id = "loc_黑风矿矿奴大通铺"
    type = "indoor"
    description = "黑风灵石矿底层矿奴的集体居所，环境恶劣拥挤，是矿奴休息、藏匿小体积物资的场所。"
  }
  location "黑风矿废弃矿道隐藏岩洞" {
    id = "loc_黑风矿隐藏岩洞"
    type = "dungeon"
    description = "位于丁字八号废弃矿道尽头的天然岩洞，被早年逃亡矿奴改造为秘密藏身处，位置隐蔽不易被监工发现。"
  }
  location "黑风矿外围黑松林" {
    id = "loc_黑风矿外围黑松林"
    type = "outdoor"
    description = "环绕黑风灵石矿的大片原始松林，是矿场与外界连通的天然屏障，常年被矿尘笼罩，地形复杂易藏匿行踪。"
  }
  location "黑风矿管控区边界木栅栏" {
    id = "loc_黑风矿管控边界"
    type = "outdoor"
    description = "黑风矿外围的木质隔离栅栏，划分矿奴管控区与外部山林的边界，有矿卫定期巡逻。"
  }
  location "黑风矿至青牛镇林间土路" {
    id = "loc_黑风矿至青牛镇土路"
    type = "outdoor"
    description = "连接黑风矿与青牛镇的偏僻林间土路，常年少有人走，是逃矿矿奴的首选逃亡路线。"
  }
  location "黑风灵石矿矿道入口广场" {
    id = "loc_黑风矿矿道入口广场"
    type = "outdoor"
    description = "黑风灵石矿所有矿道出入口前的露天公共广场，是矿奴上下工点名、灵石上缴核验、监工执行处罚的核心管控区域。"
  }
  location "黑风灵石矿主支矿道" {
    id = "loc_黑风矿主支矿道"
    type = "dungeon"
    description = "黑风灵石矿核心开采矿道，连通所有分支矿道、废弃矿道与矿场出口，是矿奴日常挖矿作业的主要区域。"
  }
  location "黑风矿监工棚" {
    id = "loc_黑风矿监工棚"
    type = "indoor"
    description = "黑风矿监工值守、办公的临时棚屋，紧邻矿道入口，是监工商议管控措施、处置违规矿奴的场所。"
  }
  location "黑风矿矿道公共作业区" {
    id = "loc_黑风矿公共作业区"
    type = "dungeon"
    description = "黑风矿主矿道内监工视线最清晰的公开挖矿作业区域，无隐蔽死角，监工可随时监控所有矿奴的作业情况。"
  }
}

storyline {
  chapter "复生被窥，灵石换得缄默" {
    id = "P1-V1-C9"
    objective "主要剧情" {
      step 1 {
        description = "林砚攥着半块萤石进入丁字八号废弃矿道，打算藏匿刚挖的灵石，默算私藏的灵石已有三十七块下品灵石，加上当日新挖的三块共四十块，原定再挖三\xe5\xa4..."
        event {
          type = "status"
        }
      }
      step 2 {
        description = "林砚刚触碰到藏物资的岩洞的活动岩石，矿道突发小型坍塌，被磨盘大的落石砸中天灵盖死亡"
        event {
          type = "status"
        }
      }
      step 3 {
        description = "林砚很快复活，探察丹田发现修为从练气二层掉回练气一层，所幸未触碰到修为下限折损寿命"
        event {
          type = "status"
        }
      }
      step 4 {
        description = "林砚发现小矿奴小石头躲在岩柱后目睹了自己复活的全过程，小石头此前传闻被灰衣人带走，实际是未查出异常被放回，一直攒灵石想换临时身份牌逃\xe5\x8e..."
        event {
          type = "status"
        }
      }
      step 5 {
        description = "林砚冲上前制住小石头，威胁他不许声张复活的事，小石头主动表示自己什么都没看见"
        event {
          type = "status"
        }
      }
    }
  }
}

