
metadata {
  title = "mine"
  genre = ["穿越修仙", "智斗博弈", "群像悬疑", "矿场求生"]
  power_system = "练气/筑基/金丹+穿越者题材绑定金手指+禁术/天道碎片体系"
  tone = "冷峻烧脑，黑暗残酷，悬念迭起，略带黑色幽默"
  dsl_version = "0.2.0"
}

