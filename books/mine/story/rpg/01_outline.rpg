metadata {
    title = "矿脉仙途"
    genre = ["修仙", "穿越", "悬疑", "求生"]
    power_system = "炼气期修仙体系，穿越者绑定专属题材金手指"
    dsl_version = "0.2.0"
    source = "novelgen_outline"
}

world {
    location "黑风灵石矿丙字三号矿道" {
        id = "loc_bing3_kuangdao"
        name = "黑风灵石矿丙字三号矿道"
        type = "dungeon"
        description = "黑风灵石矿底层低优先级开采矿道，矿顶结构不稳定，岩壁嵌有零星下品灵石碎渣，多段区域曾发生小型坍塌，死亡矿奴从未登记追责，是林砚首次、二次死亡触发复活金手指的核心场景。"
        __placeholder__ = false
    }
    location "黑风灵石矿丙字七号矿道" {
        id = "loc_bing7_kuangdao"
        name = "黑风灵石矿丙字七号矿道"
        type = "dungeon"
        description = "黑风灵石矿中层开采矿道，零散分布下品灵石矿脉，监工巡逻频次较低，是林砚前期私藏灵石的主要作业区域。"
        __placeholder__ = false
    }
    location "黑风灵石矿丁字八号废弃矿道" {
        id = "loc_ding8_kuangdao"
        name = "黑风灵石矿丁字八号废弃矿道"
        type = "dungeon"
        description = "早年开采枯竭后被矿场封禁的偏远矿道，地质结构不稳定，极少有监工涉足，是矿奴私藏物资的隐秘地带，深处连通隐藏岩洞，是林砚第四次死亡复活的场景。"
        __placeholder__ = false
    }
    location "黑风灵石矿矿奴大通铺" {
        id = "loc_kuangnu_datongpu"
        type = "indoor"
        description = "黑风灵石矿专为底层矿奴修建的简陋聚居地，由废石混合黄黏土夯筑而成，无窗户仅开一扇低矮木门，内部连通大通铺仅铺干茅草，环境恶劣，是矿奴唯一的休息场所。"
        __placeholder__ = false
    }
    location "黑风灵石矿矿道入口广场" {
        id = "loc_kuangdao_guangchang"
        type = "outdoor"
        description = "黑风灵石矿所有矿道出入口前的露天公共场地，是矿奴上下工点名、灵石上缴核验、监工执行私刑的核心区域，管制严苛，威慑性极强。"
        __placeholder__ = false
    }
    location "黑风灵石矿废弃矿道隐藏岩洞" {
        id = "loc_yandong_cangchu"
        type = "dungeon"
        description = "位于丁字八号废弃矿道尽头的天然岩洞，被早年逃亡矿奴改造为秘密藏身处，位置隐蔽无监控，是林砚私藏逃生物资的核心据点。"
        __placeholder__ = false
    }
    location "黑风灵石矿西坡三号矿道" {
        id = "loc_xipo3_kuangdao"
        type = "dungeon"
        description = "黑风灵石矿西坡偏远贫矿道，实际隐藏未被发现的富矿带，监工极少涉足，是林砚利用先知优势快速积累灵石资本的核心作业区域。"
        __placeholder__ = false
    }
    location "黑风灵石矿主矿道" {
        id = "loc_zhu_kuangdao"
        type = "dungeon"
        description = "黑风灵石矿最早开挖的核心采矿通道，连通所有分支矿道与矿场出口，是灵石运输的主要通路，缉厄司暗卫常在此处巡查排查穿越者。"
        __placeholder__ = false
    }
}

characters {
    player "林砚" {
        id = "char_linyan"
        name = "林砚"
        description = "原是地球网络小说作者，深耕矿场开局修仙题材五年，因熬夜赶稿猝死穿越进自己创作的《矿脉仙途》世界，成为开局就会死的炮灰矿奴，绑定专属金手指【附矿场复活】，拥有剧情先知优势。"
        __placeholder__ = false
        str = 6
        agi = 7
        int = 15
        vit = 8
        hp = 70
        mp = 30
        class = "炼气期散修"
        skills = ["附矿场复活", "剧情预判", "矿脉辨识", "基础吐纳"]
    }
    
    npc "周虎" {
        id = "char_zhouhu"
        name = "周虎"
        description = "黑风灵石矿丙字矿区监工，练气四层修为，性格残忍贪财，靠盘剥矿奴私藏灵石牟利，是林砚矿奴时期的主要压迫者，暗中为缉厄司外围线人，负责上报矿奴异常。"
        __placeholder__ = false
        role = "前期反派"
        default_location = "loc_kuangdao_guangchang"
        str = 12
        agi = 8
        int = 5
        vit = 10
        hp = 120
        skills = ["基础鞭法", "搜身", "矿道地形熟悉"]
    }
    
    npc "老陈" {
        id = "char_laochen"
        name = "老陈"
        description = "黑风灵石矿底层老矿奴，穿越者互助组织“书友会”潜伏成员，性格隐忍善良，熟悉矿场规则，多次暗中提醒林砚矿内异常。"
        __placeholder__ = false
        role = "中立友方"
        default_location = "loc_bing3_kuangdao"
        skills = ["挖矿", "矿道地形熟悉", "暗号联络"]
    }
    
    npc "老郑" {
        id = "char_laozheng"
        name = "老郑"
        description = "黑风灵石矿底层矿奴，书友会潜伏成员，左脸有青色胎记带黑痣，私藏中品灵石被周虎搜出后当场打死，持有丙字矿区完整矿脉图。"
        __placeholder__ = false
        role = "友方（剧情牺牲）"
        default_location = "loc_bing7_kuangdao"
    }
    
    npc "小石头" {
        id = "char_xiaoshitou"
        name = "小石头"
        description = "十二岁无父无母的小矿奴，自幼在矿场长大，熟悉全矿所有暗道岔洞，包括监工都不知道的隐秘通路，攒钱想买临时身份牌逃去山外县城。"
        __placeholder__ = false
        role = "核心友方"
        default_location = "loc_ding8_kuangdao"
        skills = ["矿道潜行", "地形熟悉", "隐蔽藏匿"]
    }
    
    npc "苏主事" {
        id = "char_su_shushi"
        name = "苏主事"
        description = "缉厄司派驻黑风矿的最高负责人，练气七层修为，手段狠厉，擅长神魂探测，专门负责猎杀矿场内的穿越者，目标是地下遗迹的禁术金手指“死后夺取”。"
        __placeholder__ = false
        role = "前期反派头目"
        default_location = "loc_zhu_kuangdao"
        skills = ["神魂探测", "穿越者排查", "基础术法"]
    }
    
    npc "缉厄司灰衣暗卫" {
        id = "char_huiyi_anwei"
        name = "缉厄司灰衣暗卫"
        description = "缉厄司基层作战人员，练气三到五层修为，统一穿灰衣制式服装，佩戴刻云纹的缉字铜牌，擅长潜伏探测，负责猎杀排查穿越者。"
        __placeholder__ = false
        role = "反派喽啰"
        default_location = "全矿区域"
        skills = ["神魂探测", "基础格斗", "潜伏匿踪"]
    }
    
    npc "小顺" {
        id = "char_xiaoshun"
        name = "小顺"
        description = "带雀斑的少年矿奴，性格懦弱，常因偷藏食物被监工殴打。"
        __placeholder__ = false
        role = "中立路人"
    }
    
    npc "瘦猴" {
        id = "char_shouhou"
        name = "瘦猴"
        description = "底层矿奴，因偷藏灵石被缉厄司探测出异常，当场被带走灭杀。"
        __placeholder__ = false
        role = "中立路人（剧情牺牲）"
    }
}

storyline {
    chapter "寒矿醒转，首死触发复生" {
        id = "P1-V1-C1"
        objective "矿场苏醒，首次确认复活能力" {
            step 1 {
                description = "现代修仙网文作者林砚熬夜赶稿时猝死，穿越到自己创作的矿场开局修仙文世界中，成为黑风灵石矿内签了死契的练气二层散修矿奴。"
                event {
                    type = "status"
                }
            }
            step 2 {
                description = "林砚刚苏醒就遭到矿监周虎鞭打，他消化完原身记忆后发现矿道内布有锁灵阵，完全压制练气期修士灵力，遂决定暂时隐忍不反抗。"
                event {
                    type = "combat"
                    detail = "受周虎鞭打无生命危险"
                    on_complete = "获得锁灵阵信息，决定隐忍"
                }
            }
            step 3 {
                description = "老矿奴老陈给林砚递来一把豁口镐头，偷偷提醒他近期矿内不太平，有腰挂漆黑铜牌的灰衣官爷随意抓走可疑矿奴不留尸首，地底深处还有诡异哭声传出。"
                event {
                    type = "knowledge"
                    detail = "获得灰衣人、矿道异常信息"
                }
            }
            step 4 {
                description = "林砚凭借自己写文积累的挖灵石经验，很快找准矿脉位置开始挖矿，半炷香时间就挖了小半筐下品灵石。"
                event {
                    type = "acquire"
                    detail = "获得半筐下品灵石碎矿"
                }
            }
            step 5 {
                description = "矿道突发坍塌，林砚被碗口大的落石砸中当场死亡；周虎为了自保拽过身边的老陈挡石，导致老陈半边肩膀被碎石砸得血肉模糊。"
                event {
                    type = "combat"
                    detail = "首次死亡，老陈受重伤"
                }
            }
            step 6 {
                description = "林砚在矿道内无监控的隐蔽角落复活，发现自己身上没有外伤，但修为跌落近一层，距离掉至练气一层仅一线，周围所有人都未察觉他死亡复活的异常。"
                event {
                    type = "status"
                    detail = "首次复活成功，修为接近练气一层，未暴露异常"
                }
            }
            step 7 {
                description = "林砚确认自己拥有死而复生的能力，将复活时攥在手里的半块下品灵石收进怀中，决定自行摸索复活规则，在危机四伏的黑风矿中活下去。"
                event {
                    type = "knowledge"
                    detail = "确认拥有复活能力"
                    on_complete = "获得半块下品灵石"
                }
            }
        }
    }
    
    chapter "二度殒命，始知复生有耗" {
        id = "P1-V1-C2"
        objective "二次死亡，探明复活修为损耗规则" {
            step 1 {
                description = "林砚苏醒误以为此前被落石砸死的记忆是幻觉，将丹田滞涩的不适感归因为锁灵阵压制与脑震荡。"
                event {
                    type = "status"
                }
            }
            step 2 {
                description = "矿监周虎发现林砚发呆，踹了他一脚并勒令他当日挖够三斤完整下品灵石，否则就把他扔去喂噬骨鼠。"
                event {
                    type = "status"
                    detail = "获得三斤下品灵石挖矿定额要求"
                }
            }
            step 3 {
                description = "林砚为完成定额回到丙字三号矿道此前挖矿的位置，刚凿下一镐就遭遇二次矿道坍塌。"
                event {
                    type = "combat"
                    detail = "遭遇二次矿难"
                }
            }
            step 4 {
                description = "林砚右腿被落石砸断、颈动脉被碎石划破当场死亡，随后再度在矿道出口的安全区复活。"
                event {
                    type = "combat"
                    detail = "二次死亡，二次复活成功"
                }
            }
            step 5 {
                description = "林砚确认自己真的拥有死而复生的能力，同时发现每死亡一次修为就会跌落：第一次死后从练气二层濒临跌到练气一层，第二次死后直接跌到练气一层。"
                event {
                    type = "knowledge"
                    detail = "探明复活修为损耗规则"
                }
            }
            step 6 {
                description = "林砚复盘出复活基础规则：复活点为离死亡点最近的无监控安全区域，且一次比更远离危险、复活后随身携带的物品不会丢失，死亡次数越多修为损耗越严重。"
                event {
                    type = "knowledge"
                    detail = "总结复活基础规则"
                }
            }
            step 7 {
                description = "林砚压下恐慌，决定先避开坍塌风险完成当日定额，再慢慢探索复活的其他规则，趁周虎核对台账的视线盲区，贴着岩壁阴影往矿道深处的安全矿脉走去。"
                event {
                    type = "status"
                    detail = "确定后续行动方向"
                }
            }
        }
    }
    
    chapter "以身试死，探明寿命折损" {
        id = "P1-V1-C3"
        objective "主动试死，确认复活寿元损耗与记忆补全机制" {
            step 1 {
                description = "林砚躲在黑风矿潮湿的矿道岩壁后，听到监工周虎安排他次日前往塌方频发、有噬骨鼠出没的丙字三号矿道清障，还得知近期有灰衣大人来矿场巡查，被带走的矿奴无一生还，私下议论的人会被直接灭口。"
                event {
                    type = "knowledge"
                    detail = "获得次日危险任务、灰衣人巡查信息"
                }
            }
            step 2 {
                description = "林砚想到自己此前两次意外死亡已经把修为从穿越初期的练气二层跌到练气一层，丹田灵气滞涩，若次日去丙字三号矿道大概率死得不明不白，存活率不足两成，遂萌生主动可控试死、摸清复活规则的想法。"
                event {
                    type = "status"
                    detail = "做出主动试死决策"
                }
            }
            step 3 {
                description = "林砚故意在走到岩石旁的周虎面前现身，捡起脚边的两块完整下品灵石当众踩碎，精准激怒贪财的周虎，被周虎用缠了铁筋带倒刺的牛筋鞭抽碎喉骨当场死亡。"
                event {
                    type = "combat"
                    detail = "主动挑衅周虎，三次死亡"
                }
            }
            step 4 {
                description = "林砚在矿奴大通铺苏醒复活，发现自己贴身揣着的半块带凿痕的灵石碎渣仍在原位，修为依然保持练气一层没有下跌，但身体虚冷、脉搏仅一息两跳，比正常练气一层修士弱了一半，平白折损了十年寿命。"
                event {
                    type = "status"
                    detail = "三次复活成功，探明寿元损耗规则"
                    on_complete = "灵石碎渣保留"
                }
            }
            step 5 {
                description = "管杂役的矿奴前来通知林砚，因他当日偷懒闹事，挖矿定额从三斤下品灵石涨到四斤，次日挖不够就要被打断腿喂噬骨鼠，林砚从门外杂役的对话得知，复活机制自动给所有在场人员补全了“周虎怕灰衣人查人头扣赏钱，故意留了林砚一命”的合理记忆，完全不会暴露复活异常。"
                event {
                    type = "knowledge"
                    detail = "探明复活记忆补全机制"
                    on_complete = "挖矿定额上涨至四斤"
                }
            }
            step 6 {
                description = "林砚啃窝头时瞥见矿场办公区的石梯上站着一名裹灰袍的女子，对方腰间挂着刻有“缉”字的青铜牌，身边随从拎着三个渗血的密封麻袋，周虎弓着腰在旁陪同，路过的矿奴都对灰袍女子避之不及。"
                event {
                    type = "location"
                    detail = "移动至大通铺外"
                    on_complete = "确认缉厄司存在"
                }
            }
            step 7 {
                description = "林砚无意间看到自己铺位旁的墙根有个指甲盖大的藏灵石的浅坑，发现大通铺的布局、住客特征都和自己五年前开写的矿场开局修仙文的开篇设定完全重合，大受震惊。"
                event {
                    type = "knowledge"
                    detail = "确认穿进自己创作的《矿脉仙途》世界"
                }
            }
        }
    }
    
    chapter "矿洞识踪，竟入自著仙途" {
        id = "P1-V1-C4"
        objective "确认穿书身份，改写炮灰命运" {
            step 1 {
                description = "林砚发现墙根的浅坑和自己创作的《矿脉仙途》开篇设定的藏物点细节完全吻合，心生疑窦。"
                event {
                    type = "knowledge"
                    detail = "发现设定吻合疑点"
                }
            }
            step 2 {
                description = "监工周虎持玄铁鞭召集所有矿奴点名，对未应答者直接记为矿难死亡，同时嘱咐小管事留意身上有奇怪印记的人，上报可换两颗聚气散奖励。"
                event {
                    type = "status"
                    detail = "获得穿越者悬赏信息"
                }
            }
            step 3 {
                description = "林砚确认周虎手上的玄铁虎纹戒指和自己设定的细节完全一致，同时发现缉厄司灰衣人出现时间早于原剧情，是第一个超出预期的变数。"
                event {
                    type = "knowledge"
                    detail = "确认穿书，发现首个剧情变数"
                }
            }
            step 4 {
                description = "林砚假装被打伤虚弱，咳哑声音一瘸一拐回到铺位，捡到掉在地上沾了草屑的窝头收好。"
                event {
                    type = "acquire"
                    detail = "获得窝头"
                }
            }
            step 5 {
                description = "矿奴老郑偷偷将半卷麻纸塞到林砚铺草深处，林砚认出老郑左脸的青色胎记和边缘黑痣是自己给角色加的专属标识。"
                event {
                    type = "knowledge"
                    detail = "确认老郑角色身份"
                    on_complete = "获得半卷麻纸"
                }
            }
            step 6 {
                description = "老郑怕林砚告发自己私藏灵石，许诺明天分半块窝头求他保密，林砚答应不会对外说。"
                event {
                    type = "status"
                    detail = "达成保密约定"
                }
            }
            step 7 {
                description = "林砚取出老郑塞的麻纸，确认是自己当年随手画的丙字矿区矿脉图，上面标注了全部18条矿道、塌方点、隐藏下品灵石矿脉，还有落款的“郑”字标识，和设定稿分毫不差。"
                event {
                    type = "knowledge"
                    detail = "完全确认穿书事实"
                }
            }
            step 8 {
                description = "林砚瞥见缉厄司灰衣人在大通铺门口巡查，连忙将矿脉图藏好。"
                event {
                    type = "status"
                    detail = "隐藏矿脉图，躲过巡查"
                }
            }
            step 9 {
                description = "林砚梳理所有吻合的细节，确认自己穿进了连载五年的《矿脉仙途》书中，身份是开篇第三章就会被周虎抽死的同名炮灰矿奴，计划后半夜趁监工换岗、所有矿奴睡熟时，用怀里的灵石碎渣修炼，补回跌至练气一层最低阈值的修为，决心利用先知优势改写自身炮灰命运。"
                event {
                    type = "status"
                    detail = "确定改写命运的生存目标"
                }
            }
        }
    }
    
    chapter "先知优势，巧藏灵石避搜" {
        id = "P1-V1-C5"
        objective "利用先知优势，私藏灵石积累资本" {
            step 1 {
                description = "天刚亮周虎喝骂所有矿奴前往丙字七号矿道挖矿，规定20斤下品灵石碎矿的硬定额，私藏灵石会被缉厄司灰衣人带走严惩。"
                event {
                    type = "status"
                    detail = "获得20斤下品灵石挖矿定额，私藏惩罚信息"
                }
            }
            step 2 {
                description = "林砚仗着自己是原世界作者的先知优势，清楚当日收工将有搜身环节，先挖够定额碎矿伪装成普通孱弱矿奴，趁监工打盹偷挖得三块完整下品灵石。"
                event {
                    type = "acquire"
                    detail = "获得三块完整下品灵石"
                }
            }
            step 3 {
                description = "林砚将灵石藏到自己当初写设定时预留的隐蔽岩缝内，摸到岩缝有类似云纹的刻痕，未细究便掩盖痕迹返回挖矿点。"
                event {
                    type = "status"
                    detail = "藏匿灵石，发现未知云纹刻痕"
                }
            }
            step 4 {
                description = "收工时周虎果然带监工进矿道搜身，老郑藏在草鞋鞋底的半块灵石被搜出，遭到周虎殴打致重伤、掉落三颗牙齿。"
                event {
                    type = "combat"
                    detail = "老郑被搜出私藏灵石，遭殴打重伤"
                }
            }
            step 5 {
                description = "林砚伪装成懦弱怕事的模样，全程顺从配合搜身，未被查出藏过灵石的痕迹，顺利过关。"
                event {
                    type = "status"
                    detail = "躲过搜身排查"
                }
            }
            step 6 {
                description = "林砚返回大通铺后复盘发现，缉厄司的存在感远超出自己最初的剧情设定，搜查力度高于开篇正常水平。"
                event {
                    type = "knowledge"
                    detail = "确认剧情变数扩大"
                }
            }
            step 7 {
                description = "后半夜林砚避开守夜监工溜回矿道，取出藏好的三块灵石贴身存放，撞见缉厄司灰衣人深夜潜入矿道深处的隐脉入口，他躲在阴影里未被对方发现。"
                event {
                    type = "location"
                    detail = "移动至矿道深处"
                    on_complete = "发现缉厄司探查隐脉"
                }
            }
            step 8 {
                description = "林砚认出缉厄司的铜牌云纹和自己此前在岩缝摸到的刻纹几乎一致，且缉厄司比原剧情提前三个月现身矿场，意识到自己构建的世界已经出现超出设定的变化。"
                event {
                    type = "knowledge"
                    detail = "确认剧情失控，先知优势存疑"
                }
            }
        }
    }
    
    chapter "灰衣现踪，溢出设定的变数" {
        id = "P1-V1-C6"
        objective "遭遇缉厄司排查，确认先知优势失效" {
            step 1 {
                description = "林砚凌晨潜回大通铺，发现老郑在等搜身风头过了兑现此前的约定，同时想起昨夜撞见缉厄司人员潜入隐脉入口，对方比原剧情提前三个月现身。"
                event {
                    type = "knowledge"
                    detail = "确认剧情时间线偏差扩大"
                }
            }
            step 2 {
                description = "白天林砚刻意按照原主的麻木节奏挖矿，多凿两斤碎渣不留可私藏的完整矿块，挨了周虎一脚也毫无反应，交矿时被周虎故意抬高定额盘剥，林砚伪装懦弱蒙混过关。"
                event {
                    type = "status"
                    detail = "伪装普通矿奴，躲过周虎盘剥"
                }
            }
            step 3 {
                description = "收工时林砚在矿道入口撞见缉厄司灰衣暗卫，认出对方穿的是缉厄司制式青灰纺面料，佩戴的缉字铜牌、佩刀上的十七道刻痕都是猎杀穿越者的标记，对方正在用针对外来神魂的探测术排查过往矿奴。"
                event {
                    type = "knowledge"
                    detail = "确认缉厄司猎杀穿越者的机制"
                }
            }
            step 4 {
                description = "偷藏灵石的矿奴瘦猴被探测出异常，当场被灰衣暗卫制住收进玄色布囊带走，在场所有人都不敢出声，林砚得知此前失踪的矿奴都是被缉厄司清理。"
                event {
                    type = "status"
                    detail = "目睹穿越者被猎杀，确认矿奴失踪真相"
                }
            }
            step 5 {
                description = "灰衣暗卫的视线扫到林砚，林砚伪装成患肺痨的懦弱病秧子，成功蒙混过关。"
                event {
                    type = "status"
                    detail = "躲过缉厄司神魂排查"
                }
            }
            step 6 {
                description = "林砚返回大通铺途中发现门板上的特殊标记，回到大通铺后惊觉原剧情已经失控，自己的创作者先知优势大打折扣。"
                event {
                    type = "knowledge"
                    detail = "发现穿越者互助组织暗号，确认剧情失控"
                }
            }
            step 7 {
                description = "老郑主动递来带特殊炭灰标记的半块窝头，示意林砚去墙角第三块砖缝取东西，林砚猜到对方属于穿越者互助组织，不敢轻举妄动。"
                event {
                    type = "status"
                    detail = "收到书友会联络信号，暂不回应"
                }
            }
            step 8 {
                description = "林砚想起原剧情里老郑次日就会因私藏灵石被周虎打死，但如今局势不明不敢贸然提醒，意识到自己此前规划的所有生存路线全部作废，再抱创作者优越感只会死得更快。"
                event {
                    type = "status"
                    detail = "放弃创作者光环，调整生存策略"
                }
            }
        }
    }
    
    chapter "冷眼观亡，斩断作者幻梦" {
        id = "P1-V1-C7"
        objective "目睹老郑惨死，彻底认清现实世界" {
            step 1 {
                description = "后半夜监工周虎踹开大通铺门，勒令所有矿奴到广场集合搜身，私藏物品者从重处罚。"
                event {
                    type = "status"
                    detail = "收到全员搜身通知"
                }
            }
            step 2 {
                description = "林砚明知老郑藏有中品灵石会在本次搜身中丧命，但害怕暴露异常引来缉厄司，再三犹豫后未向老郑示警。"
                event {
                    type = "status"
                    detail = "做出不提醒老郑的决策"
                }
            }
            step 3 {
                description = "林砚排队等待搜身时，发现多处半开书页形状的穿越者互助组织暗号，确认该组织在矿场内有不少潜伏成员。"
                event {
                    type = "knowledge"
                    detail = "确认书友会在矿内有布局"
                }
            }
            step 4 {
                description = "搜身过程中，小顺因偷藏窝头和碎石挨了两巴掌，林砚伪装成麻木畏缩的矿奴顺利通过搜身。"
                event {
                    type = "status"
                    detail = "躲过搜身排查"
                }
            }
            step 5 {
                description = "老郑藏在棉袄内衬里的中品灵石被小监工搜出，周虎为杀鸡儆猴，不顾老郑磕头求饶，用八角铁锤当场将老郑砸死。"
                event {
                    type = "combat"
                    detail = "老郑被周虎当众打死"
                }
            }
            step 6 {
                description = "林砚目睹老郑惨死全过程，彻底认清自己身处的是真实世界，此前抱有的作者光环、剧情豁免等幻梦完全破碎，只剩下强烈的求生欲。"
                event {
                    type = "status"
                    detail = "世界观转变，彻底放弃创作者幻想"
                }
            }
            step 7 {
                description = "林砚瞥见缉厄司人员藏在松树林监测矿场地面的异动纹路，确认缉厄司提前三个月抵达是为了追查矿场地下封印松动的问题。"
                event {
                    type = "knowledge"
                    detail = "确认缉厄司核心目标是地下封印"
                }
            }
            step 8 {
                description = "林砚发现老郑、负责拖老郑尸体的小监工都是穿越者互助组织成员，但所有人都对老郑的死无动于衷。"
                event {
                    type = "knowledge"
                    detail = "确认老郑、小监工的书友会身份"
                }
            }
            step 9 {
                description = "返回大通铺途中，林砚撞见老陈用老郑的血迹画组织暗号，两人对视后均装作无事发生。"
                event {
                    type = "status"
                    detail = "确认老陈书友会身份，双方心照不宣"
                }
            }
        }
    }
    
    chapter "暗积粮秣，潜备逃遁之资" {
        id = "P1-V1-C8"
        objective "私藏物资，筹备逃生计划" {
            step 1 {
                description = "林砚收到老陈悄悄压在自己铺位草席下的半块杂面窝头，发现窝头带有书友会专属的半开书页标记，不动声色将窝头揣进怀里。"
                event {
                    type = "acquire"
                    detail = "获得窝头，收到书友会联络信号"
                }
            }
            step 2 {
                description = "林砚用缝在衣襟里的灵石碎渣偷偷修炼，稳固练气二层修为，回忆此前撞见和自己复活灵光一致的绿光、老郑被周虎砸死喂妖兽的经历，彻底打消剧情光环的幻想，坚定逃生念头。"
                event {
                    type = "status"
                    detail = "修为稳固至练气二层，坚定逃生决心"
                }
            }
            step 3 {
                description = "林砚从老矿奴的议论中得知近期已有三名矿奴凭空失踪，确认是缉厄司提前三个月到场猎杀未隐藏好身份的穿越者。"
                event {
                    type = "knowledge"
                    detail = "确认穿越者猎杀现状"
                }
            }
            step 4 {
                description = "周虎以林砚此前交矿量超定额三成为由，将他发配到所有人避之不及的西坡三号贫矿道，要求每天多交两成矿，林砚清楚该矿道是自己笔下原主角的专属隐藏富矿带，暗中欣喜。"
                event {
                    type = "status"
                    detail = "被发配西坡三号矿道，获得挖矿优势"
                }
            }
            step 5 {
                description = "林砚利用监工每两个时辰换岗的两炷香空窗期，偷偷到富矿点挖取灵石，将完整灵石藏在岩缝，只上交贫矿碎渣凑重量，还挖到了珍贵的疗伤药物血蓟草。"
                event {
                    type = "acquire"
                    detail = "获得下品灵石、疗伤血蓟草"
                }
            }
            step 6 {
                description = "挖矿第十天遭遇周虎带队突击搜身，林砚情急之下将五块下品灵石含在嘴里，靠满嘴矿灰的样子躲过排查，后槽牙差点被灵石崩碎。"
                event {
                    type = "status"
                    detail = "躲过突击搜身"
                }
            }
            step 7 {
                description = "林砚撞见缉厄司人手持探灵光铜盘搜查偏僻矿道，躲进瘴气岔洞逃过一劫，决定偷偷用玄铁矿石磨制短刃防身。"
                event {
                    type = "status"
                    detail = "躲过缉厄司排查，决定制作防身武器"
                }
            }
            step 8 {
                description = "林砚分批将挖到的物资转移到只有自己知道的废弃矿道深处隐秘岩洞，发现岩洞门口有书友会的炭笔标记，顺手用矿灰抹除，确认书友会已经潜入黑风矿。"
                event {
                    type = "status"
                    detail = "藏匿物资，发现并抹除书友会标记，确认书友会潜入矿场"
                }
            }
            step 9 {
                description = "林砚清点藏身处物资，已有37块下品灵石（足够兑换出矿临时通行证还有富余）、5株血蓟草、2块磨出锋刃的玄铁矿石。"
                event {
                    type = "status"
                    detail = "完成物资清点，逃生资本初步积累"
                }
            }
            step 10 {
                description = "林砚发现岩洞深处的地下遗迹封印绿光比此前更亮，确认封印正在松动，推断缉厄司提前到场大概率是为了废弃矿道深处松动的“死后夺取”封印禁术遗迹。"
                event {
                    type = "knowledge"
                    detail = "确认缉厄司核心目标是禁术金手指“死后夺取”"
                }
            }
            step 11 {
                description = "林砚决定再在西坡三号矿道挖三天，凑够40块下品灵石再更换矿点，规避买通行证被克扣的风险。"
                event {
                    type = "status"
                    detail = "确定后续挖矿计划"
                }
            }
            step 12 {
                description = "林砚走出废弃矿道时撞见苏姓主事现身崖边，身边跟着灰衣暗卫，心头一沉。"
                event {
                    type = "location"
                    detail = "移动至矿道外，发现苏主事巡查"
                }
            }
            step 13 {
                description = "林砚返回大通铺时撞见老陈用镐头柄敲三下的书友会联络暗号，装作没看见侧身错开，决定优先攒够逃生筹码，暂不接触任何组织。"
                event {
                    type = "status"
                    detail = "回避书友会联络，优先推进逃生计划"
                }
            }
        }
    }
    
    chapter "复生被窥，灵石换得缄默" {
        id = "P1-V1-C9"
        objective "复活被小石头撞见，达成保密约定" {
            step 1 {
                description = "林砚攥着半块萤石进入丁字八号废弃矿道，打算藏匿刚挖的灵石，默算私藏的灵石已有三十七块下品灵石，加上当日新挖的三块共四十块，原定再挖三天就能凑够买通哨卡的五十块下品灵石，比原计划提前八天。"
                event {
                    type = "location"
                    detail = "移动至丁字八号废弃矿道，确认灵石积攒进度"
                }
            }
            step 2 {
                description = "林砚刚触碰到藏物资的岩洞的活动岩石，矿道突发小型坍塌，被磨盘大的落石砸中天灵盖死亡。"
                event {
                    type = "combat"
                    detail = "遭遇小型矿难，四次死亡"
                }
            }
            step 3 {
                description = "林砚很快复活，探察丹田发现修为从练气二层掉回练气一层，所幸未触碰到修为下限折损寿命。"
                event {
                    type = "status"
                    detail = "四次复活成功，修为跌至练气一层，无寿元损耗"
                }
            }
            step 4 {
                description = "林砚发现小矿奴小石头躲在岩柱后目睹了自己复活的全过程，小石头此前传闻被灰衣人带走，实际是未查出异常被放回，一直攒灵石想换临时身份牌逃去山外县城讨生活。"
                event {
                    type = "status"
                    detail = "复活被目击，获得小石头身份背景信息"
                }
            }
            step 5 {
                description = "林砚冲上前制住小石头，威胁他不许声张复活的事，小石头主动表示自己什么都没看见。"
                event {
                    type = "status"
                    detail = "威胁小石头保密，对方主动配合"
                }
            }
            step 6 {
                description = "林砚拿出两块下品灵石作为封口费交给小石头，要求他永远不许泄露相关消息。"
                event {
                    type = "acquire"
                    detail = "消耗两块下品灵石作为封口费"
                    on_complete = "达成保密约定"
                }
            }
            step 7 {
                description = "小石头收下灵石后承诺绝不会泄露秘密，还主动告知林砚自己小时候曾见过其他复活的人被灰衣人抓走，之前矿场失踪的矿奴大概率与此有关。"
                event {
                    type = "knowledge"
                    detail = "获得复活者被缉厄司抓捕的信息"
                }
            }
            step 8 {
                description = "小石头主动提出自己熟悉全矿所有暗道，包括监工都不知道的岔洞，林砚如果有需要可以到西坡废石堆划三道印子找他帮忙，不收钱。"
                event {
                    type = "status"
                    detail = "获得小石头协助承诺"
                }
            }
            step 9 {
                description = "听见矿道外传来看监工的呼喝声，小石头立刻攥着窝头溜了，生怕被人看见和林砚待在一起；林砚留在原地平复情绪，意识到原书未记载的意外极多，原定攒够灵石的计划因为修为掉级需要延长，决定后续稳妥行事，不再冒进。"
                event {
                    type = "status"
                    detail = "调整生存计划，行事转为稳妥"
                }
            }
        }
    }
    
    chapter "借矿难势，暗定逃出生天" {
        id = "P1-V1-C10"
        objective "敲定矿难逃生计划，提前探路准备" {
            step 1 {
                description = "林砚行至丁字八号矿道口时被监工周虎阻拦催促，只得跟随矿奴队伍前往搬运点搬运灵石原矿。"
                event {
                    type = "location"
                    detail = "移动至灵石搬运点，被周虎催促劳作"
                }
            }
            step 2 {
                description = "林砚劳作时反复回忆复活当日被小石头撞见、以及上午撞见缉厄司苏主事与灰衣暗卫排查的场景，意识到留在黑风矿场随时有暴露穿越者身份的风险，原本攒够五十块下品灵石买通哨卡逃矿的计划风险过高，已经不可行。"
                event {
                    type = "status"
                    detail = "原有买通哨卡的逃生计划作废"
                }
            }
            step 3 {
                description = "林砚想起自己所写的《矿脉仙途》原著剧情，得知三个月后黑风矿场西侧地脉会发生异动引发大范围矿难，届时矿场管事与监工都会优先抢救灵石仓库，对矿奴不管不顾，矿场警戒力量会降到最低，是绝佳的逃生窗口。"
                event {
                    type = "knowledge"
                    detail = "确认三个月后矿难逃生窗口"
                }
            }
            step 4 {
                description = "林砚当日收工时按定额上交所有开采的灵石，私藏1块下品灵石在怀中夹层未被监工发现，返程时撞见苏主事与灰衣暗卫议事，察觉对方比自己写的原设定更加冷厉，缉厄司的搜捕力度超出预期。"
                event {
                    type = "acquire"
                    detail = "私藏1块下品灵石"
                    on_complete = "确认缉厄司搜捕力度超标"
                }
            }
            step 5 {
                description = "林砚深夜起夜到茅房旁矮墙根时，偷听到两名监工闲聊，确认矿场内的灰衣人是官方组织缉厄司的暗卫，专门猎杀被称为“妖邪”的穿越者，带队的苏主事手段狠厉，可通过探查神魂、识别地球专属内容两种方式排查穿越者，此前已有穿越者因念出唐诗被当场烧死，连求情的矿主都被卸了一条胳膊。"
                event {
                    type = "knowledge"
                    detail = "获得缉厄司排查穿越者的具体方式"
                }
            }
            step 6 {
                description = "林砚确认缉厄司正是冲着黑风矿场内的穿越者而来，对方提前三个月到场，大概率是为了废弃矿道深处松动的“死后夺取”封印禁术遗迹，留给他的逃生时间实际不足三个月。"
                event {
                    type = "knowledge"
                    detail = "确认逃生时间仅剩三个月"
                }
            }
            step 7 {
                description = "林砚回到大通铺后敲定完整逃生计划，决定联络熟悉全矿暗道的小石头帮忙打探消息、筹备逃生物资，未来三个月绝不使用复活能力、绝不暴露任何穿越者特征，伪装成本土愚笨矿奴，提前准备备用复活点，矿难当日混在逃命矿奴中逃离。"
                event {
                    type = "status"
                    detail = "敲定完整矿难逃生计划"
                }
            }
            step 8 {
                description = "林砚决定次日向监工报备，谎称自己知道西坡矿道深处有未开采的零散小矿脉，借机申请去西坡挖矿，顺便探路、留下和小石头联络的记号，查看废弃矿道入口是否被封死。"
                event {
                    type = "status"
                    detail = "敲定次日探路与联络小石头的计划"
                }
            }
        }
    }
}