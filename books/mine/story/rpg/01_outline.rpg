            unit = "玄铁匕首"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "storage"
            delta = 1
            unit = "赤毛兔尸体"
          }
        }
      }
      step 4 {
        description = "林砚回城后先将黄叶草交给王掌柜，拿到5块下品灵石报酬和半袋灵草籽，王掌柜告知近日有穿粉裙的陌生小姑娘多方打听他的下落，已经帮他隐瞒了身份信息"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = 5
            unit = "piece"
          }
        }
      }
      step 5 {
        description = "林砚将赤毛兔尸体卖给坊市材料摊老板，拿到7块下品灵石"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = 7
            unit = "piece"
          }
        }
      }
      step 6 {
        description = "林砚花10块下品灵石租下半个月的独立修炼室，闭关修炼冲击瓶颈时发现左臂有复活折损导致的经脉暗伤，会拖慢灵气运转速度"
        event {
          type = "move"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -10
            unit = "piece"
          }
          state_delta {
            target = "char_linyan"
            kind = "injury"
            field = "left_arm_meridian"
            to = "minor dark injury"
            note = "复活折损导致的经脉暗伤，灵气运转速度降低30%"
          }
        }
      }
      step 7 {
        description = "林砚耗时五日成功突破至练气二层，灵气吸纳速度提升20%，左臂暗伤仍未完全痊愈，仅能做到灵气顺畅通过，运转速度还是比其他部位慢三成"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "level"
            from = "qi_1_late"
            to = "qi_2_early"
          }
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "spirit_absorb_speed"
            delta = 20
            unit = "percent"
            note = "突破至练气二层，吸纳速度额外提升20%"
          }
        }
      }
      step 8 {
        description = "林砚盘算后续计划：先巩固练气二层修为、再接王掌柜的采药委托攒灵石买温养经脉的灵药、回去给帮忙盯梢的小石头带蜜饯当奖励，顺便打听粉裙姑娘的动向"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "main_quest"
            to = "攒灵石购买温养经脉灵药，排查粉裙女子身份"
          }
        }
      }
