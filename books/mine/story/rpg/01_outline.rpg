  chapter "三月苦修登三层，试复生还闻主亲临" {
    id = "P1-V4-C6"
    objective "闭关修炼至练气三层，测试练气三层复活副作用" {
      step 1 {
        description = "林砚装出重病散修的样子，打发走前来打听他的粉裙女子，记录对方身上的松烟味与此前盯梢的素衣女子一致，判定为三哥势力眼线，威胁等级暂标橙色"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "disguise"
            to = "重病散修"
            note = "成功瞒过粉裙女子探查，未暴露身份"
          }
        }
      }
      step 2 {
        description = "林砚与被他救过的小孩小石头约定盯梢暗号：闭关期间无异常就每日在修炼室窗台放一颗干净小石子，有危险就敲三下玻璃"
        event {
          type = "status"
          state_delta {
            target = "char_xiaoshitou"
            kind = "transition"
            field = "side_quest"
            to = "每日在修炼室窗台放石子报平安，有危险敲三下玻璃"
          }
        }
      }
      step 3 {
        description = "林砚花费近半积蓄续了两个半月的修炼室租期，又托王掌柜购入半瓶低阶聚气丹，准备闭关冲级"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -35
            unit = "piece"
            note = "支付修炼室租金和聚气丹费用"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "storage"
            unit = "低阶聚气丹"
          }
        }
      }
      step 4 {
        description = "林砚闭关一个半月，靠自己设定的「糙汉经脉buff」吸纳灵气速度为同阶修士一倍，全程仅靠干麦饼和灵泉水度日未出修炼室，小石头每日放石子报平安，让他无需分心警戒"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "progress"
            delta = 70
            unit = "percent"
            note = "闭关一个半月，练气二层修为进度达70%"
          }
        }
      }
      step 5 {
        description = "闭关第四十五天恰好是林砚逃入青牛镇第九十天，林砚灵气累积到突破临界点，先使用八块下品灵石购入的低阶测寿玉简测得剩余寿元为14年，核算后判定复活测试风险可控"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -8
            unit = "piece"
            note = "购买低阶测寿玉简"
          }
          state_delta {
            target = "char_linyan"
            kind = "lifespan"
            field = "remaining_years"
            to = "14年"
            note = "确认剩余寿元，复活测试风险可控"
          }
        }
      }
      step 6 {
        description = "林砚运转功法突破瓶颈，顺利升到练气三层，困扰他两个月的左臂暗伤大幅好转，灵气运转几乎不再滞涩"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "level"
            from = "qi_2_early"
            to = "qi_3_early"
          }
          state_delta {
            target = "char_linyan"
            kind = "injury"
            field = "left_arm_meridian"
            to = "almost recovered"
            note = "左臂暗伤大幅好转，灵气运转速度仅降低10%"
          }
        }
      }
      step 7 {
        description = "林砚听到窗外两名散修交谈，得知三哥已经亲自到青牛镇坐镇缉拿穿越者，持有可识别穿越者的照魂盘，被抓的穿越者会被抽走神魂补天道、魂飞魄散，三哥势力手下腰牌刻有淡蓝色云纹"
        event {
          type = "knowledge"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "threat_level"
            to = "red"
            note = "三哥亲临青牛镇，持有照魂盘，威胁等级提升至最高红色"
          }
        }
      }
      step 8 {
        description = "林砚将三哥的威胁等级从橙色调整为最高级红色，决定立刻测试复活能力摸清底牌，主动触碰修炼室门后内置的淬毒禁制（练气三层及以下中者必死）"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "death"
            field = "status"
            to = "temporary_death"
            note = "主动触碰淬毒禁制触发复活"
          }
        }
      }
      step 9 {
        description = "林砚中腐骨毒身亡后成功复活，修为掉到练气二层巅峰，仅折寿2年，复活副作用相比练气一层时降低80%，验证了「修为越高复活副作用越低」的猜想"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "revive"
            field = "status"
            to = "revived"
          }
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "level"
            from = "qi_3_early"
            to = "qi_2_peak"
          }
          state_delta {
            target = "char_linyan"
            kind = "lifespan"
            field = "remaining_years"
            delta = -2
            unit = "year"
            note = "本次复活仅折寿2年，副作用降低80%，验证猜想正确"
          }
        }
      }
      step 10 {
        description = "林砚清点剩余灵石足够买两瓶聚气散补修为，打算外出探听三哥底细，还要给盯梢两个多月无差错的小石头带两串糖葫芦当奖励，随后拉开修炼室木门准备外出"
        event {
          type = "move"
        }
      }
    }
  }
  chapter "坊角留笺邀旧友，烟痕如昔引疑踪" {
    id = "P1-V4-C7"
    objective "确认书友会暗线身份，权衡赴约风险" {
      step 1 {
        description = "林砚闭关三月突破炼气三层又回落至二层巅峰，丹田灵气虚浮，出门计划购买聚气散补修为、给小石头买约定好的糖葫芦，同时打探缉厄司的搜捕尺度"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "main_quest"
            to = "购买聚气散补修为，打探缉厄司搜捕尺度"
          }
        }
      }
      step 2 {
        description = "林砚刻意绕偏僻小巷行走，遮掩左手腕的黑风矿专属玄铁镣铐印，避免暴露穿越者身份"
        event {
          type = "move"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "exposure_risk"
            delta = -50
            unit = "percent"
            note = "刻意遮掩身份痕迹，暴露风险降低"
          }
        }
      }
      step 3 {
        description = "林砚到丹药摊砍价，以两块五下品灵石一瓶的价格购入两瓶聚气散，从摊主口中得知缉厄司由三哥坐镇、持照魂盘搜捕穿越者，且书友会内部藏有缉厄司安插的内鬼"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -5
            unit = "piece"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "storage"
            delta = 2
            unit = "低阶聚气散"
          }
        }
      }
      step 4 {
        description = "林砚行至坊市出口拐角时恰逢散修吵架吸引所有人注意力，被灰衣伙计陈默故意撞到，对方刻意提及查内鬼、三哥渗透的信息后快速离开"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "contact_status"
            to = "书友会暗线主动接触"
          }
        }
      }
      step 5 {
        description = "林砚发现被塞了一张写有「三日后坊市后破庙见，同为写书人」的炭笔字条，认出字条上的特殊松烟味与此前遇到的粉裙女子、素衣女子身上的味道完全一致"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "storage"
            delta = 1
            unit = "书友会接头字条"
          }
        }
      }
      step 6 {
        description = "林砚确认递字条的是书友会暗线陈默，权衡赴约风险后决定赴约，运转灵气将字条烧毁不留痕迹"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "main_quest"
            to = "三日后前往坊市后破庙赴约，提前做好后手准备"
          }
        }
      }
      step 7 {
        description = "林砚计划接下来三日内补回炼气三层修为，提前去破庙踩点准备多重后手，安排小石头帮忙盯梢破庙周边的陌生人员"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "side_quest"
            to = "三日内恢复练气三层修为，前往破庙踩点布置后手"
          }
          state_delta {
            target = "char_xiaoshitou"
            kind = "transition"
            field = "side_quest"
            to = "盯梢破庙周边陌生人员动向"
          }
        }
      }
      step 8 {
        description = "林砚返程途中再次闻到同款松烟味，瞥见素衣女子的半角裙角在巷口一闪而逝"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "exposure_risk"
            delta = 30
            unit = "percent"
            note = "被眼线跟踪，暴露风险提升"
          }
        }
      }
    }
  }
  chapter "伏兵陡现巧突围" {
    id = "P1-V5-C9"
    objective "赴破庙接头，应对缉厄司埋伏" {
      step 1 {
        description = "林砚按约定时间前往坊市后破庙赴约，提前做好多重后手，小石头在破庙外围盯梢放风"
        event {
          type = "move"
        }
      }
      step 2 {
        description = "林砚与陈默接头，确认对方书友会暗线身份，双方交换缉厄司、内鬼相关情报"
        event {
          type = "knowledge"
        }
      }
      step 3 {
        description = "两人谈话时，缉厄司的搜捕队突然包围了破庙，陈默用话术操控金手指拖住捕快，林砚引动提前布置的坍塌制造混乱"
        event {
          type = "combat"
          enemies = []
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "combat_situation"
            to = "advantage"
            note = "制造混乱占据上风"
          }
        }
      }
      step 4 {
        description = "两人联手成功脱身，未被缉厄司抓获，未暴露身份"
        event {
          type = "move"
        }
      }
    }
  }
