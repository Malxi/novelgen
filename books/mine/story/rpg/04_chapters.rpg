
metadata {
  title = "穿越者的天道弈局"
  dsl_version = "0.2.0"
}

characters {
  player "林砚" {
    id = "char_linyan"
    class = "穿书者·练气一层"
    str = 5
    agi = 7
    int = 10
    vit = 6
  }
  npc "小石头" {
    id = "char_xiaoshitou"
    role = "情报提供者·潜在盟友"
    description = "十二岁本地矿奴，父母死于矿难，无依无靠，靠给年长矿奴跑腿换食物，熟悉黑风矿所有暗道岔洞包括监工不知道的隐秘路线，之前见过复活者被灰衣人抓走，正在攒灵石换临时身份牌想逃去山外县城，收下林砚2块下品灵石封口费后承诺保密，愿意为林砚提供情报与路线支持"
  }
  npc "周虎" {
    id = "char_zhou_hu"
    role = "黑风矿监工/缉厄司外围线人"
    description = "黑风矿监工，左脸有一道从眉骨划到下颌的刀疤，性格残忍贪婪，靠盘剥矿奴灵石牟利，是缉厄司的外围线人，修为练气四层。"
    default_location = "loc_heifeng_mine_tunnel_entrance"
  }
  npc "暗卫甲（七十三）" {
    id = "char_wei_73"
    role = "缉厄司暗卫"
    description = "缉厄司底层暗卫，编号七十三，练气九层修为，性格冷酷谨慎，负责黑风矿区域的穿越者排查与遗迹探查，手上沾染多名穿越者的性命。"
    default_location = "loc_heifeng_mine_abandoned_deep_tunnel"
  }
  npc "暗卫乙" {
    id = "char_wei_b"
    role = "缉厄司暗卫"
    description = "缉厄司底层暗卫，练气七层修为，性格贪财鲁莽，是暗卫甲的副手，一直想抓穿越者换赏金凑够买筑基丹的钱。"
    default_location = "loc_heifeng_mine_abandoned_deep_tunnel"
  }
  npc "小石头" {
    id = "char_xiao_shi_tou"
    role = "黑风矿矿奴/林砚盟友"
    description = "黑风矿的小矿奴，父母双亡，熟悉矿道所有地形，嘴严守信，之前差点被监工放养的恶犬咬死时被林砚救下，是林砚逃离计划的核心盟友。"
    default_location = "loc_heifeng_mine_miner_dormitory"
  }
  npc "顾大人" {
    id = "char_gu"
    role = "缉厄司高层"
    description = "缉厄司高层，是本次黑风矿禁术解封行动的总负责人，修为高深，心思缜密，目标是取出「死后夺取」禁术收割所有西境穿越者的天道碎片。"
    default_location = "缉厄司青牛镇分舵"
  }
  npc "书友会成员" {
    id = "char_book_club_member"
    role = "穿越者互助组织成员"
    description = "穿越者互助组织「书友会」的潜伏成员，目前在黑风矿内活动，暗中收集缉厄司的相关情报，帮助被追杀的穿越者脱身。"
    default_location = "loc_heifeng_mine_miner_dormitory"
  }
  npc "小石头" {
    id = "char_002"
    role = "队友"
    description = "黑风矿本地矿奴，父亲早年参与过黑风矿地下遗迹修建，对所有矿道路径了如指掌，机灵重诺，从小佩戴另一半云纹碎玉，是林砚逃亡路上的核心队友。"
  }
  npc "周虎" {
    id = "char_003"
    role = "前期反派"
    description = "黑风矿监工，残暴贪财，被缉厄司高层三哥收买为外围眼线，负责排查矿场行为异常的穿越者，知晓林砚的反常举动，以筑基丹为悬赏要抓捕林砚。"
  }
  npc "缉厄司暗卫甲（缉字七十三号）" {
    id = "char_004"
    role = "反派喽啰"
    description = "缉厄司正式暗卫，练气七层修为，家乡曾被失控穿越者摧毁，对穿越者抱有极强恨意，受三哥指令率队抓捕林砚。"
  }
  npc "缉厄司暗卫乙（缉字九十二号）" {
    id = "char_005"
    role = "反派喽啰"
    description = "缉厄司正式暗卫，练气七层修为，妹妹被三哥扣押作为人质，为换取妹妹自由参与抓捕林砚行动，打算将林砚作为投名状献给苏小姐。"
  }
  npc "三哥" {
    id = "char_006"
    role = "核心反派"
    description = "缉厄司高层，主导黑风矿穿越者排查行动，知晓林砚的复活能力与隐藏岩洞位置，全程监控林砚的逃亡计划，故意放林砚逃离打算顺藤摸瓜找到其他穿越者与禁术另一半碎片。"
  }
  npc "老矿头" {
    id = "char_007"
    role = "路人NPC"
    description = "黑风矿资历最老的矿奴，知晓大量矿道隐秘与地下传闻，售卖劣质掩息符给林砚，背景未知。"
  }
  npc "小监工" {
    id = "char_008"
    role = "龙套反派"
    description = "周虎的远房外甥，负责盯梢林砚，欠矿奴赵大赌债，矿崩时被落石砸死。"
  }
  npc "苏小姐" {
    id = "char_009"
    role = "隐藏反派"
    description = "缉厄司高层，暗卫乙抓捕林砚作为投名状的敬献对象，身份神秘，权柄高于三哥。"
  }
  npc "char_xiao_shi_tou" {
    id = ""
    role = "主角追随者"
    description = "黑风矿矿奴后代，被林砚从矿洞塌方中救出后死心塌地追随，机灵谨慎，擅长盯梢探听消息"
    default_location = "loc_qing_niu_zhen_bian_min_tong_pu"
  }
}

world {
  location "黑风灵石矿丁字八号废弃矿道" {
    id = "loc_heifeng_ding8"
    description = "黑风矿最偏僻的废弃矿道之一，连通林砚藏物资的隐蔽岩洞与地下遗迹外围区域，常年有落石坍塌风险，监工极少巡查，是矿奴偷偷藏东西、躲懒的隐秘去处"
  }
  location "黑风灵石矿西坡废石堆" {
    id = "loc_heifeng_xipo_dump"
    description = "西坡矿脉废弃石料的集中堆放地，偏僻荒凉几乎没人来，是林砚和小石头约定的秘密联络点"
  }
  location "黑风矿矿道入口" {
    id = "loc_heifeng_mine_tunnel_entrance"
    description = "黑风矿所有矿道的总入口，是矿奴上下工、交灵石、监工盘查的核心区域，常年有监工把守，戒备森严。"
  }
  location "黑风矿西坡废石堆" {
    id = "loc_heifeng_mine_west_slope_waste_rock_pile"
    description = "黑风矿西坡堆放开采废弃矿渣的区域，人迹罕至，是矿奴私下传递消息、藏匿物资的隐蔽地点。"
  }
  location "黑风矿未登记废弃深矿道" {
    id = "loc_heifeng_mine_abandoned_deep_tunnel"
    description = "黑风矿最深处未登记在矿场地图上的废弃矿道，因早年矿难死了多名矿奴被封禁，深处连通封印「死后夺取」禁术的上古遗迹。"
  }
  location "黑风矿矿奴大通铺" {
    id = "loc_heifeng_mine_miner_dormitory"
    description = "黑风矿底层矿奴的集体居所，环境简陋拥挤，漏风漏雨，几十名矿奴挤在通铺上休息，没有任何隐私可言。"
  }
  location "黑风矿西岔道" {
    id = "loc_heifeng_mine_west_branch_tunnel"
    description = "黑风矿西侧的废弃岔道，位置偏僻监工很少巡逻，是林砚和小石头约定的秘密碰头地点。"
  }
  location "黑风矿地下遗迹入口" {
    id = "loc_heifeng_mine_forbidden_ruins_entrance"
    description = "封印「死后夺取」禁术的上古遗迹的外围入口，岩壁上刻满血色符文，只有持对应残玉才能触发机关打开。"
  }
  location "黑风矿地下遗迹外围" {
    id = "loc_heifeng_mine_forbidden_ruins_outer"
    description = "上古遗迹的外围区域，空气中弥漫着高浓度灵气和浸骨阴气，岩壁上刻满上古符文，没有任何照明，能见度极低。"
  }
  location "黑风矿废弃矿道落石陷阱" {
    id = "loc_heifeng_mine_abandoned_tunnel_rockfall_trap"
    description = "林砚半个月前提前布置的落石陷阱，只要有重物落地的震动就会触发坍塌，掩埋现场所有痕迹。"
  }
  location "黑风矿废弃矿道岔路口" {
    id = "loc_heifeng_mine_abandoned_tunnel_fork"
    description = "废弃矿道内的岔路口，位置偏僻，岩层稳定，是林砚复活金手指的固定刷新位置。"
  }
  location "黑风矿西侧废弃支矿道" {
    id = "loc_002"
    description = "黑风矿已停产的偏僻支矿道，岩层被地下水泡酥达12年，微小灵力震动即可触发连锁坍塌，是林砚设计坑杀周虎与缉厄司暗卫的陷阱区域。"
  }
  location "黑风矿隐藏岩洞" {
    id = "loc_003"
    description = "林砚耗时三个月找到的隐秘藏身处，位于废弃矿道深处，仅知晓精准路径才可进入，存放着逃亡物资与半块封印玉佩，仅林砚与小石头知晓位置。"
  }
  location "黑风矿后山隐蔽小路" {
    id = "loc_004"
    description = "小石头父亲参与修建地下遗迹时开辟的秘密逃生路径，狭窄仅容一人通行，遍布荆棘无监工巡逻，是逃离黑风矿的唯一隐蔽路线。"
  }
  location "黑松林边缘" {
    id = "loc_005"
    description = "黑风矿外围的天然屏障，过了黑松林就彻底脱离黑风矿管控范围，通往青牛镇的必经之路。"
  }
  location "黑风矿哨塔" {
    id = "loc_006"
    description = "黑风矿最高观测点，常年有监工与缉厄司暗卫巡逻，可俯瞰整个矿场路径。"
  }
  location "loc_qing_niu_zhen" {
    id = ""
    type = "低阶修士聚居城镇"
    description = "位于黑风灵石矿附近的小型修仙城镇，是周边底层散修、矿奴、采药人的主要活动区域，目前被缉厄司管控"
  }
}

storyline {
  chapter "复生被窥，灵石换得缄默" {
    id = "P1-V1-C1"
    objective "处理复活秘密被撞破的危机，确保复活能力不暴露，稳定当前生存局面" {
      step 1 {
        description = "林砚将当日新挖到的3块下品灵石藏进隐蔽岩洞，核算总积蓄已达40块，原定再挖3天就能凑够50块买通哨卡逃矿，比计划提前8天"
      }
      step 2 {
        description = "林砚正准备离开岩洞时，矿道顶部突发小型落石坍塌，磨盘大的落石直接砸中他天灵盖，当场死亡；随后触发复活能力，复活时逸散的淡绿色灵光被衣襟内的血色玉佩吸收掩盖，未留下痕迹，修为从练气二层掉回练气一层，未触达修为下限因此未折损寿命"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "修为"
            from = "练气二层"
            to = "练气一层"
            note = "复活强制掉级，挖矿效率小幅下降，原定3天攒够灵石的计划延后至少大半个月"
          }
        }
      }
      step 3 {
        description = "林砚刚站稳就发现躲在斜后方岩柱后的小石头撞见了复活全程，得知原本被送去郑家村投靠姑母的小石头因姑母染疫病去世，早已逃回矿场多日，正在攒碎灵石想换临时身份牌逃去山外县城，刚才是来废弃矿道捡碎灵石才撞见了异常"
      }
      step 4 {
        description = "林砚迅速制住小石头，先口头掩饰自己是提前躲进旁边岩缝避过落石，再出言威胁泄露秘密就会让他死无全尸，察觉小石头有交易意图后，拿出2块下品灵石作为封口费"
        event {
          type = "relationship"
          state_delta {
            kind = "relationship"
          }
        }
      }
      step 5 {
        description = "小石头收下灵石立刻藏好，承诺死都不会泄露半个字，主动透露自己小时候见过另一名复活者被灰衣人抓走，告知林砚以后有需要可以到西坡废石堆划三道印子找他，随后听见矿道入口传来监工呼喝声，立刻猫着腰溜得无影无踪"
      }
      step 6 {
        description = "林砚复盘本次意外，意识到原书剧情存在大量他从未写过的未知隐患，同时发现隐蔽岩洞缝隙透出的地下遗迹封印淡绿色微光比半个月前亮了不少，判断封印松动速度加快，缉厄司的搜索力度会越来越大，留给自己攒钱逃矿的时间比预想的少得多"
        event {
          type = "status"
          state_delta {
            target = "地下遗迹封印松动线"
            kind = "transition"
            field = "进度"
            from = "30%"
            to = "40%"
            note = "封印逸散的微光变亮，缉厄司搜捕穿越者的力度会进一步加大，逃矿时间窗口大幅压缩"
          }
        }
      }
    }
  }
  chapter "监工鞭落，死矿催命" {
    id = "P1-V2-C1"
    objective "林砚伪装躲避探查，初探废弃矿道" {
      step 1 {
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "supplies"
            from = "无"
            to = "1块下品灵石+半块萤石"
            note = "确认随身物资完好，用矿灰掩盖容貌伪装憨傻矿奴"
          }
        }
      }
      step 2 {
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "transition"
            field = "detection_status"
            to = "未被发现"
            note = "借助矿场地脉符文波动和复活金手指自带的微弱隐匿效果，躲过练气九层暗卫的探查"
          }
        }
      }
      step 3 {
        event {
          type = "status"
          state_delta {
            target = "pt_escape_plan"
            kind = "transition"
            to = "推进"
            note = "在西坡废石堆留下三角暗号，约定和小石头亥时碰头协商逃离计划"
          }
        }
      }
      step 4 {
        event {
          type = "combat"
          combat {
            enemies = [{id = "char_zhou_hu", count = 1, level = 4}]
          }
          state_delta {
            target = "char_lin_yan"
            kind = "injury"
            field = "back"
            to = "轻伤"
            note = "被周虎一鞭抽中后背，粗布短打撕裂，留下血痕"
          }
        }
      }
      step 5 {
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "mining_quota"
            to = "每日5块下品灵石，当日先交3块"
            note = "被周虎恶意刁难，要求高额挖矿配额，完不成会被重罚甚至打死"
          }
        }
      }
      step 6 {
        event {
          type = "knowledge"
          state_delta {
            target = "char_lin_yan"
            kind = "transition"
            field = "forbidden_artifact_clue"
            to = "获得"
            note = "察觉废弃矿道灵气浓度远超普通区域，怀疑深处藏有「死后夺取」禁术封印遗迹"
          }
        }
      }
      step 7 {
        event {
          type = "acquire"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "rune_stone"
            note = "捡到与禁术同源的血纹碎石，指尖触碰有针刺感，疑似封印的一部分"
          }
        }
      }
      step 8 {
        event {
          type = "status"
          state_delta {
            target = "pt_forbidden_artifact_explore"
            kind = "transition"
            to = "开启"
            note = "发现深处有异常绿光和低语，朝着疑似遗迹的方向前进"
          }
        }
      }
    }
  }
  chapter "血纹无载，越界天规" {
    id = "P1-V2-C2"
    objective "探查废弃矿道深处，确认未知遗迹存在" {
      step 1 {
        event {
          type = "knowledge"
          state_delta {
            target = "char_lin_yan"
            kind = "transition"
            field = "miner_death_clue"
            to = "获得"
            note = "发现此前擅自闯入矿道的矿奴焦尸，死者手指直指岩壁符文方向"
          }
        }
      }
      step 2 {
        event {
          type = "acquire"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "low_grade_spirit_stone"
            note = "捡到4块下品灵石碎块，填补当日配额缺口"
          }
        }
      }
      step 3 {
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "transition"
            field = "soul_status"
            to = "轻微刺痛"
            note = "神魂受遗迹封印力量影响，出现持续刺痛感"
          }
        }
      }
      step 4 {
        event {
          type = "knowledge"
          state_delta {
            target = "char_lin_yan"
            kind = "transition"
            field = "rune_seal_clue"
            to = "获得"
            note = "确认岩壁上的血色符文是封印外围，触碰到会触发雷系攻击，此前矿奴就是触碰符文惨死"
          }
        }
      }
      step 5 {
        event {
          type = "status"
          state_delta {
            target = "pt_world_abnormality_clue"
            kind = "transition"
            to = "开启"
            note = "察觉当前世界剧情完全脱离自己所写的原书设定，存在未知变量"
          }
        }
