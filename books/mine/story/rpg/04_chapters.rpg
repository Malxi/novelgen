            field = "discovered_status"
            to = "未被发现"
            note = "暗卫误以为是常规自然坍塌，怕被落石伤到，没有进入矿道查看，成功蒙混过关"
          }
        }
      }
      step 4 {
        event {
          type = "acquire"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "low_grade_spirit_stone"
            delta = 5
            note = "取出预先藏好的五块下品灵石，伪装成挖矿成果，蹭矿灰掩盖虎口血痕"
          }
        }
      }
      step 5 {
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "transition"
            field = "disguise_status"
            to = "成功"
            note = "伪装成被坍塌吓到的普通矿奴，表现符合常态，未引起周虎怀疑"
          }
        }
      }
      step 6 {
        event {
          type = "combat"
          combat {
            enemies = [{id = "char_zhou_hu", count = 1, level = 4}]
          }
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "low_grade_spirit_stone"
            delta = -2
            note = "被周虎没收两块灵石孝敬，挨了一鞭，未暴露任何异常，周虎转身离开"
          }
        }
      }
      step 7 {
        event {
          type = "status"
          state_delta {
            target = "pt_escape_plan"
            kind = "transition"
            to = "通知盟友"
            note = "留下三角暗号通知小石头提前两天碰头，通过联络石确认附近安全，没有其他人员"
          }
        }
      }
      step 8 {
        event {
          type = "status"
          state_delta {
            target = "pt_escape_plan"
            kind = "transition"
            to = "确定提前一个月执行"
            note = "正式确定将逃离计划提前一个月，接下来需要准备逃离物资，寻找安全地方藏匿残玉"
          }
        }
      }
    }
  }
  chapter "P1-V3-C1 岩洞密约，雨夜逃期" {
    id = "P1-V3-C1"
    objective "约定逃亡" {
      step 1 {
        description = "林砚在黑风矿主矿道挖矿时，收到小石头扔来的、刻有三道杠的暗号石子，约定提前碰头。"
        event {
          type = "knowledge"
        }
      }
      step 2 {
        description = "林砚故意拖延交矿时间，绕开监工视线前往隐藏岩洞，清点三个月攒下的逃亡物资：37块下品灵石、5株血蓟草、1把玄铁匕首、2天分量的麦麸饼，确认隐匿残玉作为应急后手。"
        event {
          type = "status"
          state_delta {
            target = "char_001"
            kind = "resource"
            field = "items"
            note = "林砚确认所有逃亡物资齐全，做好逃亡准备。"
          }
        }
      }
      step 3 {
        description = "林砚在西侧矿道岔口与小石头汇合，得知三日后缉厄司高层三哥将携带探魂石全矿排查穿越者，原定一个月的逃亡计划完全赶不上。"
        event {
          type = "knowledge"
        }
      }
      step 4 {
        description = "林砚提出带小石头一起逃往青牛镇的计划，给出三日后暴雨夜引动矿道坍塌、引开巡逻队从后山小路逃亡的方案，成功说服犹豫的小石头同意合作。"
        event {
          type = "status"
        }
      }
      step 5 {
        description = "小石头拿出父亲当年修建地下遗迹时捡到的半块云纹碎玉，告知前几日见过袖口绣有相同云纹的黑袍人（三哥）来矿场找周虎，打探死而复生的异常人员。"
        event {
          type = "acquire"
          state_delta {
            target = "char_002"
            kind = "resource"
            field = "items"
            note = "小石头拿出半块云纹碎玉，证实缉厄司已经在找林砚。"
          }
        }
      }
      step 6 {
        description = "林砚触碰云纹碎玉时神魂产生刺痛，怀中的书友会联络石同步震动，确认碎玉与缉厄司针对穿越者的压制法器同源，将碎玉信息记为保命底牌。"
        event {
          type = "knowledge"
        }
      }
      step 7 {
        description = "二人核对三日后汇合细节与暗号，小石头先行离开，林砚将物资放回隐藏岩洞，潜回矿奴大通铺，逃亡正式进入倒计时。"
      }
    }
  }
  chapter "P1-V3-C2 暗标支点，矿脉伏机" {
    id = "P1-V3-C2"
    objective "标记坍塌支点" {
      step 1 {
        description = "天刚亮林砚混在上工矿奴队伍里，撞见周虎带矿卫前往西二矿道搜捕可疑人员，用半块碎灵石从老矿头处打听得知昨夜起全矿搜捕行踪诡异人员，天亮就将封禁所有偏僻支矿道。"
        event {
          type = "knowledge"
        }
      }
      step 2 {
        description = "林砚趁换岗最后混乱时刻，伪装成偷溜进矿道挖碎灵石的矿奴，绕开监工巡逻路线走偏僻支脉潜入主矿道。"
      }
      step 3 {
        description = "林砚先后找到西二矿道深处、东一主矿道岔口上方两个核心坍塌支点，用指甲在岩壁刻上专属三角标记，掩盖自己的脚印痕迹。"
        event {
          type = "status"
        }
      }
      step 4 {
        description = "林砚前往南三矿道标记最后一个核心支点时，撞见缉厄司黑袍暗卫用传讯符汇报排查进度，立即躲进空矿篓催动劣质掩息符隐蔽。"
        event {
          type = "status"
          state_delta {
            target = "char_001"
            kind = "resource"
            field = "items"
            note = "林砚使用一张劣质掩息符掩盖灵力波动，剩余2张。"
          }
        }
      }
      step 5 {
        description = "林砚偷听到暗卫提到已经注意到他总往废弃矿道钻的异常，本次排查目标就是找有复活能力的穿越者，行动由上级三哥与苏小姐主导。"
        event {
          type = "knowledge"
        }
      }
      step 6 {
        description = "暗卫嫌矿篓太脏未翻查，离开后林砚等一刻钟才出来，标记完第三个核心坍塌支点，绕路确认之前埋的黑火药位置完好未被移动。"
        event {
          type = "status"
        }
      }
      step 7 {
        description = "林砚混在早班进矿的矿奴队伍里归队，意识到自己已经被缉厄司盯上，逃亡计划出现未知变数。"
      }
    }
  }
  chapter "P1-V3-C3 监工疑踪，份额陡增" {
    id = "P1-V3-C3"
    objective "应对周虎刁难" {
      step 1 {
        description = "十个时辰早班结束，林砚混在出工矿奴队伍里准备回大通铺，周虎在监工棚台阶上当众喊住他，将他的每日挖矿份额提升到十块下品灵石，完不成就打断腿扔去喂狼。"
        event {
          type = "status"
        }
      }
      step 2 {
        description = "林砚路过周虎身边时，偷听到周虎跟小监工嘀咕，三哥三日后要带探魂石全矿排查，放跑穿越者两人都要掉脑袋，抓到活的赏百块灵石，让小监工盯紧林砚，事成了分他十块灵石还清赌债。"
        event {
          type = "knowledge"
        }
      }
      step 3 {
        description = "林砚故意摔了一跤，装出被吓破胆的懦弱样子，成功蒙骗周虎，背着矿篓进矿道后没有去偏僻支脉，反而选监工视线最好的公共作业区，放慢挖矿速度装出体力不支的样子麻痹盯梢的小监工。"
      }
      step 4 {
        description = "林砚梳理处境，确认推迟逃亡等于主动送死，只能按原计划执行，必须先解决周虎与小监工才能继续完成剩余支点标记。"
        event {
          type = "status"
        }
      }
      step 5 {
        description = "一天下来林砚只挖了两块碎灵石，交矿时周虎大怒，勒令小监工次日起寸步不离跟着林砚，小监工答应时露出如释重负的表情，显然担心赌债无法偿还。"
      }
      step 6 {
        description = "林砚表面惶恐应下处罚，内心已经确定要先解决周虎的麻烦，再推进逃亡计划。"
      }
    }
  }
  chapter "P1-V3-C4 嫁祸栽赃，阵成暗巷" {
    id = "P1-V3-C4"
    objective "嫁祸引开监工，完成灵阵布置" {
      step 1 {
        description = "林砚揣着赵大的灵石碎块熬了一夜，敲定嫁祸方案，确定不推迟逃亡计划，仍按原计划三日后雨夜引动矿崩。"
      }
      step 2 {
        description = "次日正午换班，林砚故意放慢挖矿速度，等盯梢的小监工熬不住去食堂吃饭，装咳疾发作要去茅房，支走留下盯梢的残疾老矿奴。"
      }
      step 3 {
        description = "林砚趁巡逻队换岗间隙溜进空无一人的大通铺，将三块下品灵石藏进赵大的铺草深处，意外发现小监工欠赵大的赌债欠条，认出字迹和小监工记工本一致后将欠条收走。"
        event {
          type = "acquire"
          state_delta {
            target = "char_001"
            kind = "resource"
            field = "items"
            note = "林砚获得小监工的赌债欠条，掌握小监工的把柄。"
          }
        }
      }
      step 4 {
        description = "林砚返回矿道时刚好遇上周虎清点灵石发现少了三块大发雷霆，故意撞响矿篓引周虎注意，装作怯懦的样子谎称看见赵大私藏亮闪闪的东西跑回了大通铺。"
      }
      step 5 {
        description = "周虎本就不满赵大平时偷鸡摸狗，闻言立刻带跟班去大通铺搜出藏好的三块灵石，当场将赵大打至晕死，下令把赵大关去柴房，次日扔去最深的废矿道挖矿。"
        event {
          type = "status"
        }
      }
      step 6 {
        description = "林砚趁所有人都凑去大通铺看热闹的间隙，钻进矿道深处的岔路布置七个坍塌支点的灵石触发阵，中途撞见缉厄司暗卫巡逻，躲进岩缝未被发现。"
      }
      step 7 {
        description = "不到半个时辰林砚就布置完全部触发阵，返回时看见矿场制高点岩台上站着个通体黑袍的人，对方腰间玉佩的云纹和怀里揣了半个月的半块碎玉纹路完全一致，再抬眼时黑袍人已经消失。"
        event {
          type = "knowledge"
        }
      }
      step 8 {
        description = "林砚装作怯懦的样子凑到围观人群里，看见小监工因周虎没搜出赌债欠条松了口气偷偷溜走，确认所有布置完成，仍按原计划执行逃亡。"
      }
    }
  }
  chapter "P1-V3-C5 引动灵阵，矿崩天倾" {
    id = "P1-V3-C5"
    objective "引动矿崩逃亡" {
      step 1 {
        description = "三日后暴雨夜，林砚趁监工都在草棚赌钱的时机，溜进主矿道触发提前布置好的坍塌灵阵。"
        event {
          type = "status"
        }
      }
      step 2 {
        description = "被暴雨浸泡三日的岩层比预想脆弱，矿崩比计划提前九个呼吸爆发，主矿道大面积垮塌引发混乱，矿奴哭喊声、监工怒骂声混杂在一起。"
      }
      step 3 {
        description = "放风的小石头按约定逃往黑风矿后山隐藏岩洞，林砚留下确认监工周虎是否死于矿崩。"
      }
      step 4 {
        description = "冲进矿道抢灵石的小监工被落石砸中身亡，林砚捡到小监工欠赵大的赌债欠条。"
      }
      step 5 {
        description = "林砚撤离时被掉落的实木横梁砸中后背失去意识，死而复生后出现在废弃矿道出口，修为从练气二层跌至练气一层。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "environment", count = 1}]
          }
          state_delta {
            target = "char_001"
            kind = "status"
            field = "level"
            from = "练气二层"
            to = "练气一层"
            note = "林砚被落石砸死，复活后修为掉级，未折损寿元。"
          }
        }
      }
      step 6 {
        description = "林砚确认小石头已经安全躲进岩洞，发现缉厄司三哥带着暗卫守在矿场所有明面上的出口，安排人手排查穿越者。"
        event {
          type = "knowledge"
        }
      }
      step 7 {
        description = "周虎从矿崩中逃生，找到林砚的藏身位置，举着砍矿砍刀要杀林砚泄愤。"
      }
      step 8 {
        description = "缉厄司暗卫朝着废弃矿道方向搜查过来，林砚陷入前后夹击的死局。"
      }
    }
  }
  chapter "P1-V3-C6 引虎入瓮，碎石封仇" {
    id = "P1-V3-C6"
    objective "设计杀死周虎" {
      step 1 {
        description = "周虎身负重伤，举着砍刀冲向林砚，嘴里喊着要把林砚抓去换三哥许诺的筑基丹。林砚认出周虎身上沾着自己半个月前被他拍领口时留下的缉厄司专属追踪散，这是对方能精准找到自己的原因。"
      }
      step 2 {
        description = "林砚自知练气一层修为不敌练气四层的周虎，故意示弱往西侧支矿道跑，引诱周虎追入岩层酥软的陷阱区域。"
      }
      step 3 {
        description = "周虎被怒气和筑基丹诱惑，不顾腿伤追入支矿道深处，完全没注意到岩壁传来的细碎裂响。"
      }
      step 4 {
        description = "林砚跑到安全线外后触发事先布置的坍塌机关，周虎被落石掩埋前喊出林砚是三哥要找的复活怪。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "char_003", count = 1}]
          }
          state_delta {
            target = "char_003"
            kind = "status"
            field = "status"
            from = "存活"
            to = "死亡"
            note = "周虎被落石砸死，林砚解决逃亡最大阻碍。"
          }
        }
      }
      step 5 {
        description = "林砚躲避周虎扔出的砍刀时误踏入落石范围，被碎石砸中太阳穴死亡，因身处黑风矿范围内成功复活，折损十年寿元，灵力仍维持在练气一层。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "environment", count = 1}]
          }
          state_delta {
            target = "char_001"
            kind = "status"
            field = "remaining_lifespan"
            from = "40年"
            to = "30年"
            delta = -10
            note = "林砚被落石砸死，练气一层复活折损十年寿元，剩余寿元30年，剩余复活次数2次。"
          }
        }
      }
      step 6 {
        description = "林砚从周虎的尸体上搜出两块下品灵石、半块云纹青铜腰牌，确认周虎是三哥安插在矿场的缉厄司外围线人，专门排查死而复生的异常人员。"
        event {
          type = "acquire"
          state_delta {
            target = "char_001"
            kind = "resource"
            field = "items"
            note = "林砚获得周虎的云纹青铜腰牌，证实周虎的缉厄司眼线身份。"
          }
        }
      }
      step 7 {
        description = "林砚捏碎仅能维持半个时辰灵力波动掩盖效果的劣质掩息符，转身朝后山岩洞方向走去，留下的脚印很快被大雨冲没。"
        event {
          type = "status"
          state_delta {
            target = "char_001"
            kind = "resource"
            field = "items"
            note = "林砚使用一张劣质掩息符，剩余1张。"
          }
        }
      }
    }
  }
  chapter "P1-V3-C7 灰衣截路，刃穿魂归" {
    id = "P1-V3-C7"
    objective "应对缉厄司暗卫截杀" {
      step 1 {
        description = "林砚捏碎劣质掩息符，收好周虎的云纹青铜腰牌，冒雨往老槐树汇合点赶。"
      }
      step 2 {
        description = "林砚走少有人走的岩缝小路时察觉被人跟踪，随即被两名领口绣有云纹的缉厄司灰衣暗卫堵截，对方持黄铜罗盘锁定他的位置，指认他三次出现在矿难坍塌现场、尸体无故消失。"
      }
      step 3 {
        description = "林砚装成普通矿奴试图蒙混过关，偷听到两名暗卫打算抓他回去给苏小姐当投名状，以此换取奖励、释放被三哥扣押的暗卫乙的妹妹。"
        event {
          type = "knowledge"
        }
      }
      step 4 {
        description = "暗卫甲出手发出灵气刃刺穿林砚左胸，林砚当场死亡，再次折损十年寿元。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "char_004", count = 1}, {id = "char_005", count = 1}]
          }
          state_delta {
            target = "char_001"
            kind = "status"
            field = "remaining_lifespan"
            from = "30年"
            to = "20年"
            delta = -10
            note = "林砚被暗卫杀死，练气一层复活折损十年寿元，剩余寿元20年，剩余复活次数1次。"
          }
        }
      }
      step 5 {
        description = "林砚在距遇袭点五百米的三岔路口复活，确认身上所有物品无遗失，核算出自己累计已折损二十年寿元，仅剩二十年寿命，最多还能复活两次。"
      }
      step 6 {
        description = "林砚听到两名暗卫打算封死所有出口全面搜捕他，决定利用自己对黑风矿矿道的熟悉度，引暗卫进入左侧易坍塌的松动岩层区将其坑杀，避免对方招来更多缉厄司人手。"
      }
      step 7 {
        description = "林砚故意踩落岩壁上的碎石暴露位置引暗卫过来，靠在矿道入口岩壁后确认坑杀计划所有细节无误，准备收之前折损寿元的欠账利息。"
      }
    }
  }
  chapter "P1-V3-C8 借势岩崩，灰飞烟灭" {
    id = "P1-V3-C8"
    objective "设计坑杀两名缉厄司暗卫" {
      step 1 {
        description = "两名练气七层的缉厄司暗卫追踪碎石响动进入废弃矿道，误以为林砚灵力耗空慌不择路，完全放松了警惕。"
      }
      step 2 {
        description = "林砚故意装作脚步踉跄的样子逃跑，将两名暗卫引到提前标记好的、被地下水泡酥的松动岩层核心区。"
      }
      step 3 {
        description = "林砚捏碎淬灵碎灵石触发岩层连锁坍塌，堵死矿道出口，两名暗卫先后被落石砸中身亡。"
        event {
          type = "combat"
          combat {
            enemies = [{id = "char_004", count = 1}, {id = "char_005", count = 1}]
          }
          state_delta {
            target = "char_004"
            kind = "status"
            field = "status"
            from = "存活"
            to = "死亡"
            note = "暗卫甲被落石砸死。"
          }
          state_delta {
            target = "char_005"
            kind = "status"
            field = "status"
            from = "存活"
            to = "死亡"
            note = "暗卫乙被落石砸死。"
          }
        }
      }
      step 4 {
        description = "林砚确认落石完全稳定后，从暗卫尸体处搜出两块缉厄司铜牌，检查后确认铜牌无追踪装置，且铜牌云纹与之前获得的周虎腰牌、半块碎玉的纹路完全一致。"
        event {
          type = "acquire"
          state_delta {
            target = "char_001"
            kind = "resource"
            field = "items"
            note = "林砚获得两块缉厄司暗卫的身份铜牌。"
          }
        }
      }
      step 5 {
        description = "林砚将铜牌扔回岩堆深处，掩盖自己故意设局杀人的痕迹，确认两名暗卫无生还可能。"
      }
      step 6 {
        description = "林砚检查随身物品，发现答应给小石头的半块干饼完好，自己唯一的无补丁粗麻上衣被灵气刃刺穿报废。"
      }
      step 7 {
        description = "林砚准备离开矿道时捡到半块缉厄司专属的制式云纹衣料，收入贴身内兜留作日后备用。"
        event {
          type = "acquire"
          state_delta {
            target = "char_001"
            kind = "resource"
            field = "items"
            note = "林砚获得缉厄司制式云纹衣料，可用于后续伪装。"
          }
        }
      }
      step 8 {
        description = "林砚发现矿道内有不属于自己和两名暗卫的新鲜陌生脚印，怀疑自己藏有生存物资和半块封印玉佩的隐藏岩洞被人闯入，立刻往岩洞方向赶去。"
        event {
          type = "knowledge"
        }
      }
    }
  }
  chapter "P1-V3-C9 密洞取玉，旧友相逢" {
    id = "P1-V3-C9"
    objective "取回玉佩，逃离黑风矿" {
      step 1 {
        description = "林砚雨夜奔逃前往藏有封印玉佩的废弃矿道岩洞，兜里揣着答应给小石头的半块干饼、从暗卫处捡的灰色云纹衣料、小监工的赌债欠条、老矿头给的劣质掩息符碎渣。"
      }
      step 2 {
        description = "林砚抵达岩洞门口，发现石门上自己做的石粉标记被蹭，留有缉厄司暗卫的特有脚印与松烟墨味，判断有人提前来过岩洞。"
      }
      step 3 {
        description = "林砚进入岩洞取出半块封印玉佩，发现并清除了对方留在岩缝里的云纹微踪符，确认对方故意留玉佩当诱饵等他上钩。"
        event {
          type = "acquire"
          state_delta {
            target = "char_001"
            kind = "resource"
            field = "items"
            note = "林砚成功取回半块封印玉佩，清除了追踪符，没有暴露行踪。"
          }
        }
      }
      step 4 {
        description = "林砚检查岩洞存放的逃亡物资时，发现不属于自己的窝头渣，随后躲在专属隐蔽藏身洞的小石头主动现身。"
      }
      step 5 {
        description = "小石头告知林砚自己提前两个时辰抵达，撞见黑袍暗卫来岩洞探查却未取走任何物品，同时展示了自己从小佩戴的、和林砚手中玉佩纹路完全一致的另一半碎玉。"
        event {
          type = "knowledge"
        }
      }
      step 6 {
        description = "小石头将捡到的黑袍掉落的银质云纹绣片交给林砚，林砚确认自己布局三个月的逃亡计划早已被缉厄司的人完全洞悉。"
        event {
          type = "acquire"
          state_delta {
            target = "char_001"
            kind = "resource"
            field = "items"
            note = "林砚获得三哥的黑袍掉落的云纹绣片，证实三哥亲临岩洞探查。"
          }
        }
      }
      step 7 {
        description = "林砚明知前路可能有埋伏但已无退路，接受小石头的提议走后山隐蔽小路逃亡，二人耗时半个时辰抵达黑松林边缘，即将彻底逃出黑风矿范围。"
      }
      step 8 {
        description = "林砚瞥见黑风矿哨塔上有模糊叠影，随后又消失不见，同时感受到兜里书友会联络石传来其他穿越者的极淡震动，意识到逃离矿场只是第一步。"
        event {
          type = "knowledge"
        }
      }
      step 9 {
        description = "林砚拍了拍小石头的肩膀，二人一同迈步走向黑松林深处，目标青牛镇。"
        event {
          type = "status"
        }
      }
    }
  }
  chapter "chp_1" {
    id = "P1-V4-C1"
    objective "obj_1" {
      step 1 {
        description = "林砚带小石头赶了一天一夜路，途中避开三波黑风矿折返搜捕的守卫，清晨抵达青牛镇，鞋底磨穿两双，干粮耗尽，靠练气一层灵力支撑"
        event {
          type = "location"
        }
      }
      step 2 {
        description = "二人发现城门口贴着黑风矿通缉令，活捉赏10块下品灵石，尸体赏5块，画像与本人差距极大，仅标注林砚左脸有疤、身高七尺的特征"
        event {
          type = "knowledge"
        }
      }
      step 3 {
        description = "林砚安排小石头用泥和血蓟草抹脸，掩盖二人身份与林砚手腕上的旧镣铐痕迹，乔装成进山采药迷路的叔侄"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "transition"
            to = "伪装状态（身份隐瞒中）"
            note = "涂抹泥与血蓟草掩盖外貌与镣铐印"
          }
        }
      }
      step 4 {
        description = "林砚给城防小队长塞了2块下品灵石，谎称路引遗失，顺利通过城门检查入城"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = -2
          }
        }
      }
      step 5 {
        description = "林砚兑现路上的承诺，拿出提前预留的肉包子给小石头吃，二人商议后决定去不查路引、人员混杂的便民通铺落脚"
        event {
          type = "location"
        }
      }
      step 6 {
        description = "小石头装可怜跟掌柜砍价，将两个铺位每月15块下品灵石的房租砍到12块，掌柜收下房租后叮嘱二人近期要低调，缉厄司由三哥亲自调度，正在严查无正规路引的外来修士，被抓的人几乎都没能出来"
        event {
          type = "knowledge"
        }
      }
      step 7 {
        description = "林砚想起黑风矿周虎死前喊的「三哥要找的复活怪」，心下警觉但并未表露"
        event {
          type = "relationship"
        }
      }
      step 8 {
        description = "小石头主动出门探听消息，得知缉厄司重点排查从黑风矿方向来的无路人，还有个穿素衣的女子正在打听带半大孩子的二十来岁外乡人"
        event {
          type = "knowledge"
        }
      }
      step 9 {
        description = "林砚盘算后续要找灵草相关的短工赚钱，攒钱买基础引气诀提升修为，避免停在练气一层太危险"
      }
      step 10 {
        description = "林砚发现通铺对面茶摊的戴斗笠灰衣男子正盯着自己的方向，对方手里的字条沾着松烟味，随后城门口见过的素衣女子来通铺打听人被掌柜拒绝，林砚认出素衣女子袖口、灰衣男子字条、此前黑风矿黑袍人衣料上都是同款松烟味，察觉青牛镇局势比预想的更复杂"
        event {
          type = "knowledge"
        }
      }
    }
  }
  chapter "chp_2" {
    id = "P1-V4-C2"
    objective "obj_1" {
      step 1 {
        description = "林砚叮嘱小石头待在通铺不要乱跑，对外自称掌柜远房亲戚，小石头藏好半筐血蓟草后外出收零散灵草"
      }
      step 2 {
        description = "林砚揣着仅剩的25块下品灵石到坊市找活计，发现多数招聘要求不符合自身练气一层的条件，最终看到百草堂招分拣灵草短工的告示"
        event {
          type = "location"
        }
      }
      step 3 {
        description = "林砚上前扶住差点摔倒的王掌柜接灵草筐，因三次复活的身体亏空发虚闪了腰，遭到周围应聘者嘲笑"
      }
      step 4 {
        description = "林砚没有硬扛暴露身体隐患，借小推车把灵草筐运到后院货仓，得到王掌柜初步认可，获得灵草辨识考核资格"
      }
      step 5 {
        description = "林砚准确认出所有考核灵草的品类、药性、采摘时节，还认出王掌柜特意混在普通血蓟草里的百年份血蓟草，被王掌柜破格录用，日薪1.5块下品灵石，还允许小石头来店打零工"
        event {
          type = "acquire"
        }
      }
      step 6 {
        description = "林砚刚要上岗时碰到一名来买黑风矿产血蓟草的素衣女子，对方当面打听黑风矿来的矿工踪迹，林砚发现她身上有和之前城门口碰到的可疑人员同款的松烟味"
        event {
          type = "knowledge"
        }
      }
      step 7 {
        description = "林砚不到两个时辰就分拣完后院所有灵草，小石头收完灵草返回百草堂，告知林砚那名素衣女子昨日就在通铺附近打听带小孩的外乡人"
      }
      step 8 {
        description = "王掌柜给林砚结算半块下品灵石的预支工钱，还有5块下品灵石的认出百年血蓟的奖励，提醒他近期避开穿黑衣带云纹腰牌的缉厄司人员"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
          }
        }
      }
      step 9 {
        description = "林砚绕路确认无人跟踪后返回通铺，小石头告知自己当天赚了3个铜板，还打探到下个月坊市古籍铺要处理旧功法，可以去捡漏"
        event {
          type = "knowledge"
        }
      }
    }
  }
  chapter "chp_3" {
    id = "P1-V4-C3"
    objective "obj_1" {
      step 1 {
        description = "林砚与小石头返程时撞见缉厄司差人在通铺所在巷子逐户盘查，发现巷口盯梢的素衣女子身上的松烟味与此前城门口女子、茶摊灰衣人味道一致，二人当即躲进废品巷伪装成拾荒者，搭卖炭老汉的炭车绕路一个时辰甩脱盯梢"
      }
      step 2 {
        description = "二人返回通铺后确认缉厄司已离开，藏在床底的血蓟草未被翻动"
      }
      step 3 {
        description = "接下来十五天林砚每日换路线往返百草堂分拣灵草，共攒得53块下品灵石，仍买不起功法阁标价78块的残次《基础引气诀》"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = 53
          }
        }
      }
      step 4 {
        description = "林砚盘算利用自己对黑风矿结构的熟悉，前往废弃矿道挖取矿主遗弃的高品零散灵石换功法，核算复活折寿风险后认定收益大于风险，小石头为报救命之恩主动答应帮他打掩护"
      }
      step 5 {
        description = "接下来十五天林砚共往返黑风矿六次，中途两次遇险复活：一次被坍塌顶板砸死，一次被缉厄司暗哨追捕主动撞石身亡，共折寿十年，剩余寿元十四年；期间偷听到缉厄司暗哨称抓捕的穿越者要上缴给头领三哥核验收天道碎片，三哥正在搜捕他这个黑风矿逃出来的「复活怪」"
        event {
          type = "knowledge"
        }
      }
      step 6 {
        description = "林砚将挖到的高品灵石兑换为120块下品灵石，扣除20块干粮、跌打药开销后剩100块，到功法阁花费90块买下无隐患的顶级《基础引气诀》，剩余10块留作他与小石头的生活费，掌柜额外赠送空白玉简一份"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = -90
          }
        }
      }
      step 7 {
        description = "林砚返回通铺修炼，仅用两个时辰就修炼至练气一层巅峰，发现自己因多次复活时被矿洞高浓度灵气冲刷，经脉被拓宽三倍，吸纳灵气速度是普通修士的三倍"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "cultivation"
            from = "练气一层初期"
            to = "练气一层巅峰"
          }
        }
      }
    }
  }
  chapter "chp_4" {
    id = "P1-V4-C4"
    objective "obj_1" {
      step 1 {
        description = "林砚在便民通铺清点剩余寿元与灵石，确认离灵草铺发薪还有三天，现有积蓄仅够买十天粗粮干粮，打算凑钱买聚气丹，不再冒险去黑风矿"
      }
      step 2 {
        description = "林砚抄近路走通铺后小巷前往粮铺，被三名地痞堵截，对方索要3块下品灵石过路费"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_di_pi", count = 3}]
          }
        }
      }
      step 3 {
        description = "林砚权衡硬刚、报官、假死三种方案的成本收益后，选择假死脱身，故意激怒疤脸头目被对方一棍砸中太阳穴，身体化作灵气当场消失"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "death"
            note = "被地痞砸中太阳穴身亡，触发复活机制"
          }
        }
      }
      step 4 {
        description = "三名地痞受惊误以为碰到邪祟，正要逃窜时撞见复活后出现在巷口的林砚，吓得将当天收的8块下品灵石全部上交，仓皇逃跑时提及势力头目「三哥」不许在镇子上出人命的规矩"
        event {
          type = "knowledge"
        }
      }
      step 5 {
        description = "林砚检查自身状态，确认本次复活仅从练气一层圆满降至练气一层后期，未折损任何寿元，验证了「修为越高复活副作用越低」的猜想"
        event {
          type = "knowledge"
        }
      }
      step 6 {
        description = "林砚清点收益后，到粮铺花2块下品灵石购买了十天份粗粮干粮，规划剩余16块灵石的用途：8块买聚气丹加速突破练气二层，8块留作应急备用金"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = -2
          }
        }
      }
      step 7 {
        description = "林砚返回通铺，见到收灵草回来的小石头，收下他展示的额外奖励铜板，递给他半块粗粮饼，清点灵石时意识到青牛镇已被「三哥」势力全面渗透，必须尽快提升修为攒够活命筹码"
      }
    }
  }
  chapter "chp_5" {
    id = "P1-V4-C5"
    objective "obj_1" {
      step 1 {
        description = "林砚清晨避开通铺住客出门，给留在家的小石头留了半块粗粮饼，嘱托他盯梢通铺附近的陌生面孔，有情况就去百草堂报信，随后带16块下品灵石前往坊市"
      }
      step 2 {
        description = "林砚抵达百草堂，王掌柜肯定了他此前分拣灵草零差错的工作成果，委托他去城外低阶灵草区采10株三年份黄叶草，承诺给出5块下品灵石的报酬"
      }
      step 3 {
        description = "林砚先花2块下品灵石购入玄铁匕首防身，随后前往低阶灵草区，不到半个时辰就采够了要求的黄叶草，返程时遭遇低阶妖兽赤毛兔袭击，抬手用匕首精准斩杀赤毛兔"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_chi_mao_tu", count = 1}]
          }
          state_delta {
            target = "enemy_chi_mao_tu"
            kind = "death"
          }
        }
      }
      step 4 {
        description = "林砚回城后先将黄叶草交给王掌柜，拿到5块下品灵石报酬和半袋灵草籽，王掌柜告知近日有穿粉裙的陌生小姑娘多方打听他的下落，已经帮他隐瞒了身份信息"
        event {
          type = "knowledge"
        }
      }
      step 5 {
        description = "林砚将赤毛兔尸体卖给坊市材料摊老板，拿到7块下品灵石"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = 7
          }
        }
      }
      step 6 {
        description = "林砚花10块下品灵石租下半个月的独立修炼室，闭关修炼冲击瓶颈时发现左臂有复活折损导致的经脉暗伤，会拖慢灵气运转速度"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "injury"
            field = "左臂经脉"
            to = "轻度暗伤，灵气运转减慢三成"
          }
        }
      }
      step 7 {
        description = "林砚耗时五日成功突破至练气二层，灵气吸纳速度提升20%，左臂暗伤仍未完全痊愈，仅能做到灵气顺畅通过，运转速度还是比其他部位慢三成"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "cultivation"
            from = "练气一层后期"
            to = "练气二层"
          }
        }
      }
      step 8 {
        description = "林砚盘算后续计划：先巩固练气二层修为、再接王掌柜的采药委托攒灵石买温养经脉的灵药、回去给帮忙盯梢的小石头带蜜饯当奖励，顺便打听粉裙姑娘的动向"
      }
    }
  }
  chapter "chp_6" {
    id = "P1-V4-C6"
    objective "obj_1" {
      step 1 {
        description = "林砚装出重病散修的样子，打发走前来打听他的粉裙女子，记录对方身上的松烟味与此前盯梢的素衣女子一致，判定为三哥势力眼线，威胁等级暂标橙色"
        event {
          type = "knowledge"
        }
      }
      step 2 {
        description = "林砚与被他救过的小孩小石头约定盯梢暗号：闭关期间无异常就每日在修炼室窗台放一颗干净小石子，有危险就敲三下玻璃"
      }
      step 3 {
        description = "林砚花费近半积蓄续了两个半月的修炼室租期，又托王掌柜购入半瓶低阶聚气丹，准备闭关冲级"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = -30
          }
        }
      }
      step 4 {
        description = "林砚闭关一个半月，靠自己设定的「糙汉经脉buff」吸纳灵气速度为同阶修士一倍，全程仅靠干麦饼和灵泉水度日未出修炼室，小石头每日放石子报平安，让他无需分心警戒"
      }
      step 5 {
        description = "闭关第四十五天恰好是林砚逃入青牛镇第九十天，林砚灵气累积到突破临界点，先使用八块下品灵石购入的低阶测寿玉简测得剩余寿元为14年，核算后判定复活测试风险可控"
        event {
          type = "acquire"
        }
      }
      step 6 {
        description = "林砚运转功法突破瓶颈，顺利升到练气三层，困扰他两个月的左臂暗伤大幅好转，灵气运转几乎不再滞涩"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "injury"
            field = "左臂经脉"
            to = "暗伤大幅好转，灵气运转基本不受限"
          }
        }
      }
      step 7 {
        description = "林砚听到窗外两名散修交谈，得知三哥已经亲自到青牛镇坐镇缉拿穿越者，持有可识别穿越者的照魂盘，被抓的穿越者会被抽走神魂补天道、魂飞魄散，三哥势力手下腰牌刻有淡蓝色云纹"
        event {
          type = "knowledge"
        }
      }
      step 8 {
        description = "林砚将三哥的威胁等级从橙色调整为最高级红色，决定立刻测试复活能力摸清底牌，主动触碰修炼室门后内置的淬毒禁制（练气三层及以下中者必死）"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "death"
            note = "主动触碰淬毒禁制身亡，测试复活副作用"
          }
        }
      }
      step 9 {
        description = "林砚中腐骨毒身亡后成功复活，修为掉到练气二层巅峰，仅折寿2年，复活副作用相比练气一层时降低80%，验证了「修为越高复活副作用越低」的猜想"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "cultivation"
            from = "练气三层"
            to = "练气二层巅峰"
          }
        }
      }
      step 10 {
        description = "林砚清点剩余灵石足够买两瓶聚气散补修为，打算外出探听三哥底细，还要给盯梢两个多月无差错的小石头带两串糖葫芦当奖励，随后拉开修炼室木门准备外出"
      }
    }
  }
  chapter "chp_7" {
    id = "P1-V4-C7"
    objective "obj_1" {
      step 1 {
        description = "林砚刻意绕偏僻小巷行走，遮掩左手腕的黑风矿专属玄铁镣铐印，避免暴露穿越者身份"
        event {
          type = "location"
        }
      }
      step 2 {
        description = "林砚到丹药摊砍价，以两块五下品灵石一瓶的价格购入两瓶聚气散，从摊主口中得知缉厄司由三哥坐镇、持照魂盘搜捕穿越者，且书友会内部藏有缉厄司安插的内鬼"
        event {
          type = "knowledge"
        }
      }
      step 3 {
        description = "林砚行至坊市出口拐角时恰逢散修吵架吸引所有人注意力，被灰衣伙计陈默故意撞到，对方刻意提及查内鬼、三哥渗透的信息后快速离开"
      }
      step 4 {
        description = "林砚发现被塞了一张写有「三日后坊市后破庙见，同为写书人」的炭笔字条，认出字条上的特殊松烟味与此前遇到的粉裙女子、素衣女子身上的味道完全一致"
        event {
          type = "knowledge"
        }
      }
      step 5 {
        description = "林砚确认递字条的是书友会暗线陈默，权衡赴约风险后决定赴约，运转灵气将字条烧毁不留痕迹"
      }
      step 6 {
        description = "林砚计划接下来三日内补回炼气三层修为，提前去破庙踩点准备多重后手，安排小石头帮忙盯梢破庙周边的陌生人员"
      }
      step 7 {
        description = "林砚返程途中再次闻到同款松烟味，瞥见素衣女子的半角裙角在巷口一闪而逝，确认自己仍被追踪势力盯梢"
        event {
          type = "knowledge"
        }
      }
    }
  }
