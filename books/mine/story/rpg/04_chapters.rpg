
metadata {
  title = "《穿越者的天道弈局》黑风矿开局篇"
  dsl_version = "0.2.0"
}

characters {
  player "char_linyan" {
    id = "char_linyan"
    class = "复活系穿越者/黑风矿底层矿奴"
    str = 1
    agi = 2
    int = 5
    vit = 1
    hp = 30
    mp = 10
  }
  npc "char_zhouhu" {
    id = "char_zhouhu"
    role = "前期反派/矿场监工"
    description = "黑风矿丙字区监工，原是山匪，左脸有从眉骨到下颌的刀疤，左手戴玄铁虎纹戒指，贪财残暴，练气三层修为，以虐杀矿奴为乐，私下克扣矿奴灵石攒钱给母亲买延年丹"
    default_location = "loc_blackwind_c_minetunnel, loc_blackwind_miner_dorm"
  }
  npc "char_laozheng" {
    id = "char_laozheng"
    role = "前期重要剧情NPC"
    description = "黑风矿老矿奴，在矿场挖了十年矿，左脸有青色胎记，边缘带黑痣，性格懦弱谨慎，私藏有丙字矿区完整矿脉图，为藏灵石常被周虎打骂"
    default_location = "loc_blackwind_miner_dorm, loc_blackwind_c7_minetunnel"
  }
  npc "char_e_graycloak" {
    id = "char_e_graycloak"
    role = "前期核心反派势力成员"
    description = "缉厄司外围执行人员，统一穿灰袍、蒙黑面，腰间挂刻有“缉”字的三圈云纹铜牌，负责搜捕穿越者抽取天道碎片，修为普遍练气四层以上，行动隐蔽"
    default_location = "loc_blackwind_abandoned_minetunnel, loc_blackwind_miner_dorm"
  }
  npc "char_xiaoshun" {
    id = "char_xiaoshun"
    role = "前期线索NPC"
    description = "黑风矿少年矿奴，脸上带雀斑，袖口有淡得几乎看不见的半开书墨印，性格谨慎，私下常收集矿奴遗留的废纸"
    default_location = "loc_blackwind_miner_dorm"
  }
  npc "char_common_miner" {
    id = "char_common_miner"
    role = "背景NPC"
    description = "黑风矿底层签死契的矿奴，大多为负债平民、被掳散修，修为普遍练气一层以下，常年被监工压榨，死亡率极高"
    default_location = "loc_blackwind_c_minetunnel, loc_blackwind_miner_dorm"
  }
  npc "周虎" {
    id = "char_zhou_hu"
    role = "前期反派·基层小头目"
    description = "外号周扒皮，黑风矿监工头，练气四层修为，性格残暴嗜虐，贪财好利，靠盘剥矿奴攒钱给老家儿子攒修炼资源，同时是缉厄司外围线人，负责上报矿场内的异常情况。"
    default_location = "loc_mine_field_square"
  }
  npc "小石头" {
    id = "char_xiao_shi_tou"
    role = "前期盟友·矿场活地图"
    description = "十二岁无父无母的小矿奴，父母死于矿难，从小在矿场长大，熟悉全矿所有暗道包括监工都不知道的岔洞，想攒够灵石换临时身份牌逃去山外县城讨生活，性格机灵隐忍，嘴严守诺。"
    default_location = "loc_black_wind_main_mine_tunnel"
  }
  npc "老郑" {
    id = "char_lao_zheng"
    role = "前期剧情触发者·书友会成员"
    description = "缺半块左耳的老矿奴，穿越者互助组织「书友会」潜伏成员，藏有中品灵石想攒够钱给死去的妻小上坟，后因私藏灵石被周虎当众砸死。"
    default_location = "loc_miner_dorm"
  }
  npc "老陈" {
    id = "char_lao_chen"
    role = "书友会联络员"
    description = "缺半块左耳的老矿奴，穿越者互助组织「书友会」潜伏成员，负责联络矿场内的穿越者，性格谨慎隐忍，从不暴露自身身份。"
    default_location = "loc_miner_dorm"
  }
  npc "苏主事" {
    id = "char_su_principal"
    role = "前期反派·缉厄司负责人"
    description = "缉厄司派驻黑风矿的最高负责人，手段狠厉，持有能探测穿越者神魂异常的铜盘，带队猎杀穿越者抽取天道碎片修补破损天道。"
    default_location = "loc_west_cliff_area"
  }
  npc "缉厄司灰衣暗卫" {
    id = "char_gray_cloak_guard"
    role = "反派基层喽啰"
    description = "缉厄司基层作战人员，统一穿防刀刮、能敛灵气的制式青灰纺衣，佩戴刻有上古篆体「缉」字的铜牌，佩刀上的刻痕为猎杀穿越者的计数标记，掌握针对外来神魂的探测术法。"
    default_location = "loc_outer_forest"
  }
  npc "小监工" {
    id = "char_junior_supervisor"
    role = "反派基层喽啰"
    description = "周虎手下的基层监工，负责日常搜身、监工挖矿、核对交矿定额，贪财好利，行事粗野，经常克扣矿奴的口粮与灵石。"
    default_location = "loc_mine_field_square"
  }
  npc "记账先生" {
    id = "char_accountant"
    role = "背景NPC"
    description = "矿场负责登记交矿量的管事，性格刻薄，经常刻意抬高定额克扣矿奴的灵石，对周虎唯命是从。"
    default_location = "loc_mine_field_square"
  }
  npc "瘦猴" {
    id = "char_shou_hou"
    role = "背景NPC·剧情触发者"
    description = "偷藏灵石的底层矿奴，因神魂异常被缉厄司暗卫探测出问题，当场被带走后失踪。"
    default_location = "loc_mine_field_square"
  }
}

world {
  location "loc_blackwind_c_minetunnel" {
    id = "loc_blackwind_c_minetunnel"
    description = "黑风矿丙字区开采矿道，布有压制练气期灵力的锁灵阵，岩壁嵌夜光石照明，分布有多处下品灵石矿脉，塌方频发，是底层矿奴的主要工作区域"
  }
  location "loc_blackwind_c3_minetunnel" {
    id = "loc_blackwind_c3_minetunnel"
    description = "丙字区塌方频发的矿道，有噬骨鼠出没，被周虎安排用来清障，死亡率极高"
  }
  location "loc_blackwind_miner_dorm" {
    id = "loc_blackwind_miner_dorm"
    description = "底层矿奴的集体居住区域，由粗糙木板搭建二十四个铺位，环境恶劣，霉味、汗臭味混杂，是矿奴唯一的休息场所，墙根有矿奴私藏物品的浅坑"
  }
  location "loc_blackwind_c7_minetunnel" {
    id = "loc_blackwind_c7_minetunnel"
    description = "丙字区的低产矿道，分布有隐藏下品灵石富矿层，岩壁有预留的隐蔽藏物岩缝，后期是通往地下遗迹的入口之一"
  }
  location "loc_blackwind_abandoned_minetunnel" {
    id = "loc_blackwind_abandoned_minetunnel"
    description = "早年开采完矿脉后废弃的矿道，塌方风险高，少有人迹，是矿奴私藏物品、缉厄司秘密巡查的区域，深处通往地下遗迹隐脉入口"
  }
  location "黑风灵石矿主矿道" {
    id = "loc_black_wind_main_mine_tunnel"
    description = "黑风矿核心开采通道，连接各分支矿道与出入口，是矿奴日常作业必经之路，监工常年在此巡逻巡查，岩壁嵌有零散下品灵石碎矿。"
  }
  location "黑风灵石矿丙字七号矿道" {
    id = "loc_black_wind_bing7_mine_tunnel"
    description = "黑风矿底层低优先级开采矿道，矿顶结构松动，监工将新矿奴发配至此挖取零散灵石碎矿，三年前曾发生坍塌致三名矿奴死亡。"
  }
  location "黑风灵石矿丁字八号废弃矿道" {
    id = "loc_black_wind_ding8_abandoned_tunnel"
    description = "三年前因坍塌被封禁的废弃矿道，深处有林砚藏物资的隐秘岩洞，岩壁渗出地下遗迹封印的淡绿色灵光，常年少有人至。"
  }
  location "黑风灵石矿废弃矿道隐藏岩洞" {
    id = "loc_black_wind_abandoned_tunnel_cave"
    description = "丁字八号废弃矿道最深处的隐蔽岩洞，被林砚用作藏身处，内藏他私挖的下品灵石、血蓟草等逃生物资，连通地下遗迹外围通风道。"
  }
  location "矿奴大通铺" {
    id = "loc_miner_dorm"
    description = "底层矿奴集体居住场所，环境恶劣拥挤，无窗户通风差，混杂汗味、霉味与食物腐败味，是矿奴日常休息的唯一区域。"
  }
  location "黑风矿场广场" {
    id = "loc_mine_field_square"
    description = "矿场公共区域，用于日常集合点名、突击搜身、公开行刑，是监工威慑矿奴的核心场所，边缘立有捆绑犯人的木桩。"
  }
  location "黑风灵石矿西坡三号矿道" {
    id = "loc_black_wind_xipo3_mine_tunnel"
    description = "对外标注为贫矿的废弃分支矿道，实则是高纯度零散灵石分布的隐藏富矿带，矿顶岩层松动有坍塌风险，监工极少来此巡查。"
  }
  location "黑风矿西坡废石堆" {
    id = "loc_west_slope_waste_heap"
    description = "矿场倾倒废矿渣的区域，偏僻少有人至，是林砚与小石头约定的秘密联络地点，划三道印子即可召唤小石头。"
  }
  location "黑风矿西侧悬崖区域" {
    id = "loc_west_cliff_area"
    description = "黑风矿西侧临崖区域，平时少有人至，是缉厄司苏主事带领暗卫潜伏观察矿场异动的常驻点位。"
  }
  location "黑风矿外围山林" {
    id = "loc_outer_forest"
    description = "环绕黑风矿的原始山林，是矿奴逃矿的唯一路径，常年有缉厄司暗卫巡逻排查，地形复杂易守难攻。"
  }
}

storyline {
  chapter "chap_v1c1" {
    id = "chap_v1c1"
    objective "初入矿场，首次触发复活能力" {
      step 1 {
        description = "林砚在黑风矿丙字矿区矿道苏醒，消化穿越记忆，确认自己成为签了死契的底层矿奴，修为为练气二层，矿道内布有锁灵阵完全压制练气期灵力"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "status"
            field = "identity"
            from = "蓝星网文作者"
            to = "黑风矿签死契矿奴"
            delta = 1
            note = "穿越到修仙界，绑定黑风矿范围内死而复生能力"
          }
        }
      }
      step 2 {
        description = "林砚刚苏醒就遭到周虎鞭打，老矿奴老陈递来豁口镐头，偷偷提醒近期有腰挂铜牌的灰衣人随意抓走矿奴无一生还，地底深处还有诡异响动"
        event {
          type = "interaction"
          state_delta {
            target = "char_linyan"
            kind = "knowledge"
            field = "survival_info"
            from = "无"
            to = "知晓矿道锁灵阵存在、灰衣人风险、地底异动"
            delta = 1
            note = "获得老陈的生存提醒"
          }
        }
      }
      step 3 {
        description = "林砚凭借写文积累的挖矿经验找准矿脉位置开始挖矿，半炷香挖了小半筐下品灵石，矿道突发坍塌，林砚被碗口大的落石砸中当场死亡，周虎拽老陈挡石导致老陈重伤"
        event {
          type = "combat"
          combat {
            enemies = [{id = "en_minetunnel_collapse", count = 1, level = 1}]
          }
          state_delta {
            target = "char_linyan"
            kind = "status"
            field = "life_state"
            from = "alive"
            to = "dead"
            note = "首次死亡，被坍塌落石砸中"
          }
        }
      }
      step 4 {
        description = "林砚在矿道无监控的隐蔽角落复活，身上无外伤，修为从练气二层跌至临界值，周围所有人未察觉异常，确认自己拥有死而复生能力"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "status"
            field = "life_state"
            from = "dead"
            to = "alive"
            note = "首次复活成功"
          }
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "level"
            from = "qi_2"
            to = "qi_2_critical"
            note = "首次复活修为大幅损耗，濒临跌境"
          }
        }
      }
    }
  }
  chapter "chap_v1c2" {
    id = "chap_v1c2"
    objective "二次死亡，确认复活修为损耗规则" {
      step 1 {
        description = "林砚苏醒后误以为首次死亡是幻觉，将丹田滞涩感归为锁灵阵压制和脑震荡，周虎发现林砚发呆踹了他一脚，勒令当日挖够3斤完整下品灵石，否则扔去喂噬骨鼠"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "task"
            field = "mining_quota"
            from = "无"
            to = "当日挖够3斤完整下品灵石"
            delta = 1
            note = "触发当日挖矿定额任务"
          }
        }
      }
      step 2 {
        description = "林砚为完成定额返回丙字三号矿道此前挖矿的位置，刚凿下一镐就遭遇二次矿道坍塌，右腿被落石砸断、颈动脉被碎石划破当场死亡"
        event {
          type = "combat"
          combat {
            enemies = [{id = "en_minetunnel_collapse", count = 1, level = 1}]
          }
          state_delta {
            target = "char_linyan"
            kind = "status"
            field = "life_state"
            from = "alive"
            to = "dead"
            note = "二次死亡，被坍塌落石击中要害"
          }
        }
      }
      step 3 {
        description = "林砚在矿道出口安全区复活，确认修为直接跌至练气一层，复盘总结出复活基础规则：复活点为离死亡点最近的无监控安全区域，一次比一次远离危险，复活后随身物品不会丢失，死亡次数越多修为损耗越严重"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "status"
            field = "life_state"
            from = "dead"
            to = "alive"
            note = "二次复活成功"
          }
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "level"
            from = "qi_2_critical"
            to = "qi_1"
            delta = -1
            note = "二次复活修为跌至练气一层"
          }
          state_delta {
            target = "char_linyan"
            kind = "knowledge"
            field = "revival_rule"
            from = "无"
            to = "知晓复活点规则、随身物品保留规则、修为损耗规则"
            delta = 1
            note = "掌握基础复活规则"
          }
        }
      }
    }
  }
  chapter "chap_v1c3" {
    id = "chap_v1c3"
    objective "主动试死，探明修为阈值后寿元损耗规则" {
      step 1 {
        description = "林砚躲在矿道岩壁后偷听到周虎安排他次日前往塌方频发、有噬骨鼠出没的丙字三号矿道清障，还得知近期有灰衣大人巡查，被带走的矿奴无一生还，私下议论者会被灭口，考虑到当前修为练气一层，去丙字三号矿道存活率不足两成，决定主动可控试死摸清剩余复活规则"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "task"
            field = "survival_plan"
            from = "无"
            to = "主动可控试死，完善复活规则认知"
            delta = 1
            note = "触发主动试死计划"
          }
        }
      }
      step 2 {
        description = "林砚故意在周虎面前现身，捡起脚边的两块完整下品灵石当众踩碎，精准激怒贪财的周虎，被周虎用缠了铁筋带倒钩的牛筋鞭抽碎喉骨当场死亡"
        event {
          type = "combat"
          combat {
            enemies = [{id = "en_zhouhu", count = 1, level = 3}]
          }
          state_delta {
            target = "char_linyan"
            kind = "status"
            field = "life_state"
            from = "alive"
            to = "dead"
            note = "主动触发第三次死亡"
          }
        }
      }
      step 3 {
        description = "林砚在矿奴大通铺苏醒复活，发现贴身揣着的半块带凿痕的灵石碎渣仍在原位，修为依然保持练气一层没有下跌，但身体虚冷、脉搏仅一息两跳，比正常练气一层修士弱了一半，平白折损了十年寿命；门外杂役对话透露复活机制自动给所有在场人员补全了“周虎怕灰衣人查人头扣赏钱，故意留了林砚一命”的合理记忆，完全不会暴露复活异常"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "status"
            field = "life_state"
            from = "dead"
            to = "alive"
            note = "三次复活成功"
          }
          state_delta {
            target = "char_linyan"
            kind = "lifespan"
            field = "years"
            from = "60"
            to = "50"
            delta = -10
            note = "练气一层为修为阈值，阈值后死亡折损十年寿元"
          }
          state_delta {
            target = "char_linyan"
            kind = "knowledge"
            field = "revival_rule"
            from = "基础规则"
            to = "增加修为阈值规则、寿元损耗规则、旁人记忆自动修正规则"
            delta = 1
            note = "完善复活规则认知"
          }
          state_delta {
            target = "char_linyan"
            kind = "task"
            field = "mining_quota"
            from = "3斤完整下品灵石"
            to = "4斤完整下品灵石"
            delta = 1
            note = "闹事导致挖矿定额上涨"
          }
        }
      }
      step 4 {
        description = "林砚啃窝头时瞥见矿场办公区石梯上站着裹灰袍的缉厄司人员，对方腰间挂着刻“缉”字的青铜牌，身边随从拎着三个渗血的密封麻袋，周虎弓着腰在旁陪同，路过的矿奴都对灰衣人避之不及；林砚无意间看到自己铺位旁的墙根有个指甲盖大的藏灵石浅坑，发现大通铺布局、住客特征都和自己五年前开写的《矿脉仙途》开篇设定完全重合，大受震惊"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "knowledge"
            field = "world_origin"
            from = "未知修仙界"
            to = "疑似穿进自著《矿脉仙途》小说世界"
            delta = 1
            note = "首次产生穿书猜想"
          }
          state_delta {
            target = "char_linyan"
            kind = "knowledge"
            field = "variable"
            from = "无"
            to = "缉厄司出现时间早于原剧情，为首个剧情变数"
            delta = 1
            note = "发现首个剧情异常点"
          }
        }
      }
    }
  }
  chapter "chap_v1c4" {
    id = "chap_v1c4"
    objective "验证穿书猜想，确认先知优势" {
      step 1 {
        description = "周虎持玄铁鞭召集所有矿奴点名，对未应答者直接记为矿难死亡，同时嘱咐小管事留意身上有奇怪印记的人，上报可换两颗聚气散奖励；林砚确认周虎手上的玄铁虎纹戒指和自己设定的细节完全一致"
        event {
          type = "interaction"
          state_delta {
            target = "char_linyan"
            kind = "knowledge"
            field = "world_origin"
            from = "疑似穿书"
            to = "周虎特征符合设定，穿书猜想可信度提升"
            delta = 1
            note = "首次验证设定吻合"
          }
        }
      }
      step 2 {
        description = "林砚假装被打伤虚弱，咳哑声音一瘸一拐回到铺位，矿奴老郑偷偷将半卷麻纸塞到林砚铺草深处，怕林砚告发自己私藏灵石，许诺明天分半块窝头求他保密，林砚答应不会对外说"
        event {
          type = "acquire"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "item"
            from = "无"
            to = "丙字矿区矿脉图x1"
            delta = 1
            note = "获得老郑私藏的矿脉图"
          }
        }
      }
      step 3 {
        description = "林砚取出老郑塞的麻纸，确认是自己当年随手画的丙字矿区矿脉图，上面标注了全部18条矿道、塌方点、隐藏下品灵石矿脉，还有落款的“郑”字标识，和设定稿分毫不差；刚好瞥见缉厄司灰衣人在大通铺门口巡查，连忙将矿脉图藏好"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "knowledge"
            field = "world_origin"
            from = "穿书猜想可信度提升"
            to = "确认穿进自著《矿脉仙途》，身份为开篇第三章必死的同名炮灰矿奴"
            delta = 1
            note = "彻底确认穿书事实"
          }
        }
      }
      step 4 {
        description = "林砚梳理所有吻合的细节，决定利用自己作者的先知优势改写自身炮灰命运，计划后半夜趁监工换岗、所有矿奴睡熟时，用怀里的灵石碎渣修炼，补回跌至练气一层最低阈值的修为"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "task"
            field = "long_term_goal"
            from = "无"
            to = "利用先知优势改写炮灰命运，脱离黑风矿，查清天道阴谋"
            delta = 1
            note = "确立长期生存目标"
          }
        }
      }
    }
  }
  chapter "chap_v1c5" {
    id = "chap_v1c5"
    objective "利用先知优势藏灵石避搜，发现第二个剧情变数" {
      step 1 {
        description = "天刚亮周虎喝骂所有矿奴前往丙字七号矿道挖矿，规定20斤下品灵石碎矿的硬定额，私藏灵石会被缉厄司灰衣人带走严惩，林砚清楚原剧情当日收工将有全矿搜身环节，私藏的灵石会被全部没收"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "task"
            field = "mining_quota"
            from = "4斤完整下品灵石"
            to = "20斤下品灵石碎矿"
            delta = 1
            note = "更换当日挖矿定额"
          }
        }
      }
      step 2 {
        description = "林砚先挖够定额碎矿伪装成普通孱弱矿奴，趁监工打盹偷挖得三块完整下品灵石，移动到自己当初写设定时预留的隐蔽岩缝处，将灵石藏入岩缝最深处，摸到岩缝有类似云纹的刻痕未细究，掩盖痕迹返回挖矿点"
        event {
          type = "acquire"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "item"
            from = "无"
            to = "完整下品灵石x3"
            delta = 3
            note = "偷挖获得三块完整灵石"
          }
          state_delta {
            target = "char_linyan"
            kind = "knowledge"
            field = "unknown_mark"
            from = "无"
            to = "岩缝有疑似云纹的未知刻痕"
            delta = 1
            note = "发现未知痕迹线索"
          }
        }
      }
      step 3 {
        description = "收工时周虎果然带监工进矿道搜身，老郑藏在草鞋鞋底的半块灵石被搜出，遭到周虎殴打致重伤、掉落三颗牙齿；林砚伪装成懦弱怕事的模样，全程顺从配合搜身，未被查出藏过灵石的痕迹，顺利过关"
        event {
          type = "interaction"
          state_delta {
            target = "char_laozheng"
            kind = "status"
            field = "injury_level"
            from = "normal"
            to = "severe_injury"
            delta = -1
            note = "老郑私藏灵石被发现，遭周虎殴打重伤"
          }
          state_delta {
            target = "char_linyan"
            kind = "task"
            field = "avoid_search"
            from = "未完成"
            to = "完成"
            delta = 1
            note = "利用先知优势成功避过搜身，灵石未被收缴"
          }
        }
      }
      step 4 {
        description = "后半夜林砚避开守夜监工溜回矿道，取出藏好的三块灵石贴身存放，撞见缉厄司灰衣人深夜潜入矿道深处的隐脉入口，他躲在阴影里未被对方发现；林砚认出缉厄司的铜牌云纹和自己此前在岩缝摸到的刻纹几乎一致，且缉厄司比原剧情提前三个月现身矿场，意识到自己构建的世界已经出现超出设定的变化"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "item"
            from = "完整下品灵石x3（藏于岩缝）"
            to = "完整下品灵石x3（贴身存放）"
            note = "取回藏好的灵石"
          }
          state_delta {
            target = "char_linyan"
            kind = "knowledge"
            field = "variable"
            from = "一个剧情变数"
            to = "岩缝刻痕与缉厄司铜牌云纹一致，缉厄司提前三个月出现，世界已超出原设定范围"
            delta = 1
            note = "确认第二个重大剧情变数"
          }
        }
      }
    }
  }
  chapter "矿场死局·逃遁筹备" {
    id = "chp_black_wind_mine_escape"
    objective "认知危险，认清处境" {
      step 1 {
        description = "林砚收工后在矿道入口撞见缉厄司灰衣暗卫排查过往矿奴，认出对方制式装备与针对穿越者的神魂探测术，矿奴瘦猴被探测出异常当场被带走，灰衣暗卫视线扫向林砚，林砚伪装患肺痨的虚弱病秧子成功蒙混过关。"
        event {
          type = "encounter"
          state_delta {
            target = "char_lin_yan"
            kind = "cognition"
            field = "danger_perception"
            from = "认为原剧情可控，穿越者猎杀三个月后才会开始"
            to = "意识到缉厄司提前三个月抵达，威胁远超预期"
            note = "首次接触官方穿越者猎杀机构，先知优势开始失效"
          }
        }
      }
      step 2 {
        description = "后半夜监工周虎踹开大通铺门，勒令所有矿奴到广场集合突击搜身，林砚明知老郑藏在棉袄内衬里的中品灵石会被搜出丧命，但怕暴露异常引来缉厄司，再三犹豫后未向老郑示警，亲眼目睹老郑被周虎用八角铁锤当场砸死，尸体拖去喂妖兽。"
        event {
          type = "event"
          state_delta {
            target = "char_lin_yan"
            kind = "cognition"
            field = "author_illusion"
            from = "抱有剧情豁免、作者光环的幻想，认为自己能控制剧情走向"
            to = "彻底认清世界真实性，自身无任何特权，死了就是死了"
            note = "老郑的死亡击碎最后幻想，生存优先级拉满，行事更加谨慎"
          }
        }
      }
      step 3 {
        description = "林砚返回大通铺，发现草席上被老陈放了半块印有「半开书页」标记的窝头，是穿越者互助组织「书友会」的联络信号，林砚不动声色将窝头揣进怀里，装作没看见，决定暂不接触任何组织，优先攒够逃生物资。"
        event {
          type = "encounter"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "information"
            from = "不知道书友会组织已潜入黑风矿"
            to = "知晓书友会已在矿场内布局，有大量潜伏成员"
            note = "暂不接触组织，避免暴露自身穿越者身份"
          }
        }
      }
    }
    objective "暗积粮秣，攒够逃资" {
      step 1 {
        description = "周虎以林砚此前交矿量超定额三成为由，将他发配到所有人避之不及的西坡三号贫矿道，要求每天多交两成矿，林砚清楚此处是自己笔下原主角的专属隐藏富矿带，表面装作畏缩答应，内心正中下怀。"
        event {
          type = "event"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "mine_access"
            from = "只能在主矿道挖矿，容易被监工盯着难私藏灵石"
            to = "获得富矿带开采权限，监工巡查极少，物资积累速度大幅提升"
            note = "原剧情的惩罚反而成为林砚的机遇，灵石积累速度远超预期"
          }
        }
      }
      step 2 {
        description = "林砚利用监工每两个时辰换岗的两炷香空窗期，偷偷到富矿点挖取完整灵石藏在岩缝，只上交贫矿碎渣凑重量，还挖到珍贵疗伤药物血蓟草；挖矿第十天遭遇周虎带队突击搜身，林砚情急之下将五块下品灵石含在嘴里，靠满嘴矿灰的虚弱样子蒙混过关，后槽牙差点被灵石崩碎。"
        event {
          type = "event"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "inventory"
            from = "仅有3块零散灵石碎渣，无任何疗伤物资"
            to = "积累37块下品灵石、5株血蓟草，已攒够出矿临时通行证所需的灵石数额还有富余"
            note = "财富积累完成过半，逃生基础条件初步具备"
          }
        }
      }
      step 3 {
        description = "林砚撞见缉厄司暗卫手持探灵光铜盘搜查偏僻矿道，躲进瘴气岔洞逃过一劫，决定偷偷用矿道里的玄铁矿石磨制短刃防身，分批将挖到的物资转移到丁字八号废弃矿道深处的隐秘岩洞，发现岩洞门口有书友会的炭笔标记，顺手用矿灰抹除，确认书友会已经摸到废弃矿道附近。"
        event {
          type = "event"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "weapon"
            from = "无任何防身武器，遇到监工或暗卫只能被动躲避"
            to = "拥有2块磨出锋刃的玄铁短刃，具备基础防身能力"
            note = "确认书友会已接近地下遗迹区域，矿场风险进一步提升"
          }
        }
      }
    }
    objective "应对泄密，敲定新逃生计划" {
      step 1 {
        description = "林砚攥着半块萤石进入丁字八号废弃矿道，打算藏匿当天新挖的3块灵石，刚触碰到藏物资的岩洞的活动岩石，矿道突发小型坍塌，被磨盘大的落石砸中天灵盖死亡，很快复活后探察丹田，发现修为从练气二层掉回练气一层，所幸未触碰到修为下限未折损寿命，抬头撞见小矿奴小石头躲在岩柱后目睹了自己复活的全过程。"
        event {
          type = "event"
          state_delta {
            target = "char_lin_yan"
            kind = "cultivation"
            field = "level"
            from = "练气二层，挖矿效率是普通矿奴两倍"
            to = "练气一层，挖矿效率下降，原定攒够灵石的计划需要延长"
            note = "复活能力副作用显现，修为掉级，逃生计划被迫调整"
          }
        }
      }
      step 2 {
        description = "林砚冲上前制住小石头，威胁他敢泄露消息就杀他灭口，随后拿出2块下品灵石作为封口费交给小石头，要求他永远不许泄露相关消息；小石头收下灵石承诺绝不会泄露，告知林砚自己小时候曾见过其他复活的穿越者被灰衣人抓走，之前矿场失踪的矿奴大概率与此有关，还主动提出自己熟悉全矿所有暗道，林砚如果有需要可以到西坡废石堆划三道印子找他帮忙，不收钱。"
        event {
          type = "interaction"
          state_delta {
            target = "char_xiao_shi_tou"
            kind = "relationship"
            field = "attitude"
            from = "中立陌生，仅把林砚当成普通矿奴"
            to = "暂时盟友，愿意为林砚提供暗道信息、帮忙通风报信"
            note = "获得矿场活地图助力，复活秘密的泄密风险暂时解除"
          }
        }
      }
      step 3 {
        description = "林砚深夜起夜去茅房，偷听到两名监工闲聊，得知缉厄司苏主事带队严查所有出矿哨卡，对来往人员逐一用探测铜盘核验，买通哨卡逃矿的计划风险已经高到无法承担；他回忆自己写的原剧情，得知三个月后黑风矿西侧地脉会发生异动引发大范围矿难，届时矿场所有管事和监工都会优先去抢救灵石仓库，矿场警戒力量会降到最低，是绝佳的逃生窗口，林砚当场敲定新的逃生计划，放弃原买通哨卡的方案，改为利用三个月后的矿难逃矿，决定第二天就去西坡废石堆划印子通知小石头一起逃。"
        event {
          type = "event"
          state_delta {
            target = "char_lin_yan"
            kind = "cognition"
            field = "escape_plan"
            from = "原定攒够50块下品灵石买通哨卡逃矿"
            to = "放弃原计划，改为利用三个月后的大范围矿难逃矿，联合小石头一起行动"
            note = "新计划风险更低，容错率更高，还能避开缉厄司的严格排查，逃生成功率大幅提升"
          }
        }
      }
    }
  }
}

systems {
}
