metadata {
    title = "第一部分：矿场囚笼与弈局开端"
    dsl_version = "0.2.0"
    source = "novelgen_outline"
}

world {
    location "loc_qingniu_town_gate" {
        id = "loc_qingniu_town_gate"
        name = "青牛镇城门口"
        description = "黑风灵石矿周边最近的混居小镇青牛镇的唯一官方出入口，是连接矿场荒郊与本土修仙界的第一道关卡，常年有城防军驻守盘查，三教九流混杂，是各类消息、眼线聚集的核心节点"
        __placeholder__ = false
    }
    location "loc_convenient_inn" {
        id = "loc_convenient_inn"
        name = "青牛镇便民通铺"
        description = "青牛镇南门附近最廉价的大通铺，专门接待付不起高价客栈费用的低阶散修、采药山民、流浪苦力等底层人群，经营者从不过问住客身份，只要缴纳足够的下品灵石就能入住，是逃犯、隐姓埋名者最常选择的落脚点"
        __placeholder__ = false
    }
    location "loc_inn_back_alley" {
        id = "loc_inn_back_alley"
        name = "便民通铺后小巷"
        description = "青牛镇便民通铺后方的废弃死巷，因后门被封常年无人通行，是镇内地痞流氓的固定打劫据点，偏僻无外人干扰"
        __placeholder__ = false
    }
    location "loc_qingniu_fangshi" {
        id = "loc_qingniu_fangshi"
        name = "青牛镇坊市"
        description = "青牛镇官方设立的交易市场，涵盖灵草、功法、材料、日用品等各类交易，人员混杂，是底层修士主要的活动区域"
        __placeholder__ = false
    }
    location "loc_baicaotang" {
        id = "loc_baicaotang"
        name = "青牛镇坊市百草堂"
        description = "青牛镇坊市运营超过三十年的老牌灵草店，主打收售练气期修士常用的普通灵草、疗伤草药，同时承接灵草分拣、晾晒的零散活计"
        __placeholder__ = false
    }
    location "loc_gongfa_ge" {
        id = "loc_gongfa_ge"
        name = "青牛镇坊市功法阁"
        description = "青牛镇坊市内专门售卖低阶修仙功法、术法玉简的老牌店铺，面向练气期散修、普通修仙世家子弟开放，货品普通但价格公道"
        __placeholder__ = false
    }
    location "loc_suburban_herb_area" {
        id = "loc_suburban_herb_area"
        name = "青牛镇城外低阶灵草区"
        description = "位于青牛镇外围三十里的浅山缓坡地带，仅生长十年份以内的低阶灵草，是镇上底层散修、杂役赚取灵石的常见采药点"
        __placeholder__ = false
    }
    location "loc_rental_training_room" {
        id = "loc_rental_training_room"
        name = "青牛镇坊市修炼室"
        description = "青牛镇坊市面向低阶练气散修开放的付费静修场所，按时辰收取灵石费用，内置低阶聚灵阵，灵气浓度是外界的两倍，是底层修士修炼、突破的首选场所"
        __placeholder__ = false
    }
    location "loc_heifeng_abandoned_mine_tunnel" {
        id = "loc_heifeng_abandoned_mine_tunnel"
        name = "黑风灵石矿废弃矿道"
        description = "黑风灵石矿早年开采枯竭后被官方封禁的老旧矿道分支，因坍塌风险高、表层灵石开采殆尽被矿场列为禁区，残留着不少未被清理的零散高品灵石"
        __placeholder__ = false
    }
    location "loc_abandoned_temple_behind_fangshi" {
        id = "loc_abandoned_temple_behind_fangshi"
        name = "青牛镇坊市后废弃破庙"
        description = "位于青牛镇坊市后侧荒坡上的荒废土地庙，废弃近二十年无人打理，因传言闹鬼鲜少有人靠近，被穿越者互助组织「书友会」选中作为临时秘密接头地点"
        __placeholder__ = false
    }
    location "loc_fangshi_exit_alley" {
        id = "loc_fangshi_exit_alley"
        name = "青牛镇坊市出口拐角"
        description = "青牛镇官方坊市主出口东侧的不规则转角，是坊市人流监控的盲区，常年被流动小贩、零散散修用作临时歇脚或私下交易的地点"
        __placeholder__ = false
    }
}

characters {
    player "char_lin_yan" {
        id = "char_lin_yan"
        name = "林砚"
        description = "前世为地球华夏的网络小说作者，深耕矿场开局类修仙题材创作五年，猝死穿越至修仙界成为黑风灵石矿底层矿奴，拥有附矿场复活、剧情预判、剧情修正金手指，外表22岁，多次复活折寿34年，剩余寿元12年，当前修为练气二层巅峰"
        __placeholder__ = false
        str = 7
        agi = 8
        int = 15
        vit = 6
        hp = 60
        mp = 150
        class = "穿越者修仙者"
    }
    npc "char_xiao_shitou" {
        id = "char_xiao_shitou"
        name = "小石头"
        description = "11岁，黑风灵石矿土生土长的矿奴，父母死于矿难，熟悉矿道结构，机灵懂事，被林砚救下后追随林砚，是林砚最信任的帮手"
        __placeholder__ = false
        role = "林砚追随者"
        default_location = "loc_convenient_inn"
    }
    npc "char_city_defense_captain" {
        id = "char_city_defense_captain"
        name = "城防军小队长"
        description = "32岁，青牛镇城防军小队长，驻守城门口盘查过往行人，贪小便宜，收受贿赂即可放行无正规路引人员"
        __placeholder__ = false
        role = "青牛镇城防军基层军官"
        default_location = "loc_qingniu_town_gate"
    }
    npc "char_inn_keeper" {
        id = "char_inn_keeper"
        name = "便民通铺跛脚掌柜"
        description = "52岁，青牛镇便民通铺经营者，腿有旧疾，市侩圆滑，不探听住客隐私，收够银钱就帮住客遮掩行踪，消息灵通"
        __placeholder__ = false
        role = "便民通铺经营者"
        default_location = "loc_convenient_inn"
    }
    npc "char_su_yi_woman" {
        id = "char_su_yi_woman"
        name = "素衣女子"
        description = "外貌20岁左右，三哥势力下属眼线，常年携带松烟味，负责打探林砚与小石头的踪迹"
        __placeholder__ = false
        role = "三哥势力密探"
        default_location = "loc_qingniu_fangshi"
    }
    npc "char_chen_mo" {
        id = "char_chen_mo"
        name = "陈默"
        description = "书友会青牛镇据点暗线，前谍战网文作者，拥有轨迹推演金手指，负责联络新晋穿越者"
        __placeholder__ = false
        role = "书友会暗线"
        default_location = "loc_qingniu_fangshi"
    }
    npc "char_baicaotang_keeper" {
        id = "char_baicaotang_keeper"
        name = "百草堂王掌柜"
        description = "57岁，百草堂经营者，精通灵草辨识，为人谨慎，不探听客人隐私，受过穿越者恩惠，暗中庇护底层穿越者"
        __placeholder__ = false
        role = "百草堂掌柜、书友会外围支持者"
        default_location = "loc_baicaotang"
    }
    npc "char_gongfa_ge_keeper" {
        id = "char_gongfa_ge_keeper"
        name = "功法阁矮胖掌柜"
        description = "62岁，功法阁经营者，精于算计，私下收购来路不明的功法，也偷偷售卖禁术，每月向缉厄司上报可疑客人信息"
        __placeholder__ = false
        role = "功法阁掌柜"
        default_location = "loc_gongfa_ge"
    }
    npc "char_scar_bully" {
        id = "char_scar_bully"
        name = "疤脸地痞头目"
        description = "32岁，青牛镇地痞头目，欺软怕硬，收保护费为生，受三哥势力管控，不敢在镇上出人命"
        __placeholder__ = false
        role = "青牛镇地痞头目、三哥势力外围人员"
        default_location = "loc_inn_back_alley"
    }
    npc "char_bully_underling" {
        id = "char_bully_underling"
        name = "地痞小弟"
        description = "20岁左右，疤脸地痞的手下，胆小怕事，跟随头目收保护费"
        __placeholder__ = false
        role = "地痞小喽啰"
        default_location = "loc_inn_back_alley"
    }
    npc "char_jiesi_guard" {
        id = "char_jiesi_guard"
        name = "缉厄司暗哨"
        description = "20-30岁，缉厄司基层人员，负责排查穿越者踪迹，听从三哥指令行事，手持低阶制式长刀，修为练气二层左右"
        __placeholder__ = false
        role = "缉厄司基层战斗人员"
        default_location = "loc_heifeng_abandoned_mine_tunnel"
    }
    npc "char_red_rabbit" {
        id = "char_red_rabbit"
        name = "赤毛兔"
        description = "低阶妖兽，生活在青牛镇城外低阶灵草区，攻击性弱，毛皮和肉可卖灵石"
        __placeholder__ = false
        role = "低阶妖兽"
        default_location = "loc_suburban_herb_area"
    }
    npc "char_fenqun_woman" {
        id = "char_fenqun_woman"
        name = "粉裙女子"
        description = "外貌18岁左右，三哥势力下属眼线，常年携带松烟味，负责打探林砚下落"
        __placeholder__ = false
        role = "三哥势力密探"
        default_location = "loc_qingniu_fangshi"
    }
    npc "char_jiesi_search_team" {
        id = "char_jiesi_search_team"
        name = "缉厄司搜捕队"
        description = "缉厄司专门负责搜捕穿越者的基层小队，全员练气二层以上修为，配有制式长刀和识别穿越者的低阶法器"
        __placeholder__ = false
        role = "缉厄司基层战斗单位"
        default_location = "loc_abandoned_temple_behind_fangshi"
    }
    npc "char_medicine_merchant" {
        id = "char_medicine_merchant"
        name = "丹药摊山羊胡摊主"
        description = "60岁左右，青牛镇坊市丹药摊经营者，消息灵通，知晓缉厄司和书友会的部分内幕"
        __placeholder__ = false
        role = "丹药商贩"
        default_location = "loc_qingniu_fangshi"
    }
}

storyline {
    chapter "P1-V4-C1" {
        id = "P1-V4-C1"
        title = "采药乔装入青牛，檐底松烟暗递踪"
        objective "林砚带小石头逃入青牛镇落脚，察觉当地暗藏多方势力风险" {
            step 1 {
                description = "林砚带小石头赶了一天一夜路，途中避开三波黑风矿折返搜捕的守卫，清晨抵达青牛镇，二人鞋底磨穿两双、干粮耗尽，靠练气一层灵力撑到目的地"
                event {
                    type = "location"
                    move {
                        to = "loc_qingniu_town_gate"
                    }
                    on_complete {
                        narration = "二人成功避开黑风矿搜捕，抵达青牛镇边界"
                        exp = 5
                    }
                }
            }
            step 2 {
                description = "二人发现城门口贴着黑风矿的通缉令，活捉二人赏十块下品灵石、尸体赏五块，画像与本人差距极大，仅标注了林砚左脸有疤、身高七尺的特征"
                event {
                    type = "knowledge"
                    info = "黑风矿发布通缉令，活捉二人赏10下品灵石，尸体赏5块，画像信息误差极大，仅标记林砚左脸有疤、身高七尺"
                }
            }
            step 3 {
                description = "林砚安排小石头用泥和血蓟草抹脸，掩盖二人身份和林砚手腕上的旧镣铐痕迹，乔装成进山采药迷路的叔侄"
                event {
                    type = "status"
                    status_change = "林砚与小石头伪装成采药叔侄，掩盖身份特征，降低被通缉令识别的风险"
                }
            }
            step 4 {
                description = "林砚给城防小队长塞了两块下品灵石，谎称路引遗失，顺利通过城门检查入城"
                event {
                    type = "acquire"
                    item = "青牛镇入城权限"
                    count = 1
                    on_complete {
                        narration = "成功入城，扣除2块下品灵石贿赂款"
                    }
                }
            }
            step 5 {
                description = "林砚兑现路上的承诺，拿出提前预留的肉包子给小石头吃，二人商议后决定去不查路引、人员混杂的便民通铺落脚"
                event {
                    type = "location"
                    move {
                        to = "loc_convenient_inn"
                    }
                }
            }
            step 6 {
                description = "小石头装可怜跟掌柜砍价，将两个铺位每月十五块下品灵石的房租砍到十二块，掌柜收下房租后叮嘱二人近期要低调，缉厄司由上面的「三哥」亲自调度，正在严查无正规路引的外来修士，被抓的人几乎都没能出来"
                event {
                    type = "knowledge"
                    info = "缉厄司由头领「三哥」亲自坐镇青牛镇，严查无正规路引的外来修士，被抓者无一生还"
                    on_complete {
                        narration = "成功租住通铺铺位，扣除12块下品灵石房租"
                    }
                }
            }
            step 7 {
                description = "林砚想起黑风矿周虎死前喊的「三哥要找的复活怪」，心下警觉但并未表露"
                event {
                    type = "status"
                    status_change = "林砚将「三哥」势力列为重点警惕对象"
                }
            }
            step 8 {
                description = "小石头主动出门探听消息，得知缉厄司重点排查从黑风矿方向来的无路人，还有个穿素衣的女子正在打听带半大孩子的二十来岁外乡人"
                event {
                    type = "knowledge"
                    info = "素衣女子正在打探带半大孩子的二十来岁外乡人，二人踪迹已被三哥势力盯上"
                }
            }
            step 9 {
                description = "林砚盘算后续要找灵草相关的短工赚钱，攒钱买基础引气诀提升修为，避免停在练气一层太危险"
                event {
                    type = "status"
                    status_change = "林砚制定短期生存计划：打短工攒钱买修炼功法，提升修为降低生存风险"
                }
            }
            step 10 {
                description = "林砚发现通铺对面茶摊的戴斗笠灰衣男子正盯着自己的方向，对方手里的字条沾着松烟味，随后城门口见过的素衣女子来通铺打听人被掌柜拒绝，林砚认出素衣女子袖口、灰衣男子字条、此前黑风矿黑袍人衣料上都是同款松烟味，察觉青牛镇局势比预想的更复杂"
                event {
                    type = "knowledge"
                    info = "素衣女子、灰衣男子、黑风矿黑袍人均携带同款松烟味，均属于三哥势力，青牛镇局势暗流涌动，风险高于预期"
                }
            }
        }
    }

    chapter "P1-V4-C2" {
        id = "P1-V4-C2"
        title = "百草辨株得短工，隔墙有耳问行踪"
        objective "林砚获得百草堂短工职位，确认素衣女子仍在打探二人踪迹" {
            step 1 {
                description = "林砚叮嘱小石头待在通铺不要乱跑，对外自称掌柜远房亲戚，小石头藏好半筐血蓟草后外出收零散灵草"
                event {
                    type = "status"
                    status_change = "小石头留守通铺执行盯梢、收灵草任务，林砚独自外出找工作"
                }
            }
            step 2 {
                description = "林砚揣着仅剩的25块下品灵石到坊市找活计，发现多数招聘要求不符合自身练气一层的条件"
                event {
                    type = "location"
                    move {
                        to = "loc_qingniu_fangshi"
                    }
                }
            }
            step 3 {
                description = "林砚碰到百草堂招分拣灵草短工，上前扶住差点摔倒的王掌柜接灵草筐，因三次复活的身体亏空发虚闪了腰，遭到周围应聘者嘲笑"
                event {
                    type = "status"
                    status_change = "林砚因复活导致的身体亏空虚弱闪腰，被其他应聘者轻视，未暴露复活隐患"
                }
            }
            step 4 {
                description = "林砚没有硬扛暴露身体隐患，借小推车把灵草筐运到后院货仓，得到王掌柜初步认可，获得灵草辨识考核资格"
                event {
                    type = "status"
                    status_change = "林砚获得百草堂灵草辨识考核资格"
                }
            }
            step 5 {
                description = "林砚准确认出所有考核灵草的品类、药性、采摘时节，还认出王掌柜特意混在普通血蓟草里的百年份血蓟草，被王掌柜破格录用，日薪1.5块下品灵石，还允许小石头来店打零工"
                event {
                    type = "acquire"
                    item = "百草堂短工职位"
                    count = 1
                    on_complete {
                        narration = "成功获得短工职位，日薪1.5块下品灵石，获得小石头打零工的权限"
                        exp = 10
                    }
                }
            }
            step 6 {
                description = "林砚刚要上岗时碰到一名来买黑风矿产血蓟草的素衣女子，对方当面打听黑风矿来的矿工踪迹，林砚发现她身上有和之前城门口碰到的可疑人员同款的松烟味"
                event {
                    type = "knowledge"
                    info = "素衣女子仍在打探黑风矿逃人踪迹，确认属于三哥势力，二人踪迹仍在对方监控范围内"
                }
            }
            step 7 {
                description = "林砚不到两个时辰就分拣完后院所有灵草，小石头收完灵草返回百草堂，告知林砚那名素衣女子昨日就在通铺附近打听带小孩的外乡人"
                event {
                    type = "knowledge"
                    info = "三哥势力对二人的监控已持续多日，身份暴露风险持续升高"
                }
            }
            step 8 {
                description = "王掌柜给林砚结算半块下品灵石的预支工钱，还有5块下品灵石的认出百年血蓟的奖励，提醒他近期避开穿黑衣带云纹腰牌的缉厄司人员"
                event {
                    type = "acquire"
                    item = "下品灵石"
                    count = 5.5
                    on_complete {
                        narration = "获得劳动报酬和百年血蓟奖励，获知缉厄司人员特征信息"
                    }
                }
            }
            step 9 {
                description = "林砚绕路确认无人跟踪后返回通铺，小石头告知自己当天赚了3个铜板，还打探到下个月坊市古籍铺要处理旧功法，可以去捡漏"
                event {
                    type = "knowledge"
                    info = "下个月坊市古籍铺将处理旧功法，可低价捡漏获得修炼资源"
                }
            }
        }
    }

    chapter "P1-V4-C3" {
        id = "P1-V4-C3"
        title = "算尽余寿涉旧矿，坊市购诀触灵基"
        objective "林砚往返黑风矿挖取灵石兑换修炼功法，突破至练气一层巅峰" {
            step 1 {
                description = "林砚与小石头返程时撞见缉厄司差人在通铺所在巷子逐户盘查，发现巷口盯梢的素衣女子身上的松烟味与此前城门口女子、茶摊灰衣人味道一致，二人当即躲进废品巷伪装成拾荒者，搭卖炭老汉的炭车绕路一个时辰甩脱盯梢"
                event {
                    type = "status"
                    status_change = "二人成功甩脱三哥势力盯梢，未暴露身份和住处"
                    exp = 10
                }
            }
            step 2 {
                description = "二人返回通铺后确认缉厄司已离开，藏在床底的血蓟草未被翻动"
                event {
                    type = "status"
                    status_change = "住处安全，藏好的物资未被发现"
                }
            }
            step 3 {
                description = "接下来十五天林砚每日换路线往返百草堂分拣灵草，共攒得53块下品灵石，仍买不起功法阁标价78块的残次《基础引气诀》"
                event {
                    type = "status"
                    status_change = "短期积蓄不足，无法购买修炼功法，需寻找其他灵石来源"
                }
            }
            step 4 {
                description = "林砚盘算利用自己对黑风矿结构的熟悉，前往废弃矿道挖取矿主遗弃的高品零散灵石换功法，核算复活折寿风险后认定收益大于风险，小石头为报救命之恩主动答应帮他打掩护"
                event {
                    type = "location"
                    move {
                        to = "loc_heifeng_abandoned_mine_tunnel"
                    }
                }
            }
            step 5 {
                description = "后续十五天林砚共往返黑风矿六次，中途两次遇险复活：一次被坍塌顶板砸死，一次被缉厄司暗哨追捕主动撞石身亡，共折寿十年，剩余寿元十四年；期间偷听到缉厄司暗哨称抓捕的穿越者要上缴给头领'三哥'核验收天道碎片，'三哥'正在搜捕他这个黑风矿逃出来的'复活怪'"
                event {
                    type = "combat"
                    enemies = [
                        {id = "char_jiesi_guard", count = 2, level = 2}
                    ]
                    on_complete {
                        narration = "两次遇险复活，折寿十年，剩余寿元14年，成功逃脱缉厄司追捕"
                        exp = 20
                    }
                }
                event {
                    type = "knowledge"
                    info = "三哥抓捕穿越者的目的是抽取对方体内的天道碎片，正在重点搜捕拥有复活能力的林砚"
                }
            }
            step 6 {
                description = "林砚将挖到的高品灵石兑换为120块下品灵石，扣除20块干粮、跌打药开销后剩100块"
                event {
                    type = "acquire"
                    item = "下品灵石"
                    count = 100
                }
            }
            step 7 {
                description = "林砚到功法阁花费90块买下无隐患的顶级《基础引气诀》，剩余10块留作他与小石头的生活费，掌柜额外赠送空白玉简一份"
                event {
                    type = "acquire"
                    items = [
                        {name = "顶级《基础引气诀》", count = 1},
                        {name = "空白玉简", count = 1}
                    ]
                    on_complete {
                        narration = "购买功法成功，扣除90块下品灵石，剩余10块作为生活费"
                    }
                }
            }
            step 8 {
                description = "林砚返回通铺修炼，仅用两个时辰就修炼至练气一层巅峰，发现自己因多次复活时被矿洞高浓度灵气冲刷，经脉被拓宽三倍，吸纳灵气速度是普通修士的三倍"
                event {
                    type = "status"
                    status_change = "林砚修为提升至练气一层巅峰，灵气吸纳速度为同阶普通修士的三倍，经脉拓宽带来永久修炼增益"
                    exp = 20
                }
            }
        }
    }

    chapter "P1-V4-C4" {
        id = "P1-V4-C4"
        title = "假死巷口明损耗，痞言失口露凶名"
        objective "林砚测试复活副作用规律，确认三哥势力已全面渗透青牛镇" {
            step 1 {
                description = "林砚在便民通铺清点剩余寿元与灵石，确认离灵草铺发薪还有三天，现有积蓄仅够买十天粗粮干粮，打算凑钱买聚气丹，不再冒险去黑风矿"
                event {
                    type = "status"
                    status_change = "林砚调整计划，不再冒险前往黑风矿，优先攒钱购买聚气丹提升修为"
                }
            }
            step 2 {
                description = "林砚抄近路走通铺后小巷前往粮铺，被三名地痞堵截，对方索要3块下品灵石过路费"
                event {
                    type = "combat"
                    enemies = [
                        {id = "char_scar_bully", count = 1, level = 1},
                        {id = "char_bully_underling", count = 2, level = 0}
                    ]
                }
            }
            step 3 {
                description = "林砚权衡硬刚、报官、假死三种方案的成本收益后，选择假死脱身，故意激怒疤脸头目被对方一棍砸中太阳穴，身体化作灵气当场消失"
                event {
                    type = "status"
                    status_change = "林砚触发复活能力假死脱身，未暴露战斗能力"
                }
            }
            step 4 {
                description = "三名地痞受惊误以为碰到邪祟，正要逃窜时撞见复活后出现在巷口的林砚，吓得将当天收的8块下品灵石全部上交，仓皇逃跑时提及势力头目「三哥」不许在镇子上出人命的规矩"
                event {
                    type = "acquire"
                    item = "下品灵石"
                    count = 8
                }
                event {
                    type = "knowledge"
                    info = "三哥势力已全面渗透青牛镇，管控本地灰色势力，禁止在镇上出人命暴露踪迹"
                }
            }
            step 5 {
                description = "林砚检查自身状态，确认本次复活仅从练气一层圆满降至练气一层后期，未折损任何寿元，验证了「修为越高复活副作用越低」的猜想"
                event {
                    type = "knowledge"
                    info = "复活副作用随修为提升大幅降低，练气一层时期每次复活折寿5年，本次仅修为小幅度回落，未折损寿元"
                }
            }
            step 6 {
                description = "林砚清点收益后，到粮铺花2块下品灵石购买了十天份粗粮干粮，规划剩余16块灵石的用途：8块买聚气丹加速突破练气二层，8块留作应急备用金"
                event {
                    type = "acquire"
                    item = "粗粮干粮"
                    count = 10
                    on_complete {
                        narration = "购买干粮成功，扣除2块下品灵石，剩余16块按计划分配"
                    }
                }
            }
            step 7 {
                description = "林砚返回通铺，见到收灵草回来的小石头，收下他展示的额外奖励铜板，递给他半块粗粮饼，清点灵石时意识到青牛镇已被「三哥」势力全面渗透，必须尽快提升修为攒够活命筹码"
                event {
                    type = "status"
                    status_change = "林砚提升修为的意愿大幅增强，加快修炼进度优先级调到最高"
                }
            }
        }
    }

    chapter "P1-V4-C5" {
        id = "P1-V4-C5"
        title = "山外采药斩赤兔，冲关忽闻探信人"
        objective "林砚采药斩杀低阶妖兽，突破至练气二层，获知粉裙姑娘打探自己踪迹的情报" {
            step 1 {
                description = "林砚清晨避开通铺住客出门，给留在家的小石头留了半块粗粮饼，嘱托他盯梢通铺附近的陌生面孔，有情况就去百草堂报信，随后带16块下品灵石前往坊市"
                event {
                    type = "location"
                    move {
                        to = "loc_qingniu_fangshi"
                    }
                }
            }
            step 2 {
                description = "林砚抵达百草堂，王掌柜肯定了他此前分拣灵草零差错的工作成果，委托他去城外低阶灵草区采10株三年份黄叶草，承诺给出5块下品灵石的报酬"
                event {
                    type = "acquire"
                    item = "采药委托"
                    count = 1
                    on_complete {
                        narration = "获得采药委托，完成后可获得5块下品灵石报酬"
                    }
                }
            }
            step 3 {
                description = "林砚先花2块下品灵石购入玄铁匕首防身，随后前往低阶灵草区"
                event {
                    type = "acquire"
                    item = "玄铁匕首"
                    count = 1
                    on_complete {
                        narration = "购买防身武器成功，扣除2块下品灵石"
                    }
                    move {
                        to = "loc_suburban_herb_area"
                    }
                }
            }
            step 4 {
                description = "林砚不到半个时辰就采够了要求的黄叶草，返程时遭遇低阶妖兽赤毛兔袭击，抬手用匕首精准斩杀赤毛兔"
                event {
                    type = "combat"
                    enemies = [
                        {id = "char_red_rabbit", count = 1, level = 1}
                    ]
                    on_complete {
                        narration = "成功斩杀低阶妖兽赤毛兔，未受伤"
                        exp = 15
                    }
                }
            }
            step 5 {
                description = "林砚回城后先将黄叶草交给王掌柜，拿到5块下品灵石报酬和半袋灵草籽，王掌柜告知近日有穿粉裙的陌生小姑娘多方打听他的下落，已经帮他隐瞒了身份信息"
                event {
                    type = "acquire"
                    items = [
                        {name = "下品灵石", count = 5},
                        {name = "灵草籽", count = 1}
                    ]
                }
                event {
                    type = "knowledge"
                    info = "粉裙姑娘正在打探林砚的踪迹，属于三哥势力，王掌柜已帮忙隐瞒身份信息"
                }
            }
            step 6 {
                description = "林砚将赤毛兔尸体卖给坊市材料摊老板，拿到7块下品灵石"
                event {
                    type = "acquire"
                    item = "下品灵石"
                    count = 7
                }
            }
            step 7 {
                description = "林砚花10块下品灵石租下半个月的独立修炼室，闭关修炼冲击瓶颈时发现左臂有复活折损导致的经脉暗伤，会拖慢灵气运转速度"
                event {
                    type = "acquire"
                    item = "修炼室租期"
                    count = 15
                    on_complete {
                        narration = "租下半个月独立修炼室，扣除10块下品灵石，发现左臂经脉暗伤隐患"
                    }
                }
            }
            step 8 {
                description = "林砚耗时五日成功突破至练气二层，灵气吸纳速度提升20%，左臂暗伤仍未完全痊愈，仅能做到灵气顺畅通过，运转速度还是比其他部位慢三成"
                event {
                    type = "status"
                    status_change = "林砚修为提升至练气二层，灵气吸纳速度提升20%，左臂经脉暗伤有所好转但未完全痊愈"
                    exp = 25
                }
            }
            step 9 {
                description = "林砚盘算后续计划：先巩固练气二层修为、再接王掌柜的采药委托攒灵石买温养经脉的灵药、回去给帮忙盯梢的小石头带蜜饯当奖励，顺便打听粉裙姑娘的动向"
                event {
                    type = "status"
                    status_change = "林砚制定后续修炼与情报收集计划，优先巩固修为、治疗经脉暗伤"
                }
            }
        }
    }

    chapter "P1-V4-C6" {
        id = "P1-V4-C6"
        title = "三月苦修登三层，试复生还闻主亲临"
        objective "林砚闭关三月突破练气三层，测试复活副作用规律，获知三哥亲临青牛镇的情报" {
            step 1 {
                description = "林砚装出重病散修的样子，打发走前来打听他的粉裙女子，记录对方身上的松烟味与此前盯梢的素衣女子一致，判定为三哥势力眼线，威胁等级暂标橙色"
                event {
                    type = "status"
                    status_change = "林砚成功隐瞒身份打发走粉裙女子，将粉裙女子标记为橙色威胁，确认属于三哥势力"
                }
            }
            step 2 {
                description = "林砚与被他救过的小孩小石头约定盯梢暗号：闭关期间无异常就每日在修炼室窗台放一颗干净小石子，有危险就敲三下玻璃"
                event {
                    type = "status"
                    status_change = "林砚与小石头约定安全暗号，闭关期间由小石头负责外围警戒"
                }
            }
            step 3 {
                description = "林砚花费近半积蓄续了两个半月的修炼室租期，又托王掌柜购入半瓶低阶聚气丹，准备闭关冲级"
                event {
                    type = "acquire"
                    items = [
                        {name = "修炼室租期", count = 75},
                        {name = "低阶聚气丹", count = 0.5}
                    ]
                    on_complete {
                        narration = "续上两个半月修炼室租期，购入半瓶聚气丹，扣除对应灵石积蓄"
                    }
                }
            }
            step 4 {
                description = "林砚闭关一个半月，靠自己设定的「糙汉经脉buff」吸纳灵气速度为同阶修士一倍，全程仅靠干麦饼和灵泉水度日未出修炼室，小石头每日放石子报平安，让他无需分心警戒"
                event {
                    type = "status"
                    status_change = "林砚进入闭关状态，无外界干扰，修炼效率提升一倍"
                }
            }
            step 5 {
                description = "闭关第四十五天恰好是林砚逃入青牛镇第九十天，林砚灵气累积到突破临界点，先使用八块下品灵石购入的低阶测寿玉简测得剩余寿元为14年，核算后判定复活测试风险可控"
                event {
                    type = "knowledge"
                    info = "当前剩余寿元14年，复活测试风险在可控范围内"
                }
            }
            step 6 {
                description = "林砚运转功法突破瓶颈，顺利升到练气三层，困扰他两个月的左臂暗伤大幅好转，灵气运转几乎不再滞涩"
                event {
                    type = "status"
                    status_change = "林砚修为提升至练气三层，左臂经脉暗伤大幅好转，灵气运转基本恢复正常"
                    exp = 30
                }
            }
            step 7 {
                description = "林砚听到窗外两名散修交谈，得知三哥已经亲自到青牛镇坐镇缉拿穿越者，持有可识别穿越者的照魂盘，被抓的穿越者会被抽走神魂补天道、魂飞魄散，三哥势力手下腰牌刻有淡蓝色云纹"
                event {
                    type = "knowledge"
                    info = "三哥已亲临青牛镇坐镇，持照魂盘搜捕穿越者，被抓者会被抽魂补天道魂飞魄散，手下腰牌刻有淡蓝色云纹标识"
                }
                event {
                    type = "status"
                    status_change = "林砚将三哥势力的威胁等级从橙色调整为最高级红色"
                }
            }
            step 8 {
                description = "林砚将三哥的威胁等级从橙色调整为最高级红色，决定立刻测试复活能力摸清底牌，主动触碰修炼室门后内置的淬毒禁制（练气三层及以下中者必死）"
                event {
                    type = "status"
                    status_change = "林砚主动触发淬毒禁制，触发复活能力"
                }
            }
            step 9 {
                description = "林砚中腐骨毒身亡后成功复活，修为掉到练气二层巅峰，仅折寿2年，复活副作用相比练气一层时降低80%，验证了「修为越高复活副作用越低」的猜想"
                event {
                    type = "knowledge"
                    info = "复活副作用随修为提升大幅降低，练气三层时期复活仅折寿2年，修为小幅度回落至练气二层巅峰，剩余寿元12年"
                }
            }
            step 10 {
                description = "林砚清点剩余灵石足够买两瓶聚气散补修为，打算外出探听三哥底细，还要给盯梢两个多月无差错的小石头带两串糖葫芦当奖励，随后拉开修炼室木门准备外出"
                event {
                    type = "location"
                    move {
                        to = "loc_qingniu_fangshi"
                    }
                }
            }
        }
    }

    chapter "P1-V4-C7" {
        id = "P1-V4-C7"
        title = "坊角留笺邀旧友，烟痕如昔引疑踪"
        objective "林砚获得书友会的赴约邀请，察觉书友会存在内鬼的线索" {
            step 1 {
                description = "林砚闭关三月突破炼气三层又回落至二层巅峰，丹田灵气虚浮，出门计划购买聚气散补修为、给小石头买约定好的糖葫芦，同时打探缉厄司的搜捕尺度，刻意绕偏僻小巷行走，遮掩左手腕的黑风矿专属玄铁镣铐印，避免暴露穿越者身份"
                event {
                    type = "location"
                    move {
                        to = "loc_fangshi_exit_alley"
                    }
                }
            }
            step 2 {
                description = "林砚到丹药摊砍价，以两块五下品灵石一瓶的价格购入两瓶聚气散，从摊主口中得知缉厄司由三哥坐镇、持照魂盘搜捕穿越者，且书友会内部藏有缉厄司安插的内鬼"
                event {
                    type = "acquire"
                    item = "低阶聚气散"
                    count = 2
                    on_complete {
                        narration = "购买聚气散成功，扣除5块下品灵石"
                    }
                }
                event {
                    type = "knowledge"
                    info = "穿越者互助组织「书友会」内部藏有缉厄司安插的内鬼，成员信息存在泄露风险"
                }
            }
            step 3 {
                description = "林砚行至坊市出口拐角时恰逢散修吵架吸引所有人注意力，被灰衣伙计陈默故意撞到，对方刻意提及查内鬼、三哥渗透的信息后快速离开"
                event {
                    type = "status"
                    status_change = "林砚与书友会暗线陈默首次接触，对方透露书友会存在内鬼、三哥渗透的关键信息"
                }
            }
            step 4 {
                description = "林砚发现被塞了一张写有「三日后坊市后破庙见，同为写书人」的炭笔字条，认出字条上的特殊松烟味与此前遇到的粉裙女子、素衣女子身上的味道完全一致"
                event {
                    type = "acquire"
                    item = "书友会邀约字条"
                    count = 1
                }
                event {
                    type = "knowledge"
                    info = "邀约字条携带三哥势力同款松烟味，要么递信者属于三哥势力，要么书友会内鬼已渗透到核心层，信息传递渠道存在泄露风险"
                }
            }
            step 5 {
                description = "林砚确认递字条的是书友会暗线陈默，权衡赴约风险后决定赴约，运转灵气将字条烧毁不留痕迹"
                event {
                    type = "status"
                    status_change = "林砚决定接受书友会邀约，提前准备后手应对可能存在的埋伏风险"
                }
            }
            step 6 {
                description = "林砚计划接下来三日内补回炼气三层修为，提前去破庙踩点准备多重后手，安排小石头帮忙盯梢破庙周边的陌生人员"
                event {
                    type = "status"
                    status_change = "林砚制定赴约预案：三日内恢复练气三层修为，提前踩点布置后手，安排小石头外围盯梢"
                }
            }
            step 7 {
                description = "林砚返程途中再次闻到同款松烟味，瞥见素衣女子的半角裙角在巷口一闪而逝"
                event {
                    type = "knowledge"
                    info = "二人踪迹仍在三哥势力的严密监控下，赴约风险升高"
                }
            }
        }
    }

    chapter "P1-V5-C9" {
        id = "P1-V5-C9"
        title = "伏兵陡现巧突围"
        objective "林砚赴书友会约遭遇缉厄司埋伏，与陈默联手成功突围" {
            step 1 {
                description = "三日后林砚按约定前往坊市后废弃破庙赴约，与等候在此的陈默见面交谈，确认对方同为穿越者身份"
                event {
                    type = "location"
                    move {
                        to = "loc_abandoned_temple_behind_fangshi"
                    }
                }
                event {
                    type = "relationship"
                    relation_change = "林砚与陈默确认穿越者身份，初步建立信任关系"
                }
            }
            step 2 {
                description = "两人谈话时，缉厄司的搜捕队突然包围了破庙，封锁所有出口"
                event {
                    type = "combat"
                    enemies = [
                        {id = "char_jiesi_search_team", count = 6, level = 2}
                    ]
                }
            }
            step 3 {
                description = "陈默用话术操控金手指拖住捕快，林砚引动提前布置的坍塌制造混乱"
                event {
                    type = "status"
                    status_change = "二人配合制造混乱，暂时拖住缉厄司搜捕队，获得突围窗口"
                }
            }
            step 4 {
                description = "两人联手成功脱身，未暴露身份和后续计划"
                event {
                    type = "status"
                    status_change = "成功突破缉厄司包围，未暴露身份，二人信任关系加深"
                    exp = 40
                }
            }
        }
    }
}