metadata {
  title = "矿场囚笼与弈局开端"
  dsl_version = "0.2.0"
  source = "novel_gen_outline"
}
world {
  location "青牛镇城门入口" {
    id = "loc_qingniu_gate"
    description = "连接黑风灵石矿与青牛镇的唯一官方出入口，常年有城防军驻守盘查，是各类眼线聚集的核心节点"
    __placeholder__ = false
  }
  location "便民通铺" {
    id = "loc_bianmin_inn"
    description = "青牛镇价格最低的大通铺，不查路引，人员混杂，是底层人员、逃犯落脚的首选地点"
    __placeholder__ = false
  }
  location "通铺对面茶摊" {
    id = "loc_tea_stall"
    description = "便民通铺门口的露天茶摊，人员流动大，易隐藏眼线"
    __placeholder__ = false
  }
  location "百草堂" {
    id = "loc_baicaotang"
    description = "青牛镇坊市老牌灵草店，收售低阶灵草、炮制疗伤药，掌柜为人谨慎，不打听客人隐私"
    __placeholder__ = false
  }
  location "青牛镇坊市" {
    id = "loc_fangshi"
    description = "青牛镇核心交易区域，售卖各类修仙物资、日常用品，人员混杂，三教九流聚集"
    __placeholder__ = false
  }
  location "功法阁" {
    id = "loc_gongfuge"
    description = "青牛镇坊市内售卖低阶修仙功法、术法玉简的老牌店铺，面向练气期散修开放，只认灵石不认人"
    __placeholder__ = false
  }
  location "黑风矿废弃矿道" {
    id = "loc_heifeng_abandoned_tunnel"
    description = "黑风灵石矿早年开采完毕被弃用的矿道，位置偏僻，少有人来，散落未被清理的高品灵石碎渣"
    __placeholder__ = false
  }
  location "通铺后无名小巷" {
    id = "loc_back_alley"
    description = "便民通铺后方的偏僻死巷，少有人行走，是地痞堵路截财的常选地点"
    __placeholder__ = false
  }
  location "城外低阶灵草区" {
    id = "loc_lingcao_area"
    description = "青牛镇外三里的浅山缓坡，仅生长低阶灵草，偶有低阶妖兽赤毛兔出没，是低阶散修、采药山民常去的地点"
    __placeholder__ = false
  }
  location "租赁修炼室" {
    id = "loc_rent_xiujianshi"
    description = "青牛镇坊市面向低阶散修开放的付费静修场所，内置基础聚灵阵，隔绝外界干扰，隐私性好"
    __placeholder__ = false
  }
  location "坊市后废弃破庙" {
    id = "loc_abandoned_temple"
    description = "青牛镇坊市后方荒坡上的废弃山神庙，人迹罕至，位置偏僻，是秘密接头的首选地点"
    __placeholder__ = false
  }
  location "青牛镇城郊" {
    id = "loc_qingniu_outskirt"
    description = "青牛镇城外郊区，偏僻人少，适合摆脱追兵后藏身"
    __placeholder__ = false
  }
}
characters {
  player "林砚" {
    id = "char_linyan"
    description = "原地球矿场修仙文作者，穿越成黑风矿底层矿奴，觉醒「附矿场复活」「剧情预判」金手指，多次复活折损寿元后剩余12年，当前修为练气二层巅峰，经脉经灵气冲刷拓宽三倍，吸纳灵气速度为普通修士三倍"
    __placeholder__ = false
    str = 6
    agi = 7
    int = 12
    vit = 5
    hp = 50
    mp = 20
    class = "穿越者·复活型"
  }
  npc "小石头" {
    id = "char_xiaoshitou"
    description = "黑风矿出身的孤儿矿奴，11岁，熟悉矿道地形，机灵嘴严，被林砚救出后跟随其落脚青牛镇"
    role = "主角同伴"
    default_location = "loc_bianmin_inn"
    __placeholder__ = false
  }
  npc "城防小队长" {
    id = "char_chengfang_xiaoduizhang"
    description = "青牛镇城门值守小队长，贪财好利，收足够灵石即可放行无路引人员"
    role = "路人NPC"
    default_location = "loc_qingniu_gate"
    __placeholder__ = false
  }
  npc "便民通铺掌柜" {
    id = "char_bianmin_zhanggui"
    description = "跛脚的通铺老板，为人市侩，收足够灵石即可帮住客隐瞒身份，熟知镇上局势"
    role = "情报NPC"
    default_location = "loc_bianmin_inn"
    __placeholder__ = false
  }
  npc "素衣女子" {
    id = "char_suyi_nvzi"
    description = "三哥势力安插在青牛镇的眼线，身上带有特殊松烟味，四处打听林砚踪迹"
    role = "敌方眼线"
    default_location = "loc_qingniu_gate"
    __placeholder__ = false
  }
  npc "灰衣男子" {
    id = "char_huiyi_nanzi"
    description = "书友会暗线陈默的伪装身份，在茶摊盯梢确认林砚身份，身上带有同款松烟味"
    role = "友方暗线"
    default_location = "loc_tea_stall"
    __placeholder__ = false
  }
  npc "百草堂王掌柜" {
    id = "char_baicaotang_zhanggui"
    description = "百草堂掌柜，精通灵草辨识，为人谨慎，不打听客人隐私，对林砚多有照拂"
    role = "任务NPC"
    default_location = "loc_baicaotang"
    __placeholder__ = false
  }
  npc "功法阁矮胖掌柜" {
    id = "char_gongfuge_zhanggui"
    description = "功法阁掌柜，只认灵石，会给熟客额外赠送小礼物"
    role = "交易NPC"
    default_location = "loc_gongfuge"
    __placeholder__ = false
  }
  npc "疤脸地痞头目" {
    id = "char_balian_dipi"
    description = "青牛镇地痞头目，欺软怕硬，收过路费，畏惧三哥势力"
    role = "路人敌方"
    default_location = "loc_back_alley"
    __placeholder__ = false
  }
  npc "陈默" {
    id = "char_chenmo"
    description = "原谍战文作者，穿越后成为书友会青牛镇暗线，精通反侦察与情报传递"
    role = "友方核心"
    default_location = "loc_fangshi"
    __placeholder__ = false
  }
  npc "三哥" {
    id = "char_sange"
    description = "缉厄司高层，同时是书友会最高等级潜伏内鬼，原名顾衍，残忍狡诈，布局搜捕所有穿越者抽取天道碎片"
    role = "核心反派"
    default_location = "loc_qingniu_gate"
    __placeholder__ = false
  }
  npc "缉厄司搜捕队" {
    id = "char_jiesi_soubudui"
    description = "缉厄司基层搜捕人员，携带照魂盘搜捕穿越者，听命于三哥"
    role = "敌方杂兵"
    default_location = "loc_abandoned_temple"
    __placeholder__ = false
  }
  npc "赤毛兔" {
    id = "monster_chimatu"
    description = "低阶妖兽，多活动在低阶灵草区，攻击性弱，肉质可售卖换灵石"
    role = "低阶妖兽"
    default_location = "loc_lingcao_area"
    __placeholder__ = false
  }
}
storyline {
  chapter "采药乔装入青牛，檐底松烟暗递踪" {
    id = "P1-V4-C1"
    objective "乔装进入青牛镇落脚，排查周边潜在风险" {
      step 1 {
        description = "林砚带小石头赶了一天一夜路，避开三波黑风矿搜捕守卫，清晨抵达青牛镇，干粮耗尽，靠练气一层灵力支撑到目的地"
        event {
          type = "move"
          move {
            from = "loc_heifeng_abandoned_tunnel"
            to = "loc_qingniu_gate"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "stamina"
            delta = -80
            unit = "point"
            note = "长途赶路体力耗尽"
          }
          state_delta {
            target = "char_xiaoshitou"
            kind = "resource"
            field = "stamina"
            delta = -90
            unit = "point"
            note = "孩童体力透支严重"
          }
        }
      }
      step 2 {
        description = "二人发现城门口贴着黑风矿通缉令，活捉二人赏十块下品灵石，尸体赏五块，画像与本人差距大，仅标注林砚左脸有疤、身高七尺"
        event {
          type = "knowledge"
          on_complete {
            narration = "获得通缉令情报，确认身份暴露风险较低"
          }
        }
      }
      step 3 {
        description = "林砚安排小石头用泥和血蓟草抹脸，掩盖身份和林砚手腕旧镣铐痕迹，乔装成进山采药迷路的叔侄"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "disguise"
            to = "采药叔侄·中年男子"
            note = "伪装程度90%，仅近距离仔细辨认可能暴露"
          }
          state_delta {
            target = "char_xiaoshitou"
            kind = "transition"
            field = "disguise"
            to = "采药叔侄·孩童"
            note = "伪装程度95%，无明显破绽"
          }
        }
      }
      step 4 {
        description = "林砚给城防小队长塞两块下品灵石，谎称路引遗失，顺利通过城门检查入城"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -2
            unit = "piece"
          }
          on_complete {
            narration = "成功进入青牛镇，未暴露身份"
          }
        }
      }
      step 5 {
        description = "林砚兑现承诺给小石头吃肉包子，二人商议后决定去不查路引、人员混杂的便民通铺落脚"
        event {
          type = "move"
          move {
            from = "loc_qingniu_gate"
            to = "loc_bianmin_inn"
          }
        }
      }
      step 6 {
        description = "小石头装可怜跟掌柜砍价，将两个铺位每月十五块下品灵石的房租砍到十二块，掌柜收下房租后叮嘱二人近期低调，缉厄司由三哥亲自调度，严查无正规路引的外来修士，被抓的人几乎都没能出来"
        event {
          type = "knowledge"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -12
            unit = "piece"
          }
          on_complete {
            narration = "获得缉厄司、三哥相关情报，三哥威胁等级标记为橙色"
            exp = 10
          }
        }
      }
      step 7 {
        description = "林砚想起黑风矿周虎死前喊的「三哥要找的复活怪」，心下警觉但并未表露"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "alert_level"
            to = "high"
          }
        }
      }
      step 8 {
        description = "小石头主动出门探听消息，得知缉厄司重点排查从黑风矿方向来的无路人，还有个穿素衣的女子正在打听带半大孩子的二十来岁外乡人"
        event {
          type = "knowledge"
          on_complete {
            narration = "确认素衣女子眼线身份，存在身份暴露风险"
          }
        }
      }
      step 9 {
        description = "林砚盘算后续要找灵草相关的短工赚钱，攒钱买基础引气诀提升修为，避免停在练气一层太危险"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "main_quest"
            to = "赚取灵石购买《基础引气诀》，提升修为至练气二层以上"
          }
        }
      }
      step 10 {
        description = "林砚发现通铺对面茶摊的戴斗笠灰衣男子正盯着自己的方向，对方手里的字条沾着松烟味，随后城门口见过的素衣女子来通铺打听人被掌柜拒绝，林砚认出素衣女子袖口、灰衣男子字条、此前黑风矿黑袍人衣料上都是同款松烟味，察觉青牛镇局势比预想的更复杂"
        event {
          type = "knowledge"
          on_complete {
            narration = "确认松烟味为三哥势力统一标识，青牛镇已被渗透，风险等级提升"
            exp = 15
          }
        }
      }
    }
  }
  chapter "百草辨株得短工，隔墙有耳问行踪" {
    id = "P1-V4-C2"
    objective "找到稳定收入来源，打探周边眼线动向" {
      step 1 {
        description = "林砚叮嘱小石头待在通铺不要乱跑，对外自称掌柜远房亲戚，小石头藏好半筐血蓟草后外出收零散灵草"
        event {
          type = "status"
          state_delta {
            target = "char_xiaoshitou"
            kind = "transition"
            field = "side_quest"
            to = "外出收购零散灵草，盯梢周边陌生人员动向"
          }
        }
      }
      step 2 {
        description = "林砚揣着仅剩的25块下品灵石到坊市找活计，发现多数招聘要求不符合自身练气一层的条件"
        event {
          type = "move"
          move {
            from = "loc_bianmin_inn"
            to = "loc_fangshi"
          }
        }
      }
      step 3 {
        description = "林砚碰到百草堂招分拣灵草短工，上前扶住差点摔倒的王掌柜接灵草筐，因三次复活的身体亏空发虚闪了腰，遭到周围应聘者嘲笑"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "injury"
            field = "waist"
            to = "minor sprain"
            note = "复活亏空导致体力不支"
          }
        }
      }
      step 4 {
        description = "林砚没有硬扛暴露身体隐患，借小推车把灵草筐运到后院货仓，得到王掌柜初步认可，获得灵草辨识考核资格"
        event {
          type = "status"
          on_complete {
            narration = "获得灵草分拣考核资格，未暴露修为隐患"
            exp = 5
          }
        }
      }
      step 5 {
        description = "林砚准确认出所有考核灵草的品类、药性、采摘时节，还认出王掌柜特意混在普通血蓟草里的百年份血蓟草，被王掌柜破格录用，日薪1.5块下品灵石，还允许小石头来店打零工"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "main_quest_progress"
            delta = 30
            unit = "percent"
            note = "获得稳定收入来源，赚钱进度推进30%"
          }
          on_complete {
            narration = "成功入职百草堂，日薪1.5下品灵石"
            exp = 20
          }
        }
      }
      step 6 {
        description = "林砚刚要上岗时碰到一名来买黑风矿产血蓟草的素衣女子，对方当面打听黑风矿来的矿工踪迹，林砚发现她身上有和之前城门口碰到的可疑人员同款的松烟味"
        event {
          type = "knowledge"
          on_complete {
            narration = "确认素衣女子为三哥势力眼线，身份暴露风险提升"
          }
        }
      }
      step 7 {
        description = "林砚不到两个时辰就分拣完后院所有灵草，小石头收完灵草返回百草堂，告知林砚那名素衣女子昨日就在通铺附近打听带小孩的外乡人"
        event {
          type = "knowledge"
          on_complete {
            narration = "确认自身是眼线重点排查目标，需提升警惕"
          }
        }
      }
      step 8 {
        description = "王掌柜给林砚结算半块下品灵石的预支工钱，还有5块下品灵石的认出百年血蓟的奖励，提醒他近期避开穿黑衣带云纹腰牌的缉厄司人员"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = 5.5
            unit = "piece"
          }
          on_complete {
            narration = "获得5.5下品灵石奖励，得到缉厄司特征情报"
            exp = 10
          }
        }
      }
      step 9 {
        description = "林砚绕路确认无人跟踪后返回通铺，小石头告知自己当天赚了3个铜板，还打探到下个月坊市古籍铺要处理旧功法，可以去捡漏"
        event {
          type = "knowledge"
          on_complete {
            narration = "获得旧功法处理情报，可后续低价购买功法"
          }
        }
      }
    }
  }
  chapter "算尽余寿涉旧矿，坊市购诀触灵基" {
    id = "P1-V4-C3"
    objective "赚取足够灵石购买《基础引气诀》，提升修为" {
      step 1 {
        description = "林砚与小石头返程时撞见缉厄司差人在通铺所在巷子逐户盘查，发现巷口盯梢的素衣女子身上的松烟味与此前城门口女子、茶摊灰衣人味道一致，二人当即躲进废品巷伪装成拾荒者，搭卖炭老汉的炭车绕路一个时辰甩脱盯梢"
        event {
          type = "move"
          move {
            from = "loc_fangshi"
            to = "loc_back_alley"
          }
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "exposure_risk"
            delta = -80
            unit = "percent"
            note = "成功甩脱盯梢，暂时未暴露身份"
          }
        }
      }
      step 2 {
        description = "二人返回通铺后确认缉厄司已离开，藏在床底的血蓟草未被翻动"
        event {
          type = "status"
          on_complete {
            narration = "物资未遗失，身份未暴露"
          }
        }
      }
      step 3 {
        description = "接下来十五天林砚每日换路线往返百草堂分拣灵草，共攒得53块下品灵石，仍买不起功法阁标价78块的残次《基础引气诀》"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = 53
            unit = "piece"
            note = "距购买功法还差25块下品灵石"
          }
        }
      }
      step 4 {
        description = "林砚盘算利用自己对黑风矿结构的熟悉，前往废弃矿道挖取矿主遗弃的高品零散灵石换功法，核算复活折寿风险后认定收益大于风险，小石头为报救命之恩主动答应帮他打掩护"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "side_quest"
            to = "往返黑风矿废弃矿道挖取高品灵石"
          }
        }
      }
      step 5 {
        description = "后续十五天林砚共往返黑风矿六次，中途两次遇险复活：一次被坍塌顶板砸死，一次被缉厄司暗哨追捕主动撞石身亡，共折寿十年，剩余寿元十四年；期间偷听到缉厄司暗哨称抓捕的穿越者要上缴给头领「三哥」核验收天道碎片，「三哥」正在搜捕他这个黑风矿逃出来的「复活怪」"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "lifespan"
            field = "remaining_years"
            delta = -10
            unit = "year"
            note = "两次复活共折寿10年，剩余寿元14年"
          }
          on_complete {
            narration = "两次复活验证了复活规则，获得核心情报：确认三哥搜捕穿越者抽取天道碎片，自身是重点搜捕目标"
            exp = 50
          }
        }
      }
      step 6 {
        description = "林砚将挖到的高品灵石兑换为120块下品灵石，扣除20块干粮、跌打药开销后剩100块，到功法阁花费90块买下无隐患的顶级《基础引气诀》，剩余10块留作他与小石头的生活费，掌柜额外赠送空白玉简一份"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -90
            unit = "piece"
            note = "剩余10块下品灵石作为生活费"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "storage"
            delta = 1
            unit = "《基础引气诀》"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "storage"
            delta = 1
            unit = "空白玉简"
          }
          on_complete {
            narration = "成功获得顶级《基础引气诀》，主线任务完成度80%"
            exp = 30
          }
        }
      }
      step 7 {
        description = "林砚返回通铺修炼，仅用两个时辰就修炼至练气一层巅峰，发现自己因多次复活时被矿洞高浓度灵气冲刷，经脉被拓宽三倍，吸纳灵气速度是普通修士的三倍"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "level"
            from = "qi_1_late"
            to = "qi_1_peak"
          }
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "spirit_absorb_speed"
            delta = 300
            unit = "percent"
            note = "经脉拓宽三倍，灵气吸纳速度为普通修士三倍"
          }
          on_complete {
            narration = "修炼至练气一层巅峰，获得灵气吸纳速度永久buff"
            exp = 40
          }
        }
      }
    }
  }
  chapter "假死巷口明损耗，痞言失口露凶名" {
    id = "P1-V4-C4"
    objective "测试复活副作用变化，验证修为与副作用的关联" {
      step 1 {
        description = "林砚在便民通铺清点剩余寿元与灵石，确认离灵草铺发薪还有三天，现有积蓄仅够买十天粗粮干粮，打算凑钱买聚气丹，不再冒险去黑风矿"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = 8
            unit = "piece"
            note = "剩余8块下品灵石积蓄"
          }
        }
      }
      step 2 {
        description = "林砚抄近路走通铺后小巷前往粮铺，被三名地痞堵截，对方索要3块下品灵石过路费"
        event {
          type = "combat"
          combat {
            enemies = [{id = "char_balian_dipi", count = 3, level = "qi_0"}]
          }
        }
      }
      step 3 {
        description = "林砚权衡硬刚、报官、假死三种方案的成本收益后，选择假死脱身，故意激怒疤脸头目被对方一棍砸中太阳穴，身体化作灵气当场消失"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "death"
            field = "status"
            to = "temporary_death"
            note = "主动触发复活机制"
          }
        }
      }
      step 4 {
        description = "三名地痞受惊误以为碰到邪祟，正要逃窜时撞见复活后出现在巷口的林砚，吓得将当天收的8块下品灵石全部上交，仓皇逃跑时提及势力头目「三哥」不许在镇子上出人命的规矩"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "revive"
            field = "status"
            to = "revived"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = 8
            unit = "piece"
            note = "获得地痞上交的8块下品灵石"
          }
          on_complete {
            narration = "复活成功，获得8块下品灵石，确认三哥势力已渗透青牛镇底层"
            exp = 20
          }
        }
      }
      step 5 {
        description = "林砚检查自身状态，确认本次复活仅从练气一层圆满降至练气一层后期，未折损任何寿元，验证了「修为越高复活副作用越低」的猜想"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "level"
            from = "qi_1_peak"
            to = "qi_1_late"
          }
          state_delta {
            target = "char_linyan"
            kind = "lifespan"
            field = "remaining_years"
            delta = 0
            unit = "year"
            note = "本次复活未折寿，验证修为越高副作用越低的猜想"
          }
          on_complete {
            narration = "复活副作用机制验证完成，风险可控度提升"
            exp = 30
          }
        }
      }
      step 6 {
        description = "林砚清点收益后，到粮铺花2块下品灵石购买了十天份粗粮干粮，规划剩余16块灵石的用途：8块买聚气丹加速突破练气二层，8块留作应急备用金"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -2
            unit = "piece"
            note = "剩余16块下品灵石"
          }
        }
      }
      step 7 {
        description = "林砚返回通铺，见到收灵草回来的小石头，收下他展示的额外奖励铜板，递给他半块粗粮饼，清点灵石时意识到青牛镇已被「三哥」势力全面渗透，必须尽快提升修为攒够活命筹码"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "alert_level"
            to = "extreme_high"
            note = "确认三哥势力全面渗透青牛镇，需尽快提升修为"
          }
        }
      }
    }
  }
  chapter "山外采药斩赤兔，冲关忽闻探信人" {
    id = "P1-V4-C5"
    objective "完成采药任务，突破至练气二层" {
      step 1 {
        description = "林砚清晨避开通铺住客出门，给留在家的小石头留了半块粗粮饼，嘱托他盯梢通铺附近的陌生面孔，有情况就去百草堂报信，随后带16块下品灵石前往坊市"
        event {
          type = "move"
          move {
            from = "loc_bianmin_inn"
            to = "loc_fangshi"
          }
          state_delta {
            target = "char_xiaoshitou"
            kind = "transition"
            field = "side_quest"
            to = "盯梢通铺周边陌生人员，有情况前往百草堂报信"
          }
        }
      }
      step 2 {
        description = "林砚抵达百草堂，王掌柜肯定了他此前分拣灵草零差错的工作成果，委托他去城外低阶灵草区采10株三年份黄叶草，承诺给出5块下品灵石的报酬"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "side_quest"
            to = "前往城外低阶灵草区采集10株三年份黄叶草"
          }
        }
      }
      step 3 {
        description = "林砚先花2块下品灵石购入玄铁匕首防身，随后前往低阶灵草区，不到半个时辰就采够了要求的黄叶草，返程时遭遇低阶妖兽赤毛兔袭击，抬手用匕首精准斩杀赤毛兔"
        event {
          type = "combat"
          combat {
            enemies = [{id = "monster_chimatu", count = 1, level = "qi_1"}]
            result = "win"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "storage"
            delta = 1
            unit = "玄铁匕首"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "storage"
            delta = 1
            unit = "赤毛兔尸体"
          }
          on_complete {
            narration = "斩杀赤毛兔成功，无损伤"
            exp = 15
          }
        }
      }
      step 4 {
        description = "林砚回城后先将黄叶草交给王掌柜，拿到5块下品灵石报酬和半袋灵草籽，王掌柜告知近日有穿粉裙的陌生小姑娘多方打听他的下落，已经帮他隐瞒了身份信息"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = 5
            unit = "piece"
          }
          on_complete {
            narration = "获得5块下品灵石报酬，获得情报：粉裙女子正在打听自身踪迹，疑似三哥势力眼线"
          }
        }
      }
      step 5 {
        description = "林砚将赤毛兔尸体卖给坊市材料摊老板，拿到7块下品灵石"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = 7
            unit = "piece"
          }
        }
      }
      step 6 {
        description = "林砚花10块下品灵石租下半个月的独立修炼室，闭关修炼冲击瓶颈时发现左臂有复活折损导致的经脉暗伤，会拖慢灵气运转速度"
        event {
          type = "move"
          move {
            from = "loc_fangshi"
            to = "loc_rent_xiujianshi"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -10
            unit = "piece"
          }
          state_delta {
            target = "char_linyan"
            kind = "injury"
            field = "left_arm_meridian"
            to = "minor dark injury"
            note = "复活折损导致的经脉暗伤，灵气运转速度降低30%"
          }
        }
      }
      step 7 {
        description = "林砚耗时五日成功突破至练气二层，灵气吸纳速度提升20%，左臂暗伤仍未完全痊愈，仅能做到灵气顺畅通过，运转速度还是比其他部位慢三成"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "level"
            from = "qi_1_late"
            to = "qi_2_early"
          }
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "spirit_absorb_speed"
            delta = 20
            unit = "percent"
            note = "突破至练气二层，吸纳速度额外提升20%"
          }
          on_complete {
            narration = "成功突破至练气二层，修为提升"
            exp = 40
          }
        }
      }
      step 8 {
        description = "林砚盘算后续计划：先巩固练气二层修为、再接王掌柜的采药委托攒灵石买温养经脉的灵药、回去给帮忙盯梢的小石头带蜜饯当奖励，顺便打听粉裙姑娘的动向"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "main_quest"
            to = "攒灵石购买温养经脉灵药，排查粉裙女子身份"
          }
        }
      }
    }
  }
  chapter "三月苦修登三层，试复生还闻主亲临" {
    id = "P1-V4-C6"
    objective "闭关修炼至练气三层，测试练气三层复活副作用" {
      step 1 {
        description = "林砚装出重病散修的样子，打发走前来打听他的粉裙女子，记录对方身上的松烟味与此前盯梢的素衣女子一致，判定为三哥势力眼线，威胁等级暂标橙色"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "disguise"
            to = "重病散修"
            note = "成功瞒过粉裙女子探查，未暴露身份"
          }
          on_complete {
            narration = "确认粉裙女子为三哥势力眼线，威胁等级橙色"
          }
        }
      }
      step 2 {
        description = "林砚与被他救过的小孩小石头约定盯梢暗号：闭关期间无异常就每日在修炼室窗台放一颗干净小石子，有危险就敲三下玻璃"
        event {
          type = "status"
          state_delta {
            target = "char_xiaoshitou"
            kind = "transition"
            field = "side_quest"
            to = "每日在修炼室窗台放石子报平安，有危险敲三下玻璃"
          }
        }
      }
      step 3 {
        description = "林砚花费近半积蓄续了两个半月的修炼室租期，又托王掌柜购入半瓶低阶聚气丹，准备闭关冲级"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -35
            unit = "piece"
            note = "支付修炼室租金和聚气丹费用"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "storage"
            delta = 0.5
            unit = "低阶聚气丹"
          }
        }
      }
      step 4 {
        description = "林砚闭关一个半月，靠自己设定的「糙汉经脉buff」吸纳灵气速度为同阶修士一倍，全程仅靠干麦饼和灵泉水度日未出修炼室，小石头每日放石子报平安，让他无需分心警戒"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "progress"
            delta = 70
            unit = "percent"
            note = "闭关一个半月，练气二层修为进度达70%"
          }
        }
      }
      step 5 {
        description = "闭关第四十五天恰好是林砚逃入青牛镇第九十天，林砚灵气累积到突破临界点，先使用八块下品灵石购入的低阶测寿玉简测得剩余寿元为14年，核算后判定复活测试风险可控"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -8
            unit = "piece"
            note = "购买低阶测寿玉简"
          }
          state_delta {
            target = "char_linyan"
            kind = "lifespan"
            field = "remaining_years"
            to = "14年"
            note = "确认剩余寿元，复活测试风险可控"
          }
        }
      }
      step 6 {
        description = "林砚运转功法突破瓶颈，顺利升到练气三层，困扰他两个月的左臂暗伤大幅好转，灵气运转几乎不再滞涩"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "level"
            from = "qi_2_early"
            to = "qi_3_early"
          }
          state_delta {
            target = "char_linyan"
            kind = "injury"
            field = "left_arm_meridian"
            to = "almost recovered"
            note = "左臂暗伤大幅好转，灵气运转速度仅降低10%"
          }
          on_complete {
            narration = "成功突破至练气三层，暗伤好转"
            exp = 60
          }
        }
      }
      step 7 {
        description = "林砚听到窗外两名散修交谈，得知三哥已经亲自到青牛镇坐镇缉拿穿越者，持有可识别穿越者的照魂盘，被抓的穿越者会被抽走神魂补天道、魂飞魄散，三哥势力手下腰牌刻有淡蓝色云纹"
        event {
          type = "knowledge"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "threat_level"
            to = "red"
            note = "三哥亲临青牛镇，持有照魂盘，威胁等级提升至最高红色"
          }
          on_complete {
            narration = "获得三哥亲临情报，风险等级大幅提升"
            exp = 25
          }
        }
      }
      step 8 {
        description = "林砚将三哥的威胁等级从橙色调整为最高级红色，决定立刻测试复活能力摸清底牌，主动触碰修炼室门后内置的淬毒禁制（练气三层及以下中者必死）"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "death"
            field = "status"
            to = "temporary_death"
            note = "主动触碰淬毒禁制触发复活"
          }
        }
      }
      step 9 {
        description = "林砚中腐骨毒身亡后成功复活，修为掉到练气二层巅峰，仅折寿2年，复活副作用相比练气一层时降低80%，验证了「修为越高复活副作用越低」的猜想"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "revive"
            field = "status"
            to = "revived"
          }
          state_delta {
            target = "char_linyan"
            kind = "cultivation"
            field = "level"
            from = "qi_3_early"
            to = "qi_2_peak"
          }
          state_delta {
            target = "char_linyan"
            kind = "lifespan"
            field = "remaining_years"
            delta = -2
            unit = "year"
            note = "本次复活仅折寿2年，副作用降低80%，验证猜想正确"
          }
          on_complete {
            narration = "复活测试完成，副作用可控度大幅提升"
            exp = 35
          }
        }
      }
      step 10 {
        description = "林砚清点剩余灵石足够买两瓶聚气散补修为，打算外出探听三哥底细，还要给盯梢两个多月无差错的小石头带两串糖葫芦当奖励，随后拉开修炼室木门准备外出"
        event {
          type = "move"
          move {
            from = "loc_rent_xiujianshi"
            to = "loc_fangshi"
          }
        }
      }
    }
  }
  chapter "坊角留笺邀旧友，烟痕如昔引疑踪" {
    id = "P1-V4-C7"
    objective "确认书友会暗线身份，权衡赴约风险" {
      step 1 {
        description = "林砚闭关三月突破炼气三层又回落至二层巅峰，丹田灵气虚浮，出门计划购买聚气散补修为、给小石头买约定好的糖葫芦，同时打探缉厄司的搜捕尺度"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "main_quest"
            to = "购买聚气散补修为，打探缉厄司搜捕尺度"
          }
        }
      }
      step 2 {
        description = "林砚刻意绕偏僻小巷行走，遮掩左手腕的黑风矿专属玄铁镣铐印，避免暴露穿越者身份"
        event {
          type = "move"
          move {
            from = "loc_rent_xiujianshi"
            to = "loc_fangshi"
          }
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "exposure_risk"
            delta = -50
            unit = "percent"
            note = "刻意遮掩身份痕迹，暴露风险降低"
          }
        }
      }
      step 3 {
        description = "林砚到丹药摊砍价，以两块五下品灵石一瓶的价格购入两瓶聚气散，从摊主口中得知缉厄司由三哥坐镇、持照魂盘搜捕穿越者，且书友会内部藏有缉厄司安插的内鬼"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "lower_spirit_stone"
            delta = -5
            unit = "piece"
          }
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "storage"
            delta = 2
            unit = "低阶聚气散"
          }
          on_complete {
            narration = "购入聚气散，获得核心情报：书友会内部存在缉厄司安插的内鬼"
            exp = 20
          }
        }
      }
      step 4 {
        description = "林砚行至坊市出口拐角时恰逢散修吵架吸引所有人注意力，被灰衣伙计陈默故意撞到，对方刻意提及查内鬼、三哥渗透的信息后快速离开"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "contact_status"
            to = "书友会暗线主动接触"
          }
        }
      }
      step 5 {
        description = "林砚发现被塞了一张写有「三日后坊市后破庙见，同为写书人」的炭笔字条，认出字条上的特殊松烟味与此前遇到的粉裙女子、素衣女子身上的味道完全一致"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "resource"
            field = "storage"
            delta = 1
            unit = "书友会接头字条"
          }
          on_complete {
            narration = "确认接触者为书友会暗线，松烟味为书友会与三哥势力通用标识"
          }
        }
      }
      step 6 {
        description = "林砚确认递字条的是书友会暗线陈默，权衡赴约风险后决定赴约，运转灵气将字条烧毁不留痕迹"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "main_quest"
            to = "三日后前往坊市后破庙赴约，提前做好后手准备"
          }
        }
      }
      step 7 {
        description = "林砚计划接下来三日内补回炼气三层修为，提前去破庙踩点准备多重后手，安排小石头帮忙盯梢破庙周边的陌生人员"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "side_quest"
            to = "三日内恢复练气三层修为，前往破庙踩点布置后手"
          }
          state_delta {
            target = "char_xiaoshitou"
            kind = "transition"
            field = "side_quest"
            to = "盯梢破庙周边陌生人员动向"
          }
        }
      }
      step 8 {
        description = "林砚返程途中再次闻到同款松烟味，瞥见素衣女子的半角裙角在巷口一闪而逝"
        event {
          type = "status"
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "exposure_risk"
            delta = 30
            unit = "percent"
            note = "被眼线跟踪，暴露风险提升"
          }
        }
      }
    }
  }
  chapter "伏兵陡现巧突围" {
    id = "P1-V5-C9"
    objective "赴破庙接头，应对缉厄司埋伏" {
      step 1 {
        description = "林砚按约定时间前往坊市后破庙赴约，提前做好多重后手，小石头在破庙外围盯梢放风"
        event {
          type = "move"
          move {
            from = "loc_bianmin_inn"
            to = "loc_abandoned_temple"
          }
        }
      }
      step 2 {
        description = "林砚与陈默接头，确认对方书友会暗线身份，双方交换缉厄司、内鬼相关情报"
        event {
          type = "knowledge"
          on_complete {
            narration = "成功对接书友会，获得大量核心情报"
            exp = 50
          }
        }
      }
      step 3 {
        description = "两人谈话时，缉厄司的搜捕队突然包围了破庙，陈默用话术操控金手指拖住捕快，林砚引动提前布置的坍塌制造混乱"
        event {
          type = "combat"
          combat {
            enemies = [{id = "char_jiesi_soubudui", count = 5, level = "qi_2"}]
          }
          state_delta {
            target = "char_linyan"
            kind = "transition"
            field = "combat_situation"
            to = "advantage"
            note = "制造混乱占据上风"
          }
        }
      }
      step 4 {
        description = "两人联手成功脱身，未被缉厄司抓获，未暴露身份"
        event {
          type = "move"
          move {
            from = "loc_abandoned_temple"
            to = "loc_qingniu_outskirt"
          }
          on_complete {
            narration = "成功突围，对接书友会任务完成"
            exp = 100
          }
        }
      }
    }
  }
}