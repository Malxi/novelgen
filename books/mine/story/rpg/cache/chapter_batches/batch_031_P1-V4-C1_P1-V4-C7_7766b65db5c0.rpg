metadata {
  title = "穿越者的天道弈局·矿场篇"
  dsl_version = "0.2.0"
  source = "原创小说章节内容"
}
world {
  location "loc_qing_niu_zhen" {
    name = "青牛镇"
    type = "低阶修士聚居城镇"
    description = "位于黑风灵石矿附近的小型修仙城镇，是周边底层散修、矿奴、采药人的主要活动区域，目前被缉厄司管控"
    __placeholder__ = false
  }
  location "loc_qing_niu_zhen_bian_min_tong_pu" {
    name = "青牛镇便民通铺"
    type = "城镇廉价住宿场所"
    description = "青牛镇价格最低的大通铺，鱼龙混杂，仅认钱不认人，不查身份路引，是底层散修、逃荒者的首选落脚地"
    __placeholder__ = false
  }
  location "loc_qing_niu_zhen_bai_cao_tang" {
    name = "青牛镇百草堂"
    type = "低阶灵草商铺"
    description = "青牛镇经营三十年的老牌灵草店，主营低阶灵草收售与分拣，掌柜王掌柜为人圆滑，不打探客人隐私"
    __placeholder__ = false
  }
  location "loc_qing_niu_zhen_fang_shi" {
    name = "青牛镇坊市"
    type = "修仙城镇交易区"
    description = "青牛镇核心交易场所，汇聚丹药、灵草、功法、材料等各类低阶修士物资，人员混杂，是地下情报传递的核心区域"
    __placeholder__ = false
  }
  location "loc_di_jie_ling_cao_qu" {
    name = "城外低阶灵草区"
    type = "野外灵草生长区"
    description = "青牛镇外三里的山坡，生长大量低阶灵草，有少量低阶妖兽出没，是底层采药工的主要活动区域"
    __placeholder__ = false
  }
  location "loc_du_li_xiu_lian_shi" {
    name = "独立租赁修炼室"
    type = "商用修仙修炼场所"
    description = "青牛镇坊市对外租赁的单人修炼室，内置三倍聚灵阵，隔音隔神识，适合底层修士闭关冲级"
    __placeholder__ = false
  }
  location "loc_fang_shi_hou_po_miao" {
    name = "坊市后废弃破庙"
    type = "废弃宗教建筑"
    description = "青牛镇坊市后荒坡上的废弃山神庙，人迹罕至，是穿越者互助组织书友会的秘密接头点"
    __placeholder__ = false
  }
  location "loc_hei_feng_kuang" {
    name = "黑风灵石矿"
    type = "灵石矿产区"
    description = "修仙界大型低阶灵石矿场，关押大量矿奴开矿，是主角林砚穿越后的初始地点，地下封印着禁术「死后夺取」"
    __placeholder__ = false
  }
  location "loc_zhen_si_ya_men" {
    name = "青牛镇镇司衙门"
    type = "官方行政机构"
    description = "青牛镇官方管理机构，目前被缉厄司征用，是三哥坐镇青牛镇搜捕穿越者的核心据点"
    __placeholder__ = false
  }
  location "loc_qing_niu_zhen_pian_pi_xiang" {
    name = "青牛镇偏僻小巷"
    type = "城镇隐蔽通道"
    description = "青牛镇坊市周边的废弃小巷，人迹罕至，适合秘密接头与规避巡查"
    __placeholder__ = false
  }
}
characters {
  player "char_lin_yan" {
    name = "林砚"
    description = "前世为矿场开局类网文作者，穿越到自己写的小说世界成为黑风矿矿奴，觉醒专属金手指「附矿场复活」，性格冷静理智，擅长权衡利弊，精于风险计算"
    __placeholder__ = false
    cultivation = "练气二层巅峰"
    str = 7
    agi = 8
    int = 10
    vit = 6
    hp = 80
    mp = 60
    class = "穿越者·复活类"
    skills = ["附矿场复活（死亡后在距离最近的矿场复活，修为越高复活副作用越低）", "灵草鉴别", "风险推演"]
    items = ["生存参数台账", "低阶测寿玉简", "玄铁匕首", "聚气散*2", "下品灵石*15"]
    lifespan = 12
  }
  npc "char_xiao_shi_tou" {
    name = "小石头"
    description = "黑风矿矿奴后代，被林砚从矿洞塌方中救出后死心塌地追随，机灵谨慎，擅长盯梢探听消息"
    __placeholder__ = false
    role = "主角追随者"
    default_location = "loc_qing_niu_zhen_bian_min_tong_pu"
    cultivation = "无修为"
  }
  npc "char_wang_zhang_gui" {
    name = "王掌柜"
    description = "百草堂掌柜，经营灵草生意三十年，为人圆滑，不打探客人隐私，受过穿越者恩惠，对底层修士多有照拂"
    __placeholder__ = false
    role = "中立友善NPC"
    default_location = "loc_qing_niu_zhen_bai_cao_tang"
    cultivation = "练气三层"
  }
  npc "char_chen_mo" {
    name = "陈默"
    description = "穿越者互助组织书友会青牛镇暗线，前世为谍战网文作者，擅长伪装潜伏与情报传递，耳后有一颗墨痣为标记"
    __placeholder__ = false
    role = "书友会联络员"
    default_location = "loc_qing_niu_zhen_fang_shi"
    cultivation = "练气四层"
    affiliation = "书友会"
  }
  npc "char_san_ge" {
    name = "三哥"
    description = "缉厄司高层，书友会头号内鬼，行事狠辣，持有可识别穿越者的照魂盘，搜捕穿越者抽取神魂修补天道，是前期核心反派"
    __placeholder__ = false
    role = "前期核心反派"
    default_location = "loc_zhen_si_ya_men"
    cultivation = "筑基期"
    affiliation = "缉厄司"
  }
  npc "char_fen_qun_nv" {
    name = "粉裙女子"
    description = "三哥势力眼线，多次打探林砚下落，身上带有特殊松烟味，眉眼与素衣女子相似"
    __placeholder__ = false
    role = "敌方眼线"
    default_location = "loc_qing_niu_zhen_fang_shi"
    affiliation = "缉厄司"
    cultivation = "练气二层"
  }
  npc "char_su_yi_nv" {
    name = "素衣女子"
    description = "三哥势力眼线，多次盯梢林砚，身上带有特殊松烟味，与粉裙女子属同一势力"
    __placeholder__ = false
    role = "敌方眼线"
    default_location = "loc_qing_niu_zhen_pian_pi_xiang"
    affiliation = "缉厄司"
    cultivation = "练气三层"
  }
  npc "char_dan_yao_tan_zhu" {
    name = "丹药摊摊主"
    description = "青牛镇坊市售卖低阶丹药的摊主，为人市侩，消息灵通"
    __placeholder__ = false
    role = "情报NPC"
    default_location = "loc_qing_niu_zhen_fang_shi"
    cultivation = "练气二层"
  }
  npc "enemy_chi_mao_tu" {
    name = "赤毛兔"
    description = "低阶妖兽，外形似普通野兔，毛为火红色，咬合力强，栖息于低阶灵草区"
    __placeholder__ = false
    level = "练气一层"
  }
  npc "enemy_di_pi" {
    name = "地痞"
    description = "青牛镇底层地痞团伙，受三哥势力管控，靠收过路费打劫为生"
    __placeholder__ = false
    level = "无修为"
  }
}
storyline {
  chapter "chp_1" {
    title = "采药乔装入青牛，檐底松烟暗递踪"
    objective "obj_1" {
      goal = "林砚带小石头伪装成采药人混入青牛镇，规避黑风矿通缉与缉厄司巡查，落脚便民通铺"
      step 1 {
        description = "林砚带小石头赶了一天一夜路，途中避开三波黑风矿折返搜捕的守卫，清晨抵达青牛镇，鞋底磨穿两双，干粮耗尽，靠练气一层灵力支撑"
        event {
          type = "location"
          move {
            to = "loc_qing_niu_zhen"
          }
        }
      }
      step 2 {
        description = "二人发现城门口贴着黑风矿通缉令，活捉赏10块下品灵石，尸体赏5块，画像与本人差距极大，仅标注林砚左脸有疤、身高七尺的特征"
        event {
          type = "knowledge"
          info = "黑风矿发布通缉令，悬赏二人，画像辨识度极低"
        }
      }
      step 3 {
        description = "林砚安排小石头用泥和血蓟草抹脸，掩盖二人身份与林砚手腕上的旧镣铐痕迹，乔装成进山采药迷路的叔侄"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "transition"
            to = "伪装状态（身份隐瞒中）"
            note = "涂抹泥与血蓟草掩盖外貌与镣铐印"
          }
        }
      }
      step 4 {
        description = "林砚给城防小队长塞了2块下品灵石，谎称路引遗失，顺利通过城门检查入城"
        event {
          type = "acquire"
          item = "入城权限"
          delta = 1
        }
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = -2
          }
        }
      }
      step 5 {
        description = "林砚兑现路上的承诺，拿出提前预留的肉包子给小石头吃，二人商议后决定去不查路引、人员混杂的便民通铺落脚"
        event {
          type = "location"
          move {
            to = "loc_qing_niu_zhen_bian_min_tong_pu"
          }
        }
      }
      step 6 {
        description = "小石头装可怜跟掌柜砍价，将两个铺位每月15块下品灵石的房租砍到12块，掌柜收下房租后叮嘱二人近期要低调，缉厄司由三哥亲自调度，正在严查无正规路引的外来修士，被抓的人几乎都没能出来"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = -12
          }
        }
        event {
          type = "knowledge"
          info = "缉厄司由头目三哥亲自坐镇，正在严查无正规路引的外来修士，被抓者九死一生"
        }
      }
      step 7 {
        description = "林砚想起黑风矿周虎死前喊的「三哥要找的复活怪」，心下警觉但并未表露"
        event {
          type = "relationship"
          relation = "敌对"
          target = "char_san_ge"
          note = "得知三哥正在搜捕持有复活金手指的穿越者"
        }
      }
      step 8 {
        description = "小石头主动出门探听消息，得知缉厄司重点排查从黑风矿方向来的无路人，还有个穿素衣的女子正在打听带半大孩子的二十来岁外乡人"
        event {
          type = "knowledge"
          info = "有素衣女子正在打探林砚与小石头的行踪"
        }
      }
      step 9 {
        description = "林砚盘算后续要找灵草相关的短工赚钱，攒钱买基础引气诀提升修为，避免停在练气一层太危险"
      }
      step 10 {
        description = "林砚发现通铺对面茶摊的戴斗笠灰衣男子正盯着自己的方向，对方手里的字条沾着松烟味，随后城门口见过的素衣女子来通铺打听人被掌柜拒绝，林砚认出素衣女子袖口、灰衣男子字条、此前黑风矿黑袍人衣料上都是同款松烟味，察觉青牛镇局势比预想的更复杂"
        event {
          type = "knowledge"
          info = "可疑人员身上带有统一的特殊松烟味，属于同一未知势力"
        }
      }
    }
  }
  chapter "chp_2" {
    title = "百草辨株得短工，隔墙有耳问行踪"
    objective "obj_1" {
      goal = "林砚找到稳定短工赚取灵石，确认可疑素衣女子正在追踪自己"
      step 1 {
        description = "林砚叮嘱小石头待在通铺不要乱跑，对外自称掌柜远房亲戚，小石头藏好半筐血蓟草后外出收零散灵草"
      }
      step 2 {
        description = "林砚揣着仅剩的25块下品灵石到坊市找活计，发现多数招聘要求不符合自身练气一层的条件，最终看到百草堂招分拣灵草短工的告示"
        event {
          type = "location"
          move {
            to = "loc_qing_niu_zhen_bai_cao_tang"
          }
        }
      }
      step 3 {
        description = "林砚上前扶住差点摔倒的王掌柜接灵草筐，因三次复活的身体亏空发虚闪了腰，遭到周围应聘者嘲笑"
      }
      step 4 {
        description = "林砚没有硬扛暴露身体隐患，借小推车把灵草筐运到后院货仓，得到王掌柜初步认可，获得灵草辨识考核资格"
      }
      step 5 {
        description = "林砚准确认出所有考核灵草的品类、药性、采摘时节，还认出王掌柜特意混在普通血蓟草里的百年份血蓟草，被王掌柜破格录用，日薪1.5块下品灵石，还允许小石头来店打零工"
        event {
          type = "acquire"
          item = "百草堂分拣灵草短工职位"
          delta = 1
        }
      }
      step 6 {
        description = "林砚刚要上岗时碰到一名来买黑风矿产血蓟草的素衣女子，对方当面打听黑风矿来的矿工踪迹，林砚发现她身上有和之前城门口碰到的可疑人员同款的松烟味"
        event {
          type = "knowledge"
          info = "前来打探的素衣女子身上带有同款特殊松烟味，确认属于同一追踪势力"
        }
      }
      step 7 {
        description = "林砚不到两个时辰就分拣完后院所有灵草，小石头收完灵草返回百草堂，告知林砚那名素衣女子昨日就在通铺附近打听带小孩的外乡人"
      }
      step 8 {
        description = "王掌柜给林砚结算半块下品灵石的预支工钱，还有5块下品灵石的认出百年血蓟的奖励，提醒他近期避开穿黑衣带云纹腰牌的缉厄司人员"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = 5.5
          }
        }
      }
      step 9 {
        description = "林砚绕路确认无人跟踪后返回通铺，小石头告知自己当天赚了3个铜板，还打探到下个月坊市古籍铺要处理旧功法，可以去捡漏"
        event {
          type = "knowledge"
          info = "下个月坊市古籍铺将处理旧功法，可低价收购基础引气诀"
        }
      }
    }
  }
  chapter "chp_3" {
    title = "算尽余寿涉旧矿，坊市购诀触灵基"
    objective "obj_1" {
      goal = "林砚冒险往返黑风矿挖取高品灵石兑换资金，购入顶级基础引气诀，突破至练气一层巅峰，确认复活副作用与修为负相关"
      step 1 {
        description = "林砚与小石头返程时撞见缉厄司差人在通铺所在巷子逐户盘查，发现巷口盯梢的素衣女子身上的松烟味与此前城门口女子、茶摊灰衣人味道一致，二人当即躲进废品巷伪装成拾荒者，搭卖炭老汉的炭车绕路一个时辰甩脱盯梢"
      }
      step 2 {
        description = "二人返回通铺后确认缉厄司已离开，藏在床底的血蓟草未被翻动"
      }
      step 3 {
        description = "接下来十五天林砚每日换路线往返百草堂分拣灵草，共攒得53块下品灵石，仍买不起功法阁标价78块的残次《基础引气诀》"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = 53
          }
        }
      }
      step 4 {
        description = "林砚盘算利用自己对黑风矿结构的熟悉，前往废弃矿道挖取矿主遗弃的高品零散灵石换功法，核算复活折寿风险后认定收益大于风险，小石头为报救命之恩主动答应帮他打掩护"
      }
      step 5 {
        description = "接下来十五天林砚共往返黑风矿六次，中途两次遇险复活：一次被坍塌顶板砸死，一次被缉厄司暗哨追捕主动撞石身亡，共折寿十年，剩余寿元十四年；期间偷听到缉厄司暗哨称抓捕的穿越者要上缴给头领三哥核验收天道碎片，三哥正在搜捕他这个黑风矿逃出来的「复活怪」"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "lifespan"
            delta = -10
            note = "练气一层两次复活共折寿十年，剩余寿元14年"
          }
        }
        event {
          type = "knowledge"
          info = "缉厄司抓捕穿越者是为了抽取天道碎片上交三哥，三哥正在重点搜捕持有复活金手指的林砚"
        }
      }
      step 6 {
        description = "林砚将挖到的高品灵石兑换为120块下品灵石，扣除20块干粮、跌打药开销后剩100块，到功法阁花费90块买下无隐患的顶级《基础引气诀》，剩余10块留作他与小石头的生活费，掌柜额外赠送空白玉简一份"
        event {
          type = "acquire"
          item = "顶级《基础引气诀》"
          delta = 1
        }
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = -90
          }
        }
      }
      step 7 {
        description = "林砚返回通铺修炼，仅用两个时辰就修炼至练气一层巅峰，发现自己因多次复活时被矿洞高浓度灵气冲刷，经脉被拓宽三倍，吸纳灵气速度是普通修士的三倍"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "cultivation"
            from = "练气一层初期"
            to = "练气一层巅峰"
            delta = 0.5
          }
        }
      }
    }
  }
  chapter "chp_4" {
    title = "假死巷口明损耗，痞言失口露凶名"
    objective "obj_1" {
      goal = "林砚测试复活副作用，验证修为越高损耗越低的猜想，确认三哥势力已渗透青牛镇底层"
      step 1 {
        description = "林砚在便民通铺清点剩余寿元与灵石，确认离灵草铺发薪还有三天，现有积蓄仅够买十天粗粮干粮，打算凑钱买聚气丹，不再冒险去黑风矿"
      }
      step 2 {
        description = "林砚抄近路走通铺后小巷前往粮铺，被三名地痞堵截，对方索要3块下品灵石过路费"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_di_pi" count = 3 level = "无修为"}]
          }
        }
      }
      step 3 {
        description = "林砚权衡硬刚、报官、假死三种方案的成本收益后，选择假死脱身，故意激怒疤脸头目被对方一棍砸中太阳穴，身体化作灵气当场消失"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "death"
            note = "被地痞砸中太阳穴身亡，触发复活机制"
          }
        }
      }
      step 4 {
        description = "三名地痞受惊误以为碰到邪祟，正要逃窜时撞见复活后出现在巷口的林砚，吓得将当天收的8块下品灵石全部上交，仓皇逃跑时提及势力头目「三哥」不许在镇子上出人命的规矩"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = 8
          }
        }
        event {
          type = "knowledge"
          info = "三哥势力已渗透青牛镇底层地痞团伙，管控严格"
        }
      }
      step 5 {
        description = "林砚检查自身状态，确认本次复活仅从练气一层圆满降至练气一层后期，未折损任何寿元，验证了「修为越高复活副作用越低」的猜想"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "cultivation"
            from = "练气一层巅峰"
            to = "练气一层后期"
            delta = -0.2
          }
        }
        event {
          type = "knowledge"
          info = "修为越高，复活时的寿元、修为损耗越低，练气一层后期复活未折寿"
        }
      }
      step 6 {
        description = "林砚清点收益后，到粮铺花2块下品灵石购买了十天份粗粮干粮，规划剩余16块灵石的用途：8块买聚气丹加速突破练气二层，8块留作应急备用金"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = -2
          }
        }
      }
      step 7 {
        description = "林砚返回通铺，见到收灵草回来的小石头，收下他展示的额外奖励铜板，递给他半块粗粮饼，清点灵石时意识到青牛镇已被「三哥」势力全面渗透，必须尽快提升修为攒够活命筹码"
      }
    }
  }
  chapter "chp_5" {
    title = "山外采药斩赤兔，冲关忽闻探信人"
    objective "obj_1" {
      goal = "林砚接采药委托赚取资金，斩杀赤毛兔获得额外收益，租下修炼室闭关突破至练气二层，得知有粉裙女子打探自己行踪"
      step 1 {
        description = "林砚清晨避开通铺住客出门，给留在家的小石头留了半块粗粮饼，嘱托他盯梢通铺附近的陌生面孔，有情况就去百草堂报信，随后带16块下品灵石前往坊市"
      }
      step 2 {
        description = "林砚抵达百草堂，王掌柜肯定了他此前分拣灵草零差错的工作成果，委托他去城外低阶灵草区采10株三年份黄叶草，承诺给出5块下品灵石的报酬"
      }
      step 3 {
        description = "林砚先花2块下品灵石购入玄铁匕首防身，随后前往低阶灵草区，不到半个时辰就采够了要求的黄叶草，返程时遭遇低阶妖兽赤毛兔袭击，抬手用匕首精准斩杀赤毛兔"
        event {
          type = "combat"
          combat {
            enemies = [{id = "enemy_chi_mao_tu" count = 1 level = "练气一层"}]
          }
          state_delta {
            target = "enemy_chi_mao_tu"
            kind = "death"
          }
        }
      }
      step 4 {
        description = "林砚回城后先将黄叶草交给王掌柜，拿到5块下品灵石报酬和半袋灵草籽，王掌柜告知近日有穿粉裙的陌生小姑娘多方打听他的下落，已经帮他隐瞒了身份信息"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = 5
          }
        }
        event {
          type = "knowledge"
          info = "有穿粉裙的陌生女子多方打探林砚行踪，疑似追踪势力人员"
        }
      }
      step 5 {
        description = "林砚将赤毛兔尸体卖给坊市材料摊老板，拿到7块下品灵石"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = 7
          }
        }
      }
      step 6 {
        description = "林砚花10块下品灵石租下半个月的独立修炼室，闭关修炼冲击瓶颈时发现左臂有复活折损导致的经脉暗伤，会拖慢灵气运转速度"
        event {
          type = "location"
          move {
            to = "loc_du_li_xiu_lian_shi"
          }
        }
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "injury"
            field = "左臂经脉"
            to = "轻度暗伤，灵气运转减慢三成"
          }
        }
      }
      step 7 {
        description = "林砚耗时五日成功突破至练气二层，灵气吸纳速度提升20%，左臂暗伤仍未完全痊愈，仅能做到灵气顺畅通过，运转速度还是比其他部位慢三成"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "cultivation"
            from = "练气一层后期"
            to = "练气二层"
            delta = 0.5
          }
        }
      }
      step 8 {
        description = "林砚盘算后续计划：先巩固练气二层修为、再接王掌柜的采药委托攒灵石买温养经脉的灵药、回去给帮忙盯梢的小石头带蜜饯当奖励，顺便打听粉裙姑娘的动向"
      }
    }
  }
  chapter "chp_6" {
    title = "三月苦修登三层，试复生还闻主亲临"
    objective "obj_1" {
      goal = "林砚闭关三月突破至练气三层，测试复活副作用得知练气三层仅折寿两年，确认三哥亲自坐镇青牛镇搜捕穿越者"
      step 1 {
        description = "林砚装出重病散修的样子，打发走前来打听他的粉裙女子，记录对方身上的松烟味与此前盯梢的素衣女子一致，判定为三哥势力眼线，威胁等级暂标橙色"
        event {
          type = "knowledge"
          info = "打探行踪的粉裙女子身上带有同款特殊松烟味，确认是三哥势力眼线，威胁等级橙色"
        }
      }
      step 2 {
        description = "林砚与被他救过的小孩小石头约定盯梢暗号：闭关期间无异常就每日在修炼室窗台放一颗干净小石子，有危险就敲三下玻璃"
      }
      step 3 {
        description = "林砚花费近半积蓄续了两个半月的修炼室租期，又托王掌柜购入半瓶低阶聚气丹，准备闭关冲级"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = -30
          }
        }
      }
      step 4 {
        description = "林砚闭关一个半月，靠自己设定的「糙汉经脉buff」吸纳灵气速度为同阶修士一倍，全程仅靠干麦饼和灵泉水度日未出修炼室，小石头每日放石子报平安，让他无需分心警戒"
      }
      step 5 {
        description = "闭关第四十五天恰好是林砚逃入青牛镇第九十天，林砚灵气累积到突破临界点，先使用八块下品灵石购入的低阶测寿玉简测得剩余寿元为14年，核算后判定复活测试风险可控"
        event {
          type = "acquire"
          item = "低阶测寿玉简"
          delta = 1
        }
      }
      step 6 {
        description = "林砚运转功法突破瓶颈，顺利升到练气三层，困扰他两个月的左臂暗伤大幅好转，灵气运转几乎不再滞涩"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "cultivation"
            from = "练气二层"
            to = "练气三层"
            delta = 1
          }
        }
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "injury"
            field = "左臂经脉"
            to = "暗伤大幅好转，灵气运转基本不受限"
          }
        }
      }
      step 7 {
        description = "林砚听到窗外两名散修交谈，得知三哥已经亲自到青牛镇坐镇缉拿穿越者，持有可识别穿越者的照魂盘，被抓的穿越者会被抽走神魂补天道、魂飞魄散，三哥势力手下腰牌刻有淡蓝色云纹"
        event {
          type = "knowledge"
          info = "三哥亲自坐镇青牛镇，持有照魂盘可识别穿越者，被抓者会被抽走神魂魂飞魄散，势力标识为淡蓝色云纹腰牌"
        }
      }
      step 8 {
        description = "林砚将三哥的威胁等级从橙色调整为最高级红色，决定立刻测试复活能力摸清底牌，主动触碰修炼室门后内置的淬毒禁制（练气三层及以下中者必死）"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "death"
            note = "主动触碰淬毒禁制身亡，测试复活副作用"
          }
        }
      }
      step 9 {
        description = "林砚中腐骨毒身亡后成功复活，修为掉到练气二层巅峰，仅折寿2年，复活副作用相比练气一层时降低80%，验证了「修为越高复活副作用越低」的猜想"
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "lifespan"
            delta = -2
            note = "练气三层复活仅折寿2年，剩余寿元12年"
          }
        }
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "cultivation"
            from = "练气三层"
            to = "练气二层巅峰"
            delta = -0.3
          }
        }
      }
      step 10 {
        description = "林砚清点剩余灵石足够买两瓶聚气散补修为，打算外出探听三哥底细，还要给盯梢两个多月无差错的小石头带两串糖葫芦当奖励，随后拉开修炼室木门准备外出"
      }
    }
  }
  chapter "chp_7" {
    title = "坊角留笺邀旧友，烟痕如昔引疑踪"
    objective "obj_1" {
      goal = "林砚购买聚气散补充修为，收到书友会的破庙邀约，确认特殊松烟味与三哥势力高度关联，决定赴约探查"
      step 1 {
        description = "林砚刻意绕偏僻小巷行走，遮掩左手腕的黑风矿专属玄铁镣铐印，避免暴露穿越者身份"
        event {
          type = "location"
          move {
            to = "loc_qing_niu_zhen_fang_shi"
          }
        }
      }
      step 2 {
        description = "林砚到丹药摊砍价，以两块五下品灵石一瓶的价格购入两瓶聚气散，从摊主口中得知缉厄司由三哥坐镇、持照魂盘搜捕穿越者，且书友会内部藏有缉厄司安插的内鬼"
        event {
          type = "acquire"
          item = "聚气散*2"
          delta = 1
        }
        event {
          type = "status"
          state_delta {
            target = "char_lin_yan"
            kind = "resource"
            field = "下品灵石"
            delta = -5
          }
        }
        event {
          type = "knowledge"
          info = "穿越者互助组织书友会内部藏有缉厄司安插的内鬼，核心信息已泄露"
        }
      }
      step 3 {
        description = "林砚行至坊市出口拐角时恰逢散修吵架吸引所有人注意力，被灰衣伙计陈默故意撞到，对方刻意提及查内鬼、三哥渗透的信息后快速离开"
      }
      step 4 {
        description = "林砚发现被塞了一张写有「三日后坊市后破庙见，同为写书人」的炭笔字条，认出字条上的特殊松烟味与此前遇到的粉裙女子、素衣女子身上的味道完全一致"
        event {
          type = "knowledge"
          info = "收到书友会暗线陈默的邀约，三日后坊市后破庙见面，字条上的特殊松烟味与三哥势力眼线身上的味道完全一致，存在设局可能"
        }
      }
      step 5 {
        description = "林砚确认递字条的是书友会暗线陈默，权衡赴约风险后决定赴约，运转灵气将字条烧毁不留痕迹"
      }
      step 6 {
        description = "林砚计划接下来三日内补回炼气三层修为，提前去破庙踩点准备多重后手，安排小石头帮忙盯梢破庙周边的陌生人员"
      }
      step 7 {
        description = "林砚返程途中再次闻到同款松烟味，瞥见素衣女子的半角裙角在巷口一闪而逝，确认自己仍被追踪势力盯梢"
        event {
          type = "knowledge"
          info = "行踪仍被三哥势力眼线监控，赴约需做好万全准备"
        }
      }
    }
  }
}