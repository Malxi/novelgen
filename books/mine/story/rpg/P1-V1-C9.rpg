# Chapter P1-V1-C9: 复生被窥，灵石换得缄默

storyline {
  chapter "复生被窥，灵石换得缄默" {
    id = "P1-V1-C9"

    objective "主要剧情" {
      step 1 {
        description = "林砚攥着半块萤石进入丁字八号废弃矿道，打算藏匿刚挖的灵石，默算私藏的灵石已有三十七块下品灵石，加上当日新挖的三块共四十块，原定再挖三�..."
        event {
          type = "status"
        }
      }
      step 2 {
        description = "林砚刚触碰到藏物资的岩洞的活动岩石，矿道突发小型坍塌，被磨盘大的落石砸中天灵盖死亡"
        event {
          type = "status"
        }
      }
      step 3 {
        description = "林砚很快复活，探察丹田发现修为从练气二层掉回练气一层，所幸未触碰到修为下限折损寿命"
        event {
          type = "status"
        }
      }
      step 4 {
        description = "林砚发现小矿奴小石头躲在岩柱后目睹了自己复活的全过程，小石头此前传闻被灰衣人带走，实际是未查出异常被放回，一直攒灵石想换临时身份牌逃�..."
        event {
          type = "status"
        }
      }
      step 5 {
        description = "林砚冲上前制住小石头，威胁他不许声张复活的事，小石头主动表示自己什么都没看见"
        event {
          type = "status"
        }
      }
    }
  }
}
