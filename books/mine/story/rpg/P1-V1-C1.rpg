# Chapter P1-V1-C1: 寒矿醒转，首死触发复生

storyline {
  chapter "寒矿醒转，首死触发复生" {
    id = "P1-V1-C1"

    objective "主要剧情" {
      step 1 {
        description = "现代修仙网文作者林砚熬夜赶稿时猝死，穿越到自己创作的矿场开局修仙文世界中，成为黑风灵石矿内签了死契的练气二层散修矿奴"
        event {
          type = "status"
        }
      }
      step 2 {
        description = "林砚刚苏醒就遭到矿监周虎鞭打，他消化完原身记忆后发现矿道内布有锁灵阵，完全压制练气期修士灵力，遂决定暂时隐忍不反抗"
        event {
          type = "status"
        }
      }
      step 3 {
        description = "老矿奴老陈给林砚递来一把豁口镐头，偷偷提醒他近期矿内不太平，有腰挂漆黑铜牌的灰衣官爷随意抓走可疑矿奴不留尸首，地底深处还有诡异哭声传�..."
        event {
          type = "status"
        }
      }
      step 4 {
        description = "林砚凭借自己写文积累的挖灵石经验，很快找准矿脉位置开始挖矿，半炷香时间就挖了小半筐下品灵石"
        event {
          type = "status"
        }
      }
      step 5 {
        description = "矿道突发坍塌，林砚被碗口大的落石砸中当场死亡；周虎为了自保拽过身边的老陈挡石，导致老陈半边肩膀被碎石砸得血肉模糊"
        event {
          type = "status"
        }
      }
    }
  }
}
