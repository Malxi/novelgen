
metadata {
  title = "穿越者的天道弈局"
  genre = ["仙侠", "穿越", "悬疑", "黑暗奇幻"]
  power_system = "金手指体系：附矿场复活 + 金手指体系：复活爱人 + 金手指体系：情感强制 + 金手指体系：龙傲天 + 金手指体系：异能吞噬 + 金手指体系：轨迹推演 + 金手指体系：话术操控 + 修仙境界体系：修仙 + 金手指体系：命运悲鸣 + 金手指体系：副本生成器 + 金手指体系：剧情强制 + 金手指体系：真实还原 + 金手指体系：知识污染 + 金手指体系：荒诞吸引 + 金手指体系：真实洞察 + 金手指体系：技术预演"
  tone = "冷峻烧脑，黑暗残酷，悬念迭起，略带黑色幽默"
  dsl_version = "0.2.0"
  phase = "setup"
}

characters {
  player "刘巧" {
    id = "刘巧"
    class = "mage"
    str = 10
    agi = 12
    int = 10
    vit = 10
    hp = 100
    mp = 50
  }
}

world {
}

storyline {
}

systems {
  attribute_system "Core Attributes" {
    id = "attr_core"
    description = "Numeric baseline attributes for simulation and continuity checks."
    attribute "Strength" {
      id = "str"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Agility" {
      id = "agi"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Intelligence" {
      id = "int"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "Vitality" {
      id = "vit"
      type = "stat"
      base_value = 10
      max_value = 999
      is_resource = false
    }
    attribute "HP" {
      id = "hp"
      type = "resource"
      base_value = 100
      max_value = 999999
      is_resource = true
    }
    attribute "MP" {
      id = "mp"
      type = "resource"
      base_value = 50
      max_value = 999999
      is_resource = true
    }
    attribute "Qi" {
      id = "qi"
      type = "resource"
      base_value = 0
      max_value = 999999
      is_resource = true
    }
  }
  power_formula "Core Power Formula" {
    id = "power_core"
    description = "Deterministic combat power formula for benchmark simulation."
    base_power = 10
    formula = "base + sum(attr_i * weight_i)"
    factor "Strength" {
      attribute = "str"
      weight = 2
    }
    factor "Agility" {
      attribute = "agi"
      weight = 1.2
    }
    factor "Intelligence" {
      attribute = "int"
      weight = 1.8
    }
    factor "Vitality" {
      attribute = "vit"
      weight = 1.5
    }
    factor "HP" {
      attribute = "hp"
      weight = 0.1
    }
    factor "MP" {
      attribute = "mp"
      weight = 0.2
    }
    factor "Qi" {
      attribute = "qi"
      weight = 1
    }
  }
  counter "chapter_progress" {
    track = "story.chapter"
    description = "Story progression counter"
    milestone 5 {
      title = "Arc Warmup"
    }
    milestone 10 {
      title = "Arc Core"
    }
  }
  counter "金手指体系：附矿场复活_progress" {
    track = "player.progression"
    description = "Primary progression pace tracker"
    milestone 1 {
      title = "System Activated"
    }
    milestone 3 {
      title = "First Breakthrough"
    }
    milestone 5 {
      title = "Mid-Arc Growth"
    }
  }
  progression "金手指体系：附矿场复活" {
    id = "金手指体系：附矿场复活"
    level 1 {
      name = "基础复活"
      requirements = "死亡触发，且复活点为离死亡最近的矿场"
      bonuses = ["死亡后在最近的矿场随机地点复活，身体仅恢复至死亡前一刻的「粗修复状态」（伤口闭合，但身体极度虚弱，灵力紊乱），且每次复活都会损耗部分自身修为，修为损耗下限为练气一层，练气一层复活折损10年寿命，千里无矿场时复活延迟72小时且复活后濒死，尸体会消失"]
    }
  }
  progression "金手指体系：复活爱人" {
    id = "金手指体系：复活爱人"
    level 1 {
      name = "基础爱人复活"
      requirements = "需触发两个核心条件——所爱之人死亡，且三哥自身对其怀有灵魂层面的强烈执念与爱意。"
      bonuses = ["可复活自己灵魂本源层面真心所爱的人，复活后目标身体恢复至死亡前的健康状态，但会消耗三哥自身的部分修为，且复活次数越多，修为损耗越大，甚至可能导致自身修为倒退。外力操控产生的虚假爱意无法触发该能力"]
    }
  }
  progression "金手指体系：情感强制" {
    id = "金手指体系：情感强制"
    level 1 {
      name = "基础情感诱导"
      requirements = "主动触发，需与目标面对面接触，且自身灵气充足，目标无强烈的精神防御。"
      bonuses = ["主动催动灵气，可让单个目标对自己产生强烈的爱意与无条件的保护欲，操控效果持续时间随灵气消耗而定，目标修为越低，操控效果越稳定。该能力催生的爱意为虚假情感，无法触发「复活爱人」能力"]
    }
  }
  progression "金手指体系：龙傲天" {
    id = "金手指体系：龙傲天"
    level 1 {
      name = "基础幸运加成"
      requirements = "无主动触发条件，随机被动激活，触发概率与自身气运相关。"
      bonuses = ["被动触发，日常活动中（如行走、打坐、历练）会随机获得各类对应自身修为等级的修仙机缘，包括高阶灵草、修炼功法、上古传承、灵气宝地等，机缘可能伴随危险或引来觊觎者。"]
    }
  }
  progression "金手指体系：异能吞噬" {
    id = "金手指体系：异能吞噬"
    level 1 {
      name = "基础死亡反击"
      requirements = "死后触发，且杀人者必须是拥有金手指的穿越者或伪穿越者（普通本土修士杀死不触发）。"
      bonuses = ["被拥有金手指的目标杀死后，可在原地复活，同时剥夺杀人者的金手指，将其据为己有，杀人者则会永久失去该能力；复活后身体处于虚弱状态，需短暂调息才能恢复。"]
    }
  }
  progression "金手指体系：轨迹推演" {
    id = "金手指体系：轨迹推演"
    level 1 {
      name = "基础轨迹推演"
      requirements = "主动触发，需清晰看到目标的面部或感知到其核心气息，且目标修为不超过自身。"
      bonuses = ["主动消耗少量灵气，可推演单个目标1炷香内的行动轨迹，或破解一个简单的隐藏秘密（如是否携带武器、是否撒谎、是否隐藏修为），推演结果存在10%的误差，目标修为越高，误差越大。"]
    }
  }
  progression "金手指体系：话术操控" {
    id = "金手指体系：话术操控"
    level 1 {
      name = "基础话术诱导"
      requirements = "主动触发，需与目标面对面交流，目标无强烈戒备心，且自身消耗少量灵气维持话术效果。"
      bonuses = ["主动触发话术能力，通过语言诱导，让修为低于自身（练气五层及以下）的目标做出简单行为（如放下武器、说出基础信息、暂时放弃攻击），操控持续时间为10息，目标事后会残留模糊记忆，容易对自身行为产生怀疑。"]
    }
  }
  progression "修仙境界体系：修仙" {
    id = "修仙境界体系：修仙"
    level 1 {
      name = "练气一层"
      requirements = "灵气入体，成功引天地灵气进入体内，完成第一次灵气循环。"
      bonuses = ["修仙入门境界，可初步吸纳天地灵气入体，摆脱凡人肉身限制，拥有微弱的灵气攻击力。"]
    }
    level 2 {
      name = "练气二层"
      requirements = "达到练气一层圆满，积累足够灵气，完成灵气循环的进阶。"
      bonuses = ["灵气在体内形成稳定循环，肉身强度略有提升，可熟练操控少量灵气进行基础攻击与防御。"]
    }
    level 3 {
      name = "练气三层"
      requirements = "达到练气二层圆满，攒够足够灵气，稳固体内灵气循环。"
      bonuses = ["灵气储量大幅增加，可将灵气附着于拳脚或简单法器上，攻击力显著提升。"]
    }
    level 4 {
      name = "练气四层"
      requirements = "达到练气三层圆满，攒够足够灵气，扩充体内灵气池。"
      bonuses = ["灵气在体内形成小型灵气池，可连续释放灵气攻击，续航能力提升。"]
    }
    level 5 {
      name = "练气五层"
      requirements = "达到练气四层圆满，攒够足够灵气，提纯体内灵气。"
      bonuses = ["灵气纯度提升，可初步感知周边灵气分布，对低阶法器的操控更加熟练。"]
    }
    level 6 {
      name = "练气六层"
      requirements = "达到练气五层圆满，攒够足够灵气，强化肉身与灵气的联动。"
      bonuses = ["肉身强度进一步提升，可抵御低阶灵气攻击，灵气攻击范围扩大。"]
    }
    level 7 {
      name = "练气七层"
      requirements = "达到练气六层圆满，攒够足够灵气，提升灵气操控精度。"
      bonuses = ["灵气池进一步扩大，可同时操控多道灵气攻击，战斗灵活性提升。"]
    }
    level 8 {
      name = "练气八层"
      requirements = "达到练气七层圆满，攒够足够灵气，进一步提纯灵气，掌握灵气凝练技巧。"
      bonuses = ["灵气纯度大幅提升，可释放凝练的灵气刃，攻击力大幅增强。"]
    }
    level 9 {
      name = "练气九层"
      requirements = "达到练气八层圆满，攒够足够灵气，稳固灵气与肉身的契合度。"
      bonuses = ["灵气池达到饱和，肉身与灵气达到完美契合，可应对中低阶修士的攻击。"]
    }
    level 10 {
      name = "练气十层"
      requirements = "达到练气九层圆满，攒够足够灵气，冲击练气期瓶颈。"
      bonuses = ["练气期巅峰境界，灵气池达到极限，需突破瓶颈才能进入筑基期。"]
    }
    level 11 {
      name = "筑基初期"
      requirements = "达到练气十层圆满，吞服筑基丹，借助灵石灵气辅助，成功突破筑基瓶颈。"
      bonuses = ["正式踏入修仙门槛，灵气转化为筑基灵力，肉身强度、灵气储量与操控力大幅飞跃，可御使低阶法器飞行。金手指能力增幅上限提升100%"]
    }
    level 12 {
      name = "筑基中期"
      requirements = "达到筑基初期圆满，攒够足够筑基灵力，稳固筑基境界。"
      bonuses = ["筑基灵力进一步凝练，御使法器的速度与精度提升，可施展基础筑基期法术。"]
    }
    level 13 {
      name = "筑基后期"
      requirements = "达到筑基中期圆满，攒够足够筑基灵力，冲击筑基后期瓶颈。"
      bonuses = ["筑基灵力达到饱和，肉身强度媲美中阶法器，可施展高阶筑基期法术，战斗力大幅提升。"]
    }
    level 14 {
      name = "筑基巅峰"
      requirements = "达到筑基后期圆满，攒够足够筑基灵力，做好渡雷劫的准备。"
      bonuses = ["筑基期最终境界，灵力纯度与储量达到极致，需度过雷劫才能突破至金丹期。"]
    }
    level 15 {
      name = "金丹初期"
      requirements = "达到筑基巅峰，成功度过雷劫，将筑基灵力凝聚成金丹。"
      bonuses = ["修仙界中阶境界，筑基灵力凝聚成金丹，灵力储存量与操控力呈几何级提升，可御使中阶法器，寿命大幅延长。金手指能力增幅上限提升300%"]
    }
    level 16 {
      name = "金丹中期"
      requirements = "达到金丹初期圆满，攒够足够金丹灵力，稳固金丹境界。"
      bonuses = ["金丹进一步凝练，灵力纯度提升，可施展金丹期核心法术，战斗力远超筑基期修士。"]
    }
    level 17 {
      name = "金丹后期"
      requirements = "达到金丹中期圆满，攒够足够金丹灵力，扩充金丹容量。"
      bonuses = ["金丹体积膨胀，灵力储量翻倍，可同时施展多门金丹期核心法术，肉身强度可抵御低阶法宝攻击。"]
    }
    level 18 {
      name = "金丹巅峰"
      requirements = "达到金丹后期圆满，攒够足够金丹灵力，度过心魔劫。"
      bonuses = ["金丹凝练至极致，表面浮现道纹，灵力纯度达到元婴前阈值，需度过心魔劫突破至元婴期。金手指能力增幅上限提升500%"]
    }
    level 19 {
      name = "元婴初期"
      requirements = "达到金丹巅峰，成功碎丹化婴，稳固元婴形态。"
      bonuses = ["金丹破碎化为元婴，神魂与元婴绑定，即使肉身被毁也可元婴出逃夺舍重生，寿命延长至500年，可御使高阶法宝。金手指能力增幅上限提升1000%"]
    }
    level 20 {
      name = "化神初期"
      requirements = "达到元婴巅峰，感悟基础天道规则，完成神魂与元婴的融合。"
      bonuses = ["元婴与神魂彻底融合，可神魂出窍遨游天地，初步接触天道规则，寿命延长至1000年，是修仙界高阶战力的门槛。金手指可突破部分天道规则限制"]
    }
  }
  progression "金手指体系：命运悲鸣" {
    id = "金手指体系：命运悲鸣"
    level 1 {
      name = "基础厄运感知"
      requirements = "与目标有深厚情感羁绊，且目标即将遭遇生死危机。"
      bonuses = ["被动感知自身或亲近者24小时内即将面临的重大灾难（死亡、重伤等），画面模糊，仅持续瞬间。自身产生轻微不适，伴随低概率轻微霉运事件，无法改变灾难结果。"]
    }
  }
  progression "金手指体系：副本生成器" {
    id = "金手指体系：副本生成器"
    level 1 {
      name = "基础试炼副本"
      requirements = "需提前准备「副本核心」（如玉简），并消耗大量灵石。"
      bonuses = ["可在静室或小型空地生成「试炼副本」，持续1炷香，规则简单（如「不可飞行」），怪物为低阶幻影，杀伤力低。消耗大。"]
    }
  }
  progression "金手指体系：剧情强制" {
    id = "金手指体系：剧情强制"
    level 1 {
      name = "基础情感渲染"
      requirements = "作者处于情绪波动期（如恋爱中）时无意识触发"
      bonuses = ["半径一丈内，轻微情感渲染，使异性间产生短暂好感，行为轻微偏差（如多看一眼、脸红）。作者无法主动控制。"]
    }
  }
  progression "金手指体系：真实还原" {
    id = "金手指体系：真实还原"
    level 1 {
      name = "基础场景还原"
      requirements = "对该历史场景的研究达到专家级别，且消耗大量灵石"
      bonuses = ["重现单一场景（如「某朝某市集」），持续半炷香，自身获得该时代基础常识与口音。外貌微调（如服饰变化），使用后效果可自行消退。"]
    }
  }
  progression "金手指体系：知识污染" {
    id = "金手指体系：知识污染"
    level 1 {
      name = "基础异象生成"
      requirements = "创作或思考克苏鲁相关概念时触发"
      bonuses = ["书写时，周围出现轻微异象（如阴影蠕动、低语回声），仅限于作者感知。自身做相关噩梦，无对外杀伤力。"]
    }
  }
  progression "金手指体系：荒诞吸引" {
    id = "金手指体系：荒诞吸引"
    level 1 {
      name = "基础滑稽事件触发"
      requirements = "作者处于放松或幽默状态时无意识触发"
      bonuses = ["引发小型滑稽事件（如天空掉下香蕉皮、重要符咒变成纸鹤），无伤害，纯搞笑，但可能干扰精细操作，偶尔带来意外转机。"]
    }
  }
  progression "金手指体系：真实洞察" {
    id = "金手指体系：真实洞察"
    level 1 {
      name = "基础情绪感知"
      requirements = "与目标有短暂接触（如眼神交汇），且目标情绪激烈"
      bonuses = ["感知目标当前强烈情绪（如愤怒、悲伤），获得简单画面片段（如童年创伤场景）。自身承受相应情绪波动。"]
    }
  }
  progression "金手指体系：技术预演" {
    id = "金手指体系：技术预演"
    level 1 {
      name = "基础结构解析"
      requirements = "主动触发，需触碰目标构造物，消耗对应强度的精神力"
      bonuses = ["触碰构造物即可感知其内部结构，瞬间知晓简单机械（如锁具、机关）的结构弱点与最佳开启方式，消耗精神力随构造物复杂程度提升，低阶时仅可解析简单构造物。"]
    }
  }
}
